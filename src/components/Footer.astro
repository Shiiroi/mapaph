---
/**
 * @file Footer.astro
 * @description Main footer layout categorizing tools, references, legal notes, and contact channels.
 */

import pkg from "../../package.json";

const currentYear = new Date().getFullYear();
---

<footer class="bg-mapa-green border-t border-mapa-clay/30 text-mapa-canvas">
	<div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 md:py-16">
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 md:gap-10">
			<!-- Column 1: Branding -->
			<div class="flex flex-col gap-3">
				<a
					href="/"
					class="font-serif font-bold text-xl tracking-tight text-mapa-canvas hover:text-mapa-clay transition-colors duration-200"
				>
					mapaPH
				</a>
				<p
					class="font-sans text-xs text-mapa-clay leading-relaxed font-medium"
				>
					Open-source tools, geographic references, and civic datasets built around the Philippine map.
				</p>
				<p class="font-sans text-xs text-mapa-canvas/60 mt-1">
					© {currentYear} mapaPH. <span class="text-mapa-canvas/45 select-none font-medium ml-1.5">v{pkg.version}</span>
				</p>
				<!-- Social Channels -->
				<div class="flex items-center gap-3 mt-1">
					<a
						href="https://facebook.com/mapaph.official"
						target="_blank"
						rel="noopener noreferrer"
						class="text-mapa-canvas/75 hover:text-mapa-clay transition-colors"
						aria-label="mapaPH on Facebook"
						title="Follow mapaPH on Facebook"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
						</svg>
					</a>
					<a
						href="https://instagram.com/mapaph.official"
						target="_blank"
						rel="noopener noreferrer"
						class="text-mapa-canvas/75 hover:text-mapa-clay transition-colors"
						aria-label="mapaPH on Instagram"
						title="Follow mapaPH on Instagram"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
						</svg>
					</a>
				</div>
			</div>

			<!-- Column 2: Tools & Utilities -->
			<div class="flex flex-col gap-3.5">
				<h4
					class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-clay"
				>
					Tools & Utilities
				</h4>
				<ul class="flex flex-col gap-2.5 font-sans text-sm text-mapa-canvas/80">
					<li>
						<a href="/tools/psgc-lookup" class="hover:text-mapa-clay transition-colors duration-200">
							PSGC Lookup Tool
						</a>
					</li>
					<li>
						<a href="/tools/coordinates" class="hover:text-mapa-clay transition-colors duration-200">
							Coordinate Converter
						</a>
					</li>
					<li>
						<a href="/tools/zip-codes" class="hover:text-mapa-clay transition-colors duration-200">
							ZIP Code Lookup
						</a>
					</li>
					<li>
						<a href="/tools/fare-calculator" class="hover:text-mapa-clay transition-colors duration-200">
							Commute Fare Estimator
						</a>
					</li>
					<li>
						<a href="/tools/walkability" class="hover:text-mapa-clay transition-colors duration-200">
							Walkability Map
						</a>
					</li>
					<li>
						<a href="/tools/rail-transit" class="hover:text-mapa-clay transition-colors duration-200">
							Rail Transit Map
						</a>
					</li>

					<li>
						<a href="/tools/toll-calculator" class="hover:text-mapa-clay transition-colors duration-200">
							Expressway Tolls
						</a>
					</li>
					<li>
						<a href="/tools/edsa-carousel" class="hover:text-mapa-clay transition-colors duration-200">
							EDSA Carousel Busway
						</a>
					</li>
					<li>
						<a href="/tools/kilometer-posts" class="hover:text-mapa-clay transition-colors duration-200">
							Kilometer Posts & KM 0
						</a>
					</li>
					<li>
						<a href="https://lens.mapaph.com" target="_blank" rel="noopener noreferrer" class="hover:text-mapa-clay transition-colors duration-200">
							Lens Map Visualizer ↗
						</a>
					</li>
					<li>
						<a href="/tools" class="hover:text-mapa-clay transition-colors duration-200">
							All Tools Directory
						</a>
					</li>
				</ul>
			</div>

			<!-- Column 3: Documentation & Guides -->
			<div class="flex flex-col gap-3.5">
				<h4
					class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-clay"
				>
					Guides & Docs
				</h4>
				<ul class="flex flex-col gap-2.5 font-sans text-sm text-mapa-canvas/80">
					<li>
						<a href="/docs/psgc" class="hover:text-mapa-clay transition-colors duration-200">
							PSGC Reference Guide
						</a>
					</li>
					<li>
						<a href="/docs/philippine-gis-sources" class="hover:text-mapa-clay transition-colors duration-200">
							Free GIS Data Sources
						</a>
					</li>
					<li>
						<a href="/docs/prs92-wgs84-guide" class="hover:text-mapa-clay transition-colors duration-200">
							PRS92 vs. WGS84 Guide
						</a>
					</li>
					<li>
						<a href="/docs/geojson-guide" class="hover:text-mapa-clay transition-colors duration-200">
							GeoJSON Developer Guide
						</a>
					</li>
				</ul>
			</div>

			<!-- Column 4: Legal & Community -->
			<div class="flex flex-col gap-3.5">
				<h4
					class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-clay"
				>
					About & Legal
				</h4>
				<ul class="flex flex-col gap-2.5 font-sans text-sm text-mapa-canvas/80">
					<li>
						<a href="/about" class="hover:text-mapa-clay transition-colors duration-200">
							About mapaPH
						</a>
					</li>
					<li>
						<a href="/contact" class="hover:text-mapa-clay transition-colors duration-200">
							Contact Us
						</a>
					</li>
					<li>
						<a href="/privacy" class="hover:text-mapa-clay transition-colors duration-200">
							Privacy Policy
						</a>
					</li>
					<li>
						<a href="/terms" class="hover:text-mapa-clay transition-colors duration-200">
							Terms of Use
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</footer>
