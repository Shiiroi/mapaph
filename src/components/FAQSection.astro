---
/**
 * @file FAQSection.astro
 * @description FAQ section with answers to common questions about the mapaPH hub,
 * focusing on open-source contributions, data practices, privacy, and licensing.
 * Includes interactive details/summary accordion elements and schema.org JSON-LD structured data.
 */

const faqs = [
	{
		question: "What is the purpose of mapaPH?",
		answer:
			"mapaPH serves as an open-source hub and technical documentation index for web applications built around maps of the Philippines. Our primary mission is to liberate siloed Philippine spatial data—including census demographics from the PSA, municipal financial audits from COA, and transit networks—making them accessible via interactive, browser-native tools without requiring expensive GIS desktop software.",
	},
	{
		question: "Can I use the data or code for my own projects?",
		answer:
			"Yes! All source code repositories, dataset compilation scripts, and GeoJSON boundary files hosted across the mapaPH organization are open-source and licensed under the permissive MIT License. You are free to inspect, fork, modify, and integrate our spatial files into both non-commercial research projects and commercial software applications without royalty fees.",
	},
	{
		question: "How does open-source contribution work across the ecosystem?",
		answer:
			"Every tool in the mapaPH suite is developed publicly on GitHub. Anyone can participate by opening issue tickets for bug reports, proposing new mapping tools, submitting pull requests for code enhancements, or helping curate crowdsourced dataset listings. You can find direct GitHub repository links under each application's documentation page.",
	},
	{
		question: "How is crowdsourced data verified and managed?",
		answer:
			"For directory-based utilities and transit route community submissions, data updates are submitted as pull requests against public JSON/YAML data files. Maintainers verify spatial coordinate sanity, check entries against official place registries (like the PSA PSGC catalog), and run automated validation tests before merging changes into production builds.",
	},
	{
		question: "How does mapaPH handle government data and legal compliance?",
		answer:
			"All government datasets displayed in our visualizers (such as census demographics, electoral results, and local government financial reports) are acquired from public official releases published by the PSA, COMELEC, and COA under the Philippine Freedom of Information (FOI) framework (Executive Order No. 2, s. 2016). We do not store or process personal identifiable information (PII).",
	},
	{
		question: "How is user privacy and analytics tracking handled?",
		answer:
			"The mapaPH hub website is built as a static site generated via Astro and does not use tracking cookies or intrusive third-party user fingerprinting scripts. While third-party advertising partners (like Google AdSense) may set standard advertising cookies to display relevant ads, our core open-source web applications prioritize zero telemetry and user privacy protection.",
	},
];

// Generate JSON-LD schema objects for structured SEO rich results
// Why: Providing structured JSON-LD turns our FAQ text additions into rich, search-visible structured content
// that Google can understand and present as organic rich snippets (collapsible Q&A panels) in search results.
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((faq) => ({
		"@type": "Question",
		name: faq.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: faq.answer,
		},
	})),
};
---

<section
	id="faq"
	class="bg-mapa-canvas border-t border-mapa-contour/60 py-16 md:py-24 font-serif"
>
	<div class="max-w-4xl mx-auto px-6 lg:px-8">
		<!-- Section Header -->
		<div class="border-b border-mapa-contour/50 pb-5 mb-8 text-center">
			<span
				class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green"
			>
				FAQ
			</span>
			<h2
				class="text-3xl font-extrabold text-mapa-ink tracking-tight sm:text-4xl mt-2"
			>
				Frequently Asked Questions
			</h2>
			<p class="font-sans text-sm text-mapa-clay mt-1">
				Everything you need to know about the mapaPH ecosystem, data sources,
				and tools.
			</p>
		</div>

		<!-- Accordion Q&A list -->
		<div class="divide-y divide-mapa-contour/50">
			{
				faqs.map((faq) => (
					<details class="group py-5 [&_summary::-webkit-details-marker]:hidden">
						<summary class="flex justify-between items-center font-serif text-base sm:text-lg font-bold text-mapa-ink cursor-pointer list-none select-none hover:text-mapa-green transition-colors duration-200">
							<span>{faq.question}</span>
							<span class="ml-4 flex-shrink-0 transition-transform duration-300 group-open:rotate-180 text-mapa-clay">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-5 w-5"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M19 9l-7 7-7-7"
									/>
								</svg>
							</span>
						</summary>
						<div class="mt-3 text-sm text-mapa-ink/80 leading-relaxed font-sans">
							<p>{faq.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<!-- 
	FAQ JSON-LD Structured Data - Can be placed anywhere in the document (body or head) 
	as per Google Search specifications. Safe to render inline.
-->
<script
	type="application/ld+json"
	is:inline
	set:html={JSON.stringify(jsonLd)}
/>
