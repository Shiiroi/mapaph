---
/**
 * @file ToolsSection.astro
 * @description Grid directory of mapping applications. Entire card is clickable; GitHub icon link stacks above.
 */

import { Image } from 'astro:assets';
import lensImg from '../assets/lens.png';

const tools = [
	{
		name: "Lens",
		status: "Active",
		category: "Web Application",
		url: "https://lens.mapaph.com",
		description: "Interactive choropleth map and GeoJSON download tool for Philippine administrative boundaries (regions, provinces, cities, municipalities, and barangays). Overlays census, economic, and election statistics with side-by-side comparisons.",
		image: lensImg,
		badge: "Choropleth Mapper"
	},
	{
		name: "PSGC Lookup & Code Decoder",
		status: "Active",
		category: "Built-in Utility",
		url: "/tools/psgc-lookup",
		description: "Instant client-side search across 1,742 Philippine regions, 82 provinces, and 1,642 cities & municipalities (33 HUCs, 5 ICCs, 111 CCs). Inspect 9-digit and 10-digit PSGC codes with 2024 census demographics.",
		image: null,
		badge: "1,742 Divisions"
	},
	{
		name: "Coordinate Converter (PRS92 ↔ WGS84)",
		status: "Active",
		category: "Built-in Utility",
		url: "/tools/coordinates",
		description: "Bi-directional coordinate converter between GPS latitude/longitude (WGS84 decimal degrees) and official Philippine Reference System 1992 (PRS92 / UTM Zone 51N). Explains datum shifts and PTM Zones I through V.",
		image: null,
		badge: "Surveying Utility"
	}
];
---

<section id="tools" class="max-w-7xl mx-auto px-6 lg:px-8 py-16 md:py-24">
	<!-- Section Header -->
	<div class="border-b border-mapa-contour/50 pb-5 mb-10 font-serif flex flex-col sm:flex-row sm:items-end justify-between gap-4">
		<div>
			<h2 class="text-3xl font-extrabold text-mapa-ink tracking-tight">
				The Directory
			</h2>
			<p class="font-sans text-sm text-mapa-clay mt-1">
				A catalog of open-source applications and utilities using maps of the Philippines.
			</p>
		</div>
		<a href="/tools" class="font-sans text-xs sm:text-sm font-semibold text-mapa-green hover:underline shrink-0">
			View All Tools Directory →
		</a>
	</div>

	<!-- Card Grid -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 font-sans">
		{tools.map((tool) => {
			const isExternal = tool.url.startsWith("http");
			return (
				<div
					class="flex flex-col bg-mapa-canvas border border-mapa-contour/80 rounded-xl overflow-hidden transition-all duration-300 group relative hover:border-mapa-green/60 hover:-translate-y-1 cursor-pointer shadow-xs"
				>
					{/* Overlay anchor covering container */}
					<a
						href={tool.url}
						target={isExternal ? "_blank" : "_self"}
						rel={isExternal ? "noopener noreferrer" : undefined}
						class="absolute inset-0 z-10"
						aria-label={`Visit ${tool.name}`}
					/>

					<!-- Card Preview Container -->
					<div class="block border-b border-mapa-contour/50 overflow-hidden relative z-0">
						{tool.image ? (
							<Image
								src={tool.image}
								alt={`${tool.name} preview`}
								class="w-full h-44 object-cover object-top transition-transform duration-500 group-hover:scale-105"
							/>
						) : (
							<div class="h-44 bg-mapa-canvas-dark flex flex-col items-center justify-center p-6 text-center border-b border-mapa-contour/30 relative overflow-hidden">
								{/* Decorative subtle grid lines */}
								<div class="absolute inset-0 opacity-15 bg-[radial-gradient(#3d5a45_1px,transparent_1px)] [background-size:16px_16px]"></div>
								
								<div class="w-10 h-10 rounded-full bg-mapa-green/10 border border-mapa-green/20 flex items-center justify-center text-mapa-green mb-2 relative z-10 transition-transform duration-300 group-hover:scale-110">
									<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
									</svg>
								</div>
								<span class="font-serif text-sm font-bold text-mapa-ink/90 relative z-10">{tool.name}</span>
								<span class="font-sans text-[11px] text-mapa-clay font-medium mt-0.5 relative z-10">{tool.badge}</span>
							</div>
						)}
					</div>

					<!-- Card Body -->
					<div class="p-5 flex flex-col flex-grow">
						<!-- Badges -->
						<div class="flex flex-wrap items-center gap-2 mb-3">
							<span class="uppercase text-[9px] font-bold tracking-wider px-2 py-0.5 rounded bg-mapa-contour/50 border border-mapa-contour text-mapa-ink/75 select-none">
								{tool.category}
							</span>
							<span class="uppercase text-[9px] font-bold tracking-wider px-2 py-0.5 rounded bg-mapa-green/10 border border-mapa-green/30 text-mapa-green select-none">
								Active
							</span>
						</div>

						<!-- Tool Name & Description -->
						<h3 class="font-serif text-lg font-bold text-mapa-ink group-hover:text-mapa-green transition-colors">
							{tool.name}
						</h3>
						
						<p class="text-xs text-mapa-ink/80 mt-2 leading-relaxed flex-grow line-clamp-3">
							{tool.description}
						</p>

						<!-- Actions -->
						<div class="flex items-center justify-between mt-5 pt-3 border-t border-mapa-contour/40 text-xs">
							<span class="text-mapa-green font-semibold inline-flex items-center gap-1 group-hover:underline">
								<span>Open Tool</span>
								<span>→</span>
							</span>
						</div>
					</div>
				</div>
			);
		})}
	</div>
</section>
