---
/**
 * @file HubNavbar.astro
 * @description Sticky header navigation bar containing the logo wordmark and page links.
 */

import { Image } from 'astro:assets';
import logoImg from '../assets/ph.svg';

const pathname = Astro.url.pathname;
const isTools = pathname.startsWith('/tools');
const isAbout = pathname.startsWith('/about');
const isDocs = pathname.startsWith('/docs');
---

<header class="sticky top-0 z-50 bg-mapa-canvas/95 backdrop-blur-md border-b border-mapa-contour">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16">
			<!-- Left: Logo & Wordmark -->
			<a href="/" class="flex items-center gap-2 sm:gap-2.5 py-2 pr-2 group">
				<Image
					src={logoImg}
					alt="mapaPH Logo"
					class="w-8 h-8 object-contain transition-transform duration-200 group-hover:scale-105"
					loading="eager"
				/>
				<span
					class="font-serif font-bold text-lg tracking-tight text-mapa-ink group-hover:text-mapa-green transition-colors duration-200"
				>
					mapaPH
				</span>
			</a>

			<!-- Right: Nav Links -->
			<nav aria-label="Main Navigation" class="flex items-center gap-1 sm:gap-2 md:gap-4">
				<a
					href="/tools"
					aria-current={isTools ? 'page' : undefined}
					class={`font-sans text-sm px-3 py-2 rounded-lg transition-colors duration-200 inline-flex items-center min-h-[40px] ${
						isTools
							? 'font-bold text-mapa-green bg-mapa-green/10'
							: 'font-medium text-mapa-ink hover:text-mapa-green hover:bg-mapa-canvas-dark/70'
					}`}
				>
					Tools
				</a>
				<a
					href="/about"
					aria-current={isAbout ? 'page' : undefined}
					class={`font-sans text-sm px-3 py-2 rounded-lg transition-colors duration-200 inline-flex items-center min-h-[40px] ${
						isAbout
							? 'font-bold text-mapa-green bg-mapa-green/10'
							: 'font-medium text-mapa-ink hover:text-mapa-green hover:bg-mapa-canvas-dark/70'
					}`}
				>
					About
				</a>
				<a
					href="/docs"
					aria-current={isDocs ? 'page' : undefined}
					class={`font-sans text-sm px-3 py-2 rounded-lg transition-colors duration-200 inline-flex items-center min-h-[40px] ${
						isDocs
							? 'font-bold text-mapa-green bg-mapa-green/10'
							: 'font-medium text-mapa-ink hover:text-mapa-green hover:bg-mapa-canvas-dark/70'
					}`}
				>
					Docs
				</a>
			</nav>
		</div>
	</div>
</header>
