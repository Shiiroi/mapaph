---
/**
 * @file DocsLayout.astro
 * @description Docs layout shell — Navbar on top, sticky left sidebar, scrollable content column.
 */

import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	activeSlug: 'index' | 'lens' | 'psgc' | 'data-sources' | 'geojson-guide' | 'gis-sources' | 'prs92-wgs84';
	/** Optional SEO keywords */
	keywords?: string;
	/**
	 * Optional flag to add 'noindex, follow' robots directive.
	 * Used for in-development pages that shouldn't be indexed yet.
	 */
	noindex?: boolean;
}

const { title, description, activeSlug, keywords, noindex = false } = Astro.props;

const tools = [
	{ name: 'Lens',         slug: 'lens',         url: '/docs/lens',         active: true  },
];

const references = [
	{ name: 'PSGC Reference',    slug: 'psgc',         url: '/docs/psgc'        },
	{ name: 'Free GIS Sources',  slug: 'gis-sources',  url: '/docs/philippine-gis-sources' },
	{ name: 'PRS92 vs WGS84',    slug: 'prs92-wgs84',  url: '/docs/prs92-wgs84-guide' },
	{ name: 'Open Data Sources', slug: 'data-sources', url: '/docs/data-sources'},
	{ name: 'GeoJSON Developer', slug: 'geojson-guide',url: '/docs/geojson-guide'},
];

// Ordered page list for prev/next navigation
const pages = [
	{ slug: 'index',        name: 'Overview',            url: '/docs'              },
	{ slug: 'lens',         name: 'Lens Guide',          url: '/docs/lens'         },
	{ slug: 'psgc',         name: 'PSGC Reference',      url: '/docs/psgc'        },
	{ slug: 'gis-sources',  name: 'Free GIS Sources',    url: '/docs/philippine-gis-sources' },
	{ slug: 'prs92-wgs84',  name: 'PRS92 vs WGS84',      url: '/docs/prs92-wgs84-guide' },
	{ slug: 'data-sources', name: 'Open Data Sources',   url: '/docs/data-sources' },
	{ slug: 'geojson-guide',name: 'GeoJSON Developer',   url: '/docs/geojson-guide'},
];

const currentIndex = pages.findIndex(p => p.slug === activeSlug);
const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null;
---

<BaseLayout title={title} description={description} keywords={keywords} noindex={noindex}>
	<Navbar />

	<!-- Outer wrapper: border under navbar -->
	<div class="border-t border-mapa-contour">
		<!-- Mobile Docs Navigation Bar (Visible < lg) -->
		<div class="lg:hidden bg-mapa-canvas-dark border-b border-mapa-contour px-4 sm:px-6 py-3">
			<details class="group">
				<summary class="flex items-center justify-between cursor-pointer list-none font-sans text-sm font-bold text-mapa-ink py-1">
					<span class="flex items-center gap-2">
						<svg class="w-4 h-4 text-mapa-green" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
						<span>Documentation Menu</span>
						<span class="text-xs font-normal text-mapa-muted">
							({pages.find(p => p.slug === activeSlug)?.name || 'Docs'})
						</span>
					</span>
					<svg class="w-4 h-4 text-mapa-muted transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</summary>

				<div class="pt-3 pb-2 mt-2 border-t border-mapa-contour/60 grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-sm">
					<div>
						<p class="text-[11px] font-bold uppercase tracking-wider text-mapa-green mb-1.5">Guides & References</p>
						<ul class="space-y-1">
							<li>
								<a href="/docs" class={`block py-1.5 px-2 rounded-md ${activeSlug === 'index' ? 'bg-mapa-green/15 text-mapa-green font-bold' : 'text-mapa-ink/80 hover:text-mapa-ink'}`}>
									Overview
								</a>
							</li>
							{tools.map(tool => (
								<li>
									<a href={tool.url} class={`block py-1.5 px-2 rounded-md ${activeSlug === tool.slug ? 'bg-mapa-green/15 text-mapa-green font-bold' : 'text-mapa-ink/80 hover:text-mapa-ink'}`}>
										{tool.name} Guide
									</a>
								</li>
							))}
							{references.map(ref => (
								<li>
									<a href={ref.url} class={`block py-1.5 px-2 rounded-md ${activeSlug === ref.slug ? 'bg-mapa-green/15 text-mapa-green font-bold' : 'text-mapa-ink/80 hover:text-mapa-ink'}`}>
										{ref.name}
									</a>
								</li>
							))}
						</ul>
					</div>
					<div>
						<p class="text-[11px] font-bold uppercase tracking-wider text-mapa-green mb-1.5">Interactive Tools</p>
						<ul class="space-y-1 text-xs">
							<li><a href="/tools/psgc-lookup" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">PSGC Lookup</a></li>
							<li><a href="/tools/coordinates" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Coordinate Converter</a></li>
							<li><a href="/tools/zip-codes" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">ZIP Code Lookup</a></li>
							<li><a href="/tools/fare-calculator" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Commute Fare Estimator</a></li>
							<li><a href="/tools/walkability" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Walkability Map</a></li>
							<li><a href="/tools/rail-transit" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Rail Transit Map</a></li>
							<li><a href="/tools/toll-calculator" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Expressway Tolls</a></li>
							<li><a href="/tools/edsa-carousel" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">EDSA Carousel Busway</a></li>
							<li><a href="/tools/kilometer-posts" class="block py-1.5 px-2 rounded-md text-mapa-ink/80 hover:text-mapa-green">Kilometer Posts & KM 0</a></li>
						</ul>
					</div>
				</div>
			</details>
		</div>

		<!-- Two-column layout on desktop -->
		<div class="flex min-h-[calc(100vh-4rem)] max-w-7xl mx-auto">

			<!-- ====== LEFT SIDEBAR (Desktop lg+) ====== -->
			<aside class="hidden lg:block w-60 shrink-0" aria-label="Documentation Sidebar">
				<div class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto border-r border-mapa-contour py-8 px-6 custom-scrollbar">

					<!-- SECTION: NAVIGATE -->
					<p class="font-sans text-[11px] font-bold uppercase tracking-wider text-mapa-green mb-2">
						Navigate
					</p>
					<a
						href="/docs"
						aria-current={activeSlug === 'index' ? 'page' : undefined}
						class={`font-sans text-sm py-1.5 flex items-center gap-2 transition-colors ${activeSlug === 'index' ? 'text-mapa-green font-bold' : 'text-mapa-muted hover:text-mapa-ink'}`}
					>
						<span class={`w-1.5 h-1.5 rounded-full shrink-0 ${activeSlug === 'index' ? 'bg-mapa-green' : 'bg-transparent'}`}></span>
						Overview
					</a>

					<!-- SECTION: APPLICATIONS -->
					<p class="font-sans text-[11px] font-bold uppercase tracking-wider text-mapa-green mt-7 mb-2">
						Applications
					</p>
					<nav class="flex flex-col space-y-0.5">
						{tools.map(tool => {
							const isActive = activeSlug === tool.slug;
							return (
								<a
									href={tool.url}
									aria-current={isActive ? 'page' : undefined}
									class={`font-sans text-sm py-1.5 flex items-center justify-between transition-colors ${isActive ? 'text-mapa-green font-bold' : tool.active ? 'text-mapa-muted hover:text-mapa-ink' : 'text-mapa-muted/60 hover:text-mapa-ink'}`}
								>
									<span class="flex items-center gap-2">
										<span class={`w-1.5 h-1.5 rounded-full shrink-0 ${isActive ? 'bg-mapa-green' : 'bg-transparent'}`}></span>
										{tool.name}
									</span>
								</a>
							);
						})}
					</nav>

					<!-- SECTION: REFERENCES -->
					<p class="font-sans text-[11px] font-bold uppercase tracking-wider text-mapa-green mt-7 mb-2">
						References
					</p>
					<nav class="flex flex-col space-y-0.5">
						{references.map(ref => {
							const isActive = activeSlug === ref.slug;
							return (
								<a
									href={ref.url}
									aria-current={isActive ? 'page' : undefined}
									class={`font-sans text-sm py-1.5 flex items-center justify-between transition-colors ${isActive ? 'text-mapa-green font-bold' : 'text-mapa-muted hover:text-mapa-ink'}`}
								>
									<span class="flex items-center gap-2">
										<span class={`w-1.5 h-1.5 rounded-full shrink-0 ${isActive ? 'bg-mapa-green' : 'bg-transparent'}`}></span>
										{ref.name}
									</span>
								</a>
							);
						})}
					</nav>

					<!-- SECTION: BUILT-IN UTILITIES -->
					<p class="font-sans text-[11px] font-bold uppercase tracking-wider text-mapa-green mt-7 mb-2">
						Built-in Utilities
					</p>
					<nav class="flex flex-col space-y-0.5 text-sm">
						<a href="/tools/psgc-lookup" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>PSGC Lookup</span>
						</a>
						<a href="/tools/coordinates" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Coordinate Converter</span>
						</a>
						<a href="/tools/zip-codes" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>ZIP Code Lookup</span>
						</a>
						<a href="/tools/fare-calculator" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Commute Fare Estimator</span>
						</a>
						<a href="/tools/walkability" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Walkability Map</span>
						</a>
						<a href="/tools/rail-transit" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Rail Transit Map</span>
						</a>
						<a href="/tools/toll-calculator" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Expressway Tolls</span>
						</a>
						<a href="/tools/edsa-carousel" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>EDSA Carousel Busway</span>
						</a>
						<a href="/tools/kilometer-posts" class="font-sans text-mapa-muted hover:text-mapa-green py-1.5 flex items-center gap-2 transition-colors">
							<span class="w-1.5 h-1.5 shrink-0"></span>
							<span>Kilometer Posts & KM 0</span>
						</a>
					</nav>
				</div>
			</aside>

			<!-- ====== MAIN CONTENT ====== -->
			<main id="main-content" class="flex-1 min-w-0">
				<div class="max-w-3xl px-4 sm:px-8 lg:px-12 py-8 sm:py-10">
					<slot />
				</div>

				<!-- PREV / NEXT NAVIGATION -->
				<div class="max-w-3xl px-4 sm:px-8 lg:px-12 pb-16 mt-6">
					<div class="border-t border-mapa-contour pt-6 flex justify-between items-center gap-4">
						<!-- PREV -->
						{prevPage ? (
							<a href={prevPage.url} class="group font-sans text-mapa-muted hover:text-mapa-green flex flex-col gap-1 transition-colors">
								<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-muted/80">← Previous</span>
								<span class="font-sans font-bold text-sm text-mapa-ink group-hover:text-mapa-green">{prevPage.name}</span>
							</a>
						) : <span></span>}

						<!-- NEXT -->
						{nextPage ? (
							<a href={nextPage.url} class="group font-sans text-mapa-muted hover:text-mapa-green flex flex-col items-end gap-1 transition-colors">
								<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-muted/80">Next →</span>
								<span class="font-sans font-bold text-sm text-mapa-ink group-hover:text-mapa-green">{nextPage.name}</span>
							</a>
						) : <span></span>}
					</div>
				</div>
			</main>

		</div>
	</div>

	<Footer />
</BaseLayout>
