---
/**
 * @file contact.astro
 * @description Page detailing project contact info, linking to email and GitHub issue tracker.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
	title="Contact Us — Reach the mapaPH Team" 
	description="Get in touch with the mapaPH mapping collective to suggest new tools, report bugs, or collaborate on Philippine geographic datasets."
>
	<Navbar />

	<main class="max-w-3xl mx-auto px-6 py-16 font-serif leading-relaxed">
		<article class="prose prose-stone">
			<h1 class="text-4xl font-extrabold text-mapa-green tracking-tight sm:text-5xl">
				Contact Us
			</h1>
			
			<p class="mt-6 text-xl text-mapa-ink/80 font-medium">
				Have a suggestion, mapping request, or data contribution? We'd love to hear from you.
			</p>

			<div class="mt-10 border-t border-mapa-contour/40 pt-8 max-w-xl">
				<div class="p-8 rounded-xl bg-mapa-canvas-dark border border-mapa-contour/60">
					<h2 class="text-xl font-bold text-mapa-ink font-serif mb-2">Email Inquiries</h2>
					<p class="font-sans text-sm text-mapa-ink/80 leading-relaxed mb-6">
						For data corrections, mapping suggestions, API inquiries, or collaboration opportunities, contact the maintainers directly via email.
					</p>
					<a 
						href="mailto:vrsmagwili@gmail.com" 
						class="inline-flex items-center justify-center gap-2 w-full py-3 px-6 bg-mapa-green text-white font-sans text-center text-sm font-semibold rounded-lg hover:bg-mapa-green/90 transition-all shadow-sm"
					>
						<span>vrsmagwili@gmail.com</span>
					</a>
				</div>
			</div>
		</article>
	</main>

	<Footer />
</BaseLayout>
