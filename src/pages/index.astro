---
/**
 * @file index.astro
 * @description Landing page for the mapaPH hub. Composes navbar, hero, PSGC spotlight, about, tools directory, and footer.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import About from '../components/About.astro';
import ToolsSection from '../components/ToolsSection.astro';
import LatestUpdates from "../components/LatestUpdates.astro";
import FAQSection from "../components/FAQSection.astro";
import Footer from '../components/Footer.astro';
---

<BaseLayout 
	title="mapaPH — Open-Source Tools Based on the Philippine Map" 
	description="mapaPH is an open-source hub of civic mapping tools, official Philippine Standard Geographic Code (PSGC) lookups, coordinate converters, and geographic datasets for the Philippines."
	keywords="Philippine map, Philippine geospatial tools, PSGC lookup, Philippine Standard Geographic Code, Philippine zip codes, postal code Philippines, Philippine toll calculator, NLEX toll fee, SLEX toll rates, Skyway toll fee, TPLEX toll, SCTEX rates, CALAX toll, CCLEX, Autosweep RFID, Easytrip RFID, EDSA Carousel fare calculator, EDSA busway stops, Monumento to PITX bus, Philippine kilometer post, KM 0 Luneta Manila, DPWH kilometer post finder, Bataan Death March km markers, Philippine distance calculator, Manila to Cebu distance, Manila to Davao flight time, nautical miles Philippines, Batangas Calapan ferry, Philippine bus fare calculator, jeepney fare calculator, LTFRB fare matrix, MRT 3 fare calculator, LRT 1 fare table, Metro Manila rail map, beep card fare, Philippine walkability map, 15 minute city Philippines, PRS92 converter, WGS84 GPS, Philippine GIS data, 82 provinces, 149 cities, Philippine boundaries GeoJSON, open source mapping Philippines"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "mapaPH Tools Directory",
			"description": "Suite of mapping, routing, and directory applications for the Philippines.",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"item": {
						"@type": "WebApplication",
						"name": "Lens",
						"url": "https://lens.mapaph.com",
						"description": "An interactive visualizer that overlays civic data on Philippine regional maps using color-coded choropleth maps, enabling detailed demographic and socioeconomic analysis."
					}
				},
				{
					"@type": "ListItem",
					"position": 2,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine PSGC Lookup & Code Decoder",
						"url": "https://mapaph.com/tools/psgc-lookup",
						"description": "Interactive search and code decoder for official Philippine Standard Geographic Codes (PSGC), 2024 census demographics, and administrative boundaries."
					}
				},
				{
					"@type": "ListItem",
					"position": 3,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine Coordinate Converter",
						"url": "https://mapaph.com/tools/coordinates",
						"description": "Bi-directional coordinate converter between GPS latitude/longitude (WGS84) and Philippine Reference System 1992 (PRS92 / UTM Zone 51N)."
					}
				},
				{
					"@type": "ListItem",
					"position": 4,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine ZIP Code Directory",
						"url": "https://mapaph.com/tools/zip-codes",
						"description": "Instant search and 1-click copy directory for official 4-digit Philippine postal codes across Metro Manila and all 82 provinces."
					}
				},
				{
					"@type": "ListItem",
					"position": 5,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine Commute Fare Estimator",
						"url": "https://mapaph.com/tools/fare-calculator",
						"description": "Official LTFRB distance-based public transit fare calculator for Aircon Buses, Ordinary Buses, Modern Jeepneys, Traditional Jeepneys, and MRT/LRT."
					}
				},
				{
					"@type": "ListItem",
					"position": 6,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine Walkability & 15-Minute Pedestrian Radius Map",
						"url": "https://mapaph.com/tools/walkability",
						"description": "Interactive pedestrian catchment calculator for 5, 10, and 15-minute walking radii across Philippine cities with step metrics and sidewalk standards."
					}
				},
				{
					"@type": "ListItem",
					"position": 7,
					"item": {
						"@type": "WebApplication",
						"name": "Metro Manila Rail Transit Map & Fare Guide",
						"url": "https://mapaph.com/tools/rail-transit",
						"description": "Interactive station-to-station fare calculator, travel times, and transfer guide for LRT-1, LRT-2, and MRT-3 lines in Metro Manila."
					}
				},
				{
					"@type": "ListItem",
					"position": 8,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine Expressway Toll Calculator & Schematic Map",
						"url": "https://mapaph.com/tools/toll-calculator",
						"description": "Official Toll Regulatory Board (TRB) toll fee calculator for NLEX, SLEX, Skyway, SCTEX, TPLEX, CALAX, and CCLEX with schematic route strips and RFID guides."
					}
				},
				{
					"@type": "ListItem",
					"position": 9,
					"item": {
						"@type": "WebApplication",
						"name": "EDSA Carousel Busway Stop-by-Stop Fare & Route Map",
						"url": "https://mapaph.com/tools/edsa-carousel",
						"description": "Official LTFRB fare calculator, schematic transit strip, and geographic route map for the 24/7 EDSA Carousel busway connecting Monumento to PITX."
					}
				},
				{
					"@type": "ListItem",
					"position": 10,
					"item": {
						"@type": "WebApplication",
						"name": "Philippine Highway Kilometer Post & KM 0 Marker Locator",
						"url": "https://mapaph.com/tools/kilometer-posts",
						"description": "Search and inspect DPWH concrete milestone markers across MacArthur, Maharlika, Aguinaldo, Kennon highways, and the Bataan Death March."
					}
				}
			]
		}
	</script>

	<Navbar />

	<main id="main-content">
		<HeroSection />

		<About />

		<ToolsSection />

		<LatestUpdates />

		<FAQSection />
	</main>

	<Footer />
</BaseLayout>
