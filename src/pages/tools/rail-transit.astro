			// Official Fare Calculation Helpers
			function calcSingleLineFare(lineKey, distanceKm, stationCount) {
				let beepFare = 15;
				let sjtFare = 15;

				if (lineKey === 'mrt3') {
					// MRT-3 official tier matrix based on station count
					// 1-2 stations: 13; 3-5: 16; 6-8: 20; 9-11: 24; 12+: 28
					if (stationCount <= 2) {
						beepFare = 13;
					} else if (stationCount <= 5) {
						beepFare = 16;
					} else if (stationCount <= 8) {
						beepFare = 20;
					} else if (stationCount <= 11) {
						beepFare = 24;
					} else {
						beepFare = 28;
					}
					sjtFare = beepFare;
				} else if (lineKey === 'lrt1') {
					// LRT-1: 15 base + 1.21/km
					beepFare = 15 + (distanceKm * 1.21);
					// Cap between 15 and 45
					beepFare = Math.min(45, Math.max(15, Math.round(beepFare)));
					// SJT rounded to nearest 5
					sjtFare = Math.ceil(beepFare / 5) * 5;
				} else if (lineKey === 'lrt2') {
					// LRT-2: 14 base + 1.21/km
					beepFare = 14 + (distanceKm * 1.21);
					beepFare = Math.min(33, Math.max(14, Math.round(beepFare)));
					sjtFare = Math.ceil(beepFare / 5) * 5;
				}

				return { beepFare, sjtFare };
			}

			function getLineTravelTime(lineKey, stops) {
				// Commercial operational pace
				if (lineKey === 'mrt3') return stops * 2.5;
				if (lineKey === 'lrt1') return stops * 2.3;
				if (lineKey === 'lrt2') return stops * 2.8;
				return stops * 2.5;
			}

			// Main Routing Algorithm
			function calculateRoute() {
				const originId = originSelect.value;
				const destId = destSelect.value;

				if (!originId || !destId) return;

				const origin = getStationById(originId);
				const dest = getStationById(destId);

				if (!origin || !dest) return;

				const hasDiscount = discountToggle.checked;

				// Clear previous highlighted path
				if (activeRoutePolyline) {
					map.removeLayer(activeRoutePolyline);
					activeRoutePolyline = null;
				}

				// Reset marker styles
				ALL_STATIONS.forEach(s => {
					const m = stationMarkers[s.id];
					if (m) {
						m.setStyle({
							radius: s.isTransfer ? 7 : 5,
							fillColor: s.isTransfer ? '#F59E0B' : '#FFFFFF',
							weight: s.isTransfer ? 3 : 2
						});
					}
				});

				// Highlight origin and destination pins
				stationMarkers[origin.id]?.setStyle({ radius: 9, fillColor: '#10B981', weight: 4 });
				stationMarkers[dest.id]?.setStyle({ radius: 9, fillColor: '#EF4444', weight: 4 });

				if (origin.id === dest.id) {
					fareBeepEl.textContent = '₱0.00';
					fareSjtEl.textContent = '₱0.00';
					metricTimeEl.textContent = '0 min';
					metricStopsEl.textContent = '0 stops';
					metricDistEl.textContent = '0 km';
					transferCalloutEl.classList.add('hidden');
					routeStepsListEl.innerHTML = '<div class="text-mapa-clay italic p-2">Origin and destination are the same station.</div>';
					return;
				}

				// CASE 1: Same rail line
				if (origin.lineKey === dest.lineKey) {
					const lineKey = origin.lineKey;
					const stations = STATIONS_DATA[lineKey];
					const idxA = origin.indexInLine;
					const idxB = dest.indexInLine;
					const minIdx = Math.min(idxA, idxB);
					const maxIdx = Math.max(idxA, idxB);

					const segment = stations.slice(minIdx, maxIdx + 1);
					const stopsCount = maxIdx - minIdx;
					const distanceKm = Math.abs(dest.km - origin.km);

					const { beepFare, sjtFare } = calcSingleLineFare(lineKey, distanceKm, stopsCount);
					const finalBeep = hasDiscount ? (beepFare * 0.8) : beepFare;
					const finalSjt = hasDiscount ? (sjtFare * 0.8) : sjtFare;
					const travelTime = Math.round(getLineTravelTime(lineKey, stopsCount));

					fareBeepEl.textContent = `₱${finalBeep.toFixed(2)}`;
					fareSjtEl.textContent = `₱${finalSjt.toFixed(2)}`;
					metricTimeEl.textContent = `~${travelTime} mins`;
					metricStopsEl.textContent = `${stopsCount} ${stopsCount === 1 ? 'stop' : 'stops'}`;
					metricDistEl.textContent = `${distanceKm.toFixed(1)} km`;

					transferCalloutEl.classList.add('hidden');

					// Render steps
					routeStepsListEl.innerHTML = `
						<div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
							<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[lineKey]}"></span>
							<div class="space-y-1">
								<div class="font-bold text-mapa-ink">Board ${lineKey.toUpperCase()}: ${origin.name}</div>
								<div class="text-mapa-clay text-[11px]">Ride ${stopsCount} stations towards ${dest.name} (${distanceKm.toFixed(1)} km)</div>
							</div>
						</div>
						<div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
							<span class="w-3 h-3 rounded-full bg-emerald-600 mt-0.5 shrink-0"></span>
							<div class="space-y-1">
								<div class="font-bold text-mapa-ink">Alight at ${dest.name}</div>
								<div class="text-mapa-clay text-[11px]">Tap out at turnstile. Total journey time approx. ${travelTime} minutes.</div>
							</div>
						</div>
					`;

					// Highlight polyline segment
					const pathCoords = (idxA < idxB ? segment : segment.reverse()).map(s => [s.lat, s.lon]);
					activeRoutePolyline = L.polyline(pathCoords, {
						color: '#F59E0B',
						weight: 6,
						dashArray: '8, 8',
						opacity: 0.95
					}).addTo(map);

					map.fitBounds(activeRoutePolyline.getBounds(), { padding: [40, 40] });
					return;
				}

				// CASE 2: Cross-line transfer
				// Determine optimal interchange station
				let transferA = null;
				let transferB = null;
				let transferName = '';
				let transferWalkTime = 5;

				const pairKey = [origin.lineKey, dest.lineKey].sort().join('_');

				if (pairKey === 'lrt1_mrt3') {
					// Transfer at EDSA (LRT-1) <-> Taft (MRT-3)
					transferA = getStationById(origin.lineKey === 'lrt1' ? 'lrt1_edsa' : 'mrt3_taft');
					transferB = getStationById(dest.lineKey === 'lrt1' ? 'lrt1_edsa' : 'mrt3_taft');
					transferName = 'EDSA-Taft Footbridge';
					transferWalkTime = 4;
				} else if (pairKey === 'lrt1_lrt2') {
					// Transfer at Doroteo Jose (LRT-1) <-> Recto (LRT-2)
					transferA = getStationById(origin.lineKey === 'lrt1' ? 'lrt1_doroteo_jose' : 'lrt2_recto');
					transferB = getStationById(dest.lineKey === 'lrt1' ? 'lrt1_doroteo_jose' : 'lrt2_recto');
					transferName = 'Doroteo Jose - Recto Elevated Walkway';
					transferWalkTime = 5;
				} else if (pairKey === 'lrt2_mrt3') {
					// Transfer at Cubao (LRT-2) <-> Cubao (MRT-3)
					transferA = getStationById(origin.lineKey === 'lrt2' ? 'lrt2_cubao' : 'mrt3_cubao');
					transferB = getStationById(dest.lineKey === 'lrt2' ? 'lrt2_cubao' : 'mrt3_cubao');
					transferName = 'Araneta Center-Cubao (Farmers/Gateway Walkway)';
					transferWalkTime = 6;
				}

				if (!transferA || !transferB) return;

				// Leg 1: Origin -> TransferA
				const leg1Stops = Math.abs(origin.indexInLine - transferA.indexInLine);
				const leg1Dist = Math.abs(origin.km - transferA.km);
				const leg1Fare = calcSingleLineFare(origin.lineKey, leg1Dist, leg1Stops);
				const leg1Time = getLineTravelTime(origin.lineKey, leg1Stops);

				// Leg 2: TransferB -> Destination
				const leg2Stops = Math.abs(transferB.indexInLine - dest.indexInLine);
				const leg2Dist = Math.abs(transferB.km - dest.km);
				const leg2Fare = calcSingleLineFare(dest.lineKey, leg2Dist, leg2Stops);
				const leg2Time = getLineTravelTime(dest.lineKey, leg2Stops);

				const totalBeep = leg1Fare.beepFare + leg2Fare.beepFare;
				const totalSjt = leg1Fare.sjtFare + leg2Fare.sjtFare;
				const finalBeep = hasDiscount ? (totalBeep * 0.8) : totalBeep;
				const finalSjt = hasDiscount ? (totalSjt * 0.8) : totalSjt;

				const totalStops = leg1Stops + leg2Stops;
				const totalDist = leg1Dist + leg2Dist;
				const totalTime = Math.round(leg1Time + transferWalkTime + leg2Time);

				fareBeepEl.textContent = `₱${finalBeep.toFixed(2)}`;
				fareSjtEl.textContent = `₱${finalSjt.toFixed(2)}`;
				metricTimeEl.textContent = `~${totalTime} mins`;
				metricStopsEl.textContent = `${totalStops} stops (1 transfer)`;
				metricDistEl.textContent = `${totalDist.toFixed(1)} km`;

				// Show transfer alert
				transferCalloutEl.classList.remove('hidden');
				transferCalloutEl.innerHTML = `
					<div class="font-bold flex items-center gap-1.5 mb-1">
						<span>🔄 Transfer Required:</span>
						<span>${transferName}</span>
					</div>
					<div>Exit ${origin.lineKey.toUpperCase()} at <strong>${transferA.name}</strong>, walk ~${transferWalkTime} mins across the connecting walkway, and tap into ${dest.lineKey.toUpperCase()} at <strong>${transferB.name}</strong>.</div>
				`;

				// Render 4-step itinerary
				routeStepsListEl.innerHTML = `
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[origin.lineKey]}"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">1. Board ${origin.lineKey.toUpperCase()}: ${origin.name}</div>
							<div class="text-mapa-clay text-[11px]">Ride ${leg1Stops} stops (${leg1Dist.toFixed(1)} km) &bull; Fare: ₱${(hasDiscount ? leg1Fare.beepFare * 0.8 : leg1Fare.beepFare).toFixed(2)}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-amber-500/10 border border-amber-500/30">
						<span class="w-3 h-3 rounded-full bg-amber-500 mt-0.5 shrink-0"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-amber-900">2. Transfer at ${transferA.name}</div>
							<div class="text-amber-800 text-[11px]">Walk ~${transferWalkTime} mins via ${transferName} into ${transferB.name}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[dest.lineKey]}"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">3. Board ${dest.lineKey.toUpperCase()}: ${transferB.name}</div>
							<div class="text-mapa-clay text-[11px]">Ride ${leg2Stops} stops (${leg2Dist.toFixed(1)} km) &bull; Fare: ₱${(hasDiscount ? leg2Fare.beepFare * 0.8 : leg2Fare.beepFare).toFixed(2)}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full bg-emerald-600 mt-0.5 shrink-0"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">4. Arrive at ${dest.name}</div>
							<div class="text-mapa-clay text-[11px]">Total combined time approx. ${totalTime} minutes.</div>
						</div>
					</div>
				`;

				// Draw multi-leg highlighted path
				const stListA = STATIONS_DATA[origin.lineKey];
				const minA = Math.min(origin.indexInLine, transferA.indexInLine);
				const maxA = Math.max(origin.indexInLine, transferA.indexInLine);
				const leg1Coords = stListA.slice(minA, maxA + 1).map(s => [s.lat, s.lon]);

				const stListB = STATIONS_DATA[dest.lineKey];
				const minB = Math.min(dest.indexInLine, transferB.indexInLine);
				const maxB = Math.max(dest.indexInLine, transferB.indexInLine);
				const leg2Coords = stListB.slice(minB, maxB + 1).map(s => [s.lat, s.lon]);

				const combinedCoords = [...leg1Coords, ...leg2Coords];
				activeRoutePolyline = L.polyline(combinedCoords, {
					color: '#F59E0B',
					weight: 6,
					dashArray: '8, 8',
					opacity: 0.95
				}).addTo(map);

				map.fitBounds(activeRoutePolyline.getBounds(), { padding: [40, 40] });
			}

			// Event Listeners
			originSelect.addEventListener('change', calculateRoute);
			destSelect.addEventListener('change', calculateRoute);
			discountToggle.addEventListener('change', calculateRoute);

			swapBtn.addEventListener('click', () => {
				const temp = originSelect.value;
				originSelect.value = destSelect.value;
				destSelect.value = temp;
				calculateRoute();
			});

			// Presets
			document.querySelectorAll('.preset-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const orig = btn.getAttribute('data-origin');
					const dst = btn.getAttribute('data-dest');
					if (orig && dst) {
						originSelect.value = orig;
						destSelect.value = dst;
						calculateRoute();
					}
				});
			});

			// Initial Calculation
			calculateRoute();
		})();
	</script>
</BaseLayout>
