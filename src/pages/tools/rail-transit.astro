---
/**
 * @file rail-transit.astro
 * @description Interactive Metro Manila Rail Transit Map, Station-to-Station Fare Calculator, and Transfer Guide.
 * Covers LRT-1 (Green), LRT-2 (Purple), and MRT-3 (Blue) with official DOTr/LRTA fare tables, travel times, and transfer paths.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Structured line data
const RAIL_LINES = [
	{
		id: 'lrt1',
		name: 'LRT Line 1',
		operator: 'LRTC / Light Rail Manila Corporation (LRMC)',
		color: '#00843D',
		bgLight: 'bg-emerald-500/10 text-emerald-800 border-emerald-500/30',
		terminals: 'Fernando Poe Jr. (North) ↔ Dr. Santos / Baclaran (South)',
		trains: 'Light Rail Vehicles (1G, 2G, 3G, 4G CAF)',
		stationsCount: 25,
		operatingHours: '4:30 AM – 10:15 PM'
	},
	{
		id: 'mrt3',
		name: 'MRT Line 3',
		operator: 'Department of Transportation (DOTr MRT-3)',
		color: '#0055A5',
		bgLight: 'bg-blue-500/10 text-blue-800 border-blue-500/30',
		terminals: 'North Avenue ↔ Taft Avenue',
		trains: 'ČKD Tatra RT8D5M / Dalian 8MLB',
		stationsCount: 13,
		operatingHours: '4:36 AM – 10:11 PM'
	},
	{
		id: 'lrt2',
		name: 'LRT Line 2',
		operator: 'Light Rail Transit Authority (LRTA)',
		color: '#6F2C91',
		bgLight: 'bg-purple-500/10 text-purple-800 border-purple-500/30',
		terminals: 'Recto (Manila) ↔ Antipolo (Rizal)',
		trains: 'Rotem Heavy Rail EMUs',
		stationsCount: 13,
		operatingHours: '5:00 AM – 9:30 PM'
	}
];

// Major Transfer Hubs
const TRANSFER_HUBS = [
	{
		name: 'EDSA – Taft Interchange',
		lines: ['LRT-1', 'MRT-3', 'EDSA Busway'],
		walkTime: '3–5 mins',
		walkDistance: '200 meters',
		description: 'Connected via covered elevated pedestrian bridge between LRT-1 EDSA station and MRT-3 Taft Avenue mezzanine level.'
	},
	{
		name: 'Doroteo Jose – Recto Walkway',
		lines: ['LRT-1', 'LRT-2'],
		walkTime: '4–6 mins',
		walkDistance: '240 meters',
		description: 'Direct elevated, weather-proof footbridge spanning Rizal Avenue and Recto Avenue connecting LRT-1 Doroteo Jose and LRT-2 Recto station concourse.'
	},
	{
		name: 'Araneta Center-Cubao Hub',
		lines: ['MRT-3', 'LRT-2'],
		walkTime: '5–7 mins',
		walkDistance: '350 meters',
		description: 'Connected through Farmers Plaza and Gateway Mall indoor air-conditioned walkways between MRT-3 Cubao and LRT-2 Cubao station.'
	},
	{
		name: 'North Avenue Grand Central Area',
		lines: ['MRT-3', 'LRT-1 (Planned Unified)', 'EDSA Busway'],
		walkTime: '3–6 mins',
		walkDistance: '250 meters',
		description: 'North terminal hub connecting MRT-3 North Avenue concourse to TriNoma, SM North EDSA, and the EDSA Carousel Busway terminal.'
	}
];
---

<BaseLayout
	title="Metro Manila Rail Transit Map & Station Fare Guide (LRT-1, LRT-2, MRT-3) — mapaPH Tools"
	description="Interactive Metro Manila train map and station-to-station fare calculator for LRT-1, LRT-2, and MRT-3. Calculate single journey and beep card fares, travel times, transfer points, and operating hours."
	keywords="MRT 3 fare calculator, LRT 1 fare matrix, LRT 2 fare table, Metro Manila train map, MRT station list, LRT transfer stations, beep card fares, Doroteo Jose Recto transfer, EDSA Taft transfer, Cubao MRT LRT walkway, train operating hours Manila"
>
	<!-- Leaflet Stylesheet -->
	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
		slot="schema"
	/>

	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Metro Manila Rail Transit Map & Station Fare Calculator",
					"url": "https://mapaph.com/tools/rail-transit",
					"applicationCategory": "Public Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Interactive transit routing and fare estimation utility for Metro Manila rail lines (LRT-1, LRT-2, MRT-3) with official DOTr/LRTA fare schedules.",
					"provider": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://mapaph.com"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "How much does it cost to ride MRT-3 and LRT in Metro Manila?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "For MRT-3, fares range from ₱13 (1 to 2 stations) to ₱28 (end-to-end North Ave to Taft Ave). For LRT-1, stored value (beep) fares start at ₱15 base boarding fare plus ₱1.21/km (up to ₱35 to Baclaran and ₱45 to Dr. Santos). For LRT-2, fares range from ₱14 to ₱33. Single Journey Tickets (SJT) are rounded to the nearest ₱5."
							}
						},
						{
							"@type": "Question",
							"name": "How do I transfer between MRT-3 and LRT-1?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "The primary transfer point is at Taft Avenue / EDSA. Commuters exit MRT-3 Taft Avenue station and walk approximately 200 meters across the covered elevated footbridge directly into LRT-1 EDSA station. You will need to tap out of MRT-3 and tap into LRT-1."
							}
						},
						{
							"@type": "Question",
							"name": "How do I transfer between LRT-1 and LRT-2?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Commuters transfer between LRT-1 Doroteo Jose station and LRT-2 Recto station using the dedicated 240-meter elevated pedestrian walkway. The walkway is fully covered and takes about 4 minutes to walk."
							}
						},
						{
							"@type": "Question",
							"name": "Are students, seniors, and PWDs entitled to discounts on LRT and MRT?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Yes. Under RA 11314 (Student Fare Discount Act), RA 9994 (Expanded Senior Citizens Act), and RA 10754 (Persons with Disability Act), eligible passengers receive a mandatory 20% discount on all lines using special concessionary beep cards or upon presenting a valid ID at ticket booths."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main class="max-w-7xl mx-auto px-6 lg:px-8 py-12 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-3xl mb-8">
			<div class="flex items-center gap-2 mb-2">
				<span class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Transit & Mobility Utility
				</span>
				<span class="font-sans text-xs text-mapa-clay">
					Official DOTr & LRTA Matrices
				</span>
			</div>
			<h1 class="text-3xl sm:text-4xl font-extrabold text-mapa-green font-serif tracking-tight">
				Metro Manila Rail Transit Map & Fare Guide
			</h1>
			<p class="font-sans text-sm sm:text-base text-mapa-ink/80 mt-2 leading-relaxed">
				Interactive station-to-station fare calculator, line transfer guide, and system map for LRT Line 1, LRT Line 2, and MRT Line 3. Computes regular cash fares, stored value beep™ card savings, 20% statutory discounts, and real travel times.
			</p>
		</div>

		<!-- Main 2-Column App Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			
			<!-- Left Column: Interactive Map & Station Explorer (7 cols) -->
			<div class="lg:col-span-7 flex flex-col gap-6 font-sans">
				<!-- Map Container Card -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl overflow-hidden shadow-xs flex flex-col">
					<!-- Map Header Bar -->
					<div class="p-4 border-b border-mapa-contour/50 flex flex-wrap items-center justify-between gap-3 bg-mapa-canvas">
						<div class="flex items-center gap-2">
							<span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
							<span class="text-xs font-bold uppercase tracking-wider text-mapa-ink">
								System Network Visualizer
							</span>
						</div>
						<!-- Line Filter Toggles -->
						<div class="flex items-center gap-1.5 text-xs">
							<button
								id="toggle-lrt1"
								class="px-2.5 py-1 rounded-md text-[11px] font-bold border transition-all bg-emerald-600 text-white border-emerald-700 shadow-xs"
								data-line="lrt1"
							>
								LRT-1
							</button>
							<button
								id="toggle-mrt3"
								class="px-2.5 py-1 rounded-md text-[11px] font-bold border transition-all bg-blue-600 text-white border-blue-700 shadow-xs"
								data-line="mrt3"
							>
								MRT-3
							</button>
							<button
								id="toggle-lrt2"
								class="px-2.5 py-1 rounded-md text-[11px] font-bold border transition-all bg-purple-700 text-white border-purple-800 shadow-xs"
								data-line="lrt2"
							>
								LRT-2
							</button>
						</div>
					</div>

					<!-- Leaflet Map Canvas -->
					<div
						id="rail-map"
						class="w-full h-[460px] sm:h-[520px] bg-stone-100 z-0 relative"
						aria-label="Interactive Metro Manila rail transit map"
					></div>

					<!-- Map Legend & Helper -->
					<div class="p-3.5 bg-mapa-canvas border-t border-mapa-contour/50 flex flex-wrap items-center justify-between text-xs text-mapa-ink/70 gap-2">
						<div class="flex items-center gap-3">
							<span class="inline-flex items-center gap-1">
								<span class="w-3 h-1 rounded-full bg-[#00843D]"></span>
								<span>LRT-1</span>
							</span>
							<span class="inline-flex items-center gap-1">
								<span class="w-3 h-1 rounded-full bg-[#0055A5]"></span>
								<span>MRT-3</span>
							</span>
							<span class="inline-flex items-center gap-1">
								<span class="w-3 h-1 rounded-full bg-[#6F2C91]"></span>
								<span>LRT-2</span>
							</span>
							<span class="inline-flex items-center gap-1">
								<span class="w-2.5 h-2.5 rounded-full border-2 border-amber-500 bg-white"></span>
								<span>Transfer Hub</span>
							</span>
						</div>
						<span class="text-[11px] text-mapa-clay italic">
							Click any station pin to set origin/destination
						</span>
					</div>
				</div>

				<!-- Major Transfer Hubs Cards -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-5 shadow-xs">
					<h3 class="font-serif text-lg font-bold text-mapa-ink mb-3">
						Key Metro Manila Rail Interchange Points
					</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
						{TRANSFER_HUBS.map(hub => (
							<div class="bg-mapa-canvas border border-mapa-contour/70 rounded-xl p-3 flex flex-col justify-between">
								<div>
									<div class="flex items-center justify-between gap-2 mb-1.5">
										<h4 class="font-bold text-mapa-ink">{hub.name}</h4>
										<span class="px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-800 text-[10px] font-semibold">
											{hub.walkTime}
										</span>
									</div>
									<div class="flex items-center gap-1.5 mb-2">
										{hub.lines.map(line => (
											<span class="px-1.5 py-0.5 rounded bg-mapa-canvas-dark border border-mapa-contour/60 text-[10px] text-mapa-ink/80">
												{line}
											</span>
										))}
									</div>
									<p class="text-mapa-ink/75 leading-relaxed text-[11px]">
										{hub.description}
									</p>
								</div>
								<div class="mt-2.5 pt-2 border-t border-mapa-contour/40 text-[10px] text-mapa-clay">
									Approx. walking span: {hub.walkDistance}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Right Column: Fare Calculator & Itinerary (5 cols) -->
			<div class="lg:col-span-5 flex flex-col gap-6 font-sans">
				
				<!-- Calculator Input Card -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-6 shadow-xs">
					<h2 class="font-serif text-xl font-bold text-mapa-ink mb-4 pb-2 border-b border-mapa-contour/50">
						Station-to-Station Route Planner
					</h2>

					<!-- Origin Selection -->
					<div class="mb-4">
						<label for="origin-select" class="block text-xs font-bold uppercase tracking-wider text-mapa-clay mb-1.5">
							Origin Station (Where are you boarding?)
						</label>
						<select
							id="origin-select"
							class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green"
						>
							<optgroup label="LRT Line 1 (Green)">
								<!-- Populated dynamically via JS -->
							</optgroup>
						</select>
					</div>

					<!-- Swap Button -->
					<div class="flex justify-center -my-1 relative z-10">
						<button
							id="swap-stations-btn"
							type="button"
							class="bg-mapa-canvas hover:bg-mapa-canvas-dark border border-mapa-contour rounded-full p-2 text-mapa-ink/70 hover:text-mapa-green transition-all shadow-xs"
							aria-label="Swap origin and destination stations"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
							</svg>
						</button>
					</div>

					<!-- Destination Selection -->
					<div class="mb-5">
						<label for="destination-select" class="block text-xs font-bold uppercase tracking-wider text-mapa-clay mb-1.5">
							Destination Station (Where are you getting off?)
						</label>
						<select
							id="destination-select"
							class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green"
						>
							<!-- Populated dynamically via JS -->
						</select>
					</div>

					<!-- Discount Switch -->
					<div class="bg-mapa-canvas border border-mapa-contour/70 rounded-xl p-3.5 mb-5 flex items-center justify-between gap-3">
						<div>
							<div class="text-xs font-bold text-mapa-ink">
								20% Statutory Discount
							</div>
							<div class="text-[11px] text-mapa-clay">
								Students (RA 11314), Seniors (RA 9994), PWDs (RA 10754)
							</div>
						</div>
						<label class="relative inline-flex items-center cursor-pointer shrink-0">
							<input type="checkbox" id="discount-toggle" class="sr-only peer" />
							<div class="w-11 h-6 bg-stone-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-stone-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-mapa-green"></div>
						</label>
					</div>

					<!-- Results Panel -->
					<div id="results-card" class="bg-mapa-canvas border border-mapa-contour rounded-xl p-4 flex flex-col gap-4">
						
						<!-- Fare Summary Header -->
						<div class="flex items-center justify-between pb-3 border-b border-mapa-contour/40">
							<div>
								<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay">
									Estimated Fare
								</span>
								<div class="flex items-baseline gap-2 mt-0.5">
									<span id="fare-beep" class="text-3xl font-extrabold text-mapa-green font-serif">
										₱28.00
									</span>
									<span id="fare-type-label" class="text-xs font-medium text-mapa-ink/70">
										beep™ card
									</span>
								</div>
							</div>
							<div class="text-right">
								<span class="text-[11px] text-mapa-clay block">Single Ticket (Cash)</span>
								<span id="fare-sjt" class="text-lg font-bold text-mapa-ink font-serif">
									₱30.00
								</span>
							</div>
						</div>

						<!-- Metric Badges: Time, Stations, Distance -->
						<div class="grid grid-cols-3 gap-2 text-center">
							<div class="bg-mapa-canvas-dark border border-mapa-contour/50 rounded-lg p-2">
								<span class="block text-[10px] uppercase font-bold text-mapa-clay">Travel Time</span>
								<span id="metric-time" class="text-sm font-extrabold text-mapa-ink">~32 mins</span>
							</div>
							<div class="bg-mapa-canvas-dark border border-mapa-contour/50 rounded-lg p-2">
								<span class="block text-[10px] uppercase font-bold text-mapa-clay">Stations</span>
								<span id="metric-stops" class="text-sm font-extrabold text-mapa-ink">13 stops</span>
							</div>
							<div class="bg-mapa-canvas-dark border border-mapa-contour/50 rounded-lg p-2">
								<span class="block text-[10px] uppercase font-bold text-mapa-clay">Distance</span>
								<span id="metric-distance" class="text-sm font-extrabold text-mapa-ink">16.9 km</span>
							</div>
						</div>

						<!-- Transfer Alert (hidden when same line) -->
						<div id="transfer-callout" class="hidden p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 text-xs text-amber-900 leading-relaxed">
							<!-- Populated via JS -->
						</div>

						<!-- Step-by-Step Route Legs -->
						<div class="pt-2">
							<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay block mb-2">
								Journey Step-by-Step
							</span>
							<div id="route-steps-list" class="space-y-2 text-xs">
								<!-- Populated dynamically via JS -->
							</div>
						</div>
					</div>
				</div>

				<!-- Popular Commuter Routes Quick Selector -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-5 shadow-xs">
					<h3 class="text-xs font-bold uppercase tracking-wider text-mapa-clay mb-3">
						Popular Commuter Corridors
					</h3>
					<div class="flex flex-wrap gap-2 text-xs">
						<button
							class="preset-btn px-2.5 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green transition-all text-left"
							data-origin="mrt3_north"
							data-dest="mrt3_taft"
						>
							<span class="font-bold text-mapa-ink block">MRT-3 Full Line</span>
							<span class="text-[10px] text-mapa-clay">North Ave ↔ Taft Ave</span>
						</button>
						<button
							class="preset-btn px-2.5 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green transition-all text-left"
							data-origin="lrt1_roosevelt"
							data-dest="lrt1_baclaran"
						>
							<span class="font-bold text-mapa-ink block">LRT-1 Classic Trunk</span>
							<span class="text-[10px] text-mapa-clay">FPJ ↔ Baclaran</span>
						</button>
						<button
							class="preset-btn px-2.5 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green transition-all text-left"
							data-origin="lrt2_recto"
							data-dest="lrt2_antipolo"
						>
							<span class="font-bold text-mapa-ink block">LRT-2 East-West</span>
							<span class="text-[10px] text-mapa-clay">Recto ↔ Antipolo</span>
						</button>
						<button
							class="preset-btn px-2.5 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green transition-all text-left"
							data-origin="lrt1_central"
							data-dest="mrt3_ayala"
						>
							<span class="font-bold text-mapa-ink block">Manila to Makati CBD</span>
							<span class="text-[10px] text-mapa-clay">Central ↔ Ayala (Transfer)</span>
						</button>
						<button
							class="preset-btn px-2.5 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green transition-all text-left"
							data-origin="lrt2_katipunan"
							data-dest="mrt3_ortigas"
						>
							<span class="font-bold text-mapa-ink block">Katipunan to Ortigas</span>
							<span class="text-[10px] text-mapa-clay">Transfer at Cubao</span>
						</button>
					</div>
				</div>

				<!-- Lines Overview Badge Grid -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-5 shadow-xs">
					<h3 class="text-xs font-bold uppercase tracking-wider text-mapa-clay mb-3">
						Lines At A Glance
					</h3>
					<div class="space-y-2.5 text-xs">
						{RAIL_LINES.map(line => (
							<div class="bg-mapa-canvas border border-mapa-contour/60 rounded-xl p-3 flex items-center justify-between">
								<div class="flex items-center gap-2.5">
									<span class="w-3.5 h-3.5 rounded-full shrink-0" style={`background-color: ${line.color};`}></span>
									<div>
										<h4 class="font-bold text-mapa-ink">{line.name}</h4>
										<p class="text-[11px] text-mapa-clay">{line.terminals}</p>
									</div>
								</div>
								<div class="text-right shrink-0">
									<span class="text-[10px] text-mapa-clay block">Hours</span>
									<span class="font-semibold text-mapa-ink text-[11px]">{line.operatingHours}</span>
								</div>
							</div>
						))}
					</div>
				</div>

			</div>
		</div>

		<!-- Comprehensive Editorial & Regulatory Reference Section -->
		<article class="mt-16 max-w-4xl mx-auto font-sans border-t border-mapa-contour/60 pt-12 space-y-10">
			
			<!-- Section 1: Official Fare Formulas -->
			<section>
				<h2 class="font-serif text-2xl font-bold text-mapa-ink tracking-tight mb-4">
					1. Official DOTr & LRTA Fare Determination Matrices
				</h2>
				<p class="text-sm text-mapa-ink/80 leading-relaxed mb-4">
