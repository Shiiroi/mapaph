type LineKey = 'lrt1' | 'mrt3' | 'lrt2';

interface StationItem {
	id: string;
	name: string;
	city: string;
	lat: number;
	lon: number;
	km: number;
	isTransfer: boolean;
	lineName: string;
	transferLabel?: string;
	transferTo?: string;
	lineKey: LineKey;
	indexInLine: number;
}

const LINE_COLORS: Record<LineKey, string> = {
	lrt1: '#00843D',
	mrt3: '#0055A5',
	lrt2: '#6F2C91'
};

// Flattened list with indices for sequence rendering
const ALL_STATIONS: StationItem[] = [];
(Object.keys(STATIONS_DATA) as LineKey[]).forEach(lineKey => {
	STATIONS_DATA[lineKey].forEach((st, idx) => {
		ALL_STATIONS.push({
			...st,
			lineKey,
			indexInLine: idx
		});
	});
});

// Major Transfer Hubs
