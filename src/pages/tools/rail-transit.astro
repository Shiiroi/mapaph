			const LINE_COLORS = {
				lrt1: '#00843D',
				mrt3: '#0055A5',
				lrt2: '#6F2C91'
			};

			const ALL_STATIONS = [];
			Object.keys(STATIONS_DATA).forEach(lineKey => {
				STATIONS_DATA[lineKey].forEach((st, idx) => {
					ALL_STATIONS.push({
						...st,
						lineKey,
						indexInLine: idx
					});
				});
			});

			function getStationById(id) {
				return ALL_STATIONS.find(s => s.id === id);
			}

			// DOM Elements
			const originSelect = document.getElementById('origin-select');
			const destSelect = document.getElementById('destination-select');
			const discountToggle = document.getElementById('discount-toggle');
			const swapBtn = document.getElementById('swap-stations-btn');
			const quickSwapBtn = document.getElementById('rail-quick-swap-btn');

			const targetOriginBtn = document.getElementById('rail-target-origin');
			const targetDestBtn = document.getElementById('rail-target-dest');
			const clickHintEl = document.getElementById('rail-click-hint');

			const summaryOriginEl = document.getElementById('summary-origin-name');
			const summaryDestEl = document.getElementById('summary-dest-name');
			const summaryMetricEl = document.getElementById('summary-badge-metric');

			const fareBeepEl = document.getElementById('fare-beep');
			const fareSjtEl = document.getElementById('fare-sjt');
			const metricTimeEl = document.getElementById('metric-time');
			const metricStopsEl = document.getElementById('metric-stops');
			const metricDistEl = document.getElementById('metric-distance');
			const transferCalloutEl = document.getElementById('transfer-callout');
			const routeStepsListEl = document.getElementById('route-steps-list');

			const btnViewSchematic = document.getElementById('rail-view-schematic');
			const btnViewGeo = document.getElementById('rail-view-geo');
			const schematicContainer = document.getElementById('rail-schematic-container');
			const geoContainer = document.getElementById('rail-geo-container');

			// Current active click target mode: 'origin' or 'dest'
			let currentTargetMode = 'origin';

			function setTargetMode(mode) {
				currentTargetMode = mode;
				if (mode === 'origin') {
					targetOriginBtn.className = 'px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow-xs transition-all flex items-center gap-1.5 cursor-pointer ring-2 ring-emerald-500/50';
					targetDestBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer';
					clickHintEl.className = 'text-xs text-emerald-900 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 rounded-lg flex items-center gap-1.5 font-medium';
					clickHintEl.innerHTML = '<span>👉</span><span>Click any station below or tap <strong>[🟢 Board]</strong> to set where you enter the train.</span>';
				} else {
					targetDestBtn.className = 'px-3 py-1.5 rounded-lg bg-blue-600 text-white shadow-xs transition-all flex items-center gap-1.5 cursor-pointer ring-2 ring-blue-500/50';
					targetOriginBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer';
					clickHintEl.className = 'text-xs text-blue-900 bg-blue-500/10 border border-blue-500/20 px-3 py-1.5 rounded-lg flex items-center gap-1.5 font-medium';
					clickHintEl.innerHTML = '<span>👉</span><span>Click any station below or tap <strong>[🔵 Alight]</strong> to set your destination exit.</span>';
				}
			}

			targetOriginBtn?.addEventListener('click', () => setTargetMode('origin'));
			targetDestBtn?.addEventListener('click', () => setTargetMode('dest'));

			// Populate dropdowns with organized groups
			function populateDropdowns() {
				const groups = [
					{ key: 'lrt1', label: 'LRT Line 1 (Green)' },
					{ key: 'mrt3', label: 'MRT Line 3 (Blue)' },
					{ key: 'lrt2', label: 'LRT Line 2 (Purple)' }
				];

				[originSelect, destSelect].forEach(select => {
					select.innerHTML = '';
					groups.forEach(g => {
						const optgroup = document.createElement('optgroup');
						optgroup.label = g.label;
						STATIONS_DATA[g.key].forEach(st => {
							const opt = document.createElement('option');
							opt.value = st.id;
							opt.textContent = `${st.name}`;
							optgroup.appendChild(opt);
						});
						select.appendChild(optgroup);
					});
				});

				// Defaults: MRT-3 North Avenue to MRT-3 Taft Avenue
				originSelect.value = 'mrt3_north';
				destSelect.value = 'mrt3_taft';
			}

			populateDropdowns();

			// Public handler to set station
			window.setTransitStation = function (stationId, type) {
				const st = getStationById(stationId);
				if (!st) return;

				if (type === 'origin') {
					originSelect.value = stationId;
					// Automatically prompt destination next
					setTargetMode('dest');
					clickHintEl.innerHTML = `<span>👉</span><span>Boarding set to <strong>${st.name}</strong>! Now click your <strong>🔵 Destination Station</strong> below.</span>`;
				} else {
					destSelect.value = stationId;
				}
				calculateRoute();
			};

			// Leaflet Map state (100% Free OpenStreetMap - Zero API key)
			let leafletMap = null;
			let linePolylines = {};
			let stationMarkers = {};
			let activeRoutePolyline = null;
			let isMapInitialized = false;

			function initLeafletMap() {
				if (isMapInitialized || typeof L === 'undefined') return;

				leafletMap = L.map('rail-map', {
					center: [14.595, 121.03],
					zoom: 12,
					zoomControl: true,
					scrollWheelZoom: true
				});

				// 100% Free OpenStreetMap raster tiles (Zero API key required)
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
					maxZoom: 19
				}).addTo(leafletMap);

				Object.keys(STATIONS_DATA).forEach(lineKey => {
					const coords = STATIONS_DATA[lineKey].map(s => [s.lat, s.lon]);
					linePolylines[lineKey] = L.polyline(coords, {
						color: LINE_COLORS[lineKey],
						weight: 5,
						opacity: 0.85,
						smoothFactor: 1
					}).addTo(leafletMap);

					STATIONS_DATA[lineKey].forEach(st => {
						const isTransfer = st.isTransfer;
						const marker = L.circleMarker([st.lat, st.lon], {
							radius: isTransfer ? 7 : 5,
							fillColor: isTransfer ? '#F59E0B' : '#FFFFFF',
							color: LINE_COLORS[lineKey],
							weight: isTransfer ? 3 : 2,
							opacity: 1,
							fillOpacity: 1
						}).addTo(leafletMap);

						marker.bindPopup(`
							<div class="font-sans text-xs p-1">
								<div class="font-bold text-sm text-gray-900">${st.name}</div>
								<div class="text-[11px] text-gray-500 mb-2">${lineKey.toUpperCase()} &bull; KM ${st.km.toFixed(1)}</div>
								<div class="flex gap-1.5">
									<button type="button" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setTransitStation('${st.id}', 'origin')">
										🟢 Board Here
									</button>
									<button type="button" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setTransitStation('${st.id}', 'dest')">
										🔵 Alight Here
									</button>
								</div>
							</div>
						`);

						marker.on('click', () => {
							window.setTransitStation(st.id, currentTargetMode);
						});

						stationMarkers[st.id] = marker;
					});
				});

				isMapInitialized = true;
			}

			// View Switcher logic (Schematic Strip vs Free Geo Map)
			btnViewSchematic.addEventListener('click', () => {
				btnViewSchematic.className = 'px-3 py-1.5 text-xs font-bold rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				btnViewGeo.className = 'px-3 py-1.5 text-xs font-medium rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
				schematicContainer.classList.remove('hidden');
				geoContainer.classList.add('hidden');
			});

			btnViewGeo.addEventListener('click', () => {
				btnViewGeo.className = 'px-3 py-1.5 text-xs font-bold rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				btnViewSchematic.className = 'px-3 py-1.5 text-xs font-medium rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
				geoContainer.classList.remove('hidden');
				schematicContainer.classList.add('hidden');

				initLeafletMap();
				setTimeout(() => {
					if (leafletMap) {
						leafletMap.invalidateSize();
						if (activeRoutePolyline) {
							leafletMap.fitBounds(activeRoutePolyline.getBounds(), { padding: [40, 40] });
						}
					}
				}, 100);
			});

			// Line Filter Tabs
			const lineTabs = document.querySelectorAll('.rail-line-tab');
			lineTabs.forEach(tab => {
				tab.addEventListener('click', () => {
					const lineFilter = tab.getAttribute('data-line');

					// Update tab styles
					lineTabs.forEach(t => t.classList.add('opacity-40'));
					tab.classList.remove('opacity-40');

					// Filter schematic rows
					document.querySelectorAll('.rail-station-row').forEach(row => {
						const rowLine = row.getAttribute('data-line');
						if (lineFilter === 'all' || rowLine === lineFilter) {
							row.classList.remove('hidden');
						} else {
							row.classList.add('hidden');
						}
					});

					// Filter geo map layers if initialized
					if (leafletMap) {
						['lrt1', 'mrt3', 'lrt2'].forEach(key => {
							const shouldShow = (lineFilter === 'all' || key === lineFilter);
							if (shouldShow) {
								if (linePolylines[key]) leafletMap.addLayer(linePolylines[key]);
								STATIONS_DATA[key].forEach(s => {
									if (stationMarkers[s.id]) leafletMap.addLayer(stationMarkers[s.id]);
								});
							} else {
								if (linePolylines[key]) leafletMap.removeLayer(linePolylines[key]);
								STATIONS_DATA[key].forEach(s => {
									if (stationMarkers[s.id]) leafletMap.removeLayer(stationMarkers[s.id]);
								});
							}
						});
					}
				});
			});

			// Wire station row clicks and quick action buttons
			document.querySelectorAll('.rail-station-row').forEach(row => {
				const stId = row.getAttribute('data-station-id');

				// Clicking entire row sets according to active currentTargetMode
				row.addEventListener('click', (e) => {
					// Don't duplicate if clicked on inner action buttons
					if (e.target.closest('.btn-board-quick') || e.target.closest('.btn-alight-quick')) return;
					window.setTransitStation(stId, currentTargetMode);
				});

				const boardBtn = row.querySelector('.btn-board-quick');
				boardBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					window.setTransitStation(stId, 'origin');
				});

				const alightBtn = row.querySelector('.btn-alight-quick');
				alightBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					window.setTransitStation(stId, 'dest');
				});
			});

			// Official Fare Calculation Helpers
			function calcSingleLineFare(lineKey, distanceKm, stationCount) {
				let beepFare = 15;
				let sjtFare = 15;

				if (lineKey === 'mrt3') {
					if (stationCount <= 2) {
						beepFare = 13;
					} else if (stationCount <= 5) {
						beepFare = 16;
					} else if (stationCount <= 8) {
						beepFare = 20;
					} else if (stationCount <= 11) {
						beepFare = 24;
					} else {
						beepFare = 28;
					}
					sjtFare = beepFare;
				} else if (lineKey === 'lrt1') {
					beepFare = 15 + (distanceKm * 1.21);
					beepFare = Math.min(45, Math.max(15, Math.round(beepFare)));
					sjtFare = Math.ceil(beepFare / 5) * 5;
				} else if (lineKey === 'lrt2') {
					beepFare = 14 + (distanceKm * 1.21);
					beepFare = Math.min(33, Math.max(14, Math.round(beepFare)));
					sjtFare = Math.ceil(beepFare / 5) * 5;
				}

				return { beepFare, sjtFare };
			}

			function getLineTravelTime(lineKey, stops) {
				if (lineKey === 'mrt3') return stops * 2.5;
				if (lineKey === 'lrt1') return stops * 2.3;
				if (lineKey === 'lrt2') return stops * 2.8;
				return stops * 2.5;
			}

			// Synchronize Schematic Badges & Visual Highlights
			function updateSchematicHighlights(origin, dest) {
				const isSameLine = origin.lineKey === dest.lineKey;
				const minIdx = Math.min(origin.indexInLine, dest.indexInLine);
				const maxIdx = Math.max(origin.indexInLine, dest.indexInLine);

				ALL_STATIONS.forEach(st => {
					const rowEl = document.getElementById(`rail-node-${st.id}`);
					const badgeEl = document.getElementById(`rail-badge-${st.id}`);
					if (!rowEl || !badgeEl) return;

					if (st.id === origin.id) {
						rowEl.className = 'rail-station-row relative flex items-center justify-between p-2.5 rounded-xl border border-emerald-600 bg-emerald-500/15 shadow-2xs transition-all cursor-pointer ring-1 ring-emerald-500/40';
						badgeEl.textContent = '🟢 BOARDING (START)';
						badgeEl.className = 'station-status-badge inline-block text-[9px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-600 text-white shadow-2xs';
					} else if (st.id === dest.id) {
						rowEl.className = 'rail-station-row relative flex items-center justify-between p-2.5 rounded-xl border border-blue-600 bg-blue-500/15 shadow-2xs transition-all cursor-pointer ring-1 ring-blue-500/40';
						badgeEl.textContent = '🔵 DESTINATION (EXIT)';
						badgeEl.className = 'station-status-badge inline-block text-[9px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-600 text-white shadow-2xs';
					} else if (isSameLine && st.lineKey === origin.lineKey && st.indexInLine > minIdx && st.indexInLine < maxIdx) {
						rowEl.className = 'rail-station-row relative flex items-center justify-between p-2.5 rounded-xl border border-emerald-500/30 bg-emerald-500/5 transition-all cursor-pointer';
						badgeEl.className = 'station-status-badge hidden';
					} else {
						rowEl.className = 'rail-station-row relative flex items-center justify-between p-2.5 rounded-xl border border-transparent hover:border-mapa-green/40 hover:bg-mapa-canvas transition-all cursor-pointer group';
						badgeEl.className = 'station-status-badge hidden';
					}
				});
			}

			// Main Routing Algorithm
			function calculateRoute() {
				const originId = originSelect.value;
				const destId = destSelect.value;

				if (!originId || !destId) return;

				const origin = getStationById(originId);
				const dest = getStationById(destId);

				if (!origin || !dest) return;

				const hasDiscount = discountToggle.checked;

				// Update Summary Ribbon
				if (summaryOriginEl) summaryOriginEl.textContent = origin.name;
				if (summaryDestEl) summaryDestEl.textContent = dest.name;

				// Update Schematic Visuals
				updateSchematicHighlights(origin, dest);

				// Reset / update Geo Map markers if initialized
				if (leafletMap) {
					if (activeRoutePolyline) {
						leafletMap.removeLayer(activeRoutePolyline);
						activeRoutePolyline = null;
					}

					ALL_STATIONS.forEach(s => {
						const m = stationMarkers[s.id];
						if (m) {
							m.setStyle({
								radius: s.isTransfer ? 7 : 5,
								fillColor: s.isTransfer ? '#F59E0B' : '#FFFFFF',
								weight: s.isTransfer ? 3 : 2
							});
						}
					});

					stationMarkers[origin.id]?.setStyle({ radius: 9, fillColor: '#10B981', weight: 4 });
					stationMarkers[dest.id]?.setStyle({ radius: 9, fillColor: '#3B82F6', weight: 4 });
				}

				if (origin.id === dest.id) {
					fareBeepEl.textContent = '₱0.00';
					fareSjtEl.textContent = '₱0.00';
					metricTimeEl.textContent = '0 min';
					metricStopsEl.textContent = '0 stops';
					metricDistEl.textContent = '0 km';
					if (summaryMetricEl) summaryMetricEl.textContent = '0 stops • ₱0.00';
					transferCalloutEl.classList.add('hidden');
					routeStepsListEl.innerHTML = '<div class="text-mapa-clay italic p-2">Boarding and destination are the exact same station. Choose different stations to calculate fare.</div>';
					return;
				}

				// CASE 1: Same rail line
				if (origin.lineKey === dest.lineKey) {
					const lineKey = origin.lineKey;
					const stations = STATIONS_DATA[lineKey];
					const idxA = origin.indexInLine;
					const idxB = dest.indexInLine;
					const minIdx = Math.min(idxA, idxB);
					const maxIdx = Math.max(idxA, idxB);

					const segment = stations.slice(minIdx, maxIdx + 1);
					const stopsCount = maxIdx - minIdx;
					const distanceKm = Math.abs(dest.km - origin.km);

					const { beepFare, sjtFare } = calcSingleLineFare(lineKey, distanceKm, stopsCount);
					const finalBeep = hasDiscount ? (beepFare * 0.8) : beepFare;
					const finalSjt = hasDiscount ? (sjtFare * 0.8) : sjtFare;
					const travelTime = Math.round(getLineTravelTime(lineKey, stopsCount));

					fareBeepEl.textContent = `₱${finalBeep.toFixed(2)}`;
					fareSjtEl.textContent = `₱${finalSjt.toFixed(2)}`;
					metricTimeEl.textContent = `~${travelTime} mins`;
					metricStopsEl.textContent = `${stopsCount} ${stopsCount === 1 ? 'stop' : 'stops'}`;
					metricDistEl.textContent = `${distanceKm.toFixed(1)} km`;

					if (summaryMetricEl) summaryMetricEl.textContent = `${stopsCount} stops • ₱${finalBeep.toFixed(2)}`;

					transferCalloutEl.classList.add('hidden');

					// Render steps
					routeStepsListEl.innerHTML = `
						<div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
							<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[lineKey]}"></span>
							<div class="space-y-1">
								<div class="font-bold text-mapa-ink">Board ${lineKey.toUpperCase()}: ${origin.name}</div>
								<div class="text-mapa-clay text-[11px]">Ride ${stopsCount} stations towards ${dest.name} (${distanceKm.toFixed(1)} km)</div>
							</div>
						</div>
						<div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
							<span class="w-3 h-3 rounded-full bg-blue-600 mt-0.5 shrink-0"></span>
							<div class="space-y-1">
								<div class="font-bold text-mapa-ink">Alight at ${dest.name}</div>
								<div class="text-mapa-clay text-[11px]">Tap out at turnstile. Total journey time approx. ${travelTime} minutes.</div>
							</div>
						</div>
					`;

					if (leafletMap) {
						const pathCoords = (idxA < idxB ? segment : segment.reverse()).map(s => [s.lat, s.lon]);
						activeRoutePolyline = L.polyline(pathCoords, {
							color: '#F59E0B',
							weight: 6,
							dashArray: '8, 8',
							opacity: 0.95
						}).addTo(leafletMap);
					}
					return;
				}

				// CASE 2: Cross-line transfer
				let transferA = null;
				let transferB = null;
				let transferName = '';
				let transferWalkTime = 5;

				const pairKey = [origin.lineKey, dest.lineKey].sort().join('_');

				if (pairKey === 'lrt1_mrt3') {
					transferA = getStationById(origin.lineKey === 'lrt1' ? 'lrt1_edsa' : 'mrt3_taft');
					transferB = getStationById(dest.lineKey === 'lrt1' ? 'lrt1_edsa' : 'mrt3_taft');
					transferName = 'EDSA-Taft Footbridge';
					transferWalkTime = 4;
				} else if (pairKey === 'lrt1_lrt2') {
					transferA = getStationById(origin.lineKey === 'lrt1' ? 'lrt1_doroteo_jose' : 'lrt2_recto');
					transferB = getStationById(dest.lineKey === 'lrt1' ? 'lrt1_doroteo_jose' : 'lrt2_recto');
					transferName = 'Doroteo Jose - Recto Elevated Walkway';
					transferWalkTime = 5;
				} else if (pairKey === 'lrt2_mrt3') {
					transferA = getStationById(origin.lineKey === 'lrt2' ? 'lrt2_cubao' : 'mrt3_cubao');
					transferB = getStationById(dest.lineKey === 'lrt2' ? 'lrt2_cubao' : 'mrt3_cubao');
					transferName = 'Araneta Center-Cubao (Farmers/Gateway Walkway)';
					transferWalkTime = 6;
				}

				if (!transferA || !transferB) return;

				const leg1Stops = Math.abs(origin.indexInLine - transferA.indexInLine);
				const leg1Dist = Math.abs(origin.km - transferA.km);
				const leg1Fare = calcSingleLineFare(origin.lineKey, leg1Dist, leg1Stops);
				const leg1Time = getLineTravelTime(origin.lineKey, leg1Stops);

				const leg2Stops = Math.abs(transferB.indexInLine - dest.indexInLine);
				const leg2Dist = Math.abs(transferB.km - dest.km);
				const leg2Fare = calcSingleLineFare(dest.lineKey, leg2Dist, leg2Stops);
				const leg2Time = getLineTravelTime(dest.lineKey, leg2Stops);

				const totalBeep = leg1Fare.beepFare + leg2Fare.beepFare;
				const totalSjt = leg1Fare.sjtFare + leg2Fare.sjtFare;
				const finalBeep = hasDiscount ? (totalBeep * 0.8) : totalBeep;
				const finalSjt = hasDiscount ? (totalSjt * 0.8) : totalSjt;

				const totalStops = leg1Stops + leg2Stops;
				const totalDist = leg1Dist + leg2Dist;
				const totalTime = Math.round(leg1Time + transferWalkTime + leg2Time);

				fareBeepEl.textContent = `₱${finalBeep.toFixed(2)}`;
				fareSjtEl.textContent = `₱${finalSjt.toFixed(2)}`;
				metricTimeEl.textContent = `~${totalTime} mins`;
				metricStopsEl.textContent = `${totalStops} stops (1 transfer)`;
				metricDistEl.textContent = `${totalDist.toFixed(1)} km`;

				if (summaryMetricEl) summaryMetricEl.textContent = `${totalStops} stops (1 transfer) • ₱${finalBeep.toFixed(2)}`;

				// Show transfer alert
				transferCalloutEl.classList.remove('hidden');
				transferCalloutEl.innerHTML = `
					<div class="font-bold flex items-center gap-1.5 mb-1">
						<span>🔄 Transfer Required:</span>
						<span>${transferName}</span>
					</div>
					<div>Exit ${origin.lineKey.toUpperCase()} at <strong>${transferA.name}</strong>, walk ~${transferWalkTime} mins across the connecting walkway, and tap into ${dest.lineKey.toUpperCase()} at <strong>${transferB.name}</strong>.</div>
				`;

				// Render 4-step itinerary
				routeStepsListEl.innerHTML = `
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[origin.lineKey]}"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">1. Board ${origin.lineKey.toUpperCase()}: ${origin.name}</div>
							<div class="text-mapa-clay text-[11px]">Ride ${leg1Stops} stops (${leg1Dist.toFixed(1)} km) &bull; Fare: ₱${(hasDiscount ? leg1Fare.beepFare * 0.8 : leg1Fare.beepFare).toFixed(2)}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-amber-500/10 border border-amber-500/30">
						<span class="w-3 h-3 rounded-full bg-amber-500 mt-0.5 shrink-0"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-amber-900">2. Transfer at ${transferA.name}</div>
							<div class="text-amber-800 text-[11px]">Walk ~${transferWalkTime} mins via ${transferName} into ${transferB.name}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full mt-0.5 shrink-0" style="background-color: ${LINE_COLORS[dest.lineKey]}"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">3. Board ${dest.lineKey.toUpperCase()}: ${transferB.name}</div>
							<div class="text-mapa-clay text-[11px]">Ride ${leg2Stops} stops (${leg2Dist.toFixed(1)} km) &bull; Fare: ₱${(hasDiscount ? leg2Fare.beepFare * 0.8 : leg2Fare.beepFare).toFixed(2)}</div>
						</div>
					</div>
					<div class="flex items-start gap-2.5 p-2 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
						<span class="w-3 h-3 rounded-full bg-blue-600 mt-0.5 shrink-0"></span>
						<div class="space-y-0.5">
							<div class="font-bold text-mapa-ink">4. Arrive at ${dest.name}</div>
							<div class="text-mapa-clay text-[11px]">Total combined time approx. ${totalTime} minutes.</div>
						</div>
					</div>
				`;

				if (leafletMap) {
					const stListA = STATIONS_DATA[origin.lineKey];
					const minA = Math.min(origin.indexInLine, transferA.indexInLine);
					const maxA = Math.max(origin.indexInLine, transferA.indexInLine);
					const leg1Coords = stListA.slice(minA, maxA + 1).map(s => [s.lat, s.lon]);

					const stListB = STATIONS_DATA[dest.lineKey];
					const minB = Math.min(dest.indexInLine, transferB.indexInLine);
					const maxB = Math.max(dest.indexInLine, transferB.indexInLine);
					const leg2Coords = stListB.slice(minB, maxB + 1).map(s => [s.lat, s.lon]);

					const combinedCoords = [...leg1Coords, ...leg2Coords];
					activeRoutePolyline = L.polyline(combinedCoords, {
						color: '#F59E0B',
						weight: 6,
						dashArray: '8, 8',
						opacity: 0.95
					}).addTo(leafletMap);
				}
			}

			// Event Listeners
			originSelect.addEventListener('change', calculateRoute);
			destSelect.addEventListener('change', calculateRoute);
			discountToggle.addEventListener('change', calculateRoute);

			function swapStations() {
				const temp = originSelect.value;
				originSelect.value = destSelect.value;
				destSelect.value = temp;
				calculateRoute();
			}

			swapBtn.addEventListener('click', swapStations);
			quickSwapBtn?.addEventListener('click', swapStations);

			// Presets
			document.querySelectorAll('.preset-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const orig = btn.getAttribute('data-origin');
					const dst = btn.getAttribute('data-dest');
					if (orig && dst) {
						originSelect.value = orig;
						destSelect.value = dst;
						calculateRoute();
					}
				});
			});

			// Initial Calculation
			calculateRoute();
		})();
	</script>
</BaseLayout>
