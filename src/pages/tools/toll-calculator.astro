					if (clickHint) {
						clickHint.innerHTML = '<span>👉</span><span>Clicking any plaza below will set it as your <strong>🟢 Entry Plaza</strong>.</span>';
						clickHint.className = 'text-xs text-emerald-900 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 rounded-lg flex items-center gap-1.5 font-medium';
					}
				} else {
					targetExitBtn.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-rose-600 text-white shadow-xs transition-all flex items-center gap-1.5 cursor-pointer ring-2 ring-rose-500/20';
					targetEntryBtn.className = 'px-3 py-1.5 rounded-lg text-xs text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer';
					if (clickHint) {
						clickHint.innerHTML = '<span>👉</span><span>Clicking any plaza below will set it as your <strong>🔴 Exit Plaza</strong>.</span>';
						clickHint.className = 'text-xs text-rose-900 bg-rose-500/10 border border-rose-500/20 px-3 py-1.5 rounded-lg flex items-center gap-1.5 font-medium';
					}
				}
			}

			if (targetEntryBtn) {
				targetEntryBtn.addEventListener('click', () => {
					currentTollTargetMode = 'entry';
					updateTargetModeUI();
				});
			}

			if (targetExitBtn) {
				targetExitBtn.addEventListener('click', () => {
					currentTollTargetMode = 'exit';
					updateTargetModeUI();
				});
			}

			// Highway Waypoints for realistic road curvature on geographic map
			const EXPRESSWAY_GEO_WAYPOINTS = {
				slex: [
					[14.5422, 121.0194], [14.5180, 121.0250], [14.4850, 121.0450], [14.4550, 121.0430],
					[14.4150, 121.0420], [14.3750, 121.0480], [14.3500, 121.0550], [14.3200, 121.0650],
					[14.2900, 121.0600], [14.2650, 121.0800], [14.2400, 121.0950], [14.2150, 121.1100],
					[14.1900, 121.1250], [14.1800, 121.1350], [14.1650, 121.1450], [14.1100, 121.1600]
				],
				nlex: [
					[14.6580, 121.0030], [14.7150, 120.9850], [14.7400, 120.9600], [14.7700, 120.9400],
					[14.8100, 120.9150], [14.8350, 120.9000], [14.8600, 120.8750], [14.8950, 120.8300],
					[14.9850, 120.7300], [15.0350, 120.6800], [15.0750, 120.6900], [15.1450, 120.6100],
					[15.1850, 120.5850], [15.2250, 120.5700]
				],
				skyway: [
					[14.4150, 121.0420], [14.4550, 121.0430], [14.4850, 121.0450], [14.5422, 121.0194],
					[14.5600, 121.0050], [14.5800, 120.9980], [14.5950, 121.0020], [14.6280, 121.0120],
					[14.6600, 121.0050]
				]
			};

			let activeRouteHighlightPolyline = null;

			// Global public handler for setting plazas from buttons or popups
			window.setTollPlaza = function (plazaId, targetMode) {
				if (targetMode === 'entry') {
					currentEntryId = plazaId;
					entrySelect.value = plazaId;
					currentTollTargetMode = 'exit';
					updateTargetModeUI();
				} else if (targetMode === 'exit') {
					currentExitId = plazaId;
					exitSelect.value = plazaId;
				} else {
					if (currentTollTargetMode === 'entry') {
						currentEntryId = plazaId;
						entrySelect.value = plazaId;
						currentTollTargetMode = 'exit';
						updateTargetModeUI();
					} else {
						currentExitId = plazaId;
						exitSelect.value = plazaId;
					}
				}
				calculateToll();
			};

			// Handle plaza selection from schematic node or map marker
			function handlePlazaClick(plazaId) {
				window.setTollPlaza(plazaId, currentTollTargetMode);
			}

			// Populate Entry and Exit dropdowns for active expressway
			function populatePlazaDropdowns() {
				const exp = getActiveExpressway();
				entrySelect.innerHTML = '';
				exitSelect.innerHTML = '';

				exp.plazas.forEach(p => {
					const opt1 = document.createElement('option');
					opt1.value = p.id;
					opt1.textContent = `${p.name} (km ${p.km.toFixed(1)})`;
					entrySelect.appendChild(opt1);

					const opt2 = document.createElement('option');
					opt2.value = p.id;
					opt2.textContent = `${p.name} (km ${p.km.toFixed(1)})`;
					exitSelect.appendChild(opt2);
				});

				// Set default entry and exit
				if (exp.plazas.length >= 2) {
					currentEntryId = exp.plazas[0].id;
					currentExitId = exp.plazas[exp.plazas.length - 2].id || exp.plazas[exp.plazas.length - 1].id;
					entrySelect.value = currentEntryId;
					exitSelect.value = currentExitId;
				}
			}

			// Render the Schematic Highway Strip with alternating non-overlapping cards
			function renderSchematicStrip() {
				const exp = getActiveExpressway();
				const entryIdx = exp.plazas.findIndex(p => p.id === currentEntryId);
				const exitIdx = exp.plazas.findIndex(p => p.id === currentExitId);
				const minIdx = Math.min(entryIdx, exitIdx);
				const maxIdx = Math.max(entryIdx, exitIdx);

				schematicCanvas.innerHTML = '';

				// Outer flex strip container with generous scrollable width
				const stripContainer = document.createElement('div');
				stripContainer.className = 'flex items-center min-w-max px-10 py-10 relative select-none';

				const nodeWidth = 125;
				const totalWidth = exp.plazas.length * nodeWidth;
				stripContainer.style.minWidth = `${totalWidth + 100}px`;

				// Continuous Center Highway Track
				const trackLine = document.createElement('div');
				trackLine.className = 'absolute left-10 right-10 top-1/2 -translate-y-1/2 h-3 bg-stone-300 dark:bg-stone-700 rounded-full z-0';
				stripContainer.appendChild(trackLine);

				// Active Highlight Track Segment spanning from entry node to exit node
				if (entryIdx !== -1 && exitIdx !== -1 && minIdx !== maxIdx) {
					const leftPx = 40 + (minIdx * nodeWidth) + (nodeWidth / 2);
					const rightPx = 40 + (maxIdx * nodeWidth) + (nodeWidth / 2);
					const widthPx = rightPx - leftPx;

					const activeHighlight = document.createElement('div');
					activeHighlight.className = 'absolute top-1/2 -translate-y-1/2 h-3.5 bg-emerald-500 rounded-full z-1 transition-all shadow-md';
					activeHighlight.style.left = `${leftPx}px`;
					activeHighlight.style.width = `${widthPx}px`;
					stripContainer.appendChild(activeHighlight);
				}

				// Plaza Nodes: Alternating Top and Bottom to completely eliminate label squishing
				exp.plazas.forEach((plaza, idx) => {
					const isEntry = plaza.id === currentEntryId;
					const isExit = plaza.id === currentExitId;
					const isIntermediate = idx >= minIdx && idx <= maxIdx;
					const isTop = idx % 2 === 0;

					const col = document.createElement('div');
					col.className = 'w-[125px] shrink-0 flex flex-col items-center relative z-10';

					// Plaza Card
					const card = document.createElement('div');
					card.className = `w-[115px] p-2.5 rounded-xl border text-center transition-all cursor-pointer shadow-2xs ${
						isEntry ? 'bg-emerald-500/15 border-emerald-600 ring-2 ring-emerald-500/40 shadow-xs' :
						isExit ? 'bg-rose-500/15 border-rose-600 ring-2 ring-rose-500/40 shadow-xs' :
						isIntermediate ? 'bg-emerald-500/10 border-emerald-500/40' :
						plaza.isBarrier ? 'bg-amber-500/10 border-amber-500/40 hover:border-amber-500' :
						'bg-mapa-canvas border-mapa-contour/70 hover:border-mapa-green hover:shadow-xs'
					}`;
					card.title = `Click to set as ${currentTollTargetMode.toUpperCase()}: ${plaza.name}`;

					let badgeHtml = '';
					if (isEntry) {
						badgeHtml = '<span class="inline-block text-[8px] font-extrabold uppercase px-1.5 py-0.5 rounded-full bg-emerald-600 text-white shadow-2xs">🟢 ENTRY</span>';
					} else if (isExit) {
						badgeHtml = '<span class="inline-block text-[8px] font-extrabold uppercase px-1.5 py-0.5 rounded-full bg-rose-600 text-white shadow-2xs">🔴 EXIT</span>';
					} else if (plaza.isBarrier) {
						badgeHtml = '<span class="inline-block text-[8px] font-bold uppercase px-1.5 py-0.5 rounded-full bg-amber-500 text-white shadow-2xs">BARRIER</span>';
					} else {
						badgeHtml = `<span class="inline-block text-[9px] font-mono font-semibold text-mapa-clay">km ${plaza.km.toFixed(0)}</span>`;
					}

					const cleanName = plaza.name.split(' (')[0];
					card.innerHTML = `
						<div class="mb-1">${badgeHtml}</div>
						<div class="text-[11px] font-bold text-mapa-ink leading-snug line-clamp-2" title="${plaza.name}">${cleanName}</div>
						<div class="flex items-center justify-center gap-1 mt-2 pt-1.5 border-t border-mapa-contour/40">
							<button type="button" class="btn-quick-entry px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-600/15 hover:bg-emerald-600 text-emerald-800 hover:text-white transition-all cursor-pointer shadow-2xs" data-id="${plaza.id}">🟢 In</button>
							<button type="button" class="btn-quick-exit px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-600/15 hover:bg-rose-600 text-rose-800 hover:text-white transition-all cursor-pointer shadow-2xs" data-id="${plaza.id}">🔴 Out</button>
						</div>
					`;

					card.addEventListener('click', (e) => {
						const inBtn = e.target.closest('.btn-quick-entry');
						const outBtn = e.target.closest('.btn-quick-exit');
						if (inBtn) {
							window.setTollPlaza(plaza.id, 'entry');
						} else if (outBtn) {
							window.setTollPlaza(plaza.id, 'exit');
						} else {
							window.setTollPlaza(plaza.id, currentTollTargetMode);
						}
					});

					// Connector line between card and track pin
					const connector = document.createElement('div');
					connector.className = `w-0.5 h-6 transition-colors ${
						isIntermediate ? 'bg-emerald-500' : 'bg-stone-300 dark:bg-stone-600'
					}`;

					// Pin dot on center highway track
					const pin = document.createElement('div');
					if (isEntry) {
						pin.className = 'w-6 h-6 rounded-full bg-emerald-600 border-2 border-white shadow-md flex items-center justify-center text-white text-[9px] font-bold ring-4 ring-emerald-500/30 cursor-pointer animate-pulse';
						pin.textContent = '🟢';
					} else if (isExit) {
						pin.className = 'w-6 h-6 rounded-full bg-rose-600 border-2 border-white shadow-md flex items-center justify-center text-white text-[9px] font-bold ring-4 ring-rose-500/30 cursor-pointer animate-pulse';
						pin.textContent = '🔴';
					} else if (isIntermediate) {
						pin.className = 'w-4 h-4 rounded-full bg-emerald-500 border-2 border-white shadow-sm ring-2 ring-emerald-400/40 cursor-pointer';
					} else if (plaza.isBarrier) {
						pin.className = 'w-4 h-4 rounded bg-amber-500 border border-white shadow-sm flex items-center justify-center text-[7px] text-white font-bold cursor-pointer';
						pin.textContent = 'T';
					} else {
						pin.className = 'w-3.5 h-3.5 rounded-full bg-stone-400 border-2 border-white shadow-2xs hover:scale-125 transition-transform cursor-pointer';
					}
					pin.addEventListener('click', () => window.setTollPlaza(plaza.id, currentTollTargetMode));

					// Equalizing Spacer to balance height
					const spacer = document.createElement('div');
					spacer.className = 'h-[95px] w-full pointer-events-none';

					if (isTop) {
						col.appendChild(card);
						col.appendChild(connector);
						col.appendChild(pin);
						col.appendChild(spacer);
					} else {
						col.appendChild(spacer);
						col.appendChild(pin);
						col.appendChild(connector);
						col.appendChild(card);
					}

					stripContainer.appendChild(col);
				});

				schematicCanvas.appendChild(stripContainer);
			}

			// Render Geographic Leaflet Map with Instant Route Polyline
			function initOrUpdateGeoMap() {
				if (!map && typeof L !== 'undefined') {
					map = L.map('toll-geo-map', {
						center: [14.65, 121.0],
						zoom: 10,
						zoomControl: true,
						scrollWheelZoom: true
					});

					L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
						attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
						maxZoom: 19
					}).addTo(map);
				}

				if (!map) return;

				const exp = getActiveExpressway();

				// Clear existing layers
				if (activeGeoPolyline) {
					map.removeLayer(activeGeoPolyline);
					activeGeoPolyline = null;
				}
				if (activeRouteHighlightPolyline) {
					map.removeLayer(activeRouteHighlightPolyline);
					activeRouteHighlightPolyline = null;
				}
				activeGeoMarkers.forEach(m => map.removeLayer(m));
				activeGeoMarkers = [];

				// Base highway curve polyline
				const baseCoords = EXPRESSWAY_GEO_WAYPOINTS[exp.id] || exp.plazas.map(p => [p.lat, p.lon]);
				activeGeoPolyline = L.polyline(baseCoords, {
					color: exp.color,
					weight: 5,
					opacity: 0.55
				}).addTo(map);

				// Active Journey Polyline (Entry to Exit)
				const entryIdx = exp.plazas.findIndex(p => p.id === currentEntryId);
				const exitIdx = exp.plazas.findIndex(p => p.id === currentExitId);
				const minIdx = Math.min(entryIdx, exitIdx);
				const maxIdx = Math.max(entryIdx, exitIdx);

				if (minIdx !== -1 && maxIdx !== -1) {
					const routePlazas = exp.plazas.slice(minIdx, maxIdx + 1);
					const routeCoords = routePlazas.map(p => [p.lat, p.lon]);

					if (routeCoords.length >= 2) {
						activeRouteHighlightPolyline = L.polyline(routeCoords, {
							color: '#F59E0B',
							weight: 7,
							opacity: 0.95,
							dashArray: '8, 8'
						}).addTo(map);
					}
				}

				// Plaza Markers on Map
				exp.plazas.forEach(p => {
					const isEntry = p.id === currentEntryId;
					const isExit = p.id === currentExitId;
					const isIntermediate = minIdx !== -1 && maxIdx !== -1 && exp.plazas.indexOf(p) >= minIdx && exp.plazas.indexOf(p) <= maxIdx;

					const m = L.circleMarker([p.lat, p.lon], {
						radius: isEntry || isExit ? 8 : isIntermediate ? 6 : 4,
						fillColor: isEntry ? '#059669' : isExit ? '#E11D48' : isIntermediate ? '#F59E0B' : p.isBarrier ? '#F59E0B' : '#FFFFFF',
						color: isEntry || isExit ? '#FFFFFF' : exp.color,
						weight: isEntry || isExit ? 3 : 2,
						opacity: 1,
						fillOpacity: 1
					}).addTo(map);

					m.bindPopup(`
						<div class="font-sans text-xs p-1">
							<div class="font-bold text-sm text-gray-900">${p.name}</div>
							<div class="text-[11px] text-gray-500 mb-2">${exp.name} &bull; KM ${p.km.toFixed(1)}</div>
							<div class="flex gap-1.5">
								<button type="button" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setTollPlaza('${p.id}', 'entry')">
									🟢 Set Entry
								</button>
								<button type="button" class="px-2 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setTollPlaza('${p.id}', 'exit')">
									🔴 Set Exit
								</button>
							</div>
						</div>
					`);

					m.on('click', () => {
						window.setTollPlaza(p.id, currentTollTargetMode);
					});

					activeGeoMarkers.push(m);
				});

				// Fit bounds to the active journey path immediately
				if (activeRouteHighlightPolyline) {
					map.fitBounds(activeRouteHighlightPolyline.getBounds(), { padding: [40, 40] });
				} else if (activeGeoPolyline) {
					map.fitBounds(activeGeoPolyline.getBounds(), { padding: [30, 30] });
				}
			}

			// Render dynamic itinerary list of traversed plazas
			function renderItinerary(exp, entryIdx, exitIdx, distKm, fee) {
				if (!tollItineraryList) return;
				tollItineraryList.innerHTML = '';

				if (entryIdx === -1 || exitIdx === -1) return;

				const step = entryIdx <= exitIdx ? 1 : -1;
				const traversed = [];
				for (let i = entryIdx; ; i += step) {
					traversed.push(exp.plazas[i]);
					if (i === exitIdx) break;
				}

				if (itineraryStopsCount) {
					itineraryStopsCount.textContent = `${traversed.length} Plazas (${distKm.toFixed(1)} km)`;
				}

				traversed.forEach((plaza, idx) => {
					const isStart = idx === 0;
					const isEnd = idx === traversed.length - 1;

					const row = document.createElement('div');
					row.className = `p-2 rounded-lg border flex items-center justify-between text-xs transition-colors ${
						isStart ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-950 font-bold' :
						isEnd ? 'bg-rose-500/10 border-rose-500/30 text-rose-950 font-bold' :
						plaza.isBarrier ? 'bg-amber-500/10 border-amber-500/30 text-amber-950' :
						'bg-mapa-canvas-dark border-mapa-contour/50 text-mapa-ink/80'
					}`;

					const left = document.createElement('div');
					left.className = 'flex items-center gap-2';

					const dot = document.createElement('span');
					if (isStart) {
						dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-600';
					} else if (isEnd) {
						dot.className = 'w-2.5 h-2.5 rounded-full bg-rose-600';
					} else if (plaza.isBarrier) {
						dot.className = 'w-2 h-2 rounded bg-amber-500';
					} else {
						dot.className = 'w-1.5 h-1.5 rounded-full bg-stone-400';
					}
					left.appendChild(dot);

					const nameSpan = document.createElement('span');
					nameSpan.textContent = plaza.name;
					left.appendChild(nameSpan);

					if (plaza.isBarrier) {
						const bTag = document.createElement('span');
						bTag.className = 'text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-500 text-white';
						bTag.textContent = 'Barrier';
						left.appendChild(bTag);
					}

					const right = document.createElement('span');
					right.className = 'text-[11px] font-mono text-mapa-clay';
					right.textContent = `km ${plaza.km.toFixed(1)}`;

					row.appendChild(left);
					row.appendChild(right);
					tollItineraryList.appendChild(row);
				});
			}

			// Calculate Toll Fee
			function calculateToll() {
				const exp = getActiveExpressway();
				const entryIdx = exp.plazas.findIndex(p => p.id === currentEntryId);
				const exitIdx = exp.plazas.findIndex(p => p.id === currentExitId);
				const entry = exp.plazas[entryIdx] || exp.plazas[0];
				const exit = exp.plazas[exitIdx] || exp.plazas[exp.plazas.length - 1];

				const distKm = Math.abs(exit.km - entry.km);

				// Compute Fee
				let fee = 0;
				if (entry.id === exit.id) {
					fee = 0;
				} else if (exp.id === 'cclex') {
					// Flat toll
					fee = currentClass === 1 ? 90 : currentClass === 2 ? 180 : 270;
				} else {
					// Distance-based with open barrier components
					// We use exit plaza tariff as standard TRB closed system table
					const tariffKey = `c${currentClass}`;
					const maxTariff = Math.max(entry[tariffKey], exit[tariffKey]);
					const minTariff = Math.min(entry[tariffKey], exit[tariffKey]);

					if (minTariff === 0) {
						fee = maxTariff;
					} else {
						// Differential
						fee = Math.abs(maxTariff - minTariff);
						// Minimum base toll threshold
						if (fee < 15 && distKm > 0) fee = 15;
					}
				}

				// Update UI
				tollFeeDisplay.textContent = `₱${fee.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				requiredRfidTag.textContent = exp.rfid;
				requiredRfidTag.className = `inline-block mt-0.5 px-2.5 py-1 rounded-md text-xs font-bold ${exp.rfidColor} shadow-xs`;

				metricDistance.textContent = `${distKm.toFixed(1)} km`;
				metricSystem.textContent = exp.system.split(' ')[0];

				// Rate per KM metric
				if (metricRateKm) {
					const rate = distKm > 0 ? (fee / distKm) : 0;
					metricRateKm.textContent = `₱${rate.toFixed(2)} / km`;
				}

				const classLabel = currentClass === 1 ? 'Class 1 (Cars, SUVs, 400cc+)' : currentClass === 2 ? 'Class 2 (Buses, 2-Axle Trucks)' : 'Class 3 (Heavy 3+ Axle Trucks)';
				breakdownVehicle.textContent = classLabel;
				breakdownOperator.textContent = exp.operator.split(' (')[0];

				activeCorridorTitle.textContent = `${exp.name} Corridor Visualizer`;
				corridorRfidBadge.textContent = exp.rfid;
				corridorRfidBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold ${exp.rfidColor}`;

				// Summary Ribbon
				if (summaryEntryName) summaryEntryName.textContent = entry.name;
				if (summaryExitName) summaryExitName.textContent = exit.name;
				if (summaryTollMetric) summaryTollMetric.textContent = `${distKm.toFixed(1)} km • ₱${fee.toFixed(2)}`;

				renderSchematicStrip();
				renderItinerary(exp, entryIdx, exitIdx, distKm, fee);

				if (currentView === 'geo' && map) {
					initOrUpdateGeoMap();
				}
			}

			// View Toggle (Schematic Strip vs Geo Map) with Instant Path Fitting
			function setTollView(view) {
				currentView = view;
				if (view === 'schematic') {
					schematicView.classList.remove('hidden');
					geoMapView.classList.add('hidden');

					btnViewSchematic.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold transition-all bg-mapa-canvas text-mapa-green shadow-xs';
					btnViewGeo.className = 'px-2.5 py-1 rounded-md text-[11px] font-medium text-mapa-ink/60 hover:text-mapa-ink transition-all';
					renderSchematicStrip();
				} else {
					schematicView.classList.add('hidden');
					geoMapView.classList.remove('hidden');

					btnViewGeo.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold transition-all bg-mapa-canvas text-mapa-green shadow-xs';
					btnViewSchematic.className = 'px-2.5 py-1 rounded-md text-[11px] font-medium text-mapa-ink/60 hover:text-mapa-ink transition-all';

					initOrUpdateGeoMap();
					if (map) {
						map.invalidateSize();
						if (activeRouteHighlightPolyline) {
							map.fitBounds(activeRouteHighlightPolyline.getBounds(), { padding: [40, 40] });
						}
						setTimeout(() => {
							map.invalidateSize();
						}, 50);
					}
				}
			}

			btnViewSchematic.addEventListener('click', () => setTollView('schematic'));
			btnViewGeo.addEventListener('click', () => setTollView('geo'));

			// Swap Handler
			function handleSwap() {
				const temp = currentEntryId;
				currentEntryId = currentExitId;
				currentExitId = temp;
				entrySelect.value = currentEntryId;
				exitSelect.value = currentExitId;
				calculateToll();
			}

			// Event Listeners
			expSelect.addEventListener('change', () => {
				currentExpId = expSelect.value;
				populatePlazaDropdowns();
				calculateToll();
			});

			entrySelect.addEventListener('change', () => {
				currentEntryId = entrySelect.value;
				calculateToll();
			});

			exitSelect.addEventListener('change', () => {
				currentExitId = exitSelect.value;
				calculateToll();
			});

			if (swapBtn) swapBtn.addEventListener('click', handleSwap);
			if (quickSwapBtn) quickSwapBtn.addEventListener('click', handleSwap);

			// Vehicle Class selection
			classBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					currentClass = parseInt(btn.getAttribute('data-class'), 10) || 1;
					classBtns.forEach(b => {
						b.className = 'vehicle-class-btn p-2.5 rounded-xl border transition-all text-center bg-mapa-canvas border-mapa-contour text-mapa-ink/70 hover:border-mapa-green/50';
					});
					btn.className = 'vehicle-class-btn p-2.5 rounded-xl border transition-all text-center bg-mapa-canvas border-mapa-green text-mapa-green shadow-xs font-bold';
					calculateToll();
				});
			});

			// Preset Trip Buttons
			document.querySelectorAll('.preset-trip-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const expId = btn.getAttribute('data-exp');
					const orig = btn.getAttribute('data-orig');
					const dest = btn.getAttribute('data-dest');

					if (expId && orig && dest) {
						currentExpId = expId;
						expSelect.value = expId;
						populatePlazaDropdowns();

						currentEntryId = orig;
						currentExitId = dest;
						entrySelect.value = orig;
						exitSelect.value = dest;

						calculateToll();
					}
				});
			});

			// Initialize
			updateTargetModeUI();
			populatePlazaDropdowns();
			calculateToll();
		})();
	</script>
</BaseLayout>
