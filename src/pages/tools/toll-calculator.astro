			const tollFeeDisplay = document.getElementById('toll-fee-display');
			const requiredRfidTag = document.getElementById('required-rfid-tag');
			const metricDistance = document.getElementById('metric-toll-distance');
			const metricRateKm = document.getElementById('metric-rate-km');
			const metricSystem = document.getElementById('metric-toll-system');
			const breakdownVehicle = document.getElementById('breakdown-vehicle');
			const breakdownOperator = document.getElementById('breakdown-operator');
			const activeCorridorTitle = document.getElementById('active-corridor-title');
			const corridorRfidBadge = document.getElementById('corridor-rfid-badge');

			const summaryEntryName = document.getElementById('summary-entry-name');
			const summaryExitName = document.getElementById('summary-exit-name');
			const summaryTollMetric = document.getElementById('summary-toll-metric');
			const itineraryStopsCount = document.getElementById('itinerary-stops-count');
			const tollItineraryList = document.getElementById('toll-itinerary-list');

			const schematicView = document.getElementById('schematic-view-container');
			const schematicCanvas = document.getElementById('schematic-strip-canvas');
			const geoMapView = document.getElementById('toll-geo-map');
			const btnViewSchematic = document.getElementById('btn-view-schematic');
			const btnViewGeo = document.getElementById('btn-view-geo');

			// Leaflet Map instance
			let map = null;
			let activeGeoPolyline = null;
			let activeGeoMarkers = [];

			function getActiveExpressway() {
				return EXPRESSWAYS.find(e => e.id === currentExpId) || EXPRESSWAYS[0];
			}

			// Target mode switcher UI
			function updateTargetModeUI() {
				if (!targetEntryBtn || !targetExitBtn) return;
				if (currentTollTargetMode === 'entry') {
					targetEntryBtn.className = 'px-3 py-1.5 rounded-lg font-bold text-xs bg-emerald-600 text-white shadow-xs transition-all flex items-center gap-1.5 cursor-pointer ring-2 ring-emerald-500/20';
