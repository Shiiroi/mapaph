<BaseLayout
	title="Philippine Expressway Toll Fee Calculator & Schematic Map (NLEX, SLEX, Skyway, SCTEX, TPLEX) — mapaPH Tools"
	description="Official Toll Regulatory Board (TRB) toll fee calculator for Class 1, 2, and 3 vehicles across NLEX, SLEX, Skyway, SCTEX, TPLEX, CALAX, and CCLEX. Features schematic corridor diagrams and RFID tag guides."
	keywords="NLEX toll fee calculator, SLEX toll rates, Skyway toll fee, SCTEX toll rates, TPLEX toll matrix, CALAX toll fee, CCLEX toll rate, Autosweep RFID vs Easytrip RFID, Class 1 toll fee Philippines, TRB toll matrix, expressway distance map Philippines"
>
	<!-- Leaflet Stylesheet -->
	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
		slot="schema"
	/>

	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Philippine Expressway Toll Calculator & Schematic Map",
					"url": "https://mapaph.com/tools/toll-calculator",
					"applicationCategory": "Highway Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Interactive toll fee and corridor routing calculator for Philippine tollways with official TRB vehicle class rates and Autosweep/Easytrip RFID guides.",
					"provider": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://mapaph.com"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "What are the vehicle classifications on Philippine expressways?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Under the Toll Regulatory Board (TRB), Class 1 includes light vehicles, cars, SUVs, vans, pickups, and motorcycles 400cc and above. Class 2 includes buses, heavy commercial vans, and 2-axle trucks. Class 3 covers heavy large multi-axle freight trucks, articulated lorries, and container haulers."
							}
						},
						{
							"@type": "Question",
							"name": "Which RFID tag do I need: Autosweep or Easytrip?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Autosweep RFID is used on San Miguel Corporation tollways (SLEX, Skyway Stages 1–3, NAIAX, MCX, TPLEX, and STAR Tollway). Easytrip RFID is used on Metro Pacific tollways (NLEX, SCTEX, CAVITEX, CALAX, C5 South Link, and CCLEX in Cebu). Under Phase 2 interoperability, you can enroll your Autosweep sticker to work on Easytrip tollways and vice-versa, though wallets remain separate."
							}
						},
						{
							"@type": "Question",
							"name": "Can motorcycles use Philippine expressways?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Yes, but strictly only motorcycles with an engine displacement of 400cc or higher under DOTr/LTO Department Order No. 2007-15. They pay standard Class 1 toll rates. An exception exists on CCLEX in Cebu, where motorcycles between 110cc and 399cc are legally permitted under Class 1M rates."
							}
						},
						{
							"@type": "Question",
							"name": "How much does Skyway Stage 3 cost from Buendia to Balintawak?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "For a Class 1 vehicle (car/SUV), riding the entire elevated Skyway Stage 3 from Buendia/Makati to Balintawak/NLEX costs ₱264.00. The full elevated run from Alabang South Station to Balintawak costs ₱428.00."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main class="max-w-7xl mx-auto px-6 lg:px-8 py-12 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-3xl mb-8">
			<div class="flex items-center gap-2 mb-2">
				<span class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Expressway & Toll Utility
				</span>
				<span class="font-sans text-xs text-mapa-clay">
					Official TRB Regulated Tariffs
				</span>
			</div>
			<h1 class="text-3xl sm:text-4xl font-extrabold text-mapa-green font-serif tracking-tight">
				Philippine Expressway Toll Calculator & Schematic Map
			</h1>
			<p class="font-sans text-sm sm:text-base text-mapa-ink/80 mt-2 leading-relaxed">
				Calculate official Toll Regulatory Board (TRB) entry-to-exit toll fees for Class 1, 2, and 3 vehicles across all major Philippine tollways. Features schematic corridor diagrams, RFID interoperability guides, and road kilometer tracking.
			</p>
		</div>

		<!-- 2-Column App Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			
			<!-- Left Column: Visual Highway Strip & Geographic Map (7 cols) -->
			<div class="lg:col-span-7 flex flex-col gap-6 font-sans">
				
				<!-- Plaza Click Target Selector & Journey Status Bar -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-4 shadow-xs flex flex-col gap-3">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div class="flex items-center gap-2 flex-wrap">
							<span class="text-xs font-bold uppercase tracking-wider text-mapa-clay">
								Clicking Plaza Sets:
							</span>
							<div class="inline-flex rounded-xl bg-mapa-canvas p-1 border border-mapa-contour text-xs font-bold">
								<button
									id="toll-target-entry"
									type="button"
									class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow-xs transition-all flex items-center gap-1.5 cursor-pointer ring-2 ring-emerald-500/50"
									title="Clicking any plaza will set it as your Entry plaza"
								>
									<span class="w-2 h-2 rounded-full bg-white"></span>
									<span>🟢 Entry Plaza (Start)</span>
								</button>
								<button
									id="toll-target-exit"
									type="button"
									class="px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer"
									title="Clicking any plaza will set it as your Exit plaza"
								>
									<span class="w-2 h-2 rounded-full bg-rose-500"></span>
									<span>🔴 Exit Plaza (End)</span>
								</button>
							</div>
						</div>

						<button
							id="toll-quick-swap-btn"
							type="button"
