	<!-- Interactive Schematic & Toll Calculation Engine -->
	<script is:inline define:vars={{ EXPRESSWAYS }}>
		(function () {
			// State
			let currentExpId = 'nlex';
			let currentClass = 1; // 1, 2, or 3
			let currentEntryId = 'balintawak';
			let currentExitId = 'dau';
			let currentView = 'schematic'; // 'schematic' or 'geo'

			// DOM Elements
			const expSelect = document.getElementById('expressway-select');
			const entrySelect = document.getElementById('entry-plaza-select');
			const exitSelect = document.getElementById('exit-plaza-select');
			const swapBtn = document.getElementById('swap-plazas-btn');
			const classBtns = document.querySelectorAll('.vehicle-class-btn');

			const tollFeeDisplay = document.getElementById('toll-fee-display');
			const requiredRfidTag = document.getElementById('required-rfid-tag');
			const metricDistance = document.getElementById('metric-toll-distance');
			const metricSystem = document.getElementById('metric-toll-system');
			const breakdownVehicle = document.getElementById('breakdown-vehicle');
			const breakdownOperator = document.getElementById('breakdown-operator');
			const activeCorridorTitle = document.getElementById('active-corridor-title');
			const corridorRfidBadge = document.getElementById('corridor-rfid-badge');

			const schematicView = document.getElementById('schematic-view-container');
			const schematicCanvas = document.getElementById('schematic-strip-canvas');
			const geoMapView = document.getElementById('toll-geo-map');
			const btnViewSchematic = document.getElementById('btn-view-schematic');
			const btnViewGeo = document.getElementById('btn-view-geo');

			// Leaflet Map instance
			let map = null;
			let activeGeoPolyline = null;
			let activeGeoMarkers = [];

			function getActiveExpressway() {
				return EXPRESSWAYS.find(e => e.id === currentExpId) || EXPRESSWAYS[0];
			}

			// Populate Entry and Exit dropdowns for active expressway
			function populatePlazaDropdowns() {
				const exp = getActiveExpressway();
				entrySelect.innerHTML = '';
				exitSelect.innerHTML = '';

				exp.plazas.forEach(p => {
					const opt1 = document.createElement('option');
					opt1.value = p.id;
					opt1.textContent = `${p.name} (km ${p.km.toFixed(1)})`;
					entrySelect.appendChild(opt1);

					const opt2 = document.createElement('option');
					opt2.value = p.id;
					opt2.textContent = `${p.name} (km ${p.km.toFixed(1)})`;
					exitSelect.appendChild(opt2);
				});

				// Set default entry and exit
				if (exp.plazas.length >= 2) {
					currentEntryId = exp.plazas[0].id;
					currentExitId = exp.plazas[exp.plazas.length - 2].id || exp.plazas[exp.plazas.length - 1].id;
					entrySelect.value = currentEntryId;
					exitSelect.value = currentExitId;
				}
			}

			// Render the Schematic Highway Strip
			function renderSchematicStrip() {
				const exp = getActiveExpressway();
				const entryIdx = exp.plazas.findIndex(p => p.id === currentEntryId);
				const exitIdx = exp.plazas.findIndex(p => p.id === currentExitId);
				const minIdx = Math.min(entryIdx, exitIdx);
				const maxIdx = Math.max(entryIdx, exitIdx);

				schematicCanvas.innerHTML = '';

				// Outer flex ribbon wrapper
				const stripContainer = document.createElement('div');
				stripContainer.className = 'flex items-center min-w-[700px] py-4 relative';

				// Main connecting track line
				const trackLine = document.createElement('div');
				trackLine.className = 'absolute left-6 right-6 top-1/2 -translate-y-1/2 h-2.5 bg-stone-300 rounded-full z-0';
				stripContainer.appendChild(trackLine);

				// Active highlight portion of the track line
				if (entryIdx !== -1 && exitIdx !== -1 && minIdx !== maxIdx) {
					const pctStart = (minIdx / (exp.plazas.length - 1)) * 100;
					const pctEnd = (maxIdx / (exp.plazas.length - 1)) * 100;
					const activeHighlight = document.createElement('div');
					activeHighlight.className = 'absolute top-1/2 -translate-y-1/2 h-3.5 bg-amber-500 rounded-full z-1 transition-all shadow-sm';
					activeHighlight.style.left = `calc(${pctStart}% + 12px)`;
					activeHighlight.style.width = `calc(${pctEnd - pctStart}% - 24px)`;
					stripContainer.appendChild(activeHighlight);
				}

				// Plazas nodes
				exp.plazas.forEach((plaza, idx) => {
					const isEntry = plaza.id === currentEntryId;
					const isExit = plaza.id === currentExitId;
					const isIntermediate = idx > minIdx && idx < maxIdx;

					const nodeWrapper = document.createElement('div');
					nodeWrapper.className = 'flex-1 flex flex-col items-center relative z-10 cursor-pointer group';
					nodeWrapper.title = `Click to set as Entry or Exit: ${plaza.name}`;

					// Pin icon circle
					const pin = document.createElement('div');
					if (isEntry) {
						pin.className = 'w-6 h-6 rounded-full bg-emerald-600 border-2 border-white shadow-md flex items-center justify-center text-white text-[10px] font-bold ring-4 ring-emerald-500/30';
						pin.textContent = 'A';
					} else if (isExit) {
						pin.className = 'w-6 h-6 rounded-full bg-rose-600 border-2 border-white shadow-md flex items-center justify-center text-white text-[10px] font-bold ring-4 ring-rose-500/30';
						pin.textContent = 'B';
					} else if (plaza.isBarrier) {
						pin.className = `w-4 h-4 rounded bg-amber-500 border border-white shadow-sm flex items-center justify-center text-[8px] text-white font-bold ${isIntermediate ? 'ring-2 ring-amber-400' : ''}`;
						pin.textContent = 'T';
					} else {
						pin.className = `w-3.5 h-3.5 rounded-full border-2 border-white shadow-xs transition-all ${isIntermediate ? 'bg-amber-400' : 'bg-stone-400 group-hover:scale-125'}`;
					}

					// Label above/below
					const label = document.createElement('div');
					label.className = `mt-2 text-[10px] text-center max-w-[75px] truncate font-medium transition-colors ${isEntry ? 'font-bold text-emerald-800' : isExit ? 'font-bold text-rose-800' : 'text-stone-600 group-hover:text-mapa-green'}`;
					label.textContent = plaza.name.split(' (')[0];

					const kmLabel = document.createElement('div');
					kmLabel.className = 'text-[9px] text-stone-600 font-mono';
					kmLabel.textContent = `km ${plaza.km.toFixed(0)}`;

					nodeWrapper.appendChild(pin);
					nodeWrapper.appendChild(label);
					nodeWrapper.appendChild(kmLabel);

					// Click interaction on schematic node
					nodeWrapper.addEventListener('click', () => {
						if (currentEntryId === plaza.id) {
							// If already entry, set as exit
							currentExitId = plaza.id;
							exitSelect.value = plaza.id;
						} else {
							currentExitId = plaza.id;
							exitSelect.value = plaza.id;
						}
						calculateToll();
					});

					stripContainer.appendChild(nodeWrapper);
				});

				schematicCanvas.appendChild(stripContainer);
			}

			// Render Geographic Leaflet Map
			function initOrUpdateGeoMap() {
				if (!map) {
					map = L.map('toll-geo-map', {
						center: [14.65, 121.0],
						zoom: 10,
						zoomControl: true,
						scrollWheelZoom: true
					});

					L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
						attribution: '&copy; OpenStreetMap &copy; CARTO',
						maxZoom: 19
					}).addTo(map);
				}

				const exp = getActiveExpressway();

				// Clear existing markers & polyline
				if (activeGeoPolyline) {
					map.removeLayer(activeGeoPolyline);
					activeGeoPolyline = null;
				}
				activeGeoMarkers.forEach(m => map.removeLayer(m));
				activeGeoMarkers = [];

				const coords = exp.plazas.map(p => [p.lat, p.lon]);

				activeGeoPolyline = L.polyline(coords, {
					color: exp.color,
					weight: 5,
					opacity: 0.85
				}).addTo(map);

				exp.plazas.forEach(p => {
					const isEntry = p.id === currentEntryId;
					const isExit = p.id === currentExitId;

					const m = L.circleMarker([p.lat, p.lon], {
						radius: isEntry || isExit ? 7 : 4,
						fillColor: isEntry ? '#059669' : isExit ? '#E11D48' : p.isBarrier ? '#F59E0B' : '#FFFFFF',
						color: exp.color,
						weight: 2,
						opacity: 1,
						fillOpacity: 1
					}).addTo(map);

					m.bindTooltip(`<strong>${p.name}</strong><br><span style="font-size:10px;">km ${p.km.toFixed(1)} &bull; ${exp.name}</span>`);

					m.on('click', () => {
						currentExitId = p.id;
						exitSelect.value = p.id;
						calculateToll();
					});

					activeGeoMarkers.push(m);
				});

				map.fitBounds(activeGeoPolyline.getBounds(), { padding: [30, 30] });
			}

			// Calculate Toll Fee
			function calculateToll() {
				const exp = getActiveExpressway();
				const entry = exp.plazas.find(p => p.id === currentEntryId) || exp.plazas[0];
				const exit = exp.plazas.find(p => p.id === currentExitId) || exp.plazas[exp.plazas.length - 1];

				const distKm = Math.abs(exit.km - entry.km);

				// Compute Fee
				let fee = 0;
				if (entry.id === exit.id) {
					fee = 0;
				} else if (exp.id === 'cclex') {
					// Flat toll
					fee = currentClass === 1 ? 90 : currentClass === 2 ? 180 : 270;
				} else {
					// Distance-based with open barrier components
					// We use exit plaza tariff as standard TRB closed system table
					const tariffKey = `c${currentClass}`;
					const maxTariff = Math.max(entry[tariffKey], exit[tariffKey]);
					const minTariff = Math.min(entry[tariffKey], exit[tariffKey]);

					if (minTariff === 0) {
						fee = maxTariff;
					} else {
						// Differential
						fee = Math.abs(maxTariff - minTariff);
						// Minimum base toll threshold
						if (fee < 15 && distKm > 0) fee = 15;
					}
				}

				// Update UI
				tollFeeDisplay.textContent = `₱${fee.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				requiredRfidTag.textContent = exp.rfid;
				requiredRfidTag.className = `inline-block mt-0.5 px-2.5 py-1 rounded-md text-xs font-bold ${exp.rfidColor} shadow-xs`;

				metricDistance.textContent = `${distKm.toFixed(1)} km`;
				metricSystem.textContent = exp.system.split(' ')[0];

				const classLabel = currentClass === 1 ? 'Class 1 (Cars, SUVs, 400cc+)' : currentClass === 2 ? 'Class 2 (Buses, 2-Axle Trucks)' : 'Class 3 (Heavy 3+ Axle Trucks)';
				breakdownVehicle.textContent = classLabel;
				breakdownOperator.textContent = exp.operator.split(' (')[0];

				activeCorridorTitle.textContent = `${exp.name} Visualizer`;
				corridorRfidBadge.textContent = exp.rfid;
				corridorRfidBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold ${exp.rfidColor}`;

				renderSchematicStrip();

				if (currentView === 'geo' && map) {
					initOrUpdateGeoMap();
				}
			}

			// View Toggle (Schematic Strip vs Geo Map)
			btnViewSchematic.addEventListener('click', () => {
				currentView = 'schematic';
				schematicView.classList.remove('hidden');
				geoMapView.classList.add('hidden');

				btnViewSchematic.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold transition-all bg-mapa-canvas text-mapa-green shadow-xs';
				btnViewGeo.className = 'px-2.5 py-1 rounded-md text-[11px] font-medium text-mapa-ink/60 hover:text-mapa-ink transition-all';
			});

			btnViewGeo.addEventListener('click', () => {
				currentView = 'geo';
				schematicView.classList.add('hidden');
				geoMapView.classList.remove('hidden');

				btnViewGeo.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold transition-all bg-mapa-canvas text-mapa-green shadow-xs';
				btnViewSchematic.className = 'px-2.5 py-1 rounded-md text-[11px] font-medium text-mapa-ink/60 hover:text-mapa-ink transition-all';

				setTimeout(() => {
					initOrUpdateGeoMap();
					map.invalidateSize();
				}, 100);
			});

			// Event Listeners
			expSelect.addEventListener('change', () => {
				currentExpId = expSelect.value;
				populatePlazaDropdowns();
				calculateToll();
			});

			entrySelect.addEventListener('change', () => {
				currentEntryId = entrySelect.value;
				calculateToll();
			});

			exitSelect.addEventListener('change', () => {
				currentExitId = exitSelect.value;
				calculateToll();
			});

			swapBtn.addEventListener('click', () => {
				const temp = currentEntryId;
				currentEntryId = currentExitId;
				currentExitId = temp;
				entrySelect.value = currentEntryId;
				exitSelect.value = currentExitId;
				calculateToll();
			});

			// Vehicle Class selection
			classBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					currentClass = parseInt(btn.getAttribute('data-class'), 10) || 1;
					classBtns.forEach(b => {
						b.className = 'vehicle-class-btn p-2.5 rounded-xl border transition-all text-center bg-mapa-canvas border-mapa-contour text-mapa-ink/70 hover:border-mapa-green/50';
					});
					btn.className = 'vehicle-class-btn p-2.5 rounded-xl border transition-all text-center bg-mapa-canvas border-mapa-green text-mapa-green shadow-xs font-bold';
					calculateToll();
				});
			});

			// Preset Trip Buttons
			document.querySelectorAll('.preset-trip-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const expId = btn.getAttribute('data-exp');
					const orig = btn.getAttribute('data-orig');
					const dest = btn.getAttribute('data-dest');

					if (expId && orig && dest) {
						currentExpId = expId;
						expSelect.value = expId;
						populatePlazaDropdowns();

						currentEntryId = orig;
						currentExitId = dest;
						entrySelect.value = orig;
						exitSelect.value = dest;

						calculateToll();
					}
				});
			});

			// Initialize
			populatePlazaDropdowns();
			calculateToll();
		})();
	</script>
</BaseLayout>
