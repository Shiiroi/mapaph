---
/**
 * @file rail-schedule.astro
 * @description Metro Manila Rail Schedule, Headway Arrival Estimator, and Station-by-Station First/Last Train Finder.
 * Covers MRT-3, LRT-1 (Cavite Extension), and LRT-2 with Manila Time (UTC+8) calculations.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
	RAIL_LINES,
	STATIONS_DATA,
	SCHEDULE_SPECS,
	buildLineTimetable,
	formatMinutesTo12H
} from '../../data/rail-lines';

const mrt3Timetable = buildLineTimetable('mrt3');
const lrt1Timetable = buildLineTimetable('lrt1');
const lrt2Timetable = buildLineTimetable('lrt2');

const clientPayload = {
	lines: RAIL_LINES,
	stations: STATIONS_DATA,
	specs: SCHEDULE_SPECS
};
---

<BaseLayout
	title="2026 MRT & LRT Schedule: First/Last Train & Arrival Estimator | mapaPH"
	description="Check station-by-station First & Last Train times, estimated arrival headways, gate cutoff alerts, and live Manila Time status for MRT-3, LRT-1 (Dr. Santos), and LRT-2."
	keywords="MRT last train schedule 2026, LRT-1 first train schedule, LRT-2 operating hours, MRT train arrival time estimator, North Ave last train, Taft Avenue last train, Dr. Santos LRT-1 schedule, MRT headway frequency, Metro Manila train schedule"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Metro Manila Rail Schedule & Arrival Estimator (MRT-3, LRT-1, LRT-2)",
					"url": "https://www.mapaph.com/tools/rail-schedule",
					"applicationCategory": "TravelApplication",
					"operatingSystem": "Web Browser",
					"description": "Interactive station-by-station First and Last Train calculator, headway arrival countdown, and transfer cutoff checker for MRT-3, LRT-1, and LRT-2 in Philippine Standard Time.",
					"featureList": [
						"Station-specific First and Last Train passing estimates across 51 stations",
						"Weekday vs Weekend/Holiday dispatch comparison including MRT-3 extended evening hours",
						"Scheduled headway wait-time indicator in Asia/Manila UTC+8",
						"5-minute ticket booth and turnstile gate cutoff warnings",
						"Cross-line interchange closure alerts at Cubao, EDSA-Taft, and Doroteo Jose-Recto"
					],
					"author": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://www.mapaph.com"
					}
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": "https://www.mapaph.com/"
						},
						{
							"@type": "ListItem",
							"position": 2,
							"name": "Tools",
							"item": "https://www.mapaph.com/tools"
						},
						{
							"@type": "ListItem",
							"position": 3,
							"name": "Rail Schedule & Arrival Estimator",
							"item": "https://www.mapaph.com/tools/rail-schedule"
						}
					]
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "What time is the last train on MRT-3 on weekdays vs weekends?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Under DOTr MRT-3's extended weekday schedule (Monday to Friday), the last southbound train departs North Avenue at 10:30 PM and the last northbound train departs Taft Avenue at 11:09 PM. On Saturdays, Sundays, and holidays, the last trains revert to 9:30 PM from North Avenue and 10:09 PM from Taft Avenue. Ticket booths close 5 minutes prior."
							}
						},
						{
							"@type": "Question",
							"name": "What are the LRT-1 first and last train hours to Dr. Santos?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "On weekdays, LRT-1 starts at 4:30 AM from both Fernando Poe Jr. (FPJ) and Dr. Santos stations. The last weekday train departs Dr. Santos (northbound) at 10:30 PM and FPJ (southbound) at 10:45 PM. On weekends and holidays, first trips start at 5:00 AM and last trains depart at 9:30 PM (Dr. Santos) and 9:45 PM (FPJ)."
							}
						},
						{
							"@type": "Question",
							"name": "Is there an official live GPS train arrival API in the Philippines?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "No. Neither DOTr MRT-3, LRMC (LRT-1), nor LRTA (LRT-2) publishes a public GTFS-Realtime feed or live track signaling API. Independent trackers use published headway intervals, timetable cadence simulations, or crowdsourced commuter reports to estimate train positions."
							}
						},
						{
							"@type": "Question",
							"name": "What time do LRT-2 trains stop running?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "LRT-2 opens gates at 4:50 AM with first departures at 5:00 AM daily from Recto and Antipolo. On weekdays, the last train leaves Antipolo at 9:00 PM and Recto at 9:30 PM. On weekends and holidays, the last trips generally wrap up by 9:00 PM from both terminals."
							}
						},
						{
							"@type": "Question",
							"name": "Do station entrance gates close before the last train departs?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Yes. Across LRT-1, LRT-2, and MRT-3, ticket vending windows and security turnstiles generally close 3 to 5 minutes before the scheduled arrival of the last revenue train so passengers can safely clear the platforms."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main id="main-content" class="max-w-7xl mx-auto px-6 lg:px-8 py-12 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-3xl mb-8">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-mapa-muted mb-3">
				<a href="/" class="hover:text-mapa-green transition-colors">Home</a>
				<span>/</span>
				<a href="/tools" class="hover:text-mapa-green transition-colors">Tools</a>
				<span>/</span>
				<a href="/tools/rail-transit" class="hover:text-mapa-green transition-colors">Rail Transit</a>
				<span>/</span>
				<span class="text-mapa-ink font-semibold">Schedule & Arrival Estimator</span>
			</nav>
			<div class="flex flex-wrap items-center gap-2 mb-2">
				<span class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Transit Operations & Timetables
				</span>
				<span class="font-sans text-xs text-mapa-muted">
					Manila Time (UTC+8) &bull; 51 Stations
				</span>
			</div>
			<h1 class="text-3xl sm:text-4xl font-extrabold text-mapa-green font-serif tracking-tight">
				MRT &amp; LRT Train Schedule, Headway &amp; Last-Train Estimator
			</h1>
			<p class="font-sans text-sm sm:text-base text-mapa-ink/80 mt-2 leading-relaxed">
				Check when the first and last trains pass your exact station along MRT-3, LRT-1 (FPJ to Dr. Santos), and LRT-2 (Recto to Antipolo). Includes live Philippine Standard Time dispatch status, headway wait estimates, gate cutoff buffers, and transfer closing warnings.
			</p>
		</div>

		<!-- Interactive Estimator Console -->
		<section aria-label="Live Schedule and Last Train Calculator" class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-5 sm:p-7 shadow-xs font-sans mb-10">
			<!-- Top Controls Row: Clock & Day Mode -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-mapa-contour/60">
				<div class="flex flex-wrap items-center gap-3">
					<div class="px-3.5 py-2 rounded-xl bg-mapa-canvas border border-mapa-contour flex items-center gap-2.5">
						<span id="live-clock-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
						<div>
							<span class="block text-[10px] font-bold uppercase tracking-wider text-mapa-muted">Manila Time (UTC+8)</span>
							<span id="manila-clock-display" class="text-sm font-bold text-mapa-ink tabular-nums">--:--:-- --</span>
						</div>
					</div>

					<div class="flex items-center gap-1.5 bg-mapa-canvas border border-mapa-contour rounded-xl p-1">
						<button type="button" id="day-weekday-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-mapa-green text-white">
							Weekday (Mon-Fri)
						</button>
						<button type="button" id="day-weekend-btn" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-mapa-ink/75 hover:bg-mapa-canvas-dark transition-colors">
							Weekend / Holiday
						</button>
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-2">
					<button type="button" id="mode-live-btn" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-mapa-green bg-mapa-green/10 text-mapa-green transition-colors">
						Use Current Time
					</button>
					<div class="flex items-center gap-1.5 bg-mapa-canvas border border-mapa-contour rounded-lg px-2.5 py-1">
						<label for="sim-time-input" class="text-[11px] font-semibold text-mapa-muted">Test Time:</label>
						<input id="sim-time-input" type="time" class="text-xs font-bold text-mapa-ink bg-transparent focus:outline-none cursor-pointer" />
					</div>
				</div>
			</div>

			<!-- Line & Station Picker Row -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 py-5 border-b border-mapa-contour/60 items-end">
				<div class="lg:col-span-5">
					<span class="block text-xs font-bold uppercase tracking-wider text-mapa-muted mb-2">1. Select Rail Line</span>
					<div class="grid grid-cols-3 gap-2">
						<button type="button" data-line-tab="mrt3" class="line-tab px-3 py-2.5 rounded-xl border text-xs font-bold transition-all bg-[#0055A5] text-white border-[#0055A5] shadow-xs">
							MRT-3 (Blue)
						</button>
						<button type="button" data-line-tab="lrt1" class="line-tab px-3 py-2.5 rounded-xl border text-xs font-bold transition-all bg-mapa-canvas text-mapa-ink/80 border-mapa-contour hover:border-mapa-green">
							LRT-1 (Green)
						</button>
						<button type="button" data-line-tab="lrt2" class="line-tab px-3 py-2.5 rounded-xl border text-xs font-bold transition-all bg-mapa-canvas text-mapa-ink/80 border-mapa-contour hover:border-mapa-rust">
							LRT-2 (Purple)
						</button>
					</div>
				</div>

				<div class="lg:col-span-4">
					<label for="station-select" class="block text-xs font-bold uppercase tracking-wider text-mapa-muted mb-2">2. Choose Your Station</label>
					<select id="station-select" class="w-full px-3.5 py-2.5 rounded-xl bg-mapa-canvas border border-mapa-contour text-sm font-semibold text-mapa-ink focus:outline-none focus:border-mapa-green">
						<!-- Populated via script -->
					</select>
				</div>

				<div class="lg:col-span-3">
					<span class="block text-xs font-bold uppercase tracking-wider text-mapa-muted mb-2">Quick Hubs</span>
					<div class="flex flex-wrap gap-1.5">
						<button type="button" class="quick-station-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-mapa-canvas border border-mapa-contour hover:border-mapa-navy text-mapa-ink/80 transition-colors" data-line="mrt3" data-station="mrt3_ayala">Ayala</button>
						<button type="button" class="quick-station-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-mapa-canvas border border-mapa-contour hover:border-mapa-navy text-mapa-ink/80 transition-colors" data-line="mrt3" data-station="mrt3_cubao">Cubao</button>
						<button type="button" class="quick-station-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-mapa-canvas border border-mapa-contour hover:border-mapa-green text-mapa-ink/80 transition-colors" data-line="lrt1" data-station="lrt1_edsa">EDSA-Taft</button>
						<button type="button" class="quick-station-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-mapa-canvas border border-mapa-contour hover:border-mapa-green text-mapa-ink/80 transition-colors" data-line="lrt1" data-station="lrt1_dr_santos">Dr. Santos</button>
						<button type="button" class="quick-station-btn px-2.5 py-1.5 rounded-lg text-[11px] font-semibold bg-mapa-canvas border border-mapa-contour hover:border-mapa-rust text-mapa-ink/80 transition-colors" data-line="lrt2" data-station="lrt2_katipunan">Katipunan</button>
					</div>
				</div>
			</div>

			<!-- Live Output Summary Banner -->
			<div id="station-banner" class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
				<div>
					<div class="flex flex-wrap items-center gap-2">
						<h2 id="selected-station-heading" class="font-serif text-xl sm:text-2xl font-bold text-mapa-ink">
							MRT-3: Ayala Station
						</h2>
						<span id="service-phase-badge" class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 border border-emerald-500/30">
							Checking Status...
						</span>
					</div>
					<p id="selected-station-meta" class="text-xs text-mapa-muted mt-0.5">
						Makati City &bull; KM 13.4 along line alignment
					</p>
				</div>
				<div class="text-xs text-mapa-ink/75 bg-mapa-canvas border border-mapa-contour/70 px-3 py-2 rounded-xl">
					<strong class="text-mapa-ink">Transparency Note:</strong> Estimates use published dispatch intervals (not train GPS). Verify live alerts at <a id="advisory-portal-link" href="https://dotrmrt3.gov.ph/" target="_blank" rel="noopener noreferrer" class="text-mapa-green font-bold hover:underline">DOTr MRT-3 Service Portal</a>.
				</div>
			</div>

			<!-- Direction Cards (Both Directions) -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
				<!-- Forward Direction Card -->
				<div id="dir-fwd-card" class="bg-mapa-canvas border border-mapa-contour rounded-2xl p-5 flex flex-col justify-between gap-4">
					<div>
						<div class="flex items-start justify-between gap-2 mb-3">
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Platform Direction A</span>
								<h3 id="fwd-dir-title" class="font-serif text-lg font-bold text-mapa-ink">Southbound (to Taft Ave)</h3>
							</div>
							<span id="fwd-status-pill" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-700">
								Open
							</span>
						</div>

						<div class="grid grid-cols-2 gap-3 mb-4">
							<div class="p-3 rounded-xl bg-mapa-canvas-dark border border-mapa-contour/60">
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Scheduled Headway</span>
								<span id="fwd-headway" class="text-lg font-extrabold text-mapa-green mt-0.5 block">~3.5-4.5 min</span>
								<span id="fwd-next-est" class="text-[11px] text-mapa-ink/75 block mt-0.5">Next cadence: ~2 min</span>
							</div>
							<div class="p-3 rounded-xl bg-mapa-canvas-dark border border-mapa-contour/60">
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Last Train Remaining</span>
								<span id="fwd-countdown" class="text-lg font-extrabold text-mapa-ink mt-0.5 block tabular-nums">--h --m</span>
								<span id="fwd-cutoff-note" class="text-[11px] text-mapa-ink/75 block mt-0.5">Gate cutoff: --:-- PM</span>
							</div>
						</div>

						<div class="space-y-1.5 text-xs border-t border-mapa-contour/50 pt-3">
							<div class="flex justify-between">
								<span class="text-mapa-muted">First train passes this station:</span>
								<span id="fwd-first-time" class="font-bold text-mapa-ink">--:-- AM</span>
							</div>
							<div class="flex justify-between">
								<span class="text-mapa-muted">Last train passes this station:</span>
								<span id="fwd-last-time" class="font-bold text-mapa-rust">--:-- PM</span>
							</div>
							<div class="flex justify-between">
								<span class="text-mapa-muted">Origin terminal dispatch window:</span>
								<span id="fwd-terminal-span" class="font-medium text-mapa-ink/80">--:-- AM - --:-- PM</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Reverse Direction Card -->
				<div id="dir-rev-card" class="bg-mapa-canvas border border-mapa-contour rounded-2xl p-5 flex flex-col justify-between gap-4">
					<div>
						<div class="flex items-start justify-between gap-2 mb-3">
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Platform Direction B</span>
								<h3 id="rev-dir-title" class="font-serif text-lg font-bold text-mapa-ink">Northbound (to North Ave)</h3>
							</div>
							<span id="rev-status-pill" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-700">
								Open
							</span>
						</div>

						<div class="grid grid-cols-2 gap-3 mb-4">
							<div class="p-3 rounded-xl bg-mapa-canvas-dark border border-mapa-contour/60">
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Scheduled Headway</span>
								<span id="rev-headway" class="text-lg font-extrabold text-mapa-green mt-0.5 block">~3.5-4.5 min</span>
								<span id="rev-next-est" class="text-[11px] text-mapa-ink/75 block mt-0.5">Next cadence: ~3 min</span>
							</div>
							<div class="p-3 rounded-xl bg-mapa-canvas-dark border border-mapa-contour/60">
								<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted block">Last Train Remaining</span>
								<span id="rev-countdown" class="text-lg font-extrabold text-mapa-ink mt-0.5 block tabular-nums">--h --m</span>
								<span id="rev-cutoff-note" class="text-[11px] text-mapa-ink/75 block mt-0.5">Gate cutoff: --:-- PM</span>
							</div>
						</div>

						<div class="space-y-1.5 text-xs border-t border-mapa-contour/50 pt-3">
							<div class="flex justify-between">
								<span class="text-mapa-muted">First train passes this station:</span>
								<span id="rev-first-time" class="font-bold text-mapa-ink">--:-- AM</span>
							</div>
							<div class="flex justify-between">
								<span class="text-mapa-muted">Last train passes this station:</span>
								<span id="rev-last-time" class="font-bold text-mapa-rust">--:-- PM</span>
							</div>
							<div class="flex justify-between">
								<span class="text-mapa-muted">Origin terminal dispatch window:</span>
								<span id="rev-terminal-span" class="font-medium text-mapa-ink/80">--:-- AM - --:-- PM</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Simulated Schedule Cadence Strip -->
			<div class="mt-5 p-4 rounded-xl bg-mapa-canvas border border-mapa-contour">
				<div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
					<span class="text-xs font-bold text-mapa-ink">Simulated Line Cadence (Schedule Model, Non-GPS)</span>
					<span id="line-spec-note" class="text-[11px] text-mapa-muted"></span>
				</div>
				<div id="cadence-track" class="relative w-full py-3 px-2 overflow-x-auto">
					<!-- Rendered by JS -->
				</div>
			</div>

			<!-- Dynamic Transfer / Late-Night Fallback Alert -->
			<div id="transfer-warning-box" class="hidden mt-4 p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-mapa-ink leading-relaxed">
			</div>

			<!-- Related Transit Cross-Links -->
			<div class="mt-5 pt-4 border-t border-mapa-contour/60 flex flex-wrap items-center justify-between gap-3 text-xs">
				<div class="flex flex-wrap items-center gap-2">
					<span class="font-bold text-mapa-muted">Need fares or 24/7 bus options?</span>
					<a href="/tools/rail-transit" class="px-3 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green text-mapa-green font-bold transition-colors">
						Calculate Beep &amp; SJT Fares &rarr;
					</a>
					<a href="/tools/edsa-carousel" class="px-3 py-1.5 rounded-lg bg-mapa-canvas border border-mapa-contour hover:border-mapa-green text-mapa-ink font-semibold transition-colors">
						24/7 EDSA Carousel Busway (After Last Train) &rarr;
					</a>
				</div>
			</div>
		</section>

		<!-- SSR Station-by-Station Timetable Reference Tables -->
		<section aria-label="Full Station Timetable Directory" class="mb-14 font-sans">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-5 border-b border-mapa-contour/60 pb-4">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-mapa-green block mb-1">2026 Static Timetable Matrix</span>
					<h2 class="font-serif text-2xl sm:text-3xl font-bold text-mapa-ink tracking-tight">
						Complete Station-by-Station First &amp; Last Train Tables
					</h2>
					<p class="text-xs sm:text-sm text-mapa-ink/75 mt-1">
						Estimated passing windows calculated from published terminal dispatches plus segment run times and dwell offsets. Gates typically close 5 minutes prior.
					</p>
				</div>
				<div class="flex items-center gap-1.5 bg-mapa-canvas-dark p-1 rounded-xl border border-mapa-contour self-start">
					<button type="button" data-table-tab="mrt3" class="table-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-[#0055A5] text-white transition-colors">MRT-3</button>
					<button type="button" data-table-tab="lrt1" class="table-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-mapa-ink/80 hover:bg-mapa-canvas transition-colors">LRT-1</button>
					<button type="button" data-table-tab="lrt2" class="table-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-mapa-ink/80 hover:bg-mapa-canvas transition-colors">LRT-2</button>
				</div>
			</div>

			<!-- MRT-3 Timetable -->
			<div id="table-panel-mrt3" class="table-panel overflow-x-auto bg-mapa-canvas-dark border border-mapa-contour rounded-2xl">
				<table class="w-full text-left border-collapse text-xs">
					<thead>
						<tr class="border-b border-mapa-contour bg-mapa-canvas text-mapa-ink">
							<th class="p-3 font-bold">MRT-3 Station</th>
							<th class="p-3 font-bold">City / KM</th>
							<th class="p-3 font-bold">Southbound (to Taft) Weekday</th>
							<th class="p-3 font-bold">Northbound (to North Ave) Weekday</th>
