	<script is:inline define:vars={{ clientPayload }}>
		(function () {
			const { lines, stations, specs } = clientPayload;
			let activeLine = 'mrt3';
			let activeStationId = 'mrt3_ayala';
			let isWeekdayMode = true;
			let useLiveClock = true;

			const lineTabs = document.querySelectorAll('.line-tab');
			const tableTabs = document.querySelectorAll('.table-tab-btn');
			const tablePanels = document.querySelectorAll('.table-panel');
			const stationSelect = document.getElementById('station-select');
			const quickButtons = document.querySelectorAll('.quick-station-btn');
			const dayWeekdayBtn = document.getElementById('day-weekday-btn');
			const dayWeekendBtn = document.getElementById('day-weekend-btn');
			const modeLiveBtn = document.getElementById('mode-live-btn');
			const simTimeInput = document.getElementById('sim-time-input');
			const clockDisplay = document.getElementById('manila-clock-display');
			const clockDot = document.getElementById('live-clock-dot');

			function getManilaNowParts() {
				const now = new Date();
				const formatter = new Intl.DateTimeFormat('en-US', {
					timeZone: 'Asia/Manila',
					hour12: false,
					weekday: 'short',
					hour: '2-digit',
					minute: '2-digit',
					second: '2-digit'
				});
				const parts = formatter.formatToParts(now);
				const map = {};
				parts.forEach((p) => {
					map[p.type] = p.value;
				});
				const h = Number(map.hour === '24' ? '0' : map.hour);
				const m = Number(map.minute);
				const s = Number(map.second);
				const isWeekend = map.weekday === 'Sat' || map.weekday === 'Sun';
				return { h, m, s, isWeekend, totalMinutes: h * 60 + m + s / 60 };
			}

			// Auto-initialize weekday toggle from current Manila day
			const initParts = getManilaNowParts();
			isWeekdayMode = !initParts.isWeekend;

			function format12H(totalMin) {
				const wrapped = ((Math.round(totalMin) % 1440) + 1440) % 1440;
				const h24 = Math.floor(wrapped / 60);
				const mins = wrapped % 60;
				const period = h24 >= 12 ? 'PM' : 'AM';
				const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
				return `${h12}:${String(mins).padStart(2, '0')} ${period}`;
			}

			function formatDuration(diffMin) {
				const rounded = Math.max(0, Math.round(diffMin));
				const hrs = Math.floor(rounded / 60);
				const mins = rounded % 60;
				if (hrs === 0) return `${mins}m`;
				return `${hrs}h ${mins}m`;
			}

			function getOffsetMinutes(lineKey, stationIndex) {
				const spec = specs[lineKey];
				const lineStations = stations[lineKey];
				const st = lineStations[stationIndex];
				const maxIdx = lineStations.length - 1;
				const offsetFwd = Math.round(st.km * spec.minPerKm + stationIndex * spec.dwellMinPerStop);
				const distRev = Math.max(0, spec.totalKm - st.km);
				const offsetRev = Math.round(distRev * spec.minPerKm + (maxIdx - stationIndex) * spec.dwellMinPerStop);
				return { offsetFwd, offsetRev };
			}

			function getCurrentHeadway(spec, currentMin) {
				if (!isWeekdayMode) {
					return { range: spec.weekendHeadwayMin, avg: (spec.weekendHeadwayMin[0] + spec.weekendHeadwayMin[1]) / 2, phase: 'Weekend / Holiday Cadence' };
				}
				const inMorningPeak = currentMin >= spec.peakMorningStartMin && currentMin <= spec.peakMorningEndMin;
				const inEveningPeak = currentMin >= spec.peakEveningStartMin && currentMin <= spec.peakEveningEndMin;
				if (inMorningPeak || inEveningPeak) {
					return { range: spec.peakHeadwayMin, avg: (spec.peakHeadwayMin[0] + spec.peakHeadwayMin[1]) / 2, phase: 'Rush Hour Peak' };
				}
				if (currentMin >= 20 * 60 + 30 || currentMin < 5 * 60 + 30) {
					return { range: spec.lateNightHeadwayMin, avg: (spec.lateNightHeadwayMin[0] + spec.lateNightHeadwayMin[1]) / 2, phase: 'Late / Early Window' };
				}
				return { range: spec.offPeakHeadwayMin, avg: (spec.offPeakHeadwayMin[0] + spec.offPeakHeadwayMin[1]) / 2, phase: 'Off-Peak Standard' };
			}

			function updateDayButtonsUI() {
				if (isWeekdayMode) {
					dayWeekdayBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-mapa-green text-white';
					dayWeekendBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold text-mapa-ink/75 hover:bg-mapa-canvas-dark transition-colors';
				} else {
					dayWeekendBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-mapa-green text-white';
					dayWeekdayBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold text-mapa-ink/75 hover:bg-mapa-canvas-dark transition-colors';
				}
			}

			function updateLineTabsUI() {
				const colorMap = {
					mrt3: 'bg-[#0055A5] text-white border-[#0055A5] shadow-xs',
					lrt1: 'bg-[#00843D] text-white border-[#00843D] shadow-xs',
					lrt2: 'bg-[#6F2C91] text-white border-[#6F2C91] shadow-xs'
				};
				lineTabs.forEach((btn) => {
					const key = btn.getAttribute('data-line-tab');
					if (key === activeLine) {
						btn.className = `line-tab px-3 py-2.5 rounded-xl border text-xs font-bold transition-all ${colorMap[key]}`;
					} else {
						btn.className = 'line-tab px-3 py-2.5 rounded-xl border text-xs font-bold transition-all bg-mapa-canvas text-mapa-ink/80 border-mapa-contour hover:border-mapa-green';
					}
				});
			}

			function populateStationSelect() {
				const list = stations[activeLine];
				stationSelect.innerHTML = '';
				list.forEach((st) => {
					const opt = document.createElement('option');
					opt.value = st.id;
					opt.textContent = st.isTransfer ? `${st.name} (Transfer)` : st.name;
					stationSelect.appendChild(opt);
				});
				if (!list.some((s) => s.id === activeStationId)) {
					activeStationId = list[Math.floor(list.length / 2)].id;
				}
				stationSelect.value = activeStationId;
			}

			function renderDirectionCard(prefix, dirSpec, offsetMin, currentMin, headwayInfo, gateCutoffBuffer) {
				const firstTermMin = isWeekdayMode ? dirSpec.weekdayFirstMin : dirSpec.weekendFirstMin;
				const lastTermMin = isWeekdayMode ? dirSpec.weekdayLastMin : dirSpec.weekendLastMin;
				const firstPassMin = firstTermMin + offsetMin;
				const lastPassMin = lastTermMin + offsetMin;
				const cutoffMin = lastPassMin - gateCutoffBuffer;

				document.getElementById(`${prefix}-dir-title`).textContent = dirSpec.label;
				document.getElementById(`${prefix}-first-time`).textContent = format12H(firstPassMin);
				document.getElementById(`${prefix}-last-time`).textContent = format12H(lastPassMin);
				document.getElementById(`${prefix}-terminal-span`).textContent = `${format12H(firstTermMin)} - ${format12H(lastTermMin)}`;
				document.getElementById(`${prefix}-cutoff-note`).textContent = `Gate cutoff: ${format12H(cutoffMin)}`;

				const statusPill = document.getElementById(`${prefix}-status-pill`);
				const headwayEl = document.getElementById(`${prefix}-headway`);
				const nextEstEl = document.getElementById(`${prefix}-next-est`);
				const countdownEl = document.getElementById(`${prefix}-countdown`);

				const isRunning = currentMin >= firstPassMin && currentMin <= lastPassMin;
				const minsUntilLast = lastPassMin - currentMin;
				const minsUntilFirst = currentMin < firstPassMin ? firstPassMin - currentMin : 1440 - currentMin + firstPassMin;

				if (!isRunning) {
					statusPill.textContent = 'Closed';
					statusPill.className = 'text-[11px] font-bold px-2.5 py-1 rounded-lg bg-rose-500/15 text-rose-700';
					headwayEl.textContent = 'No Trains';
					headwayEl.className = 'text-lg font-extrabold text-mapa-muted mt-0.5 block';
					nextEstEl.textContent = `First train in ${formatDuration(minsUntilFirst)}`;
					countdownEl.textContent = 'Service Ended';
					countdownEl.className = 'text-base font-extrabold text-rose-700 mt-0.5 block';
				} else if (minsUntilLast <= 30) {
					statusPill.textContent = minsUntilLast <= gateCutoffBuffer ? 'Gates Closing' : 'Final 30m';
					statusPill.className = 'text-[11px] font-bold px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-800';
					headwayEl.textContent = `~${headwayInfo.range[0]}-${headwayInfo.range[1]} min`;
					headwayEl.className = 'text-lg font-extrabold text-amber-700 mt-0.5 block';
					const cyclePos = (currentMin - firstPassMin) % headwayInfo.avg;
					const estWait = Math.max(0.5, Math.min(minsUntilLast, headwayInfo.avg - cyclePos));
					nextEstEl.textContent = `Next cadence: ~${Math.ceil(estWait)} min`;
					countdownEl.textContent = formatDuration(minsUntilLast);
					countdownEl.className = 'text-lg font-extrabold text-amber-700 mt-0.5 block tabular-nums';
				} else {
					statusPill.textContent = 'Active';
					statusPill.className = 'text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-700';
					headwayEl.textContent = `~${headwayInfo.range[0]}-${headwayInfo.range[1]} min`;
					headwayEl.className = 'text-lg font-extrabold text-mapa-green mt-0.5 block';
					const cyclePos = (currentMin - firstPassMin) % headwayInfo.avg;
					const estWait = Math.max(1, headwayInfo.avg - cyclePos);
					nextEstEl.textContent = `Next cadence: ~${Math.ceil(estWait)} min`;
					countdownEl.textContent = formatDuration(minsUntilLast);
					countdownEl.className = 'text-lg font-extrabold text-mapa-ink mt-0.5 block tabular-nums';
				}
			}

			function renderCadenceStrip(lineStations, spec, activeIdx, currentMin, headwayInfo) {
				const container = document.getElementById('cadence-track');
				const lineColor = activeLine === 'lrt1' ? '#00843D' : activeLine === 'lrt2' ? '#6F2C91' : '#0055A5';
				const startMin = isWeekdayMode ? spec.forward.weekdayFirstMin : spec.forward.weekendFirstMin;
				const endMin = isWeekdayMode ? spec.forward.weekdayLastMin : spec.forward.weekendLastMin;
				const totalRun = Math.round(spec.totalKm * spec.minPerKm + (lineStations.length - 1) * spec.dwellMinPerStop);
				const serviceOpen = currentMin >= startMin && currentMin <= endMin + totalRun;

				let html = '<div class="min-w-[640px] relative pt-5 pb-7 px-3">';
				html += `<div class="h-1.5 rounded-full w-full relative" style="background:${lineColor}30;">`;
				if (serviceOpen) {
					const numTrains = Math.max(2, Math.floor(totalRun / headwayInfo.avg));
					for (let t = 0; t < numTrains; t++) {
						const frac = (((currentMin * 60) / (headwayInfo.avg * 60) + t) % numTrains) / numTrains;
						const pct = (frac * 96 + 2).toFixed(1);
						html += `<span class="absolute -top-1 w-3.5 h-3.5 rounded-full border-2 border-white shadow-xs transition-all duration-500" style="left:${pct}%;background:${lineColor};" title="Simulated scheduled trainsets"></span>`;
					}
				}
				html += '</div>';
				html += '<div class="flex justify-between mt-2">';
				lineStations.forEach((st, idx) => {
					const isSelected = idx === activeIdx;
					const showLabel = isSelected || idx === 0 || idx === lineStations.length - 1 || idx % 3 === 0;
					html += `<button type="button" data-strip-station="${st.id}" class="flex flex-col items-center group cursor-pointer" style="width:${100 / lineStations.length}%;">`;
					html += `<span class="w-2.5 h-2.5 -mt-[19px] rounded-full border-2 transition-transform ${isSelected ? 'scale-125 bg-mapa-rust border-white z-10' : 'bg-white border-mapa-ink/50 group-hover:scale-110'}"></span>`;
					if (showLabel) {
						const short = st.name.replace(/\s*\(.*\)/, '').replace('Araneta Center-', '');
						html += `<span class="text-[9px] mt-1.5 text-center leading-tight ${isSelected ? 'font-bold text-mapa-rust' : 'text-mapa-muted'}">${short}</span>`;
					}
					html += '</button>';
				});
				html += '</div></div>';
				container.innerHTML = html;

				container.querySelectorAll('[data-strip-station]').forEach((btn) => {
					btn.addEventListener('click', () => {
						activeStationId = btn.getAttribute('data-strip-station');
						stationSelect.value = activeStationId;
						updateAll();
					});
				});
			}

			function updateAll() {
				const lineMeta = lines.find((l) => l.id === activeLine);
				const spec = specs[activeLine];
				const lineStations = stations[activeLine];
				const idx = Math.max(0, lineStations.findIndex((s) => s.id === activeStationId));
				const station = lineStations[idx];

				const nowParts = getManilaNowParts();
				let evalMin = nowParts.totalMinutes;
				let clockStr = `${format12H(nowParts.h * 60 + nowParts.m).replace(' ', `:${String(nowParts.s).padStart(2, '0')} `)} PHT`;
				if (!useLiveClock && simTimeInput.value) {
					const [sh, sm] = simTimeInput.value.split(':').map(Number);
					evalMin = sh * 60 + sm;
					clockStr = `${format12H(evalMin)} (Simulated)`;
					clockDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
				} else {
					const hPad = String(nowParts.h).padStart(2, '0');
					const mPad = String(nowParts.m).padStart(2, '0');
					if (simTimeInput.value !== `${hPad}:${mPad}` && useLiveClock) {
						simTimeInput.value = `${hPad}:${mPad}`;
					}
					clockDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
				}
				clockDisplay.textContent = clockStr;

				document.getElementById('selected-station-heading').textContent = `${lineMeta.shortName}: ${station.name}`;
				document.getElementById('selected-station-meta').textContent = `${station.city} • KM ${station.km.toFixed(1)}${station.transferLabel ? ` • ${station.transferLabel}` : ''}`;
				const advLink = document.getElementById('advisory-portal-link');
				advLink.href = lineMeta.advisoryUrl;
				advLink.textContent = lineMeta.advisoryLabel;
				document.getElementById('line-spec-note').textContent = spec.scheduleNote;

				const headwayInfo = getCurrentHeadway(spec, evalMin);
				const { offsetFwd, offsetRev } = getOffsetMinutes(activeLine, idx);

				// Global line phase badge
				const badge = document.getElementById('service-phase-badge');
				const anyOpen =
					(evalMin >= (isWeekdayMode ? spec.forward.weekdayFirstMin : spec.forward.weekendFirstMin) + offsetFwd &&
						evalMin <= (isWeekdayMode ? spec.forward.weekdayLastMin : spec.forward.weekendLastMin) + offsetFwd) ||
					(evalMin >= (isWeekdayMode ? spec.reverse.weekdayFirstMin : spec.reverse.weekendFirstMin) + offsetRev &&
						evalMin <= (isWeekdayMode ? spec.reverse.weekdayLastMin : spec.reverse.weekendLastMin) + offsetRev);

				if (anyOpen) {
					badge.textContent = `Open • ${headwayInfo.phase}`;
					badge.className = 'text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 border border-emerald-500/30';
				} else {
					badge.textContent = 'Closed for Night Maintenance';
					badge.className = 'text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-rose-500/15 text-rose-700 border border-rose-500/30';
				}

				renderDirectionCard('fwd', spec.forward, offsetFwd, evalMin, headwayInfo, spec.gateCutoffBeforeLastMin);
				renderDirectionCard('rev', spec.reverse, offsetRev, evalMin, headwayInfo, spec.gateCutoffBeforeLastMin);
				renderCadenceStrip(lineStations, spec, idx, evalMin, headwayInfo);

				// Transfer warning box
				const warnBox = document.getElementById('transfer-warning-box');
				if (station.transferTo) {
					let connMsg = '';
					if (station.id === 'mrt3_cubao' || station.id === 'lrt2_cubao') {
						connMsg = '<strong>Cubao Interchange Note:</strong> MRT-3 runs until 10:30 PM / 11:09 PM on weekdays, whereas connecting LRT-2 trains stop departing Antipolo at 9:00 PM and Recto at 9:30 PM (9:00 PM on weekends).';
					} else if (station.id === 'lrt1_doroteo_jose' || station.id === 'lrt2_recto') {
						connMsg = '<strong>Doroteo Jose / Recto Transfer Note:</strong> LRT-2 closes earlier (9:00 PM Antipolo / 9:30 PM Recto weekdays) than LRT-1 (10:30 PM / 10:45 PM weekdays). Check LRT-2 passing times before walking the footbridge after 8:45 PM.';
					} else if (station.id === 'lrt1_edsa' || station.id === 'mrt3_taft') {
						connMsg = '<strong>EDSA / Taft Transfer Note:</strong> Both lines run late on weekdays (~10:30 PM to 11:09 PM), and the 24/7 EDSA Carousel Busway departs right below the elevated station walkway.';
					}
					if (connMsg) {
						warnBox.innerHTML = connMsg;
						warnBox.classList.remove('hidden');
					} else {
						warnBox.classList.add('hidden');
					}
				} else {
					warnBox.classList.add('hidden');
				}
			}

			// Event listeners
			lineTabs.forEach((btn) => {
				btn.addEventListener('click', () => {
					activeLine = btn.getAttribute('data-line-tab');
					updateLineTabsUI();
					populateStationSelect();
					updateAll();
				});
			});

			stationSelect.addEventListener('change', (e) => {
				activeStationId = e.target.value;
				updateAll();
			});

			quickButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					activeLine = btn.getAttribute('data-line');
					activeStationId = btn.getAttribute('data-station');
					updateLineTabsUI();
					populateStationSelect();
					updateAll();
				});
			});

			dayWeekdayBtn.addEventListener('click', () => {
				isWeekdayMode = true;
				updateDayButtonsUI();
				updateAll();
			});

			dayWeekendBtn.addEventListener('click', () => {
				isWeekdayMode = false;
				updateDayButtonsUI();
				updateAll();
			});

			modeLiveBtn.addEventListener('click', () => {
				useLiveClock = true;
				modeLiveBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold border border-mapa-green bg-mapa-green/10 text-mapa-green transition-colors';
				updateAll();
			});

			simTimeInput.addEventListener('input', () => {
				if (simTimeInput.value) {
					useLiveClock = false;
					modeLiveBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold border border-mapa-contour bg-mapa-canvas text-mapa-ink/80 transition-colors';
					updateAll();
				}
			});

			// Timetable tabs
			const tableColorMap = {
				mrt3: 'bg-[#0055A5] text-white',
				lrt1: 'bg-[#00843D] text-white',
				lrt2: 'bg-[#6F2C91] text-white'
			};
			tableTabs.forEach((btn) => {
				btn.addEventListener('click', () => {
					const target = btn.getAttribute('data-table-tab');
					tableTabs.forEach((b) => {
						const k = b.getAttribute('data-table-tab');
						b.className = `table-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-colors ${k === target ? tableColorMap[k] : 'text-mapa-ink/80 hover:bg-mapa-canvas'}`;
					});
					tablePanels.forEach((p) => {
						if (p.id === `table-panel-${target}`) p.classList.remove('hidden');
						else p.classList.add('hidden');
					});
				});
			});

			updateDayButtonsUI();
			updateLineTabsUI();
			populateStationSelect();
			updateAll();
			setInterval(() => {
				if (useLiveClock) updateAll();
			}, 1000);
		})();
	</script>
</BaseLayout>
