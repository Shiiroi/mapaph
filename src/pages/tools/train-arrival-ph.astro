---
/**
 * @file train-arrival-ph.astro
 * @description Train Arrival PH (Phase 1 Hub): Metro Manila MRT-3, LRT-1, and LRT-2
 * wait estimator, next-3-trains headway cadence, first/last train & transfer cutoff planner,
 * and interactive simulated corridor visualizer.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
	RAIL_LINES,
	STATIONS_DATA,
	LINE_COLORS,
	SCHEDULE_SPECS,
	formatMinutesTo12H,
	buildLineTimetable,
	type LineKey
} from '../../data/rail-lines';

const timetablesByLine = {
	mrt3: buildLineTimetable('mrt3'),
	lrt1: buildLineTimetable('lrt1'),
	lrt2: buildLineTimetable('lrt2')
};

const orderedLines = (['mrt3', 'lrt1', 'lrt2'] as LineKey[])
	.map((id) => RAIL_LINES.find((l) => l.id === id)!)
	.filter(Boolean);

const findStation = (line: LineKey, query: string) =>
	STATIONS_DATA[line].find((s) => s.name.toLowerCase().includes(query.toLowerCase()));

const quickHubs = [
	{ label: 'North Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'north') || STATIONS_DATA.mrt3[0] },
	{ label: 'MRT Cubao', line: 'mrt3' as LineKey, st: findStation('mrt3', 'cubao') || STATIONS_DATA.mrt3[3] },
	{ label: 'Ayala', line: 'mrt3' as LineKey, st: findStation('mrt3', 'ayala') || STATIONS_DATA.mrt3[9] },
	{ label: 'Taft Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'taft') || STATIONS_DATA.mrt3[STATIONS_DATA.mrt3.length - 1] },
	{ label: 'D. Jose', line: 'lrt1' as LineKey, st: findStation('lrt1', 'jose') || STATIONS_DATA.lrt1[9] },
	{ label: 'PITX', line: 'lrt1' as LineKey, st: findStation('lrt1', 'asia world') || STATIONS_DATA.lrt1[STATIONS_DATA.lrt1.length - 3] },
	{ label: 'Recto', line: 'lrt2' as LineKey, st: findStation('lrt2', 'recto') || STATIONS_DATA.lrt2[0] },
	{ label: 'Antipolo', line: 'lrt2' as LineKey, st: findStation('lrt2', 'antipolo') || STATIONS_DATA.lrt2[STATIONS_DATA.lrt2.length - 1] }
].filter((h) => Boolean(h.st));

const defaultMrt3Timetable = timetablesByLine.mrt3;
const defaultLrt1Timetable = timetablesByLine.lrt1;
const defaultLrt2Timetable = timetablesByLine.lrt2;
const defaultDestMrt3 = 'mrt3_ayala';
---

<BaseLayout
	title="MRT-3, LRT-1 & LRT-2 Schedule 2026: Live Wait Time & Last Train | mapaPH"
	description="Check 2026 MRT-3, LRT-1 & LRT-2 first and last train times, live Manila clock wait estimates, next-3-trains headway cadence, and Cubao, Recto & Taft transfer cutoffs across all 51 stations."
	keywords="mrt 3 schedule 2026, lrt 1 schedule 2026, lrt 2 schedule 2026, train arrival ph, mrt 3 arrival time, lrt 1 arrival time, mrt 3 operating hours, lrt 1 operating hours, lrt 2 operating hours, last train mrt 3, last train lrt 1, lrt 2 last trip, mrt 3 live tracker, edsa carousel overnight"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Train Arrival PH: MRT-3, LRT-1 & LRT-2 Wait Time & Schedule Tracker",
					"url": "https://www.mapaph.com/tools/train-arrival-ph",
					"applicationCategory": "Public Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Metro Manila rail schedule estimator providing real-time Manila clock wait windows, next-3-trains headway cadence, origin-to-destination transfer cutoff checks, and interactive corridor maps across MRT-3, LRT-1, and LRT-2.",
					"offers": {
						"@type": "Offer",
						"price": "0",
						"priceCurrency": "PHP"
					}
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mapaph.com" },
						{ "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.mapaph.com/tools" },
						{ "@type": "ListItem", "position": 3, "name": "Train Arrival PH", "item": "https://www.mapaph.com/tools/train-arrival-ph" }
					]
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "How are train wait times and map positions estimated in Manila?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Philippine rail operators (DOTr MRT-3, LRMC LRT-1, and LRTA LRT-2) do not publish public live GTFS-RT train GPS feeds. Train Arrival PH computes estimated wait windows, next-3-trains cadence, and corridor map positions transparently from published weekday/weekend first and last terminal dispatches, rush-hour versus off-peak headway intervals, and kilometer-based segment travel offsets in Philippine Standard Time."
							}
						},
						{
							"@type": "Question",
							"name": "How does Use My GPS nearest-station snapping protect my privacy?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Your device coordinates never leave your browser. When you press Use My GPS, client-side JavaScript computes Haversine distance locally against all 51 rail station coordinates and automatically selects your nearest platform within 650 meters."
							}
						},
						{
							"@type": "Question",
							"name": "What time is the last train on MRT-3, LRT-1, and LRT-2?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "On weekdays, MRT-3 extended operations dispatch the last southbound train from North Avenue at 10:30 PM and the last northbound train from Taft Avenue at 11:09 PM (9:30 PM and 10:09 PM on weekends). LRT-1 weekday last trips leave Fernando Poe Jr. at 10:30 PM and Dr. Santos at 10:45 PM. LRT-2 closes earlier: 9:00 PM from Antipolo and 9:30 PM from Recto on weekdays, or 9:00 PM both ways on weekends. Concourse gates close roughly 5 minutes prior."
							}
						},
						{
							"@type": "Question",
							"name": "What can commuters ride after MRT-3 or LRT-1 closes for the night?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "After rail services conclude around 9:30 PM to 11:09 PM, the EDSA Carousel BRT busway operates 24/7 along the dedicated EDSA center median from Monumento to PITX, directly serving major transfer points including North Avenue, Quezon Avenue, Ortigas, Guadalupe, Ayala, and Taft Avenue."
							}
						}
					]
				}
			]
		}
	</script>

	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
		slot="schema"
	/>

	<style is:global>
		#live-rail-map .leaflet-div-icon {
			background: transparent;
			border: none;
		}
		.rail-train-pill {
			display: inline-flex;
			align-items: center;
			gap: 4px;
			padding: 2px 6px;
			border-radius: 9999px;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 10px;
			line-height: 1.1;
			white-space: nowrap;
			transform: translate(-50%, -50%);
		}
		.rail-train-est {
			background: #f7f3e9;
			color: #211d16;
			border: 1.5px dashed;
			box-shadow: 0 1px 3px rgba(33, 29, 22, 0.16);
			font-weight: 700;
		}
		.rail-train-live {
			color: #ffffff;
			border: 2px solid #ffffff;
			box-shadow: 0 3px 10px rgba(33, 29, 22, 0.34);
			font-weight: 800;
			font-size: 11px;
			padding: 3px 8px;
		}
	</style>

	<Navbar />

	<main
		id="main-content"
		data-supabase-url={import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.VITE_SUPABASE_URL || ''}
		data-supabase-key={import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY || ''}
		class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 text-mapa-ink"
	>
		<!-- Clean Editorial Page Header -->
		<div class="max-w-4xl mb-6">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-mapa-muted mb-3">
				<a href="/" class="hover:text-mapa-green transition-colors">Home</a>
				<span>/</span>
				<a href="/tools" class="hover:text-mapa-green transition-colors">Tools</a>
				<span>/</span>
				<span class="text-mapa-ink font-semibold">Train Arrival PH</span>
			</nav>
			<div class="flex flex-wrap items-center gap-2 mb-2 text-xs font-sans">
				<span class="font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Rail Wait &amp; Schedule Utility
				</span>
				<span class="text-mapa-muted">
					51 Stations &bull; Next-3 Cadence &bull; Transfer Cutoff Checker
				</span>
			</div>
			<h1 class="font-serif text-3xl sm:text-4xl font-extrabold tracking-tight text-mapa-ink">
				Train Arrival PH: MRT-3, LRT-1 &amp; LRT-2 Wait &amp; Schedule Estimator
			</h1>
			<p class="mt-2 text-sm sm:text-base text-mapa-ink/80 font-sans leading-relaxed max-w-3xl">
				Operators in Metro Manila do not publish public live train GPS telemetry. This tool calculates next-3-trains wait windows, peak versus off-peak headway intervals, last-train gate cutoffs, and interchange transfer buffers directly from official weekday and weekend dispatch timetables in Philippine Standard Time.
			</p>
		</div>

		<!-- Step 1 & 2: Rail Line Switcher + Inspect Station Controls -->
		<section aria-label="Rail Line and Station Selection" class="mb-5 font-sans space-y-3">
			<div class="flex items-center justify-between gap-2 flex-wrap">
				<span class="text-xs font-bold uppercase tracking-wider text-mapa-muted">
					1. Rail Line &amp; Station
				</span>
				<span id="activeCadenceChip" class="inline-flex items-center gap-1.5 text-[11px] font-medium text-mapa-muted">
					Checking Manila headway window...
				</span>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="tablist" aria-label="Metro Manila rail lines">
				{orderedLines.map((line) => {
					const lineHex = LINE_COLORS[line.id];
					const isDefault = line.id === 'mrt3';
					return (
						<button
							type="button"
							role="tab"
							aria-selected={isDefault ? 'true' : 'false'}
							data-line-tab={line.id}
							class={`line-tab-btn text-left rounded-xl px-4 py-3 transition-colors cursor-pointer flex items-center justify-between gap-3 ${
								isDefault
									? 'bg-mapa-canvas border-2 border-mapa-ink shadow-xs'
									: 'bg-mapa-canvas-dark border border-mapa-contour hover:border-mapa-ink/45'
							}`}
						>
							<div class="min-w-0">
								<div class="flex items-center gap-2">
									<span
										data-line-pill
										class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-mono font-bold shrink-0 ${
											isDefault
												? 'text-white'
												: 'border border-mapa-contour bg-mapa-canvas text-mapa-ink'
										}`}
										style={isDefault ? `background-color: ${lineHex};` : undefined}
									>
										{!isDefault && (
											<span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${lineHex};`}></span>
										)}
										<span>{line.shortName}</span>
									</span>
									<span class={`font-serif font-bold text-sm sm:text-base truncate ${isDefault ? 'text-mapa-ink' : 'text-mapa-ink/80'}`}>
										{line.name}
									</span>
								</div>
								<p class="text-[11px] text-mapa-muted mt-1 truncate">
									{line.stationsCount} stops &bull; {line.terminals.replace('<->', '↔')}
								</p>
							</div>
							<span
								data-line-state-tag
								data-line-stops={`${line.stationsCount} stops`}
								class={`shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded whitespace-nowrap ${
									isDefault
										? 'bg-mapa-ink text-white'
										: 'bg-mapa-canvas text-mapa-muted border border-mapa-contour/80'
								}`}
							>
								{isDefault ? 'Active' : `${line.stationsCount} stops`}
							</span>
						</button>
					);
				})}
			</div>

			<!-- Compact Inspect Station Bar -->
			<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-3.5 sm:p-4 shadow-xs space-y-2.5">
				<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
					<div class="flex-1 flex flex-col sm:flex-row sm:items-center gap-2.5">
						<label for="stationSelect" class="text-xs font-bold uppercase tracking-wider text-mapa-muted shrink-0 whitespace-nowrap">
							Inspect Station
						</label>
						<div class="flex-1 flex items-center gap-2">
							<select
								id="stationSelect"
								class="w-full h-10 px-3 rounded-xl border border-mapa-contour bg-mapa-canvas text-sm font-semibold text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green/40 cursor-pointer"
							>
								{STATIONS_DATA.mrt3.map((st, idx) => (
									<option value={st.id} selected={idx === 0}>
										{idx + 1}. {st.name} ({st.city})
									</option>
								))}
							</select>
							<button
								type="button"
								id="gpsLocateBtn"
								class="shrink-0 h-10 px-3 rounded-xl text-xs font-semibold border border-mapa-contour bg-mapa-canvas text-mapa-ink hover:border-mapa-green hover:text-mapa-green transition-colors cursor-pointer inline-flex items-center gap-1.5 whitespace-nowrap"
								title="Snap locally to nearest station within 650m (GPS only locates you, it does not report a train)"
							>
								<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z" />
								</svg>
								<span>Nearest via GPS</span>
							</button>
						</div>
					</div>

					<!-- Manila Clock & Day Type Segmented Toggle -->
					<div class="flex flex-wrap items-center justify-between lg:justify-end gap-2.5">
						<div class="inline-flex items-center gap-2 h-10 px-3 rounded-xl border border-mapa-contour bg-mapa-canvas text-xs">
							<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted whitespace-nowrap">PHT</span>
							<span id="manilaClock" class="font-mono text-sm font-bold text-mapa-ink whitespace-nowrap">--:-- --</span>
							<span id="manilaDayTag" class="hidden sm:inline text-[11px] text-mapa-muted whitespace-nowrap">Manila</span>
						</div>

						<div class="inline-flex items-center gap-0.5 p-1 h-10 rounded-xl border border-mapa-contour bg-mapa-canvas" role="group" aria-label="Schedule day mode">
							<button type="button" data-day-btn="auto" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white">
								Auto
							</button>
							<button type="button" data-day-btn="weekday" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink">
								Weekday
							</button>
							<button type="button" data-day-btn="weekend" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink">
								Weekend
							</button>
						</div>
					</div>
				</div>

				<div id="gpsStatusBanner" class="hidden rounded-xl border border-mapa-contour bg-mapa-canvas px-3.5 py-2 text-xs text-mapa-ink/85 leading-snug"></div>
				<div id="serviceAlertBanner" class="hidden rounded-xl border px-3.5 py-2 text-xs font-medium"></div>
			</div>
		</section>

		<!-- Full-Width Corridor Map Row + 2-Column Arrivals & Trip Estimate Row -->
		<section aria-label="Corridor Visualizer, Station Arrivals, and Train Trip Estimate" class="space-y-5 mb-12 font-sans">
			<!-- Row 1: Full-Width Interactive Corridor Map / 2D Schematic / Station Spine -->
			<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl overflow-hidden shadow-xs">
				<div class="p-4 border-b border-mapa-contour bg-mapa-canvas flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div class="min-w-0">
						<h2 id="corridorHeading" class="font-serif text-lg font-bold text-mapa-ink truncate">
							MRT Line 3 Corridor Map
						</h2>
						<p id="lineOperatorMeta" class="text-[11px] text-mapa-muted truncate">
							Department of Transportation (DOTr MRT-3) &bull; Tap any station marker to inspect schedules
						</p>
					</div>

					<!-- 3-Way View Switcher -->
					<div
						class="inline-flex items-center p-1 rounded-xl border border-mapa-contour bg-mapa-canvas-dark shrink-0 self-start sm:self-auto"
						role="tablist"
						aria-label="Visualizer mode"
					>
						<button
							type="button"
							role="tab"
							aria-selected="true"
							data-view-mode="map"
							class="view-mode-btn h-8 px-2.5 sm:px-3 rounded-lg text-xs font-bold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white"
						>
							Live Map
						</button>
						<button
							type="button"
							role="tab"
							aria-selected="false"
							data-view-mode="diagram"
							class="view-mode-btn h-8 px-2.5 sm:px-3 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink"
						>
							Diagram
						</button>
						<button
							type="button"
							role="tab"
							aria-selected="false"
							data-view-mode="list"
							class="view-mode-btn h-8 px-2.5 sm:px-3 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink"
						>
							Station List
						</button>
					</div>
				</div>

				<!-- Sub-toolbar: Map Scope vs Station Filter + Est Toggle + Legend -->
				<div class="px-4 py-2 border-b border-mapa-contour/70 bg-mapa-canvas-dark flex flex-wrap items-center justify-between gap-2 text-[11px]">
					<div class="flex items-center gap-2 flex-wrap">
						<div id="mapScopeControls" class="flex items-center gap-1.5 flex-wrap">
							<div class="inline-flex items-center p-0.5 rounded-lg border border-mapa-contour bg-mapa-canvas" role="group" aria-label="Map line scope">
								<button
									type="button"
									data-map-scope="focus"
									class="map-scope-btn px-2.5 py-1 rounded-md text-[11px] font-bold bg-mapa-ink text-white cursor-pointer transition-colors"
								>
									Active Line
								</button>
								<button
									type="button"
									data-map-scope="all"
									class="map-scope-btn px-2.5 py-1 rounded-md text-[11px] font-semibold text-mapa-ink/75 hover:text-mapa-ink cursor-pointer transition-colors"
								>
									All 3 Lines
								</button>
							</div>
							<button
								type="button"
								id="resetMapViewBtn"
								class="px-2.5 py-1 rounded-lg border border-mapa-contour bg-mapa-canvas text-[11px] font-semibold text-mapa-ink hover:border-mapa-ink transition-colors cursor-pointer"
							>
								Fit View
							</button>
						</div>

						<div id="listFilterControl" class="hidden w-full sm:w-48">
							<input
								id="stationFilterInput"
								type="search"
								placeholder="Filter stations..."
								aria-label="Filter stations on active line"
								class="w-full h-8 px-3 rounded-lg border border-mapa-contour bg-mapa-canvas text-xs text-mapa-ink placeholder:text-mapa-muted focus:outline-none focus:ring-2 focus:ring-mapa-green/40"
							/>
						</div>

						<button
							type="button"
							id="toggleEstTrainsBtn"
							aria-pressed="true"
							class="px-2.5 py-1 rounded-lg border border-mapa-ink bg-mapa-ink text-white text-[11px] font-bold transition-colors cursor-pointer whitespace-nowrap"
							title="Show or hide schedule-estimated train markers on the map and diagram"
						>
							Show Est. Trains: ON
						</button>
					</div>

					<div class="flex items-center gap-2.5 flex-wrap ml-auto">
						<span class="inline-flex items-center gap-1 text-mapa-muted">
							<span class="w-2.5 h-2.5 rounded-full border-2 border-mapa-ink bg-mapa-navy inline-block"></span>
							<span>Inspected</span>
						</span>
						<span class="inline-flex items-center gap-1 text-mapa-muted">
							<span class="px-1.5 py-0.5 leading-none rounded-full bg-mapa-green text-white font-mono text-[9px] font-extrabold">LIVE</span>
							<span>Rider</span>
						</span>
						<span class="inline-flex items-center gap-1 text-mapa-muted">
							<span class="px-1.5 py-0.5 leading-none rounded-full border border-dashed border-mapa-ink/70 bg-mapa-canvas font-mono text-[9px] font-bold text-mapa-ink">EST</span>
							<span>Schedule</span>
						</span>
						<span id="mapTrainCountBadge" class="font-mono font-bold text-[10px] text-mapa-ink px-2 py-0.5 rounded bg-mapa-canvas border border-mapa-contour">
							-- ACTIVE TRAINS
						</span>
					</div>
				</div>

				<!-- Panel 1: Leaflet OpenStreetMap View (Default) -->
				<div id="mapViewPanel" class="relative w-full h-[340px] sm:h-[420px] lg:h-[460px] bg-mapa-canvas-dark">
					<div id="live-rail-map" class="w-full h-full z-10"></div>
					<div
						id="mapFallbackBanner"
						class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center p-6 text-center bg-mapa-canvas"
					>
						<p class="font-serif font-bold text-base text-mapa-ink">Street map tiles unavailable offline</p>
						<p class="text-xs text-mapa-muted mt-1 max-w-sm">
							Use the 2D Network Diagram or Station List tabs above to inspect trains and schedules.
						</p>
					</div>
