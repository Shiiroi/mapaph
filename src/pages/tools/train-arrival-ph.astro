				}
				return verts;
			}

			function interpolatePolyPoints(pts, tNorm, isGeo, reverseTangent) {
				if (!pts.length) return { pos: [0, 0], angleDeg: 0 };
				if (pts.length === 1) return { pos: pts[0], angleDeg: reverseTangent ? 180 : 0 };

				const t = Math.max(0, Math.min(1, tNorm));
				const lens = [];
				let total = 0;
				for (let i = 0; i < pts.length - 1; i++) {
					const a = pts[i];
					const b = pts[i + 1];
					const dx = isGeo ? (b[1] - a[1]) * Math.cos((a[0] * Math.PI) / 180) : b[0] - a[0];
					const dy = isGeo ? b[0] - a[0] : b[1] - a[1];
					const len = Math.hypot(dx, dy) || 0.00001;
					lens.push(len);
					total += len;
				}

				let targetDist = t * total;
				for (let i = 0; i < lens.length; i++) {
					if (targetDist <= lens[i] || i === lens.length - 1) {
						const frac = lens[i] > 0 ? Math.max(0, Math.min(1, targetDist / lens[i])) : 0;
						const a = pts[i];
						const b = pts[i + 1];
						const p0 = a[0] + (b[0] - a[0]) * frac;
						const p1 = a[1] + (b[1] - a[1]) * frac;
						let dx;
						let dy;
						if (isGeo) {
							dx = (b[1] - a[1]) * Math.cos((p0 * Math.PI) / 180);
							dy = b[0] - a[0];
						} else {
							dx = b[0] - a[0];
							dy = -(b[1] - a[1]);
						}
						if (reverseTangent) {
							dx = -dx;
							dy = -dy;
						}
						const angleDeg = (Math.atan2(dx, dy) * 180) / Math.PI;
						return { pos: [p0, p1], angleDeg };
					}
					targetDist -= lens[i];
				}
				return { pos: pts[0], angleDeg: 0 };
			}

			function getTrackPositionAtFloatIndex(lineKey, stationFloatIdx, isReverse) {
				const sts = stationsData[lineKey] || [];
				if (!sts.length) return { lat: 14.5995, lon: 120.9842, bearingDeg: 0, svgX: 600, svgY: 600, svgAngleDeg: 0 };
				const clamped = Math.max(0, Math.min(sts.length - 1, stationFloatIdx));
				const segIdx = clamped >= sts.length - 1 ? Math.max(0, sts.length - 2) : Math.floor(clamped);
				const segT = clamped >= sts.length - 1 ? 1 : clamped - segIdx;
				const stA = sts[segIdx];
				const stB = sts[Math.min(sts.length - 1, segIdx + 1)];

				const geoPts = [[stA.lat, stA.lon]];
				const wp = GEO_WAYPOINTS[stA.id + '>' + stB.id];
				if (wp && wp.length) wp.forEach((p) => geoPts.push(p));
				geoPts.push([stB.lat, stB.lon]);
				const geoRes = interpolatePolyPoints(geoPts, segT, true, isReverse);

				const dLine = diagramPts[lineKey] || [];
				const iA = diagramIndexByStation[lineKey][stA.id] ?? 0;
				const iB = diagramIndexByStation[lineKey][stB.id] ?? dLine.length - 1;
				const lo = Math.min(iA, iB);
				const hi = Math.max(iA, iB);
				const svgPts = dLine.slice(lo, hi + 1).map((p) => [p.x, p.y]);
				const svgRes = interpolatePolyPoints(svgPts, segT, false, isReverse);

				return {
					lat: geoRes.pos[0],
					lon: geoRes.pos[1],
					bearingDeg: geoRes.angleDeg,
					svgX: svgRes.pos[0],
					svgY: svgRes.pos[1],
					svgAngleDeg: svgRes.angleDeg
				};
			}

			function offsetToStationFloatIndex(lineKey, elapsedMin, dirKey) {
				const table = timetablesByLine[lineKey] || [];
				const maxIdx = table.length - 1;
				if (dirKey === 'fwd') {
					if (elapsedMin <= 0) return 0;
					for (let i = 0; i < maxIdx; i++) {
						const oA = table[i].offsetForwardMin;
						const oB = table[i + 1].offsetForwardMin;
						if (elapsedMin <= oB) {
							const t = oB > oA ? (elapsedMin - oA) / (oB - oA) : 0;
							return i + Math.max(0, Math.min(1, t));
						}
					}
					return maxIdx;
				}
				if (elapsedMin <= 0) return maxIdx;
				for (let i = maxIdx - 1; i >= 0; i--) {
					const oStart = table[i + 1].offsetReverseMin;
					const oEnd = table[i].offsetReverseMin;
					if (elapsedMin <= oEnd) {
						const t = oEnd > oStart ? (elapsedMin - oStart) / (oEnd - oStart) : 0;
						return i + 1 - Math.max(0, Math.min(1, t));
					}
				}
				return 0;
			}

			function computeLineTrainsSnapshot(lineKey, clock, isWeekend, allSightings) {
				const spec = specsData[lineKey];
				const table = timetablesByLine[lineKey];
				const maxIdx = table.length - 1;
				const dirCodeFwd = spec.forward.shortDir === 'Eastbound' ? 'EB' : 'SB';
				const dirCodeRev = spec.reverse.shortDir === 'Westbound' ? 'WB' : 'NB';
				const hw = getHeadwayRange(spec, clock.totalMin, isWeekend);
				const avgHeadway = (hw[0] + hw[1]) / 2;

				const fwdFirst = isWeekend ? spec.forward.weekendFirstMin : spec.forward.weekdayFirstMin;
				const fwdLast = isWeekend ? spec.forward.weekendLastMin : spec.forward.weekdayLastMin;
				const revFirst = isWeekend ? spec.reverse.weekendFirstMin : spec.reverse.weekdayFirstMin;
				const revLast = isWeekend ? spec.reverse.weekendLastMin : spec.reverse.weekdayLastMin;
				const totalFwdTrip = table[maxIdx].offsetForwardMin;
				const totalRevTrip = table[0].offsetReverseMin;

				const estTrains = [];
				const estByIndex = {};

				for (let d = fwdFirst; d <= fwdLast + 0.001; d += avgHeadway) {
					const elapsed = clock.exactMin - d;
					if (elapsed >= 0 && elapsed <= totalFwdTrip) {
						const floatIdx = offsetToStationFloatIndex(lineKey, elapsed, 'fwd');
						const geom = getTrackPositionAtFloatIndex(lineKey, floatIdx, false);
						const iFrom = Math.min(maxIdx - 1, Math.floor(floatIdx));
						const iTo = Math.min(maxIdx, iFrom + 1);
						const nearIdx = Math.round(floatIdx);
						if (!estByIndex[nearIdx]) estByIndex[nearIdx] = { fwd: false, rev: false };
						estByIndex[nearIdx].fwd = true;
						estTrains.push({
							id: 'est_' + lineKey + '_fwd_' + d.toFixed(2),
							kind: 'est',
							lineKey,
							dirKey: 'fwd',
							dirShort: dirCodeFwd,
							dirName: spec.forward.shortDir,
							fromName: table[iFrom].station.name,
							toName: table[iTo].station.name,
							lat: geom.lat,
							lon: geom.lon,
							bearingDeg: geom.bearingDeg,
							svgX: geom.svgX,
							svgY: geom.svgY,
							svgAngleDeg: geom.svgAngleDeg
						});
					}
				}

				for (let d = revFirst; d <= revLast + 0.001; d += avgHeadway) {
					const elapsed = clock.exactMin - d;
					if (elapsed >= 0 && elapsed <= totalRevTrip) {
						const floatIdx = offsetToStationFloatIndex(lineKey, elapsed, 'rev');
						const geom = getTrackPositionAtFloatIndex(lineKey, floatIdx, true);
						const iFrom = Math.min(maxIdx, Math.ceil(floatIdx));
						const iTo = Math.max(0, iFrom - 1);
						const nearIdx = Math.round(floatIdx);
						if (!estByIndex[nearIdx]) estByIndex[nearIdx] = { fwd: false, rev: false };
						estByIndex[nearIdx].rev = true;
						estTrains.push({
							id: 'est_' + lineKey + '_rev_' + d.toFixed(2),
							kind: 'est',
							lineKey,
							dirKey: 'rev',
							dirShort: dirCodeRev,
							dirName: spec.reverse.shortDir,
							fromName: table[iFrom].station.name,
							toName: table[iTo].station.name,
							lat: geom.lat,
							lon: geom.lon,
							bearingDeg: geom.bearingDeg,
							svgX: geom.svgX,
							svgY: geom.svgY,
							svgAngleDeg: geom.svgAngleDeg
						});
					}
				}

				const liveTrains = [];
				const seenKeys = new Set();
				const packedStations = new Set();
				const lineSightings = allSightings.filter((s) => s.line_key === lineKey);

				lineSightings.forEach((rep) => {
					if (rep.report_type === 'crowded') {
						packedStations.add(rep.station_id);
						return;
					}
					if (rep.report_type !== 'arriving' && rep.report_type !== 'on_board' && rep.report_type !== 'delayed') {
						return;
					}
					const dedupKey = rep.direction + '|' + rep.station_id + '|' + (rep.report_type === 'delayed' ? 'delay' : 'train');
					if (seenKeys.has(dedupKey)) return;
					seenKeys.add(dedupKey);

					const repEntry = getTimetableEntry(lineKey, rep.station_id);
					const ageMin = Math.max(0, (clock.nowMs - Date.parse(rep.created_at)) / 60000);
					const isFwd = rep.direction === 'fwd';
					const isDelayed = rep.report_type === 'delayed';
					const maxTrip = isFwd ? totalFwdTrip : totalRevTrip;
					const baseOffset = isFwd ? repEntry.offsetForwardMin : repEntry.offsetReverseMin;

					let floatIdx = repEntry.index;
					let isProjected = false;
					if (!isDelayed && ageMin > 0.75 && ageMin <= 10) {
						const projOffset = Math.min(maxTrip, baseOffset + ageMin);
						floatIdx = offsetToStationFloatIndex(lineKey, projOffset, rep.direction);
						isProjected = Math.round(floatIdx) !== repEntry.index;
					}

					const geom = getTrackPositionAtFloatIndex(lineKey, floatIdx, !isFwd);
					const nearEntry = table[Math.max(0, Math.min(maxIdx, Math.round(floatIdx)))];

					liveTrains.push({
						id: 'live_' + rep.id,
						kind: isDelayed ? 'live_delay' : 'live',
						lineKey,
						dirKey: rep.direction,
						dirShort: isFwd ? dirCodeFwd : dirCodeRev,
						dirName: isFwd ? spec.forward.shortDir : spec.reverse.shortDir,
						stationId: rep.station_id,
						reportedStationName: repEntry.station.name,
						projectedStationName: nearEntry.station.name,
						isProjected,
						ageMin,
						ageStr: formatAgeMinutes(rep.created_at, clock.nowMs),
						ageStrShort: formatAgeShort(rep.created_at, clock.nowMs),
						isLocalOnly: Boolean(rep.isLocalOnly),
						lat: geom.lat,
						lon: geom.lon,
						bearingDeg: geom.bearingDeg,
						svgX: geom.svgX,
						svgY: geom.svgY,
						svgAngleDeg: geom.svgAngleDeg,
						report: rep
					});
				});

				return { estTrains, estByIndex, liveTrains, packedStations };
			}

			async function fetchLiveSightings() {
				if (!supabaseUrl || !supabaseAnonKey) {
					remoteSightings = [];
					setFeedBadge('unconfigured', 'Schedule simulation (public DB env missing)');
					renderAll();
					return;
				}

				const sinceIso = new Date(Date.now() - LIVE_WINDOW_MS).toISOString();
				const endpoint =
					supabaseUrl +
					'/rest/v1/rail_sightings?select=id,line_key,station_id,direction,report_type,source_kind,crowd_level,created_at' +
					'&created_at=gte.' +
					encodeURIComponent(sinceIso) +
					'&order=created_at.desc&limit=80';

				try {
					const res = await fetch(endpoint, {
						headers: {
							apikey: supabaseAnonKey,
							Authorization: 'Bearer ' + supabaseAnonKey,
							Accept: 'application/json'
						}
					});

					if (!res.ok) {
						let errDetail = 'HTTP ' + res.status;
						try {
							const body = await res.json();
							if (body && body.message) errDetail += ' - ' + body.message;
							if (res.status === 404 || (body && body.code === 'PGRST205')) {
								setFeedBadge('migration_pending', 'Schedule fallback (run SQL migration for live feed)');
								remoteSightings = [];
								renderAll();
								return;
							}
						} catch (_parseErr) {
							// Keep HTTP error status message
						}
						setFeedBadge('error', 'Live feed offline (' + errDetail + ')');
						remoteSightings = [];
						renderAll();
						return;
					}

					const rows = await res.json();
					remoteSightings = Array.isArray(rows) ? rows : [];
					const count = remoteSightings.length;
					setFeedBadge(
						'connected',
						count > 0 ? 'Shared live feed (' + count + ' across Manila)' : 'Shared live feed connected'
					);
					renderAll();
				} catch (err) {
					const msg = err && err.message ? err.message : 'Network error';
					setFeedBadge('error', 'Live feed unreachable (' + msg + ')');
					remoteSightings = [];
					renderAll();
				}
			}

			function computeDirectionModel(dirKey, clock, isWeekend, lineSightings) {
				const spec = specsData[currentLine];
				const dirSpec = dirKey === 'fwd' ? spec.forward : spec.reverse;
				const entry = getTimetableEntry(currentLine, currentStationId);
				const firstMin =
					dirKey === 'fwd'
						? isWeekend
							? entry.weekendFirstFwd
							: entry.weekdayFirstFwd
						: isWeekend
						? entry.weekendFirstRev
						: entry.weekdayFirstRev;
				const lastMin =
					dirKey === 'fwd'
						? isWeekend
							? entry.weekendLastFwd
							: entry.weekdayLastFwd
						: isWeekend
						? entry.weekendLastRev
						: entry.weekdayLastRev;
				const offset = dirKey === 'fwd' ? entry.offsetForwardMin : entry.offsetReverseMin;
				const cutoffMin = lastMin - spec.gateCutoffBeforeLastMin;

				const headwayRange = getHeadwayRange(spec, clock.totalMin, isWeekend);
				const avgHeadway = (headwayRange[0] + headwayRange[1]) / 2;

				let statusText = 'Operating';
				let statusTone = 'open';
				let estWaitMin = null;
				let estArrivalStr = 'Ended';

				if (clock.totalMin < spec.gateOpenMin) {
					statusText = 'Closed';
					statusTone = 'closed';
					estWaitMin = firstMin - clock.totalMin;
					estArrivalStr = 'First: ' + fmt12h(firstMin);
				} else if (clock.totalMin < firstMin) {
					statusText = 'Opening Soon';
					statusTone = 'warn';
					estWaitMin = firstMin - clock.totalMin;
					estArrivalStr = 'First: ' + fmt12h(firstMin);
				} else if (clock.totalMin > lastMin) {
					statusText = 'Service Ended';
					statusTone = 'closed';
					estWaitMin = null;
					estArrivalStr = 'Use EDSA Carousel (24/7)';
				} else {
					if (clock.totalMin >= cutoffMin) {
						statusText = 'Gate Cutoff Window';
						statusTone = 'warn';
					}
					const elapsedSinceFirst = Math.max(0, clock.totalMin - firstMin);
					const k = Math.ceil(elapsedSinceFirst / avgHeadway);
					let candidate = Math.round(firstMin + k * avgHeadway);
					if (candidate < clock.totalMin) candidate = clock.totalMin + 1;
					if (candidate > lastMin) candidate = lastMin;
					estWaitMin = Math.max(0, candidate - clock.totalMin);
					estArrivalStr = 'Est. ' + fmt12h(candidate);
				}

				const selIdx = entry.index;
				const dirReports = lineSightings.filter((s) => s.direction === dirKey);

				let liveMatch = null;
				let liveDelayed = null;
				let latestCrowd = null;

				for (let i = 0; i < dirReports.length; i++) {
					const rep = dirReports[i];
					if (!latestCrowd && rep.crowd_level) latestCrowd = rep;
					if (rep.report_type === 'delayed' && !liveDelayed) liveDelayed = rep;

					if (rep.report_type === 'arriving' || rep.report_type === 'on_board') {
						const repEntry = getTimetableEntry(currentLine, rep.station_id);
						const ageMin = Math.max(0, (clock.nowMs - Date.parse(rep.created_at)) / 60000);
						if (rep.station_id === currentStationId && ageMin <= 5) {
							liveMatch = {
								kind: 'at_station',
								report: rep,
								stationName: repEntry.station.name,
								ageStr: formatAgeMinutes(rep.created_at, clock.nowMs),
								etaMin: 0
							};
							break;
						}
						const isUpstream = dirKey === 'fwd' ? repEntry.index < selIdx : repEntry.index > selIdx;
						if (isUpstream && ageMin <= 14) {
							const repOffset = dirKey === 'fwd' ? repEntry.offsetForwardMin : repEntry.offsetReverseMin;
							const segDelta = Math.max(1, offset - repOffset);
							const eta = Math.round(segDelta - ageMin);
							if (eta >= -1 && eta <= 18) {
								liveMatch = {
									kind: 'approaching',
									report: rep,
									stationName: repEntry.station.name,
									ageStr: formatAgeMinutes(rep.created_at, clock.nowMs),
									etaMin: Math.max(0, eta)
								};
								break;
							}
						}
					}
				}

				return {
					dirSpec,
					firstMin,
					lastMin,
					cutoffMin,
					headwayRange,
					statusText,
					statusTone,
					estWaitMin,
					estArrivalStr,
					liveMatch,
					liveDelayed,
					latestCrowd
				};
			}

			function renderDirectionCard(prefix, model) {
				const dirPill = document.getElementById(prefix + 'DirPill');
				const lineDot = document.getElementById(prefix + 'LineDot');
				const innerBox = document.getElementById(prefix + 'InnerBox');
				const sourceBadge = document.getElementById(prefix + 'SourceBadge');
				const destLabel = document.getElementById(prefix + 'DestLabel');
				const statusChip = document.getElementById(prefix + 'StatusChip');
				const countdown = document.getElementById(prefix + 'Countdown');
				const exactTime = document.getElementById(prefix + 'ExactTime');
				const liveDetail = document.getElementById(prefix + 'LiveDetail');
				const firstEl = document.getElementById(prefix + 'FirstTime');
				const lastEl = document.getElementById(prefix + 'LastTime');
				const cutoffEl = document.getElementById(prefix + 'CutoffTime');

				const lineHex = lineColors[currentLine] || '#3D5A45';
				lineDot.style.backgroundColor = lineHex;

				dirPill.textContent = model.dirSpec.shortDir;
				destLabel.textContent = 'Towards ' + model.dirSpec.destinationTerminal;

				statusChip.textContent = model.statusText;
				statusChip.className = 'shrink-0 text-[11px] font-semibold whitespace-nowrap';
				if (model.statusTone === 'open') {
					statusChip.classList.add('text-mapa-green');
				} else if (model.statusTone === 'warn') {
					statusChip.classList.add('text-mapa-rust');
				} else {
					statusChip.classList.add('text-mapa-muted');
				}

				firstEl.textContent = fmt12h(model.firstMin);
				lastEl.textContent = fmt12h(model.lastMin);
				cutoffEl.textContent = fmt12h(model.cutoffMin);

				const estWaitLabel =
					model.estWaitMin === null
						? 'Ended'
						: model.estWaitMin === 0
						? 'Due now'
						: '~' + model.estWaitMin + ' min';

				if (model.liveMatch) {
					const lm = model.liveMatch;
					const isLocalOnly = Boolean(lm.report.isLocalOnly);
					innerBox.className = isLocalOnly
						? 'rounded-xl bg-mapa-canvas border-2 border-mapa-navy p-3'
						: 'rounded-xl bg-mapa-canvas border-2 border-mapa-green p-3';
					sourceBadge.textContent = isLocalOnly
						? 'LOCAL PREVIEW · ' + lm.ageStr
						: 'LIVE TRACKED · ' + lm.ageStr;
					sourceBadge.className = isLocalOnly
						? 'inline-block px-1.5 py-0.5 rounded font-mono text-[10px] font-bold uppercase tracking-wider bg-mapa-navy text-white'
						: 'inline-block px-1.5 py-0.5 rounded font-mono text-[10px] font-bold uppercase tracking-wider bg-mapa-green text-white';

					countdown.textContent = lm.etaMin === 0 ? 'Arriving' : '~' + lm.etaMin + ' min';
					exactTime.textContent = 'Sched: ' + estWaitLabel;

					let msg =
						lm.kind === 'at_station'
							? 'Rider at ' + lm.stationName + ' (' + lm.ageStr + ').'
							: 'Upstream @ ' + lm.stationName + ' (' + lm.ageStr + ').';
					if (model.liveDelayed) msg += ' Caution: delay reported.';
					liveDetail.textContent = msg;
				} else {
					innerBox.className = 'rounded-xl bg-mapa-canvas border border-mapa-contour p-3';
					sourceBadge.textContent =
						model.estWaitMin === null
							? 'CLOSED'
							: 'ESTIMATED · ' + model.headwayRange[0] + '-' + model.headwayRange[1] + 'm';
					sourceBadge.className =
						'inline-block px-1.5 py-0.5 rounded font-mono text-[10px] font-bold uppercase tracking-wider bg-mapa-canvas-dark text-mapa-muted border border-mapa-contour';

					countdown.textContent = estWaitLabel;
					exactTime.textContent = model.estArrivalStr;

					let fallbackNote =
						model.estWaitMin === null
							? 'Closed now. Use 24/7 EDSA Carousel along EDSA.'
							: 'Schedule math (0 live upstream sightings).';
					if (model.liveDelayed) {
						fallbackNote = 'Delay reported recently on this bound.';
					} else if (model.latestCrowd) {
						fallbackNote += ' Crowd: ' + model.latestCrowd.crowd_level + '.';
					}
					liveDetail.textContent = fallbackNote;
				}
			}

			function updateLiveVsEstBanner(liveTrains) {
