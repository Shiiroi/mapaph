			// Polyline geometry helpers shared across Leaflet geographic map and 2D SVG diagram
			function getGeoVerticesForLine(lineKey) {
				const sts = stationsData[lineKey] || [];
				const verts = [];
				for (let i = 0; i < sts.length; i++) {
					verts.push([sts[i].lat, sts[i].lon]);
					if (i < sts.length - 1) {
						const wp = GEO_WAYPOINTS[sts[i].id + '>' + sts[i + 1].id];
						if (wp && wp.length) {
							wp.forEach((p) => verts.push(p));
