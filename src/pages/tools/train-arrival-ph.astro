			function computeScopedTrains(clock, isWeekend, allSightings) {
				const scopeKeys = mapScope === 'all' ? ['mrt3', 'lrt1', 'lrt2'] : [currentLine];
				let scopedEst = [];
				let scopedLive = [];
				const packedSet = new Set();
				let activeLineEstByIndex = {};

				['mrt3', 'lrt1', 'lrt2'].forEach((lk) => {
					const snap = computeLineTrainsSnapshot(lk, clock, isWeekend, allSightings);
					if (lk === currentLine) {
						activeLineEstByIndex = snap.estByIndex;
					}
					if (scopeKeys.includes(lk)) {
						scopedEst = scopedEst.concat(snap.estTrains);
						scopedLive = scopedLive.concat(snap.liveTrains);
						snap.packedStations.forEach((stId) => packedSet.add(lk + '|' + stId));
					}
				});

				scopedLive.sort((a, b) => a.ageMin - b.ageMin);
				return { scopedEst, scopedLive, packedSet, activeLineEstByIndex };
			}

			function refreshVisualizersOnly() {
				const clock = getManilaClock();
				const isWeekend = getEffectiveIsWeekend(clock);
				const allSightings = getAllCombinedSightings(clock.nowMs);
				const { scopedEst, scopedLive, packedSet } = computeScopedTrains(clock, isWeekend, allSightings);

				mapTrainCountBadge.textContent = scopedEst.length + ' EST · ' + scopedLive.length + ' LIVE';
				updateLiveVsEstBanner(scopedLive);

				if (viewMode === 'map') {
					renderLeafletTrains(scopedEst, scopedLive);
				} else if (viewMode === 'diagram') {
					renderDiagramView(scopedEst, scopedLive, packedSet);
				}
			}

			function renderAll() {
				const clock = getManilaClock();
				lastRenderedMinute = clock.totalMin;
				const isWeekend = getEffectiveIsWeekend(clock);
				const spec = specsData[currentLine];
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];
				const station = findStationById(currentLine, currentStationId);

				updateLineTabsUI();
				updateViewModeUI();
				updateMapScopeUI();

				manilaClockEl.textContent = clock.formatted;
				manilaDayTagEl.textContent = clock.weekdayLabel + ' · ' + (isWeekend ? 'Weekend' : 'Weekday');

				corridorHeading.textContent =
					viewMode === 'list'
						? lineMeta.name + ' Station List'
						: mapScope === 'all'
						? 'Metro Manila 3-Line Rail Tracker'
						: lineMeta.name + (viewMode === 'diagram' ? ' Schematic Network' : ' Live Map');

				lineOperatorMeta.textContent =
					lineMeta.operator + ' · ' + lineMeta.stationsCount + ' stations · Tap any station pin to inspect';
				stationMetaNote.textContent = station.name + ' (' + station.city + ') · km ' + station.km.toFixed(1);
				checkInStationLabel.textContent = station.name;

				if (gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId) {
					gpsVerifiedTag.classList.remove('hidden');
				} else {
					gpsVerifiedTag.classList.add('hidden');
				}

				document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
					const dir = btn.getAttribute('data-checkin-dir');
					btn.textContent = dir === 'fwd' ? spec.forward.shortDir : spec.reverse.shortDir;
					btn.className =
						dir === checkInDir
							? 'checkin-dir-btn h-8 px-2 rounded-lg text-xs font-bold cursor-pointer transition-colors bg-mapa-navy text-white whitespace-nowrap truncate'
							: 'checkin-dir-btn h-8 px-2 rounded-lg text-xs font-semibold cursor-pointer transition-colors text-mapa-ink/75 hover:text-mapa-ink whitespace-nowrap truncate';
				});

				const allSightings = getAllCombinedSightings(clock.nowMs);
				const lineSightings = allSightings.filter((s) => s.line_key === currentLine);
				const { scopedEst, scopedLive, packedSet, activeLineEstByIndex } = computeScopedTrains(
					clock,
					isWeekend,
					allSightings
				);

				mapTrainCountBadge.textContent = scopedEst.length + ' EST · ' + scopedLive.length + ' LIVE';
				updateLiveVsEstBanner(scopedLive);

				const fwdModel = computeDirectionModel('fwd', clock, isWeekend, lineSightings);
				const revModel = computeDirectionModel('rev', clock, isWeekend, lineSightings);
				renderDirectionCard('fwd', fwdModel);
				renderDirectionCard('rev', revModel);

				renderLeafletTracksAndStations(packedSet);
				renderLeafletTrains(scopedEst, scopedLive);
				renderDiagramView(scopedEst, scopedLive, packedSet);
				renderStationSpine(clock, isWeekend, lineSightings, activeLineEstByIndex);
				renderSightingsList(clock, lineSightings);

				const activeFwdWarn = fwdModel.statusTone === 'warn';
				const activeRevWarn = revModel.statusTone === 'warn';
				const bothClosed = fwdModel.statusTone === 'closed' && revModel.statusTone === 'closed';
				if (bothClosed) {
					serviceAlertBanner.classList.remove('hidden');
					serviceAlertBanner.className =
						'rounded-xl border border-mapa-rust/35 bg-mapa-canvas text-mapa-rust px-3.5 py-2.5 text-xs font-medium';
					serviceAlertBanner.textContent =
						lineMeta.shortName +
