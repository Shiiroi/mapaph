						xferTag.className = 'inline-block px-1.5 py-0.5 rounded border border-mapa-contour bg-mapa-canvas text-[10px] font-medium text-mapa-ink/80';
						xferTag.textContent = st.transferLabel;
						xfer.appendChild(xferTag);
						left.appendChild(xfer);
					}

					// Right live & estimated badges (only shown when informative)
					const right = document.createElement('div');
					right.className = 'shrink-0 flex flex-col items-end gap-1';

					if (liveList.length > 0) {
						const topRep = liveList[0];
						const livePill = document.createElement('span');
						livePill.className =
							'px-2 py-0.5 rounded text-[10px] font-bold ' +
							(topRep.report_type === 'delayed'
								? 'bg-mapa-rust text-white'
								: 'bg-mapa-green text-white');
						const repTypeMap = {
							arriving: 'Arriving',
							on_board: 'On board',
							crowded: 'Packed',
							delayed: 'Delay'
						};
						livePill.textContent =
							(repTypeMap[topRep.report_type] || 'Report') + ' · ' + formatAgeMinutes(topRep.created_at, clock.nowMs);
						right.appendChild(livePill);
					}

					if (estTrain && (estTrain.fwd || estTrain.rev)) {
						const estTag = document.createElement('span');
						estTag.className = 'px-1.5 py-0.5 rounded border border-mapa-contour bg-mapa-canvas font-mono text-[10px] font-semibold text-mapa-ink/75';
						const parts = [];
						if (estTrain.fwd) parts.push(dirCodeFwd + ' >');
						if (estTrain.rev) parts.push('< ' + dirCodeRev);
						estTag.textContent = parts.join(' | ');
						right.appendChild(estTag);
					}

					btn.appendChild(left);
					btn.appendChild(right);
					btn.addEventListener('click', () => {
						currentStationId = st.id;
						stationSelect.value = st.id;
						updateUrlParams();
						renderAll();
					});

					stationSpineScroll.appendChild(btn);
				});
				stationSpineScroll.scrollTop = prevScrollTop;
			}

			function renderSightingsList(clock, lineSightings) {
				if (!lineSightings.length) {
					liveSightingsList.innerHTML = '';
					const emptyBox = document.createElement('div');
					const isOfflineState =
						feedStatus.state === 'error' ||
						feedStatus.state === 'migration_pending' ||
						feedStatus.state === 'unconfigured';
					emptyBox.className = 'rounded-lg border border-mapa-contour bg-mapa-canvas px-3 py-2.5 text-mapa-muted leading-snug';
					emptyBox.textContent = isOfflineState
						? feedStatus.message + '. Directional arrival cards above are using published schedule cadence.'
						: 'No rider sightings reported on this line in the past 15 minutes. Directional arrivals above use published schedule cadence.';
					liveSightingsList.appendChild(emptyBox);
					return;
				}

				const spec = specsData[currentLine];
				liveSightingsList.innerHTML = '';
				lineSightings.slice(0, 8).forEach((item) => {
					const st = findStationById(currentLine, item.station_id);
					const dirName = item.direction === 'fwd' ? spec.forward.shortDir : spec.reverse.shortDir;
					const reportLabels = {
						arriving: 'Train arriving / boarding',
						on_board: 'Rider on board',
						crowded: 'Platform packed',
						delayed: 'Delay / hold reported'
					};
					const row = document.createElement('div');
					row.className =
						'flex items-center justify-between gap-2 rounded-lg border border-mapa-contour bg-mapa-canvas px-3 py-2';

					const left = document.createElement('div');
					left.className = 'min-w-0 flex-1';

					const topText = document.createElement('div');
					topText.className = 'font-semibold text-mapa-ink truncate';
					topText.textContent = (reportLabels[item.report_type] || item.report_type) + ' · ' + st.name;

					const subText = document.createElement('div');
					subText.className = 'text-[11px] text-mapa-muted';
					const originLabel = item.isLocalOnly
						? 'Local preview'
						: item.source_kind === 'gps_snap'
						? 'GPS verified'
						: 'Manual check-in';
					subText.textContent = dirName + ' · ' + (item.crowd_level ? item.crowd_level + ' crowd · ' : '') + originLabel;

					left.appendChild(topText);
					left.appendChild(subText);

					const right = document.createElement('span');
					right.className = 'shrink-0 font-mono text-[11px] text-mapa-muted';
					right.textContent = formatAgeMinutes(item.created_at, clock.nowMs);

					row.appendChild(left);
					row.appendChild(right);
					liveSightingsList.appendChild(row);
				});
			}

			function updateLineTabsUI() {
				document.querySelectorAll('.line-tab-btn').forEach((btn) => {
					const tabLine = btn.getAttribute('data-line-tab');
					const isActive = tabLine === currentLine;
					const lineHex = lineColors[tabLine] || '#3D5A45';
					btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
					if (isActive) {
						btn.className = 'line-tab-btn text-left rounded-xl px-4 py-3 border transition-colors cursor-pointer flex items-center justify-between gap-3 bg-mapa-canvas border-mapa-ink shadow-xs';
						btn.style.borderLeft = '4px solid ' + lineHex;
					} else {
						btn.className = 'line-tab-btn text-left rounded-xl px-4 py-3 border transition-colors cursor-pointer flex items-center justify-between gap-3 bg-mapa-canvas-dark border-mapa-contour hover:border-mapa-ink/40';
						btn.style.borderLeft = '4px solid transparent';
					}
				});
			}

			function renderAll() {
				const clock = getManilaClock();
				lastRenderedMinute = clock.totalMin;
				const isWeekend = getEffectiveIsWeekend(clock);
				const spec = specsData[currentLine];
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];
				const station = findStationById(currentLine, currentStationId);

				updateLineTabsUI();

				manilaClockEl.textContent = clock.formatted;
				manilaDayTagEl.textContent = clock.weekdayLabel + ' · ' + (isWeekend ? 'Weekend' : 'Weekday');

				lineOperatorMeta.textContent = lineMeta.operator + ' · ' + lineMeta.stationsCount + ' stations · Tap any stop to inspect';
				stationMetaNote.textContent =
					station.name + ' (' + station.city + ') · km ' + station.km.toFixed(1);
				checkInStationLabel.textContent = station.name;

				if (gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId) {
					gpsVerifiedTag.classList.remove('hidden');
				} else {
					gpsVerifiedTag.classList.add('hidden');
				}

				document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
					const dir = btn.getAttribute('data-checkin-dir');
					btn.textContent = dir === 'fwd' ? spec.forward.shortDir : spec.reverse.shortDir;
					if (dir === checkInDir) {
						btn.className = 'checkin-dir-btn h-9 px-3 rounded-lg text-xs font-bold cursor-pointer transition-colors bg-mapa-navy text-white whitespace-nowrap';
					} else {
						btn.className = 'checkin-dir-btn h-9 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-colors text-mapa-ink/75 hover:text-mapa-ink whitespace-nowrap';
					}
				});

				const allSightings = getAllCombinedSightings(clock.nowMs);
				const lineSightings = allSightings.filter((s) => s.line_key === currentLine);

				const fwdModel = computeDirectionModel('fwd', clock, isWeekend, lineSightings);
				const revModel = computeDirectionModel('rev', clock, isWeekend, lineSightings);

				renderDirectionCard('fwd', fwdModel);
				renderDirectionCard('rev', revModel);
				renderStationSpine(clock, isWeekend, lineSightings);
				renderSightingsList(clock, lineSightings);

				const activeFwdWarn = fwdModel.statusTone === 'warn';
				const activeRevWarn = revModel.statusTone === 'warn';
				const bothClosed = fwdModel.statusTone === 'closed' && revModel.statusTone === 'closed';
				if (bothClosed) {
					serviceAlertBanner.classList.remove('hidden');
					serviceAlertBanner.className =
						'rounded-xl border border-mapa-rust/35 bg-mapa-canvas text-mapa-rust px-3.5 py-2.5 text-xs font-medium';
					serviceAlertBanner.textContent =
						lineMeta.shortName +
						' passenger service at ' +
						station.name +
						' is currently closed. Overnight riders along EDSA can use the 24/7 EDSA Carousel.';
				} else if (activeFwdWarn || activeRevWarn) {
					serviceAlertBanner.classList.remove('hidden');
					serviceAlertBanner.className =
						'rounded-xl border border-mapa-rust/35 bg-mapa-canvas text-mapa-rust px-3.5 py-2.5 text-xs font-medium';
					serviceAlertBanner.textContent =
						'Closing notice: final train gate cutoff is active or approaching within minutes.';
				} else {
					serviceAlertBanner.classList.add('hidden');
				}
			}

			function populateStationSelect(preferredStationId) {
				const list = stationsData[currentLine] || [];
				stationSelect.innerHTML = '';
				list.forEach((st, idx) => {
					const opt = document.createElement('option');
					opt.value = st.id;
					opt.textContent = idx + 1 + '. ' + st.name + ' (' + st.city + ')';
					stationSelect.appendChild(opt);
				});
				const matched = list.find((s) => s.id === preferredStationId) || list[0];
				currentStationId = matched.id;
				stationSelect.value = currentStationId;
			}

			function switchLine(newLine, preferredStationId) {
				if (!stationsData[newLine]) return;
				const changed = newLine !== currentLine;
				currentLine = newLine;
				stationFilterQuery = '';
				if (stationFilterInput) stationFilterInput.value = '';
				populateStationSelect(preferredStationId || null);
				updateUrlParams();
				if (changed) {
					fetchLiveSightings();
				} else {
					renderAll();
				}
			}

			function updateUrlParams() {
				try {
					const url = new URL(window.location.href);
					url.searchParams.set('line', currentLine);
					url.searchParams.set('station', currentStationId);
					window.history.replaceState({}, '', url.toString());
				} catch (_err) {
					// Ignore in restricted frames
				}
			}

			function showCheckInMessage(tone, text) {
				checkInFeedback.classList.remove('hidden');
				if (tone === 'success') {
					checkInFeedback.className =
						'rounded-lg border border-mapa-green/40 bg-mapa-canvas text-mapa-green px-3 py-2 text-xs font-medium';
				} else if (tone === 'warn') {
					checkInFeedback.className =
						'rounded-lg border border-mapa-contour bg-mapa-canvas text-mapa-ink px-3 py-2 text-xs font-medium';
				} else {
					checkInFeedback.className =
						'rounded-lg border border-mapa-rust/40 bg-mapa-canvas text-mapa-rust px-3 py-2 text-xs font-medium';
				}
				checkInFeedback.textContent = text;
			}

			function startCooldownTimer() {
				cooldownUntilMs = Date.now() + COOLDOWN_MS;
				const reportBtns = document.querySelectorAll('.report-btn');
				if (cooldownInterval) clearInterval(cooldownInterval);

				function tick() {
					const rem = Math.ceil((cooldownUntilMs - Date.now()) / 1000);
					if (rem <= 0) {
						clearInterval(cooldownInterval);
						cooldownInterval = null;
						reportBtns.forEach((b) => b.removeAttribute('disabled'));
						return;
					}
					reportBtns.forEach((b) => b.setAttribute('disabled', 'true'));
				}
				tick();
				cooldownInterval = setInterval(tick, 500);
			}

			async function submitSighting(reportType) {
				const nowMs = Date.now();
				if (nowMs < cooldownUntilMs) {
					const waitSec = Math.ceil((cooldownUntilMs - nowMs) / 1000);
					showCheckInMessage('warn', 'Cooldown active: wait ' + waitSec + 's before submitting another report.');
					return;
				}

				const payload = {
					line_key: currentLine,
					station_id: currentStationId,
					direction: checkInDir,
					report_type: reportType,
					source_kind:
						gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId
							? 'gps_snap'
							: 'manual',
					crowd_level: crowdLevel,
					client_token: getOrCreateClientToken()
				};

				const station = findStationById(currentLine, currentStationId);

				if (!supabaseUrl || !supabaseAnonKey) {
					const localItem = Object.assign(
						{ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true },
						payload
					);
					localPreviewSightings.unshift(localItem);
					saveLocalPreviewSightings(localPreviewSightings);
					showCheckInMessage(
						'warn',
						'Saved locally in browser preview for ' + station.name + ' (public Supabase env vars not configured).'
					);
					startCooldownTimer();
					renderAll();
					return;
				}

				try {
					const res = await fetch(supabaseUrl + '/rest/v1/rail_sightings', {
						method: 'POST',
						headers: {
							apikey: supabaseAnonKey,
							Authorization: 'Bearer ' + supabaseAnonKey,
							'Content-Type': 'application/json',
							Prefer: 'return=representation'
						},
						body: JSON.stringify(payload)
					});

					if (!res.ok) {
						let detail = 'HTTP ' + res.status;
						let code = '';
						try {
							const errBody = await res.json();
							if (errBody && errBody.message) detail = errBody.message;
							if (errBody && errBody.code) code = errBody.code;
						} catch (_e) {
							// Ignore parse error
						}

						if (res.status === 404 || code === 'PGRST205') {
							const localItem = Object.assign(
								{ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true },
								payload
							);
							localPreviewSightings.unshift(localItem);
							saveLocalPreviewSightings(localPreviewSightings);
							showCheckInMessage(
								'warn',
								'Shared rail_sightings table is not created yet in Supabase. Saved locally as browser preview for ' + station.name + '.'
							);
							startCooldownTimer();
							renderAll();
							return;
						}

						if (res.status === 401 || res.status === 403 || code === '42501') {
							showCheckInMessage('warn', 'Rate limit: please wait 20 seconds between check-ins (' + detail + ').');
							startCooldownTimer();
							return;
						}

						showCheckInMessage('error', 'Failed to broadcast check-in: ' + detail);
						return;
					}

					const inserted = await res.json();
					const row =
						Array.isArray(inserted) && inserted[0]
							? inserted[0]
							: Object.assign({ id: 'ok_' + Date.now(), created_at: new Date().toISOString() }, payload);
					remoteSightings.unshift(row);
					showCheckInMessage('success', 'Shared rider sighting posted for ' + station.name + '.');
					startCooldownTimer();
					renderAll();
				} catch (err) {
					const msg = err && err.message ? err.message : 'Network error';
					showCheckInMessage('error', 'Network error sending check-in: ' + msg);
				}
			}

			function handleGpsLocate() {
				if (!navigator.geolocation) {
					gpsStatusBanner.classList.remove('hidden');
					gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-canvas text-mapa-rust px-3.5 py-2 text-xs';
					gpsStatusBanner.textContent = 'Geolocation is not supported in this browser. Please select your station manually.';
					return;
				}

				gpsLocateBtn.disabled = true;
				const origSpan = gpsLocateBtn.querySelector('span');
				if (origSpan) origSpan.textContent = 'Locating...';

				navigator.geolocation.getCurrentPosition(
					(pos) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';

						const userLat = pos.coords.latitude;
						const userLon = pos.coords.longitude;
						let best = null;

						['mrt3', 'lrt1', 'lrt2'].forEach((lk) => {
							stationsData[lk].forEach((st) => {
								const d = haversineMeters(userLat, userLon, st.lat, st.lon);
								if (!best || d < best.distMeters) {
									best = { lineKey: lk, station: st, distMeters: Math.round(d) };
								}
							});
						});

						gpsStatusBanner.classList.remove('hidden');
						if (best && best.distMeters <= GPS_MAX_RADIUS_METERS) {
							gpsSnapState = {
								active: true,
								lineKey: best.lineKey,
								stationId: best.station.id,
								distMeters: best.distMeters
							};
							gpsStatusBanner.className =
								'rounded-xl border border-mapa-green/40 bg-mapa-canvas text-mapa-green px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Snapped locally to ' +
								best.station.name +
								' (' +
								best.lineKey.toUpperCase() +
								', ~' +
								best.distMeters +
								'm away). Coordinates stay in your browser.';
							switchLine(best.lineKey, best.station.id);
						} else if (best) {
							gpsSnapState = { active: false, lineKey: null, stationId: null, distMeters: best.distMeters };
							gpsStatusBanner.className =
								'rounded-xl border border-mapa-contour bg-mapa-canvas text-mapa-ink px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Nearest rail station is ' +
								best.station.name +
								' (~' +
								(best.distMeters / 1000).toFixed(1) +
								' km away, outside 650m station radius). Manual selection stays enabled.';
							renderAll();
						}
					},
					(geoErr) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';
						gpsStatusBanner.classList.remove('hidden');
						gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-canvas text-mapa-rust px-3.5 py-2 text-xs';
						gpsStatusBanner.textContent =
							'Location permission unavailable (' + (geoErr && geoErr.message ? geoErr.message : 'blocked') + ').';
					},
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 15000 }
				);
			}

			// Event listeners
			document.querySelectorAll('.line-tab-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const line = btn.getAttribute('data-line-tab');
					if (line) switchLine(line, null);
				});
			});

			stationSelect.addEventListener('change', () => {
				currentStationId = stationSelect.value;
				updateUrlParams();
				renderAll();
			});

			if (stationFilterInput) {
				stationFilterInput.addEventListener('input', () => {
					stationFilterQuery = stationFilterInput.value || '';
					const clock = getManilaClock();
					const isWeekend = getEffectiveIsWeekend(clock);
					const lineSightings = getAllCombinedSightings(clock.nowMs).filter((s) => s.line_key === currentLine);
					renderStationSpine(clock, isWeekend, lineSightings);
				});
			}

			document.querySelectorAll('.day-mode-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					dayMode = btn.getAttribute('data-day-btn') || 'auto';
					document.querySelectorAll('.day-mode-btn').forEach((b) => {
						if (b.getAttribute('data-day-btn') === dayMode) {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white';
						} else {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink';
						}
					});
					renderAll();
				});
			});

			document.querySelectorAll('.quick-hub-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const hubLine = btn.getAttribute('data-hub-line');
					const hubStation = btn.getAttribute('data-hub-station');
					if (hubLine && hubStation) switchLine(hubLine, hubStation);
				});
			});

			document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					checkInDir = btn.getAttribute('data-checkin-dir') || 'fwd';
					renderAll();
				});
			});

			document.querySelectorAll('.crowd-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					crowdLevel = btn.getAttribute('data-crowd') || 'moderate';
					document.querySelectorAll('.crowd-btn').forEach((b) => {
						if (b.getAttribute('data-crowd') === crowdLevel) {
							b.className = 'crowd-btn h-8 px-2 rounded-lg text-xs font-bold cursor-pointer transition-colors bg-mapa-canvas-dark text-mapa-ink border border-mapa-contour/70';
						} else {
							b.className = 'crowd-btn h-8 px-2 rounded-lg text-xs font-medium cursor-pointer transition-colors text-mapa-ink/75';
						}
					});
				});
			});

			document.querySelectorAll('.report-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const rType = btn.getAttribute('data-report');
					if (rType) submitSighting(rType);
				});
			});

			gpsLocateBtn.addEventListener('click', handleGpsLocate);
			refreshFeedBtn.addEventListener('click', fetchLiveSightings);

			try {
				const params = new URLSearchParams(window.location.search);
				const qLine = params.get('line');
				const qStation = params.get('station');
				if (qLine && stationsData[qLine]) currentLine = qLine;
				populateStationSelect(qStation);
			} catch (_err) {
				populateStationSelect(null);
			}

			fetchLiveSightings();
			setInterval(() => {
				if (document.hidden) return;
				const clock = getManilaClock();
				manilaClockEl.textContent = clock.formatted;
				if (lastRenderedMinute !== clock.totalMin) {
					lastRenderedMinute = clock.totalMin;
					renderAll();
				}
			}, 1000);
			setInterval(() => {
				if (!document.hidden) fetchLiveSightings();
			}, 30000);
		})();
	</script>
</BaseLayout>
