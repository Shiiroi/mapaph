				const sourceBadge = document.getElementById(prefix + 'SourceBadge');
				const destLabel = document.getElementById(prefix + 'DestLabel');
				const statusChip = document.getElementById(prefix + 'StatusChip');
				const countdown = document.getElementById(prefix + 'Countdown');
				const exactTime = document.getElementById(prefix + 'ExactTime');
				const liveDetail = document.getElementById(prefix + 'LiveDetail');
				const firstEl = document.getElementById(prefix + 'FirstTime');
				const lastEl = document.getElementById(prefix + 'LastTime');
				const cutoffEl = document.getElementById(prefix + 'CutoffTime');

				const lineHex = lineColors[currentLine] || '#3D5A45';
				lineDot.style.backgroundColor = lineHex;

				dirPill.textContent = model.dirSpec.shortDir;
				destLabel.textContent = 'Towards ' + model.dirSpec.destinationTerminal;

				statusChip.textContent = model.statusText;
				statusChip.className = 'shrink-0 text-xs font-semibold whitespace-nowrap';
				if (model.statusTone === 'open') {
					statusChip.classList.add('text-mapa-green');
				} else if (model.statusTone === 'warn') {
					statusChip.classList.add('text-mapa-rust');
				} else {
					statusChip.classList.add('text-mapa-muted');
				}

				firstEl.textContent = fmt12h(model.firstMin);
				lastEl.textContent = fmt12h(model.lastMin);
				cutoffEl.textContent = fmt12h(model.cutoffMin);

				const estWaitLabel =
					model.estWaitMin === null
						? 'Ended'
						: model.estWaitMin === 0
						? 'Due now'
						: '~' + model.estWaitMin + ' min';

				if (model.liveMatch) {
					const lm = model.liveMatch;
					const isLocalOnly = Boolean(lm.report.isLocalOnly);
					sourceBadge.textContent = isLocalOnly
						? 'Local browser check-in preview'
						: 'Rider report · ' + lm.ageStr + (lm.report.source_kind === 'gps_snap' ? ' · GPS station verified' : '');
					sourceBadge.className = isLocalOnly
						? 'font-semibold text-mapa-navy'
						: 'font-semibold text-mapa-green';
					countdown.textContent =
						lm.etaMin === 0 ? 'Arriving / Boarding' : '~' + lm.etaMin + ' min away';
					exactTime.textContent = 'Schedule est. ' + estWaitLabel;

					let msg =
						lm.kind === 'at_station'
							? 'Reported at ' + lm.stationName + ' (' + lm.ageStr + ').'
							: 'Spotted at ' + lm.stationName + ' (' + lm.ageStr + ').';
					if (model.liveDelayed) msg += ' Caution: delay reported recently.';
					liveDetail.textContent = msg;
				} else {
					sourceBadge.textContent =
						model.estWaitMin === null
							? 'Outside operating hours'
							: 'Schedule estimate · every ' + model.headwayRange[0] + '-' + model.headwayRange[1] + ' min';
					sourceBadge.className = 'font-semibold text-mapa-muted';
					countdown.textContent = estWaitLabel;
					exactTime.textContent = model.estArrivalStr;

					let fallbackNote =
						model.estWaitMin === null
							? 'Rail closed for this bound. Overnight commuters along EDSA can ride the 24/7 EDSA Carousel.'
							: 'No live rider check-ins on this bound in the past 15 minutes.';
					if (model.liveDelayed) {
						fallbackNote = 'Delay reported recently on this direction. ' + fallbackNote;
					} else if (model.latestCrowd) {
						fallbackNote += ' Crowd level reported: ' + model.latestCrowd.crowd_level + '.';
					}
					liveDetail.textContent = fallbackNote;
				}
			}

			function renderStationSpine(clock, isWeekend, lineSightings) {
				const table = timetablesByLine[currentLine];
				const lineHex = lineColors[currentLine] || '#3D5A45';
				const spec = specsData[currentLine];
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];

				corridorHeading.textContent = lineMeta.name + ' Station Corridor';

				// Index live sightings by station
				const sightingsByStation = {};
				lineSightings.forEach((s) => {
					if (!sightingsByStation[s.station_id]) sightingsByStation[s.station_id] = [];
					sightingsByStation[s.station_id].push(s);
				});

				const estTrainsByIdx = computeEstimatedTrainStops(clock, isWeekend);
				const q = stationFilterQuery.trim().toLowerCase();

				const visibleRows = table.filter((row) => {
					if (!q) return true;
					return (
						row.station.name.toLowerCase().includes(q) ||
