			function startCooldownTimer() {
				cooldownUntilMs = Date.now() + COOLDOWN_MS;
				const reportBtns = document.querySelectorAll('.report-btn');
				if (cooldownInterval) clearInterval(cooldownInterval);

				function tick() {
					const rem = Math.ceil((cooldownUntilMs - Date.now()) / 1000);
					if (rem <= 0) {
						clearInterval(cooldownInterval);
						cooldownInterval = null;
						reportBtns.forEach((b) => b.removeAttribute('disabled'));
						return;
					}
					reportBtns.forEach((b) => b.setAttribute('disabled', 'true'));
				}
				tick();
				cooldownInterval = setInterval(tick, 500);
			}

			async function submitSighting(reportType) {
				const nowMs = Date.now();
				if (nowMs < cooldownUntilMs) {
					const waitSec = Math.ceil((cooldownUntilMs - nowMs) / 1000);
					showCheckInMessage('warn', 'Cooldown active: wait ' + waitSec + 's before submitting another report.');
					return;
				}

				const payload = {
					line_key: currentLine,
					station_id: currentStationId,
					direction: checkInDir,
					report_type: reportType,
					source_kind:
						gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId
							? 'gps_snap'
							: 'manual',
					crowd_level: crowdLevel,
					client_token: getOrCreateClientToken()
				};

				const station = findStationById(currentLine, currentStationId);

				if (!supabaseUrl || !supabaseAnonKey) {
					const localItem = Object.assign(
						{ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true },
						payload
					);
					localPreviewSightings.unshift(localItem);
					saveLocalPreviewSightings(localPreviewSightings);
					showCheckInMessage(
						'warn',
						'Saved locally in browser preview for ' + station.name + ' (public Supabase env vars not configured).'
					);
					startCooldownTimer();
					renderAll();
					return;
				}

				try {
					const res = await fetch(supabaseUrl + '/rest/v1/rail_sightings', {
						method: 'POST',
						headers: {
							apikey: supabaseAnonKey,
							Authorization: 'Bearer ' + supabaseAnonKey,
							'Content-Type': 'application/json',
							Prefer: 'return=representation'
						},
						body: JSON.stringify(payload)
					});

					if (!res.ok) {
						let detail = 'HTTP ' + res.status;
						let code = '';
						try {
							const errBody = await res.json();
							if (errBody && errBody.message) detail = errBody.message;
							if (errBody && errBody.code) code = errBody.code;
						} catch (_e) {
							// Ignore parse error
						}

						if (res.status === 404 || code === 'PGRST205') {
							const localItem = Object.assign(
								{ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true },
								payload
							);
							localPreviewSightings.unshift(localItem);
							saveLocalPreviewSightings(localPreviewSightings);
							showCheckInMessage(
								'warn',
								'Shared rail_sightings table is not created yet in Supabase. Saved locally as browser preview for ' + station.name + '.'
							);
							startCooldownTimer();
							renderAll();
							return;
						}

						if (res.status === 401 || res.status === 403 || code === '42501') {
							showCheckInMessage('warn', 'Rate limit: please wait 20 seconds between check-ins (' + detail + ').');
							startCooldownTimer();
							return;
						}

						showCheckInMessage('error', 'Failed to broadcast check-in: ' + detail);
						return;
					}

					const inserted = await res.json();
					const row =
						Array.isArray(inserted) && inserted[0]
							? inserted[0]
							: Object.assign({ id: 'ok_' + Date.now(), created_at: new Date().toISOString() }, payload);
					remoteSightings.unshift(row);
					showCheckInMessage('success', 'Shared rider sighting posted for ' + station.name + '.');
					startCooldownTimer();
					renderAll();
				} catch (err) {
					const msg = err && err.message ? err.message : 'Network error';
					showCheckInMessage('error', 'Network error sending check-in: ' + msg);
				}
			}

			function handleGpsLocate() {
				if (!navigator.geolocation) {
					gpsStatusBanner.classList.remove('hidden');
					gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-canvas text-mapa-rust px-3.5 py-2 text-xs';
					gpsStatusBanner.textContent = 'Geolocation is not supported in this browser. Please select your station manually.';
					return;
				}

				gpsLocateBtn.disabled = true;
				const origSpan = gpsLocateBtn.querySelector('span');
				if (origSpan) origSpan.textContent = 'Locating...';

				navigator.geolocation.getCurrentPosition(
					(pos) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';

						const userLat = pos.coords.latitude;
						const userLon = pos.coords.longitude;
						let best = null;

						['mrt3', 'lrt1', 'lrt2'].forEach((lk) => {
							stationsData[lk].forEach((st) => {
								const d = haversineMeters(userLat, userLon, st.lat, st.lon);
								if (!best || d < best.distMeters) {
									best = { lineKey: lk, station: st, distMeters: Math.round(d) };
								}
							});
						});

						gpsStatusBanner.classList.remove('hidden');
						if (best && best.distMeters <= GPS_MAX_RADIUS_METERS) {
							gpsSnapState = {
								active: true,
								lineKey: best.lineKey,
								stationId: best.station.id,
								distMeters: best.distMeters
							};
							gpsStatusBanner.className =
								'rounded-xl border border-mapa-green/40 bg-mapa-canvas text-mapa-green px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Snapped locally to ' +
								best.station.name +
								' (' +
								best.lineKey.toUpperCase() +
								', ~' +
								best.distMeters +
								'm away). Coordinates stay in your browser.';
							switchLine(best.lineKey, best.station.id);
						} else if (best) {
							gpsSnapState = { active: false, lineKey: null, stationId: null, distMeters: best.distMeters };
							gpsStatusBanner.className =
								'rounded-xl border border-mapa-contour bg-mapa-canvas text-mapa-ink px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Nearest rail station is ' +
								best.station.name +
								' (~' +
								(best.distMeters / 1000).toFixed(1) +
								' km away, outside 650m station radius). Manual selection stays enabled.';
							renderAll();
						}
					},
					(geoErr) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';
						gpsStatusBanner.classList.remove('hidden');
						gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-canvas text-mapa-rust px-3.5 py-2 text-xs';
						gpsStatusBanner.textContent =
							'Location permission unavailable (' + (geoErr && geoErr.message ? geoErr.message : 'blocked') + ').';
					},
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 15000 }
				);
			}

			// Event listeners
			document.querySelectorAll('.line-tab-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const line = btn.getAttribute('data-line-tab');
					if (line) switchLine(line, null);
				});
			});

			document.querySelectorAll('.view-mode-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const m = btn.getAttribute('data-view-mode');
					if (m) {
						viewMode = m;
						renderAll();
					}
				});
			});

			document.querySelectorAll('.map-scope-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const sc = btn.getAttribute('data-map-scope');
					if (sc) {
						mapScope = sc;
						renderAll();
					}
				});
			});

			resetMapViewBtn.addEventListener('click', () => {
				fitActiveLeafletBounds();
			});

			liveVsEstActionBtn.addEventListener('click', () => {
				if (lastLiveBannerTarget && lastLiveBannerTarget.type === 'pin' && lastLiveBannerTarget.train) {
					const t = lastLiveBannerTarget.train;
					viewMode = 'map';
					renderAll();
					if (leafletMap) {
						leafletMap.setView([t.lat, t.lon], 14, { animate: true });
					}
				} else {
					const panel = document.getElementById('checkInPanel');
					if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			});

			stationSelect.addEventListener('change', () => {
				currentStationId = stationSelect.value;
				updateUrlParams();
				renderAll();
			});

			if (stationFilterInput) {
				stationFilterInput.addEventListener('input', () => {
					stationFilterQuery = stationFilterInput.value || '';
					const clock = getManilaClock();
					const isWeekend = getEffectiveIsWeekend(clock);
					const allSightings = getAllCombinedSightings(clock.nowMs);
					const lineSightings = allSightings.filter((s) => s.line_key === currentLine);
					const { activeLineEstByIndex } = computeScopedTrains(clock, isWeekend, allSightings);
					renderStationSpine(clock, isWeekend, lineSightings, activeLineEstByIndex);
				});
			}

			document.querySelectorAll('.day-mode-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					dayMode = btn.getAttribute('data-day-btn') || 'auto';
					document.querySelectorAll('.day-mode-btn').forEach((b) => {
						if (b.getAttribute('data-day-btn') === dayMode) {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white';
						} else {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink';
						}
					});
					renderAll();
				});
			});

			document.querySelectorAll('.quick-hub-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const hubLine = btn.getAttribute('data-hub-line');
					const hubStation = btn.getAttribute('data-hub-station');
					if (hubLine && hubStation) switchLine(hubLine, hubStation);
				});
			});

			document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					checkInDir = btn.getAttribute('data-checkin-dir') || 'fwd';
					renderAll();
				});
			});

			document.querySelectorAll('.crowd-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					crowdLevel = btn.getAttribute('data-crowd') || 'moderate';
					document.querySelectorAll('.crowd-btn').forEach((b) => {
						if (b.getAttribute('data-crowd') === crowdLevel) {
							b.className = 'crowd-btn h-8 px-1.5 rounded-lg text-xs font-bold cursor-pointer transition-colors bg-mapa-canvas-dark text-mapa-ink border border-mapa-contour/70';
						} else {
							b.className = 'crowd-btn h-8 px-1.5 rounded-lg text-xs font-medium cursor-pointer transition-colors text-mapa-ink/75';
						}
					});
				});
			});

			document.querySelectorAll('.report-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const rType = btn.getAttribute('data-report');
					if (rType) submitSighting(rType);
				});
			});

			gpsLocateBtn.addEventListener('click', handleGpsLocate);
			refreshFeedBtn.addEventListener('click', fetchLiveSightings);

			try {
				const params = new URLSearchParams(window.location.search);
				const qLine = params.get('line');
				const qStation = params.get('station');
				if (qLine && stationsData[qLine]) currentLine = qLine;
				populateStationSelect(qStation);
			} catch (_err) {
				populateStationSelect(null);
			}

			fetchLiveSightings();
			setInterval(() => {
				if (document.hidden) return;
				const clock = getManilaClock();
				manilaClockEl.textContent = clock.formatted;
				if (lastRenderedMinute !== clock.totalMin) {
					lastRenderedMinute = clock.totalMin;
					renderAll();
				}
			}, 1000);
			// Smooth 5-second motion tick along Geo Map & Diagram without re-rendering Leaflet tiles
			setInterval(() => {
				if (document.hidden) return;
				refreshVisualizersOnly();
			}, 5000);
			setInterval(() => {
				if (!document.hidden) fetchLiveSightings();
			}, 30000);
		})();
	</script>
</BaseLayout>
