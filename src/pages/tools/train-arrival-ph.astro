---
/**
 * @file train-arrival-ph.astro
 * @description Train Arrival PH: Prominent line switcher + connected station corridor (upgraded from rail-transit.astro) + hybrid crowdsourced & scheduled arrival tracker.
 */

import { loadEnv } from 'vite';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
	RAIL_LINES,
	STATIONS_DATA,
	LINE_COLORS,
	SCHEDULE_SPECS,
	formatMinutesTo12H,
	buildLineTimetable,
	type LineKey
} from '../../data/rail-lines';

const env = loadEnv(import.meta.env.MODE, process.cwd(), '');

const supabaseUrl = (
	env.PUBLIC_SUPABASE_URL ||
	env.VITE_SUPABASE_URL ||
	process.env.PUBLIC_SUPABASE_URL ||
	process.env.VITE_SUPABASE_URL ||
	''
)
	.trim()
	.replace(/\/+$/, '');

const supabaseAnonKey = (
	env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
	env.VITE_SUPABASE_PUBLISHABLE_KEY ||
	env.PUBLIC_SUPABASE_ANON_KEY ||
	env.VITE_SUPABASE_ANON_KEY ||
	process.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
	process.env.VITE_SUPABASE_PUBLISHABLE_KEY ||
	process.env.PUBLIC_SUPABASE_ANON_KEY ||
	process.env.VITE_SUPABASE_ANON_KEY ||
	''
).trim();

const timetablesByLine = {
	mrt3: buildLineTimetable('mrt3'),
	lrt1: buildLineTimetable('lrt1'),
	lrt2: buildLineTimetable('lrt2')
};

// Display MRT-3 first alongside LRT-1 and LRT-2 for commuter frequency
const orderedLines = (['mrt3', 'lrt1', 'lrt2'] as LineKey[])
	.map((id) => RAIL_LINES.find((l) => l.id === id)!)
	.filter(Boolean);

const findStation = (line: LineKey, query: string) =>
	STATIONS_DATA[line].find((s) => s.name.toLowerCase().includes(query.toLowerCase()));

const quickHubs = [
	{ label: 'North Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'north') || STATIONS_DATA.mrt3[0] },
	{ label: 'MRT Cubao', line: 'mrt3' as LineKey, st: findStation('mrt3', 'cubao') || STATIONS_DATA.mrt3[3] },
	{ label: 'Ayala', line: 'mrt3' as LineKey, st: findStation('mrt3', 'ayala') || STATIONS_DATA.mrt3[9] },
	{ label: 'Taft Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'taft') || STATIONS_DATA.mrt3[STATIONS_DATA.mrt3.length - 1] },
	{ label: 'D. Jose', line: 'lrt1' as LineKey, st: findStation('lrt1', 'jose') || STATIONS_DATA.lrt1[9] },
	{ label: 'PITX', line: 'lrt1' as LineKey, st: findStation('lrt1', 'asia world') || STATIONS_DATA.lrt1[STATIONS_DATA.lrt1.length - 3] },
	{ label: 'Recto', line: 'lrt2' as LineKey, st: findStation('lrt2', 'recto') || STATIONS_DATA.lrt2[0] },
	{ label: 'Antipolo', line: 'lrt2' as LineKey, st: findStation('lrt2', 'antipolo') || STATIONS_DATA.lrt2[STATIONS_DATA.lrt2.length - 1] }
].filter((h) => Boolean(h.st));

const defaultMrt3Timetable = timetablesByLine.mrt3;
const defaultLrt1Timetable = timetablesByLine.lrt1;
const defaultLrt2Timetable = timetablesByLine.lrt2;
---

<BaseLayout
	title="Train Arrival PH: Live Crowdsourced & Scheduled MRT-3, LRT-1, LRT-2 Tracker | mapaPH Tools"
	description="Check live crowdsourced train sightings and scheduled arrival windows for MRT-3, LRT-1, and LRT-2 in Metro Manila. View station-by-station first and last train times, headway countdowns, opt-in GPS check-ins, and crowd reports in Manila Time."
	keywords="train arrival ph, mrt 3 arrival time, lrt 1 arrival time, lrt 2 schedule, manila train tracker, crowdsource train location philippines, last train mrt 3, last train lrt 1, edsa carousel overnight"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Train Arrival PH: MRT-3, LRT-1 & LRT-2 Crowdsourced & Schedule Tracker",
					"url": "https://www.mapaph.com/tools/train-arrival-ph",
					"applicationCategory": "Public Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Hybrid Metro Manila commuter tracker combining anonymous crowdsourced train sightings and opt-in station GPS snaps with deterministic dispatch schedules across all 51 MRT-3, LRT-1, and LRT-2 stations.",
					"offers": {
						"@type": "Offer",
						"price": "0",
						"priceCurrency": "PHP"
					}
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mapaph.com" },
						{ "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.mapaph.com/tools" },
						{ "@type": "ListItem", "position": 3, "name": "Train Arrival PH", "item": "https://www.mapaph.com/tools/train-arrival-ph" }
					]
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "Is Metro Manila train arrival tracking real-time GPS telemetry?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Philippine rail operators (DOTr MRT-3, LRMC LRT-1, and LRTA LRT-2) do not currently publish public GTFS-RT or train GPS feeds. Train Arrival PH uses a transparent hybrid engine: when commuters tap to report a train arriving, riding on board, or station crowding (optionally snapped via browser GPS within 650 meters of a station), the page shows Rider Report sightings. When no recent rider reports exist, it automatically falls back to Scheduled cadence computed from published terminal dispatch times and segment distances."
							}
						},
						{
							"@type": "Question",
							"name": "How does optional GPS train location sharing protect my privacy?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Your raw latitude and longitude coordinates never leave your device. If you press Use My GPS and grant browser permission, distance calculation runs locally in JavaScript to find the nearest rail station within 650 meters. Only the station ID, rail line, direction, and report label are shared, never your GPS coordinates or identity."
							}
						},
						{
							"@type": "Question",
							"name": "What time is the last train on MRT-3, LRT-1, and LRT-2?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "On weekdays, MRT-3 extended operations dispatch the last southbound train from North Avenue at 10:30 PM and the last northbound train from Taft Avenue at 11:09 PM (reverting to 9:30 PM and 10:09 PM on weekends). LRT-1 weekday last trips leave Fernando Poe Jr. at 10:30 PM and Dr. Santos at 10:45 PM. LRT-2 closes earlier: 9:00 PM from Antipolo and 9:30 PM from Recto on weekdays, or 9:00 PM both ways on weekends. Station gates generally close 5 minutes prior."
							}
						},
						{
							"@type": "Question",
							"name": "What can commuters ride after MRT-3 or LRT-1 closes for the night?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "After rail services conclude around 9:30 PM to 11:09 PM, the EDSA Carousel BRT busway runs 24/7 along the dedicated EDSA center median from Monumento to PITX, directly serving major transfer points including North Avenue, Quezon Avenue, Ortigas, Guadalupe, Ayala, and Taft Avenue."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 text-mapa-ink">
		<!-- Clean Editorial Page Header (Matching rail-transit.astro) -->
		<div class="max-w-4xl mb-6">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-mapa-muted mb-3">
				<a href="/" class="hover:text-mapa-green transition-colors">Home</a>
				<span>/</span>
				<a href="/tools" class="hover:text-mapa-green transition-colors">Tools</a>
				<span>/</span>
				<span class="text-mapa-ink font-semibold">Train Arrival PH</span>
			</nav>
			<div class="flex flex-wrap items-center gap-2 mb-2 text-xs font-sans">
				<span class="font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Transit &amp; Operations Utility
				</span>
				<span class="text-mapa-muted">
					Schedules + Anonymous Commuter Sightings
				</span>
			</div>
			<h1 class="font-serif text-3xl sm:text-4xl font-extrabold tracking-tight text-mapa-ink">
				Train Arrival PH: MRT-3, LRT-1 &amp; LRT-2 Tracker
			</h1>
			<p class="mt-2 text-sm sm:text-base text-mapa-ink/80 font-sans leading-relaxed max-w-3xl">
				Operators in Metro Manila do not publish public train GPS feeds. This tracker surfaces anonymous commuter sightings from the past 15 minutes when available and falls back transparently to official dispatch cadence, first and last trips, and gate cutoffs in Philippine Standard Time.
			</p>
		</div>

		<!-- Step 1: Prominent Rail Line Switcher (Primary Hero Control) -->
		<section aria-label="Select Metro Manila Rail Line" class="mb-5 font-sans">
			<div class="flex items-center justify-between gap-2 mb-2">
				<span class="text-xs font-bold uppercase tracking-wider text-mapa-muted">
					1. Select Rail Line
				</span>
				<span id="feedConnectionPill" class="inline-flex items-center gap-1.5 text-[11px] font-medium text-mapa-muted">
					<span id="feedConnectionDot" class="w-2 h-2 rounded-full bg-mapa-clay shrink-0"></span>
					<span id="feedConnectionText">Checking rider feed...</span>
				</span>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="tablist" aria-label="Metro Manila rail lines">
				{orderedLines.map((line) => {
					const lineHex = LINE_COLORS[line.id];
					const isDefault = line.id === 'mrt3';
					return (
						<button
							type="button"
							role="tab"
							aria-selected={isDefault ? 'true' : 'false'}
							data-line-tab={line.id}
							class={`line-tab-btn text-left rounded-xl px-4 py-3 border transition-colors cursor-pointer flex items-center justify-between gap-3 ${
								isDefault
									? 'bg-mapa-canvas border-mapa-ink shadow-xs'
									: 'bg-mapa-canvas-dark border-mapa-contour hover:border-mapa-ink/40'
							}`}
							style={isDefault ? `border-left: 4px solid ${lineHex};` : `border-left: 4px solid transparent;`}
						>
							<div class="min-w-0">
								<div class="flex items-center gap-2">
									<span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background-color: ${lineHex};`}></span>
									<span class="font-serif font-bold text-base text-mapa-ink">{line.shortName}</span>
									<span class="text-xs font-medium text-mapa-muted">{line.name}</span>
								</div>
								<p class="text-[11px] text-mapa-muted mt-0.5 truncate">
									{line.terminals.replace('<->', '↔')}
								</p>
							</div>
							<span class="shrink-0 text-[11px] font-mono font-semibold text-mapa-ink/75 px-2 py-0.5 rounded bg-mapa-canvas-dark border border-mapa-contour/80">
								{line.stationsCount} stops
							</span>
						</button>
					);
				})}
			</div>
		</section>

		<!-- Step 2: Station Bar, Manila Clock & Day Mode -->
		<section aria-label="Station Selection and Clock Controls" class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-4 sm:p-5 mb-6 font-sans shadow-xs space-y-3.5">
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
				<!-- Station Dropdown + GPS button -->
				<div class="flex-1 flex flex-col sm:flex-row sm:items-center gap-2.5">
					<label for="stationSelect" class="text-xs font-bold uppercase tracking-wider text-mapa-muted shrink-0 whitespace-nowrap">
						2. Station
					</label>
					<div class="flex-1 flex items-center gap-2">
						<select
							id="stationSelect"
							class="w-full h-10 px-3 rounded-xl border border-mapa-contour bg-mapa-canvas text-sm font-semibold text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green/40 cursor-pointer"
						>
							{STATIONS_DATA.mrt3.map((st, idx) => (
								<option value={st.id} selected={idx === 0}>
									{idx + 1}. {st.name} ({st.city})
								</option>
							))}
						</select>
						<button
							type="button"
							id="gpsLocateBtn"
							class="shrink-0 h-10 px-3 rounded-xl text-xs font-semibold border border-mapa-contour bg-mapa-canvas text-mapa-ink hover:border-mapa-green hover:text-mapa-green transition-colors cursor-pointer inline-flex items-center gap-1.5 whitespace-nowrap"
							title="Snap locally to nearest station within 650m (coordinates never leave your browser)"
						>
							<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z" />
							</svg>
							<span>Use My GPS</span>
						</button>
					</div>
				</div>

				<!-- Manila Clock & Day Type Segmented Toggle -->
				<div class="flex flex-wrap items-center justify-between lg:justify-end gap-2.5">
					<div class="inline-flex items-center gap-2 h-10 px-3 rounded-xl border border-mapa-contour bg-mapa-canvas text-xs">
						<span class="text-[10px] font-bold uppercase tracking-wider text-mapa-muted whitespace-nowrap">PHT</span>
						<span id="manilaClock" class="font-mono text-sm font-bold text-mapa-ink whitespace-nowrap">--:-- --</span>
						<span id="manilaDayTag" class="hidden sm:inline text-[11px] text-mapa-muted whitespace-nowrap">Manila</span>
					</div>

					<div class="inline-flex items-center gap-0.5 p-1 h-10 rounded-xl border border-mapa-contour bg-mapa-canvas" role="group" aria-label="Schedule day mode">
						<button type="button" data-day-btn="auto" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white">
							Auto
						</button>
						<button type="button" data-day-btn="weekday" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink">
							Weekday
						</button>
						<button type="button" data-day-btn="weekend" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/75 hover:text-mapa-ink">
							Weekend
						</button>
					</div>
				</div>
			</div>

			<!-- Quick Hub Shortcuts Row -->
			<div class="pt-3 border-t border-mapa-contour/60 flex flex-wrap items-center gap-1.5">
				<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-muted mr-1 whitespace-nowrap">
					Quick Hubs:
				</span>
				{quickHubs.map((hub) => (
					<button
						type="button"
						data-hub-line={hub.line}
						data-hub-station={hub.st.id}
						class="quick-hub-btn h-7 px-2.5 rounded-lg text-xs font-medium border border-mapa-contour bg-mapa-canvas text-mapa-ink/85 hover:border-mapa-ink transition-colors cursor-pointer whitespace-nowrap"
					>
						{hub.label}
					</button>
				))}
				<span id="stationMetaNote" class="ml-auto text-[11px] text-mapa-muted hidden md:inline">
					North Avenue (Quezon City) &bull; km 0.0
				</span>
			</div>

			<div id="gpsStatusBanner" class="hidden rounded-xl border border-mapa-contour bg-mapa-canvas px-3.5 py-2 text-xs text-mapa-ink/85 leading-snug"></div>
			<div id="serviceAlertBanner" class="hidden rounded-xl border px-3.5 py-2.5 text-xs font-medium"></div>
		</section>

		<!-- Directional Arrival Departure Boards (Always Side-by-Side Above Corridor List) -->
		<section aria-label="Next Train Arrival Estimates" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 font-sans">
			<!-- Forward Bound Card -->
			<div id="cardFwd" class="rounded-2xl border border-mapa-contour bg-mapa-canvas-dark p-5 flex flex-col justify-between gap-4 shadow-2xs">
				<div>
					<div class="flex items-start justify-between gap-3 mb-3">
						<div class="min-w-0">
							<div class="flex items-center gap-2">
								<span id="fwdLineDot" class="w-2.5 h-2.5 rounded-full shrink-0" style={`background-color: ${LINE_COLORS.mrt3};`}></span>
								<h2 id="fwdDirPill" class="font-serif text-lg font-bold text-mapa-ink whitespace-nowrap">
									Southbound
								</h2>
							</div>
							<p id="fwdDestLabel" class="text-xs text-mapa-muted mt-0.5 truncate">
								Towards Taft Avenue
							</p>
						</div>
						<span id="fwdStatusChip" class="shrink-0 text-xs font-semibold text-mapa-green whitespace-nowrap">
							Operating
						</span>
					</div>

					<div class="rounded-xl bg-mapa-canvas border border-mapa-contour p-4">
						<div class="flex items-baseline justify-between gap-2 flex-wrap">
							<div id="fwdCountdown" class="font-mono text-2xl sm:text-3xl font-extrabold text-mapa-ink">
								~4 min
							</div>
							<div id="fwdExactTime" class="font-mono text-xs sm:text-sm font-semibold text-mapa-ink/75">
								Est. --:-- --
							</div>
						</div>
						<div class="mt-2 flex items-center gap-2 flex-wrap text-xs">
							<span id="fwdSourceBadge" class="font-semibold text-mapa-muted">
								Schedule estimate
							</span>
						</div>
						<p id="fwdLiveDetail" class="mt-1 text-xs text-mapa-ink/75 leading-snug">
							Loading schedule baseline...
						</p>
					</div>
				</div>

				<div class="grid grid-cols-3 gap-2 pt-3 border-t border-mapa-contour/70 text-xs">
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">First Train</span>
						<span id="fwdFirstTime" class="font-mono font-bold text-mapa-ink">--:--</span>
					</div>
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Last Train</span>
						<span id="fwdLastTime" class="font-mono font-bold text-mapa-rust">--:--</span>
					</div>
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Gate Cutoff</span>
						<span id="fwdCutoffTime" class="font-mono font-bold text-mapa-ink">--:--</span>
					</div>
				</div>
			</div>

			<!-- Reverse Bound Card -->
			<div id="cardRev" class="rounded-2xl border border-mapa-contour bg-mapa-canvas-dark p-5 flex flex-col justify-between gap-4 shadow-2xs">
				<div>
					<div class="flex items-start justify-between gap-3 mb-3">
						<div class="min-w-0">
							<div class="flex items-center gap-2">
								<span id="revLineDot" class="w-2.5 h-2.5 rounded-full shrink-0" style={`background-color: ${LINE_COLORS.mrt3};`}></span>
								<h2 id="revDirPill" class="font-serif text-lg font-bold text-mapa-ink whitespace-nowrap">
									Northbound
								</h2>
							</div>
							<p id="revDestLabel" class="text-xs text-mapa-muted mt-0.5 truncate">
								Towards North Avenue
							</p>
						</div>
						<span id="revStatusChip" class="shrink-0 text-xs font-semibold text-mapa-green whitespace-nowrap">
							Operating
						</span>
					</div>

					<div class="rounded-xl bg-mapa-canvas border border-mapa-contour p-4">
						<div class="flex items-baseline justify-between gap-2 flex-wrap">
							<div id="revCountdown" class="font-mono text-2xl sm:text-3xl font-extrabold text-mapa-ink">
								~5 min
							</div>
							<div id="revExactTime" class="font-mono text-xs sm:text-sm font-semibold text-mapa-ink/75">
								Est. --:-- --
							</div>
						</div>
						<div class="mt-2 flex items-center gap-2 flex-wrap text-xs">
							<span id="revSourceBadge" class="font-semibold text-mapa-muted">
								Schedule estimate
							</span>
						</div>
						<p id="revLiveDetail" class="mt-1 text-xs text-mapa-ink/75 leading-snug">
							Loading schedule baseline...
						</p>
					</div>
				</div>

				<div class="grid grid-cols-3 gap-2 pt-3 border-t border-mapa-contour/70 text-xs">
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">First Train</span>
						<span id="revFirstTime" class="font-mono font-bold text-mapa-ink">--:--</span>
					</div>
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Last Train</span>
						<span id="revLastTime" class="font-mono font-bold text-mapa-rust">--:--</span>
					</div>
					<div>
						<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Gate Cutoff</span>
						<span id="revCutoffTime" class="font-mono font-bold text-mapa-ink">--:--</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Main 2-Column Interactive Workspace (Adapted & Upgraded from rail-transit.astro) -->
		<section aria-label="Station Corridor and Live Commuter Reporting" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mb-12 font-sans">
			<!-- Left Column (7 cols): Connected Station Line Spine with Inline Train & Rider Indicators -->
			<div class="lg:col-span-7 bg-mapa-canvas-dark border border-mapa-contour rounded-2xl overflow-hidden shadow-xs">
				<div class="p-4 border-b border-mapa-contour bg-mapa-canvas flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div>
						<h2 id="corridorHeading" class="font-serif text-lg font-bold text-mapa-ink">
							MRT Line 3 Station Corridor
						</h2>
						<p id="lineOperatorMeta" class="text-[11px] text-mapa-muted">
							Department of Transportation (DOTr MRT-3) &bull; Tap any station to inspect arrivals
						</p>
					</div>
					<div class="relative w-full sm:w-52 shrink-0">
						<input
							id="stationFilterInput"
							type="search"
							placeholder="Filter stations..."
							aria-label="Filter stations on active line"
