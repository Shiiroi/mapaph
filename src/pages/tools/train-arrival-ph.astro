			function getOrCreateClientToken() {
				try {
					let existing = window.localStorage.getItem(CLIENT_TOKEN_KEY);
					if (existing && existing.length >= 12) return existing;
					const rand =
						typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
							? crypto.randomUUID().replace(/-/g, '')
							: String(Date.now()) + Math.random().toString(36).slice(2, 14);
					window.localStorage.setItem(CLIENT_TOKEN_KEY, rand);
					return rand;
				} catch (_err) {
					return 'anon_' + Math.random().toString(36).slice(2, 14);
				}
			}

			function loadLocalPreviewSightings() {
				try {
					const raw = window.localStorage.getItem(LOCAL_PREVIEW_KEY);
					if (!raw) return [];
					const parsed = JSON.parse(raw);
					if (!Array.isArray(parsed)) return [];
					const now = Date.now();
					return parsed.filter((item) => item && item.created_at && now - Date.parse(item.created_at) <= LIVE_WINDOW_MS);
				} catch (_err) {
					return [];
				}
			}

			function saveLocalPreviewSightings(items) {
				try {
					const now = Date.now();
					const fresh = items.filter((item) => item && item.created_at && now - Date.parse(item.created_at) <= LIVE_WINDOW_MS);
					window.localStorage.setItem(LOCAL_PREVIEW_KEY, JSON.stringify(fresh.slice(0, 25)));
				} catch (_err) {
					// Non-fatal if storage quota is disabled in private mode
				}
			}

			function getManilaClock() {
				const now = new Date();
				const fmt = new Intl.DateTimeFormat('en-US', {
					timeZone: 'Asia/Manila',
					weekday: 'short',
					hour: 'numeric',
					minute: '2-digit',
					second: '2-digit',
					hour12: true
				});
				const numFmt = new Intl.DateTimeFormat('en-US', {
					timeZone: 'Asia/Manila',
					weekday: 'short',
					hour: '2-digit',
					minute: '2-digit',
					hour12: false
				});
				const parts = numFmt.formatToParts(now);
				const map = {};
				parts.forEach((p) => {
					map[p.type] = p.value;
				});
				const wd = (map.weekday || '').toLowerCase();
				const hour = Number(map.hour || 0) % 24;
				const minute = Number(map.minute || 0);
				const isWeekendAuto = wd.startsWith('sat') || wd.startsWith('sun');
				const timeStr = fmt.format(now);
				return {
					nowMs: now.getTime(),
					totalMin: hour * 60 + minute,
					isWeekendAuto,
					weekdayLabel: map.weekday || 'Today',
					formatted: timeStr
				};
			}

			function fmt12h(totalMinutes) {
				const wrapped = ((Math.round(totalMinutes) % 1440) + 1440) % 1440;
				const h24 = Math.floor(wrapped / 60);
				const m = wrapped % 60;
				const ampm = h24 >= 12 ? 'PM' : 'AM';
				const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
				return h12 + ':' + String(m).padStart(2, '0') + ' ' + ampm;
			}

			function formatAgeMinutes(createdAtIso, nowMs) {
				const createdMs = Date.parse(createdAtIso);
				if (Number.isNaN(createdMs)) return 'recent';
				const diffSec = Math.max(0, Math.round((nowMs - createdMs) / 1000));
				if (diffSec < 60) return 'just now';
				const mins = Math.floor(diffSec / 60);
				return mins + 'm ago';
			}

			function getEffectiveIsWeekend(clock) {
				if (dayMode === 'weekend') return true;
				if (dayMode === 'weekday') return false;
				return clock.isWeekendAuto;
			}

			function getHeadwayRange(spec, nowMin, isWeekend) {
				if (nowMin >= 20 * 60 + 30 || nowMin < 5 * 60 + 30) {
					return spec.lateNightHeadwayMin;
				}
				if (isWeekend) {
					return spec.weekendHeadwayMin;
				}
				const inMorningPeak = nowMin >= spec.peakMorningStartMin && nowMin <= spec.peakMorningEndMin;
				const inEveningPeak = nowMin >= spec.peakEveningStartMin && nowMin <= spec.peakEveningEndMin;
				if (inMorningPeak || inEveningPeak) {
					return spec.peakHeadwayMin;
				}
				return spec.offPeakHeadwayMin;
			}

			function findStationById(lineKey, stationId) {
				const list = stationsData[lineKey] || [];
				return list.find((s) => s.id === stationId) || list[0];
			}

			function getTimetableEntry(lineKey, stationId) {
				const table = timetablesByLine[lineKey] || [];
				return table.find((row) => row.station.id === stationId) || table[0];
			}

			function haversineMeters(lat1, lon1, lat2, lon2) {
				const R = 6371000;
				const toRad = (d) => (d * Math.PI) / 180;
				const dLat = toRad(lat2 - lat1);
				const dLon = toRad(lon2 - lon1);
				const a =
					Math.sin(dLat / 2) * Math.sin(dLat / 2) +
					Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
				return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
			}

			function getAllCombinedSightings(nowMs) {
				const isFresh = (s) => {
					if (!s || !s.created_at) return false;
					const ts = Date.parse(s.created_at);
					return !Number.isNaN(ts) && nowMs - ts <= LIVE_WINDOW_MS;
				};
				const freshRemote = remoteSightings.filter(isFresh);
				const freshLocal = localPreviewSightings.filter(isFresh);
				const merged = freshRemote.concat(freshLocal);
				merged.sort((a, b) => Date.parse(b.created_at) - Date.parse(a.created_at));
				return merged;
			}

			function setFeedBadge(state, text) {
				feedStatus = { state, message: text };
				feedConnectionText.textContent = text;
				feedConnectionDot.className = 'w-2 h-2 rounded-full shrink-0';
				if (state === 'connected') {
					feedConnectionDot.classList.add('bg-emerald-500');
					feedConnectionPill.className =
						'shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-semibold border border-emerald-600/30 bg-emerald-600/10 text-emerald-800 whitespace-nowrap self-start sm:self-center';
				} else if (state === 'checking') {
					feedConnectionDot.classList.add('bg-amber-500', 'animate-pulse');
					feedConnectionPill.className =
						'shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-semibold border border-mapa-contour bg-mapa-canvas text-mapa-muted whitespace-nowrap self-start sm:self-center';
				} else {
					feedConnectionDot.classList.add('bg-amber-600');
					feedConnectionPill.className =
						'shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-semibold border border-amber-600/35 bg-amber-500/10 text-amber-800 whitespace-nowrap self-start sm:self-center';
				}
			}

			async function fetchLiveSightings() {
				if (!supabaseUrl || !supabaseAnonKey) {
					remoteSightings = [];
					setFeedBadge('unconfigured', 'Schedule Mode (Public Supabase Env Missing)');
					renderAll();
					return;
				}

				const sinceIso = new Date(Date.now() - LIVE_WINDOW_MS).toISOString();
				const endpoint =
					supabaseUrl +
					'/rest/v1/rail_sightings?select=id,line_key,station_id,direction,report_type,source_kind,crowd_level,created_at' +
					'&line_key=eq.' +
					encodeURIComponent(currentLine) +
					'&created_at=gte.' +
					encodeURIComponent(sinceIso) +
					'&order=created_at.desc&limit=50';

				try {
					const res = await fetch(endpoint, {
						headers: {
							apikey: supabaseAnonKey,
							Authorization: 'Bearer ' + supabaseAnonKey,
							Accept: 'application/json'
						}
					});

					if (!res.ok) {
						let errDetail = 'HTTP ' + res.status;
						try {
							const body = await res.json();
							if (body && body.message) errDetail += ' - ' + body.message;
							if (res.status === 404 || (body && body.code === 'PGRST205')) {
								setFeedBadge('migration_pending', 'Schedule Mode (Run SQL Migration for Shared Feed)');
								remoteSightings = [];
								renderAll();
								return;
							}
						} catch (_parseErr) {
							// keep HTTP status fallback
						}
						setFeedBadge('error', 'Live Feed Offline (' + errDetail + ')');
						remoteSightings = [];
						renderAll();
						return;
					}

					const rows = await res.json();
					remoteSightings = Array.isArray(rows) ? rows : [];
					const count = remoteSightings.length;
					setFeedBadge(
						'connected',
						count > 0 ? 'Shared Feed Connected (' + count + ' recent)' : 'Shared Feed Connected (0 sightings)'
					);
					renderAll();
				} catch (err) {
					const msg = err && err.message ? err.message : 'Network error';
					setFeedBadge('error', 'Live Feed Unreachable (' + msg + ')');
					remoteSightings = [];
					renderAll();
				}
			}

			function computeDirectionModel(dirKey, clock, isWeekend, lineSightings) {
				const spec = specsData[currentLine];
				const dirSpec = dirKey === 'fwd' ? spec.forward : spec.reverse;
				const entry = getTimetableEntry(currentLine, currentStationId);
				const firstMin =
					dirKey === 'fwd'
						? isWeekend
							? entry.weekendFirstFwd
							: entry.weekdayFirstFwd
						: isWeekend
						? entry.weekendFirstRev
						: entry.weekdayFirstRev;
				const lastMin =
					dirKey === 'fwd'
						? isWeekend
							? entry.weekendLastFwd
							: entry.weekdayLastFwd
						: isWeekend
						? entry.weekendLastRev
						: entry.weekdayLastRev;
				const termFirst = isWeekend ? dirSpec.weekendFirstMin : dirSpec.weekdayFirstMin;
				const termLast = isWeekend ? dirSpec.weekendLastMin : dirSpec.weekdayLastMin;
				const offset = dirKey === 'fwd' ? entry.offsetForwardMin : entry.offsetReverseMin;
				const cutoffMin = lastMin - spec.gateCutoffBeforeLastMin;

				const headwayRange = getHeadwayRange(spec, clock.totalMin, isWeekend);
				const avgHeadway = (headwayRange[0] + headwayRange[1]) / 2;

				let statusText = 'Operating';
				let statusTone = 'open';
				let estWaitMin = null;
				let estArrivalStr = 'Ended';
				let nextScheduledArrMin = null;

				if (clock.totalMin < spec.gateOpenMin) {
					statusText = 'Closed';
					statusTone = 'closed';
					estWaitMin = firstMin - clock.totalMin;
					estArrivalStr = 'First: ' + fmt12h(firstMin);
					nextScheduledArrMin = firstMin;
				} else if (clock.totalMin < firstMin) {
					statusText = 'Opening Soon';
					statusTone = 'warn';
					estWaitMin = firstMin - clock.totalMin;
					estArrivalStr = 'First: ' + fmt12h(firstMin);
					nextScheduledArrMin = firstMin;
				} else if (clock.totalMin > lastMin) {
					statusText = 'Service Ended';
					statusTone = 'closed';
					estWaitMin = null;
					estArrivalStr = 'Use EDSA Carousel (24/7)';
				} else {
					if (clock.totalMin >= cutoffMin) {
						statusText = 'Last Train / Gate Cutoff';
						statusTone = 'warn';
					}
					// Walk deterministic departures spaced by avgHeadway from terminal
					const elapsedSinceFirst = Math.max(0, clock.totalMin - firstMin);
					const k = Math.ceil(elapsedSinceFirst / avgHeadway);
					let candidate = Math.round(firstMin + k * avgHeadway);
					if (candidate < clock.totalMin) candidate = clock.totalMin + 1;
					if (candidate > lastMin) candidate = lastMin;
					nextScheduledArrMin = candidate;
					estWaitMin = Math.max(0, candidate - clock.totalMin);
					estArrivalStr = 'Est. ' + fmt12h(candidate);
				}

				// Check live crowdsourced sightings for this direction
				const selIdx = entry.index;
				const dirReports = lineSightings.filter((s) => s.direction === dirKey);

				let liveMatch = null;
				let liveDelayed = null;
				let latestCrowd = null;

				for (let i = 0; i < dirReports.length; i++) {
					const rep = dirReports[i];
					if (!latestCrowd && rep.crowd_level) {
						latestCrowd = rep;
					}
					if (rep.report_type === 'delayed' && !liveDelayed) {
						liveDelayed = rep;
					}
					if (rep.report_type === 'arriving' || rep.report_type === 'on_board') {
						const repEntry = getTimetableEntry(currentLine, rep.station_id);
						const ageMin = Math.max(0, (clock.nowMs - Date.parse(rep.created_at)) / 60000);
						if (rep.station_id === currentStationId && ageMin <= 5) {
							liveMatch = {
								kind: 'at_station',
								report: rep,
								stationName: repEntry.station.name,
								ageStr: formatAgeMinutes(rep.created_at, clock.nowMs),
								etaMin: 0
							};
							break;
						}
						const isUpstream = dirKey === 'fwd' ? repEntry.index < selIdx : repEntry.index > selIdx;
						if (isUpstream && ageMin <= 14) {
							const repOffset = dirKey === 'fwd' ? repEntry.offsetForwardMin : repEntry.offsetReverseMin;
							const segDelta = Math.max(1, offset - repOffset);
							const eta = Math.round(segDelta - ageMin);
							if (eta >= -1 && eta <= 18) {
								liveMatch = {
									kind: 'approaching',
									report: rep,
									stationName: repEntry.station.name,
									ageStr: formatAgeMinutes(rep.created_at, clock.nowMs),
									etaMin: Math.max(0, eta)
								};
								break;
							}
						}
					}
				}

				return {
					dirSpec,
					firstMin,
					lastMin,
					cutoffMin,
					avgHeadway,
					headwayRange,
					statusText,
					statusTone,
					estWaitMin,
					estArrivalStr,
					nextScheduledArrMin,
					liveMatch,
					liveDelayed,
					latestCrowd,
					termFirst,
					termLast
				};
			}

			function renderDirectionCard(prefix, model) {
				const dirPill = document.getElementById(prefix + 'DirPill');
				const sourceBadge = document.getElementById(prefix + 'SourceBadge');
				const destLabel = document.getElementById(prefix + 'DestLabel');
				const statusChip = document.getElementById(prefix + 'StatusChip');
				const headline = document.getElementById(prefix + 'PrimaryHeadline');
				const countdown = document.getElementById(prefix + 'Countdown');
				const exactTime = document.getElementById(prefix + 'ExactTime');
				const liveDetail = document.getElementById(prefix + 'LiveDetail');
				const firstEl = document.getElementById(prefix + 'FirstTime');
				const lastEl = document.getElementById(prefix + 'LastTime');
				const cutoffEl = document.getElementById(prefix + 'CutoffTime');

				dirPill.textContent = model.dirSpec.shortDir;
				destLabel.textContent = 'Towards ' + model.dirSpec.destinationTerminal;

				statusChip.textContent = model.statusText;
				statusChip.className = 'shrink-0 px-2.5 py-1 rounded-full text-[11px] font-bold whitespace-nowrap border';
				if (model.statusTone === 'open') {
					statusChip.classList.add('bg-mapa-green/15', 'text-mapa-green', 'border-mapa-green/30');
				} else if (model.statusTone === 'warn') {
					statusChip.classList.add('bg-amber-500/15', 'text-amber-800', 'border-amber-600/35');
				} else {
					statusChip.classList.add('bg-mapa-rust/15', 'text-mapa-rust', 'border-mapa-rust/35');
				}

				firstEl.textContent = fmt12h(model.firstMin);
				lastEl.textContent = fmt12h(model.lastMin);
				cutoffEl.textContent = fmt12h(model.cutoffMin);

				const estWaitLabel =
					model.estWaitMin === null
						? 'Ended'
						: model.estWaitMin === 0
						? 'Due now'
						: '~' + model.estWaitMin + ' min';

				if (model.liveMatch) {
					const lm = model.liveMatch;
					const isLocalOnly = Boolean(lm.report.isLocalOnly);
					sourceBadge.textContent = isLocalOnly ? 'LOCAL PREVIEW PIN' : 'LIVE RIDER SIGHTING';
					sourceBadge.className =
						'px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wide border whitespace-nowrap ' +
						(isLocalOnly
							? 'border-amber-600/40 bg-amber-500/15 text-amber-800'
							: 'border-emerald-600/40 bg-emerald-600/15 text-emerald-800');
					headline.textContent =
						lm.kind === 'at_station' ? 'Live Commuter Report (On Platform)' : 'Live Commuter Train Approaching';
					countdown.textContent =
						lm.etaMin === 0 ? 'Arriving / Boarding' : '~' + lm.etaMin + ' min away';
					exactTime.textContent = 'Reported ' + lm.ageStr + (lm.report.source_kind === 'gps_snap' ? ' (GPS)' : '');

					let msg =
						lm.kind === 'at_station'
							? 'Passenger reported train at ' + lm.stationName + ' ' + lm.ageStr + '.'
							: 'Spotted at ' + lm.stationName + ' (' + lm.ageStr + ').';
					msg += ' Schedule baseline: ' + estWaitLabel + ' (' + model.estArrivalStr + ').';
					if (model.liveDelayed) {
						msg += ' Caution: Delay reported recently.';
					}
					liveDetail.textContent = msg;
				} else {
					sourceBadge.textContent = 'ESTIMATED • SCHEDULE';
					sourceBadge.className =
						'px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wide border border-mapa-contour bg-mapa-canvas-dark text-mapa-navy whitespace-nowrap';
					headline.textContent = model.estWaitMin === null ? 'Service Window' : 'Estimated Next Train (No Live Reports)';
					countdown.textContent = estWaitLabel;
					exactTime.textContent = model.estArrivalStr;

					let fallbackNote =
						model.estWaitMin === null
							? 'Outside operating hours. Night riders use 24/7 EDSA Carousel.'
							: 'Headway cadence: every ' + model.headwayRange[0] + '-' + model.headwayRange[1] + ' mins. Be the first on platform to check in.';
					if (model.liveDelayed) {
						fallbackNote = 'Delay alert reported recently on this direction. ' + fallbackNote;
					} else if (model.latestCrowd) {
						fallbackNote += ' Crowd reported: ' + model.latestCrowd.crowd_level.toUpperCase() + '.';
					}
					liveDetail.textContent = fallbackNote;
				}
			}

			function renderCorridorTrack(clock, isWeekend, lineSightings) {
				const stations = stationsData[currentLine];
				const spec = specsData[currentLine];
				const maxIdx = stations.length - 1;
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];

				stripLeftLabel.textContent = stations[0].name;
				stripRightLabel.textContent = stations[maxIdx].name;

				trackStationsLayer.innerHTML = '';
				trackEstTrainsLayer.innerHTML = '';
				trackLivePinsLayer.innerHTML = '';
				trackLabelsLayer.innerHTML = '';

				// Index live sightings by station
				const sightingsByStation = {};
				lineSightings.forEach((s) => {
					if (!sightingsByStation[s.station_id]) sightingsByStation[s.station_id] = [];
					sightingsByStation[s.station_id].push(s);
				});

				stations.forEach((st, idx) => {
					const pct = (2 + (idx / maxIdx) * 96).toFixed(3);
					const isSelected = st.id === currentStationId;
					const hasLive = Boolean(sightingsByStation[st.id] && sightingsByStation[st.id].length > 0);

					// Station touch wrapper centered directly on top-1/2 -translate-y-1/2
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className =
						'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center cursor-pointer group focus:outline-none ' +
						(isSelected ? 'z-30' : 'z-10 hover:z-20');
					btn.style.left = pct + '%';
					btn.title = st.name + ' (' + st.city + ')';
					btn.setAttribute('aria-label', 'Select ' + st.name);

					const dot = document.createElement('span');
					dot.className = 'block rounded-full border-2 border-mapa-canvas transition-transform shadow-2xs';
					if (isSelected) {
						dot.classList.add('w-4', 'h-4', 'scale-110');
						dot.style.backgroundColor = lineMeta.color;
						dot.style.boxShadow = '0 0 0 3px rgba(61, 90, 69, 0.28)';
					} else if (hasLive) {
						dot.classList.add('w-3.5', 'h-3.5', 'bg-emerald-600');
					} else if (st.isTransfer) {
						dot.classList.add('w-3', 'h-3', 'bg-mapa-navy');
					} else {
						dot.classList.add('w-2.5', 'h-2.5', 'bg-mapa-contour');
					}

					btn.appendChild(dot);
					btn.addEventListener('click', () => {
						currentStationId = st.id;
						stationSelect.value = st.id;
						updateUrlParams();
						renderAll();
					});
					trackStationsLayer.appendChild(btn);

					// Label only selected station inside trackLabelsLayer to guarantee zero overlapping text across 25 stops
					if (isSelected) {
						const lbl = document.createElement('span');
						lbl.className = 'absolute top-0 font-bold text-mapa-ink bg-mapa-canvas-dark px-2 py-0.5 rounded border border-mapa-contour whitespace-nowrap shadow-2xs';
						lbl.style.left = pct + '%';
						if (idx <= 1) {
							lbl.style.transform = 'translateX(-10%)';
						} else if (idx >= maxIdx - 1) {
							lbl.style.transform = 'translateX(-90%)';
						} else {
							lbl.style.transform = 'translateX(-50%)';
						}
						lbl.textContent = st.name;
						trackLabelsLayer.appendChild(lbl);
					}

					// Plot pulsing LIVE rider pin above/on track centered on top-1/2 -translate-y-1/2
					if (hasLive) {
						const rep = sightingsByStation[st.id][0];
						const pin = document.createElement('span');
						pin.className =
							'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 z-40 inline-flex items-center justify-center w-6 h-6 rounded-full ' +
							(rep.report_type === 'delayed' ? 'bg-mapa-rust/25' : 'bg-emerald-500/30') +
							' animate-ping';
						pin.style.left = pct + '%';
						trackLivePinsLayer.appendChild(pin);
					}
				});

				// Plot estimated schedule cadence trains (deterministic from terminal dispatch & headway)
				const endTable = timetablesByLine[currentLine];
				const totalFwdTrip = endTable[maxIdx].offsetForwardMin;
				const totalRevTrip = endTable[0].offsetReverseMin;
				const headwayRange = getHeadwayRange(spec, clock.totalMin, isWeekend);
				const avgHeadway = (headwayRange[0] + headwayRange[1]) / 2;

				const fwdFirst = isWeekend ? spec.forward.weekendFirstMin : spec.forward.weekdayFirstMin;
				const fwdLast = isWeekend ? spec.forward.weekendLastMin : spec.forward.weekdayLastMin;
				const revFirst = isWeekend ? spec.reverse.weekendFirstMin : spec.reverse.weekdayFirstMin;
				const revLast = isWeekend ? spec.reverse.weekendLastMin : spec.reverse.weekdayLastMin;

				// Forward estimated markers
				for (let d = fwdFirst; d <= fwdLast; d += avgHeadway) {
					const elapsed = clock.totalMin - d;
					if (elapsed >= 0 && elapsed <= totalFwdTrip) {
						const progress = elapsed / Math.max(1, totalFwdTrip);
						const xPct = (2 + progress * 96).toFixed(2);
						const marker = document.createElement('span');
						marker.className =
							'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-sm border border-mapa-navy bg-mapa-canvas text-[8px] font-bold text-mapa-navy flex items-center justify-center shadow-2xs z-20';
						marker.style.left = xPct + '%';
						marker.textContent = '>';
						trackEstTrainsLayer.appendChild(marker);
					}
				}

				// Reverse estimated markers
				for (let d = revFirst; d <= revLast; d += avgHeadway) {
					const elapsed = clock.totalMin - d;
					if (elapsed >= 0 && elapsed <= totalRevTrip) {
						const progress = 1 - elapsed / Math.max(1, totalRevTrip);
						const xPct = (2 + progress * 96).toFixed(2);
						const marker = document.createElement('span');
						marker.className =
							'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-sm border border-mapa-green bg-mapa-canvas text-[8px] font-bold text-mapa-green flex items-center justify-center shadow-2xs z-20';
						marker.style.left = xPct + '%';
						marker.textContent = '<';
						trackEstTrainsLayer.appendChild(marker);
					}
				}
			}

			function renderSightingsList(clock, lineSightings) {
				if (!lineSightings.length) {
					liveSightingsList.innerHTML = '';
					const emptyBox = document.createElement('div');
					const isOfflineState =
						feedStatus.state === 'error' ||
						feedStatus.state === 'migration_pending' ||
						feedStatus.state === 'unconfigured';
					emptyBox.className = isOfflineState
						? 'rounded-lg border border-amber-600/35 bg-amber-500/10 px-3.5 py-2.5 text-amber-900'
						: 'rounded-lg border border-dashed border-mapa-contour px-3.5 py-2.5 text-mapa-muted';
					emptyBox.textContent = isOfflineState
						? feedStatus.message + '. Directional arrivals above are using published schedule cadence math.'
						: 'No rider sightings reported on this line in the past 15 minutes. Directional arrivals above are using published schedule cadence math.';
					liveSightingsList.appendChild(emptyBox);
					return;
				}

				const spec = specsData[currentLine];
				liveSightingsList.innerHTML = '';
				lineSightings.slice(0, 8).forEach((item) => {
					const st = findStationById(currentLine, item.station_id);
					const dirName = item.direction === 'fwd' ? spec.forward.shortDir : spec.reverse.shortDir;
					const reportLabels = {
						arriving: 'Train Arriving / Boarding',
						on_board: 'Rider On Board',
						crowded: 'Platform Packed / Long Queue',
						delayed: 'Delay / Train Hold Reported'
					};
					const row = document.createElement('div');
					row.className =
						'flex flex-wrap items-center justify-between gap-2 rounded-lg border border-mapa-contour/80 bg-mapa-canvas-dark px-3 py-2';

					const left = document.createElement('div');
					left.className = 'flex items-center gap-2 flex-wrap';

					const badge = document.createElement('span');
					badge.className =
						'px-2 py-0.5 rounded text-[10px] font-bold uppercase ' +
						(item.isLocalOnly
							? 'bg-amber-500/15 text-amber-800 border border-amber-600/30'
							: 'bg-emerald-600/15 text-emerald-800 border border-emerald-600/30');
					badge.textContent = item.isLocalOnly ? 'Local Preview' : item.source_kind === 'gps_snap' ? 'GPS Verified' : 'Live Rider';

					const desc = document.createElement('span');
					desc.className = 'font-medium text-mapa-ink';
					desc.textContent =
						(reportLabels[item.report_type] || item.report_type) +
						' at ' +
						st.name +
						' (' +
						dirName +
						')';

					left.appendChild(badge);
					left.appendChild(desc);

					if (item.crowd_level) {
						const crowd = document.createElement('span');
						crowd.className = 'px-1.5 py-0.5 rounded bg-mapa-canvas border border-mapa-contour text-[10px] text-mapa-muted uppercase font-semibold';
						crowd.textContent = item.crowd_level;
						left.appendChild(crowd);
					}

					const right = document.createElement('span');
					right.className = 'font-mono text-[11px] text-mapa-muted';
					right.textContent = formatAgeMinutes(item.created_at, clock.nowMs);

					row.appendChild(left);
					row.appendChild(right);
					liveSightingsList.appendChild(row);
				});
			}

			function renderAll() {
				const clock = getManilaClock();
				const isWeekend = getEffectiveIsWeekend(clock);
				const spec = specsData[currentLine];
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];
				const station = findStationById(currentLine, currentStationId);

				manilaClockEl.textContent = clock.formatted;
				manilaDayTagEl.textContent = clock.weekdayLabel + ' (' + (isWeekend ? 'Weekend/Holiday' : 'Weekday') + ')';

				lineOperatorMeta.textContent = lineMeta.operator + ' • ' + lineMeta.stationsCount + ' Stations';
				stationMetaNote.textContent =
					station.name + ' (' + station.city + ') • km ' + station.km.toFixed(1) + (station.transferLabel ? ' • ' + station.transferLabel : '');
				checkInStationLabel.textContent = station.name;

				// Update GPS verified pill visibility
				if (gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId) {
					gpsVerifiedTag.classList.remove('hidden');
				} else {
					gpsVerifiedTag.classList.add('hidden');
				}

				// Update Check-In direction labels to match active line (e.g. Eastbound/Westbound for LRT-2)
				document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
					const dir = btn.getAttribute('data-checkin-dir');
					btn.textContent = dir === 'fwd' ? spec.forward.shortDir : spec.reverse.shortDir;
					if (dir === checkInDir) {
						btn.className = 'checkin-dir-btn h-8 px-2.5 rounded-md text-xs font-semibold cursor-pointer transition-colors bg-mapa-navy text-white whitespace-nowrap';
					} else {
						btn.className = 'checkin-dir-btn h-8 px-2.5 rounded-md text-xs font-semibold cursor-pointer transition-colors text-mapa-ink/80 hover:text-mapa-ink whitespace-nowrap';
					}
				});

				const allSightings = getAllCombinedSightings(clock.nowMs);
				const lineSightings = allSightings.filter((s) => s.line_key === currentLine);

				const fwdModel = computeDirectionModel('fwd', clock, isWeekend, lineSightings);
				const revModel = computeDirectionModel('rev', clock, isWeekend, lineSightings);

				renderDirectionCard('fwd', fwdModel);
				renderDirectionCard('rev', revModel);
				renderCorridorTrack(clock, isWeekend, lineSightings);
				renderSightingsList(clock, lineSightings);

				// Service Alert Banner for late-night gate cutoff or overnight transition
				const activeFwdWarn = fwdModel.statusTone === 'warn';
				const activeRevWarn = revModel.statusTone === 'warn';
				const bothClosed = fwdModel.statusTone === 'closed' && revModel.statusTone === 'closed';
				if (bothClosed) {
					serviceAlertBanner.classList.remove('hidden');
					serviceAlertBanner.className =
						'rounded-xl border border-mapa-rust/40 bg-mapa-rust/10 text-mapa-rust px-4 py-3 text-xs sm:text-sm font-medium';
					serviceAlertBanner.textContent =
						lineMeta.shortName +
						' service at ' +
						station.name +
						' is currently outside passenger hours. Overnight commuters along EDSA can take the 24/7 EDSA Carousel busway.';
				} else if (activeFwdWarn || activeRevWarn) {
					serviceAlertBanner.classList.remove('hidden');
					serviceAlertBanner.className =
						'rounded-xl border border-amber-600/40 bg-amber-500/10 text-amber-900 px-4 py-3 text-xs sm:text-sm font-medium';
					serviceAlertBanner.textContent =
						'Closing Warning: Last train gate cutoff is active or approaching within minutes. Proceed directly to platform gates now.';
				} else {
					serviceAlertBanner.classList.add('hidden');
				}
			}

			function populateStationSelect(preferredStationId) {
				const list = stationsData[currentLine] || [];
				stationSelect.innerHTML = '';
				list.forEach((st, idx) => {
					const opt = document.createElement('option');
					opt.value = st.id;
					opt.textContent = idx + 1 + '. ' + st.name + ' (' + st.city + ')';
					stationSelect.appendChild(opt);
				});
				const matched = list.find((s) => s.id === preferredStationId) || list[0];
				currentStationId = matched.id;
				stationSelect.value = currentStationId;
			}

			function updateUrlParams() {
				try {
					const url = new URL(window.location.href);
					url.searchParams.set('line', currentLine);
					url.searchParams.set('station', currentStationId);
					window.history.replaceState({}, '', url.toString());
				} catch (_err) {
					// safe ignore in restricted frames
				}
			}

			function showCheckInMessage(tone, text) {
				checkInFeedback.classList.remove('hidden');
				if (tone === 'success') {
					checkInFeedback.className =
						'mt-3 rounded-lg border border-emerald-600/35 bg-emerald-600/10 text-emerald-900 px-3 py-2 text-xs font-medium';
				} else if (tone === 'warn') {
					checkInFeedback.className =
						'mt-3 rounded-lg border border-amber-600/40 bg-amber-500/10 text-amber-900 px-3 py-2 text-xs font-medium';
				} else {
					checkInFeedback.className =
						'mt-3 rounded-lg border border-mapa-rust/40 bg-mapa-rust/10 text-mapa-rust px-3 py-2 text-xs font-medium';
				}
				checkInFeedback.textContent = text;
			}

			function startCooldownTimer() {
				cooldownUntilMs = Date.now() + COOLDOWN_MS;
				const reportBtns = document.querySelectorAll('.report-btn');
				if (cooldownInterval) clearInterval(cooldownInterval);

				function tick() {
					const rem = Math.ceil((cooldownUntilMs - Date.now()) / 1000);
					if (rem <= 0) {
						clearInterval(cooldownInterval);
						cooldownInterval = null;
						reportBtns.forEach((b) => b.removeAttribute('disabled'));
						return;
					}
					reportBtns.forEach((b) => b.setAttribute('disabled', 'true'));
				}
				tick();
				cooldownInterval = setInterval(tick, 500);
			}

			async function submitSighting(reportType) {
				const nowMs = Date.now();
				if (nowMs < cooldownUntilMs) {
					const waitSec = Math.ceil((cooldownUntilMs - nowMs) / 1000);
					showCheckInMessage('warn', 'Cooldown active: wait ' + waitSec + 's before submitting another rider report.');
					return;
				}

				const payload = {
					line_key: currentLine,
					station_id: currentStationId,
					direction: checkInDir,
					report_type: reportType,
					source_kind:
						gpsSnapState.active && gpsSnapState.lineKey === currentLine && gpsSnapState.stationId === currentStationId
							? 'gps_snap'
							: 'manual',
					crowd_level: crowdLevel,
					client_token: getOrCreateClientToken()
				};

				const station = findStationById(currentLine, currentStationId);

				// Explicit fallback handling when shared DB is not configured or unmigrated
				if (!supabaseUrl || !supabaseAnonKey) {
					const localItem = Object.assign({ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true }, payload);
					localPreviewSightings.unshift(localItem);
					saveLocalPreviewSightings(localPreviewSightings);
					showCheckInMessage(
						'warn',
						'Saved locally in your browser preview for ' + station.name + ' (public Supabase env vars are not configured for cross-user broadcast).'
					);
					startCooldownTimer();
					renderAll();
					return;
				}

				try {
					const res = await fetch(supabaseUrl + '/rest/v1/rail_sightings', {
						method: 'POST',
						headers: {
							apikey: supabaseAnonKey,
							Authorization: 'Bearer ' + supabaseAnonKey,
							'Content-Type': 'application/json',
							Prefer: 'return=representation'
						},
						body: JSON.stringify(payload)
					});

					if (!res.ok) {
						let detail = 'HTTP ' + res.status;
						let code = '';
						try {
							const errBody = await res.json();
							if (errBody && errBody.message) detail = errBody.message;
							if (errBody && errBody.code) code = errBody.code;
						} catch (_e) {
							// ignore body parse failure
						}

						if (res.status === 404 || code === 'PGRST205') {
							const localItem = Object.assign(
								{ id: 'local_' + Date.now(), created_at: new Date().toISOString(), isLocalOnly: true },
								payload
							);
							localPreviewSightings.unshift(localItem);
							saveLocalPreviewSightings(localPreviewSightings);
							showCheckInMessage(
								'warn',
								'Shared rail_sightings table is not created yet in Supabase. Saved locally in your browser preview so you can see how live pins render.'
							);
							startCooldownTimer();
							renderAll();
							return;
						}

						if (res.status === 401 || res.status === 403 || code === '42501') {
							showCheckInMessage('warn', 'Rate limit or policy check triggered: please wait 20 seconds between check-ins (' + detail + ').');
							startCooldownTimer();
							return;
						}

						showCheckInMessage('error', 'Failed to broadcast check-in: ' + detail);
						return;
					}

					const inserted = await res.json();
					const row = Array.isArray(inserted) && inserted[0] ? inserted[0] : Object.assign({ id: 'ok_' + Date.now(), created_at: new Date().toISOString() }, payload);
					remoteSightings.unshift(row);
					showCheckInMessage('success', 'Thank you! Live rider check-in posted for ' + station.name + '.');
					startCooldownTimer();
					renderAll();
				} catch (err) {
					const msg = err && err.message ? err.message : 'Network error';
					showCheckInMessage('error', 'Network error sending rider check-in: ' + msg);
				}
			}

			function handleGpsLocate() {
				if (!navigator.geolocation) {
					gpsStatusBanner.classList.remove('hidden');
					gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-rust/10 text-mapa-rust px-3.5 py-2 text-xs';
					gpsStatusBanner.textContent = 'Geolocation is not supported by this browser. Select your line and station manually.';
					return;
				}

				gpsLocateBtn.disabled = true;
				const origSpan = gpsLocateBtn.querySelector('span');
				if (origSpan) origSpan.textContent = 'Locating...';

				navigator.geolocation.getCurrentPosition(
					(pos) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';

						const userLat = pos.coords.latitude;
						const userLon = pos.coords.longitude;
						let best = null;

						['mrt3', 'lrt1', 'lrt2'].forEach((lk) => {
							stationsData[lk].forEach((st) => {
								const d = haversineMeters(userLat, userLon, st.lat, st.lon);
								if (!best || d < best.distMeters) {
									best = { lineKey: lk, station: st, distMeters: Math.round(d) };
								}
							});
						});

						gpsStatusBanner.classList.remove('hidden');
						if (best && best.distMeters <= GPS_MAX_RADIUS_METERS) {
							gpsSnapState = {
								active: true,
								lineKey: best.lineKey,
								stationId: best.station.id,
								distMeters: best.distMeters
							};
							currentLine = best.lineKey;
							lineSelect.value = best.lineKey;
							populateStationSelect(best.station.id);
							updateUrlParams();
							gpsStatusBanner.className =
								'rounded-xl border border-emerald-600/35 bg-emerald-600/10 text-emerald-900 px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Snapped via GPS to ' +
								best.station.name +
								' (' +
								best.lineKey.toUpperCase() +
								', ~' +
								best.distMeters +
								'm away). Raw coordinates stay private in your browser.';
							fetchLiveSightings();
						} else if (best) {
							gpsSnapState = { active: false, lineKey: null, stationId: null, distMeters: best.distMeters };
							gpsStatusBanner.className =
								'rounded-xl border border-amber-600/40 bg-amber-500/10 text-amber-900 px-3.5 py-2 text-xs';
							gpsStatusBanner.textContent =
								'Nearest rail station is ' +
								best.station.name +
								' (~' +
								(best.distMeters / 1000).toFixed(1) +
								' km away, outside the 650m platform fence). Manual selection stays enabled.';
							renderAll();
						}
					},
					(geoErr) => {
						gpsLocateBtn.disabled = false;
						if (origSpan) origSpan.textContent = 'Use My GPS';
						gpsStatusBanner.classList.remove('hidden');
						gpsStatusBanner.className = 'rounded-xl border border-mapa-rust/40 bg-mapa-rust/10 text-mapa-rust px-3.5 py-2 text-xs';
						gpsStatusBanner.textContent =
							'GPS permission declined or unavailable (' + (geoErr && geoErr.message ? geoErr.message : 'location blocked') + '). Manual selection remains active.';
					},
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 15000 }
				);
			}

			// Event listeners
			lineSelect.addEventListener('change', () => {
				currentLine = lineSelect.value;
				populateStationSelect(null);
				updateUrlParams();
				fetchLiveSightings();
			});

			stationSelect.addEventListener('change', () => {
				currentStationId = stationSelect.value;
				updateUrlParams();
				renderAll();
			});

			document.querySelectorAll('.day-mode-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					dayMode = btn.getAttribute('data-day-btn') || 'auto';
					document.querySelectorAll('.day-mode-btn').forEach((b) => {
						if (b.getAttribute('data-day-btn') === dayMode) {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white';
						} else {
							b.className = 'day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/80 hover:text-mapa-ink';
						}
					});
					renderAll();
				});
			});

			document.querySelectorAll('.quick-hub-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const hubLine = btn.getAttribute('data-hub-line');
					const hubStation = btn.getAttribute('data-hub-station');
					if (!hubLine || !hubStation) return;
					const changedLine = hubLine !== currentLine;
					currentLine = hubLine;
					lineSelect.value = hubLine;
					populateStationSelect(hubStation);
					updateUrlParams();
					if (changedLine) {
						fetchLiveSightings();
					} else {
						renderAll();
					}
				});
			});

			document.querySelectorAll('.checkin-dir-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					checkInDir = btn.getAttribute('data-checkin-dir') || 'fwd';
					renderAll();
				});
			});

			document.querySelectorAll('.crowd-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					crowdLevel = btn.getAttribute('data-crowd') || 'moderate';
					document.querySelectorAll('.crowd-btn').forEach((b) => {
						if (b.getAttribute('data-crowd') === crowdLevel) {
							b.className = 'crowd-btn h-8 px-2.5 rounded-md text-xs font-semibold cursor-pointer transition-colors bg-mapa-canvas text-mapa-ink shadow-2xs';
						} else {
							b.className = 'crowd-btn h-8 px-2.5 rounded-md text-xs font-medium cursor-pointer transition-colors text-mapa-ink/80';
						}
					});
				});
			});

			document.querySelectorAll('.report-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const rType = btn.getAttribute('data-report');
					if (rType) submitSighting(rType);
				});
			});

			gpsLocateBtn.addEventListener('click', handleGpsLocate);
			refreshFeedBtn.addEventListener('click', fetchLiveSightings);

			// Init from URL query params if present
			try {
				const params = new URLSearchParams(window.location.search);
				const qLine = params.get('line');
				const qStation = params.get('station');
				if (qLine && stationsData[qLine]) {
					currentLine = qLine;
					lineSelect.value = qLine;
				}
				populateStationSelect(qStation);
			} catch (_err) {
				populateStationSelect(null);
			}

			fetchLiveSightings();
			setInterval(() => {
				if (!document.hidden) renderAll();
			}, 1000);
			setInterval(() => {
				if (!document.hidden) fetchLiveSightings();
			}, 30000);
		})();
	</script>
</BaseLayout>
