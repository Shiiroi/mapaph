---
/**
 * @file train-arrival-ph.astro
 * @description Train Arrival PH: Hybrid crowdsourced sightings + schedule cadence estimator for MRT-3, LRT-1, and LRT-2.
 */

import { loadEnv } from 'vite';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
	RAIL_LINES,
	STATIONS_DATA,
	SCHEDULE_SPECS,
	formatMinutesTo12H,
	buildLineTimetable,
	type LineKey
} from '../../data/rail-lines';

const env = loadEnv(import.meta.env.MODE, process.cwd(), '');

const supabaseUrl = (
	env.PUBLIC_SUPABASE_URL ||
	env.VITE_SUPABASE_URL ||
	process.env.PUBLIC_SUPABASE_URL ||
	process.env.VITE_SUPABASE_URL ||
	''
)
	.trim()
	.replace(/\/+$/, '');

const supabaseAnonKey = (
	env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
	env.VITE_SUPABASE_PUBLISHABLE_KEY ||
	env.PUBLIC_SUPABASE_ANON_KEY ||
	env.VITE_SUPABASE_ANON_KEY ||
	process.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
	process.env.VITE_SUPABASE_PUBLISHABLE_KEY ||
	process.env.VITE_SUPABASE_ANON_KEY ||
	process.env.PUBLIC_SUPABASE_ANON_KEY ||
	''
).trim();

const timetablesByLine = {
	mrt3: buildLineTimetable('mrt3'),
	lrt1: buildLineTimetable('lrt1'),
	lrt2: buildLineTimetable('lrt2')
};

const findStation = (line: LineKey, query: string) =>
	STATIONS_DATA[line].find((s) => s.name.toLowerCase().includes(query.toLowerCase()));

const quickHubs = [
	{ label: 'North Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'north') || STATIONS_DATA.mrt3[0] },
	{ label: 'MRT Cubao', line: 'mrt3' as LineKey, st: findStation('mrt3', 'cubao') || STATIONS_DATA.mrt3[3] },
	{ label: 'Ayala', line: 'mrt3' as LineKey, st: findStation('mrt3', 'ayala') || STATIONS_DATA.mrt3[9] },
	{ label: 'Taft Ave', line: 'mrt3' as LineKey, st: findStation('mrt3', 'taft') || STATIONS_DATA.mrt3[STATIONS_DATA.mrt3.length - 1] },
	{ label: 'D. Jose', line: 'lrt1' as LineKey, st: findStation('lrt1', 'jose') || STATIONS_DATA.lrt1[9] },
	{ label: 'PITX', line: 'lrt1' as LineKey, st: findStation('lrt1', 'asia world') || STATIONS_DATA.lrt1[STATIONS_DATA.lrt1.length - 3] },
	{ label: 'Recto', line: 'lrt2' as LineKey, st: findStation('lrt2', 'recto') || STATIONS_DATA.lrt2[0] },
	{ label: 'Antipolo', line: 'lrt2' as LineKey, st: findStation('lrt2', 'antipolo') || STATIONS_DATA.lrt2[STATIONS_DATA.lrt2.length - 1] }
].filter((h) => Boolean(h.st));

const defaultMrt3Timetable = timetablesByLine.mrt3;
const defaultLrt1Timetable = timetablesByLine.lrt1;
const defaultLrt2Timetable = timetablesByLine.lrt2;
---

<BaseLayout
	title="Train Arrival PH: Live Crowdsourced & Scheduled MRT-3, LRT-1, LRT-2 Tracker | mapaPH Tools"
	description="Check live crowdsourced train sightings and scheduled arrival windows for MRT-3, LRT-1, and LRT-2 in Metro Manila. View station-by-station first and last train times, headway countdowns, opt-in GPS check-ins, and crowd reports in Manila Time."
	keywords="train arrival ph, mrt 3 arrival time, lrt 1 arrival time, lrt 2 schedule, manila train tracker, crowdsource train location philippines, last train mrt 3, last train lrt 1, edsa carousel overnight"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Train Arrival PH: MRT-3, LRT-1 & LRT-2 Crowdsourced & Schedule Tracker",
					"url": "https://www.mapaph.com/tools/train-arrival-ph",
					"applicationCategory": "Public Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Hybrid Metro Manila commuter tracker combining anonymous crowdsourced train sightings and opt-in station GPS snaps with deterministic dispatch schedules across all 51 MRT-3, LRT-1, and LRT-2 stations.",
					"offers": {
						"@type": "Offer",
						"price": "0",
						"priceCurrency": "PHP"
					}
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mapaph.com" },
						{ "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.mapaph.com/tools" },
						{ "@type": "ListItem", "position": 3, "name": "Train Arrival PH", "item": "https://www.mapaph.com/tools/train-arrival-ph" }
					]
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "Is Metro Manila train arrival tracking real-time GPS telemetry?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Philippine rail operators (DOTr MRT-3, LRMC LRT-1, and LRTA LRT-2) do not currently publish public GTFS-RT or train GPS feeds. Train Arrival PH uses a transparent hybrid engine: when commuters tap to report a train arriving, riding on board, or station crowding (optionally snapped via browser GPS within 650 meters of a station), the page shows LIVE RIDER sightings. When no recent rider reports exist, it automatically falls back to ESTIMATED schedule cadence computed from published terminal dispatch times and segment distances."
							}
						},
						{
							"@type": "Question",
							"name": "How does optional GPS train location sharing protect my privacy?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Your raw latitude and longitude coordinates never leave your device. If you press Check In via GPS and grant browser permission, distance calculation runs locally in JavaScript to find the nearest rail station within 650 meters. Only the station ID, rail line, direction, and report label are shared, never your GPS coordinates or identity."
							}
						},
						{
							"@type": "Question",
							"name": "What time is the last train on MRT-3, LRT-1, and LRT-2?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "On weekdays, MRT-3 extended operations dispatch the last southbound train from North Avenue at 10:30 PM and the last northbound train from Taft Avenue at 11:09 PM (reverting to 9:30 PM and 10:09 PM on weekends). LRT-1 weekday last trips leave Fernando Poe Jr. at 10:30 PM and Dr. Santos at 10:45 PM. LRT-2 closes earlier: 9:00 PM from Antipolo and 9:30 PM from Recto on weekdays, or 9:00 PM both ways on weekends. Station gates generally close 5 minutes prior."
							}
						},
						{
							"@type": "Question",
							"name": "What can commuters ride after MRT-3 or LRT-1 closes for the night?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "After rail services conclude around 9:30 PM to 11:09 PM, the EDSA Carousel BRT busway runs 24/7 along the dedicated EDSA center median from Monumento to PITX, directly serving major transfer points including North Avenue, Quezon Avenue, Ortigas, Guadalupe, Ayala, and Taft Avenue."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-4xl mb-6">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-mapa-muted mb-3">
				<a href="/" class="hover:text-mapa-green transition-colors">Home</a>
				<span>/</span>
				<a href="/tools" class="hover:text-mapa-green transition-colors">Tools</a>
				<span>/</span>
				<span class="text-mapa-ink font-medium">Train Arrival PH</span>
			</nav>
			<div class="flex flex-wrap items-center gap-2 mb-2.5">
				<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-mapa-green/15 text-mapa-green border border-mapa-green/30">
					Crowdsourced + Schedule Cadence
				</span>
				<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-mapa-navy/10 text-mapa-navy border border-mapa-navy/25">
					MRT-3 &bull; LRT-1 &bull; LRT-2
				</span>
			</div>
			<h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-mapa-ink">
				Train Arrival PH: MRT-3, LRT-1 &amp; LRT-2 Tracker
			</h1>
			<p class="mt-2.5 text-sm sm:text-base text-mapa-ink/80 font-sans leading-relaxed max-w-3xl">
				Check live crowdsourced commuter train sightings alongside estimated headway arrival windows, first and last trip passing times, and 5-minute gate cutoffs across all 51 Metro Manila stations in Philippine Standard Time (UTC+8).
			</p>
		</div>

		<!-- Transparency Banner: Honest Data Source Disclosure -->
		<div class="mb-6 rounded-xl border border-mapa-contour bg-mapa-canvas-dark px-4 py-3 text-xs sm:text-sm font-sans flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
			<div class="flex items-start sm:items-center gap-2.5 text-mapa-ink/85">
				<span class="mt-0.5 sm:mt-0 inline-flex shrink-0 items-center justify-center w-5 h-5 rounded-full bg-mapa-navy/15 text-mapa-navy font-bold text-[11px]">i</span>
				<p class="leading-snug">
					<strong>How this data works:</strong> PH rail operators do not publish public GPS or GTFS-RT train APIs. Sightings labeled <span class="font-bold text-mapa-green">LIVE RIDER</span> come from anonymous commuter check-ins in the last 15 minutes; otherwise, arrivals automatically show <span class="font-bold text-mapa-navy">ESTIMATED</span> schedule math.
				</p>
			</div>
			<span id="feedConnectionPill" class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-semibold border border-mapa-contour bg-mapa-canvas text-mapa-muted whitespace-nowrap self-start sm:self-center">
				<span id="feedConnectionDot" class="w-2 h-2 rounded-full bg-amber-500"></span>
				<span id="feedConnectionText">Checking live rider feed...</span>
			</span>
		</div>

		<!-- Interactive Tracker Application Shell -->
		<section aria-label="Interactive Train Arrival and Crowdsource Tracker" class="rounded-2xl border border-mapa-contour bg-mapa-canvas-dark shadow-xs overflow-hidden mb-10 font-sans">
			<!-- Top Utility Bar: Manila Clock + Day Type Toggle (Uniform Height Items) -->
			<div class="px-4 sm:px-6 py-3.5 border-b border-mapa-contour bg-mapa-canvas flex flex-wrap items-center justify-between gap-3">
				<div class="flex items-center gap-2.5 h-10 px-3 rounded-xl border border-mapa-contour bg-mapa-canvas-dark">
					<span class="w-2 h-2 rounded-full bg-mapa-green animate-pulse shrink-0"></span>
					<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-muted whitespace-nowrap">Manila Time</span>
					<span id="manilaClock" class="font-mono text-sm sm:text-base font-bold text-mapa-ink whitespace-nowrap">--:-- --</span>
					<span id="manilaDayTag" class="hidden sm:inline-block text-[11px] font-medium text-mapa-muted whitespace-nowrap">PHT</span>
				</div>

				<div class="flex items-center gap-1 p-1 h-10 rounded-xl border border-mapa-contour bg-mapa-canvas-dark" role="group" aria-label="Schedule day mode">
					<button type="button" data-day-btn="auto" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap bg-mapa-green text-white">
						Auto
					</button>
					<button type="button" data-day-btn="weekday" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/80 hover:text-mapa-ink">
						Weekday
					</button>
					<button type="button" data-day-btn="weekend" class="day-mode-btn h-8 px-2.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap text-mapa-ink/80 hover:text-mapa-ink">
						Weekend / Holiday
					</button>
				</div>
			</div>

			<!-- Balanced 2-Column Line & Station Controls + Full-Width Quick Hubs -->
			<div class="p-4 sm:p-6 border-b border-mapa-contour space-y-4">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label for="lineSelect" class="block text-xs font-bold uppercase tracking-wider text-mapa-muted mb-1.5">
							1. Select Rail Line
						</label>
						<select id="lineSelect" class="w-full h-11 px-3.5 rounded-xl border border-mapa-contour bg-mapa-canvas text-sm font-semibold text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green/40 focus:border-mapa-green cursor-pointer">
							{RAIL_LINES.map((line) => (
								<option value={line.id} selected={line.id === 'mrt3'}>
									{line.shortName} ({line.stationsCount} stations) - {line.terminals}
								</option>
							))}
						</select>
						<p id="lineOperatorMeta" class="mt-1.5 text-[11px] text-mapa-muted leading-tight">
							DOTr MRT-3 &bull; 13 Stations along EDSA Corridor
						</p>
					</div>

					<div>
						<label for="stationSelect" class="block text-xs font-bold uppercase tracking-wider text-mapa-muted mb-1.5">
							2. Select Boarding Station
						</label>
						<select id="stationSelect" class="w-full h-11 px-3.5 rounded-xl border border-mapa-contour bg-mapa-canvas text-sm font-semibold text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green/40 focus:border-mapa-green cursor-pointer">
							{STATIONS_DATA.mrt3.map((st, idx) => (
								<option value={st.id} selected={idx === 0}>
									{idx + 1}. {st.name} ({st.city})
								</option>
							))}
						</select>
						<p id="stationMetaNote" class="mt-1.5 text-[11px] text-mapa-muted leading-tight">
							North Avenue (Quezon City) &bull; km 0.0
						</p>
					</div>
				</div>

				<!-- Clean Single-Row Quick Transfer Hubs -->
				<div class="pt-3 border-t border-mapa-contour/60 flex flex-wrap items-center gap-2">
					<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-muted mr-1 whitespace-nowrap">
						Quick Hubs:
					</span>
					{quickHubs.map((hub) => (
						<button
							type="button"
							data-hub-line={hub.line}
							data-hub-station={hub.st.id}
							class="quick-hub-btn h-8 px-3 rounded-lg text-xs font-medium border border-mapa-contour bg-mapa-canvas text-mapa-ink/85 hover:border-mapa-green hover:text-mapa-green transition-colors cursor-pointer whitespace-nowrap"
						>
							{hub.label}
						</button>
					))}
					<button
						type="button"
						id="gpsLocateBtn"
						class="sm:ml-auto h-8 px-3 rounded-lg text-xs font-semibold border border-mapa-green/40 bg-mapa-green/10 text-mapa-green hover:bg-mapa-green hover:text-white transition-colors cursor-pointer inline-flex items-center gap-1.5 whitespace-nowrap"
					>
						<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z" />
						</svg>
						<span>Use My GPS</span>
					</button>
				</div>
				<div id="gpsStatusBanner" class="hidden rounded-xl border px-3.5 py-2 text-xs leading-snug"></div>
			</div>

			<!-- Two Directional Arrival & Live Sighting Cards -->
			<div class="p-4 sm:p-6 space-y-5">
				<div id="serviceAlertBanner" class="hidden rounded-xl border px-4 py-3 text-xs sm:text-sm font-medium"></div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
					<!-- Direction 1: Forward (Southbound / Eastbound) -->
					<div id="cardFwd" class="rounded-xl border border-mapa-contour bg-mapa-canvas p-4 sm:p-5 flex flex-col justify-between gap-4">
						<div>
							<div class="flex items-start justify-between gap-2 mb-3">
								<div class="min-w-0">
									<div class="flex items-center gap-2 flex-wrap">
										<span id="fwdDirPill" class="px-2.5 py-0.5 rounded-md text-xs font-bold bg-mapa-navy text-white whitespace-nowrap">
											Southbound
										</span>
										<span id="fwdSourceBadge" class="px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wide border border-mapa-contour bg-mapa-canvas-dark text-mapa-navy whitespace-nowrap">
											ESTIMATED &bull; SCHEDULE
										</span>
									</div>
									<p id="fwdDestLabel" class="text-xs font-medium text-mapa-muted mt-1.5 truncate">
										Towards Taft Avenue
									</p>
								</div>
								<span id="fwdStatusChip" class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-bold whitespace-nowrap bg-mapa-green/15 text-mapa-green border border-mapa-green/30">
									Operating
								</span>
							</div>

							<div class="rounded-lg bg-mapa-canvas-dark border border-mapa-contour/80 p-3.5">
								<div id="fwdPrimaryHeadline" class="text-xs font-semibold uppercase tracking-wider text-mapa-muted">
									Next Expected Train
								</div>
								<div class="mt-1 flex items-baseline justify-between gap-2 flex-wrap">
									<div id="fwdCountdown" class="font-mono text-2xl sm:text-3xl font-extrabold text-mapa-ink">
										~4 min
									</div>
									<div id="fwdExactTime" class="font-mono text-xs sm:text-sm font-semibold text-mapa-green">
										Est. --:-- --
									</div>
								</div>
								<p id="fwdLiveDetail" class="mt-1.5 text-xs text-mapa-ink/80 leading-snug">
									Loading schedule baseline...
								</p>
							</div>
						</div>

						<div class="grid grid-cols-3 gap-2 pt-3 border-t border-mapa-contour/70 text-xs">
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">First Train</span>
								<span id="fwdFirstTime" class="font-mono font-bold text-mapa-ink">--:--</span>
							</div>
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Last Train</span>
								<span id="fwdLastTime" class="font-mono font-bold text-mapa-rust">--:--</span>
							</div>
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Gate Cutoff</span>
								<span id="fwdCutoffTime" class="font-mono font-bold text-mapa-ink">--:--</span>
							</div>
						</div>
					</div>

					<!-- Direction 2: Reverse (Northbound / Westbound) -->
					<div id="cardRev" class="rounded-xl border border-mapa-contour bg-mapa-canvas p-4 sm:p-5 flex flex-col justify-between gap-4">
						<div>
							<div class="flex items-start justify-between gap-2 mb-3">
								<div class="min-w-0">
									<div class="flex items-center gap-2 flex-wrap">
										<span id="revDirPill" class="px-2.5 py-0.5 rounded-md text-xs font-bold bg-mapa-green text-white whitespace-nowrap">
											Northbound
										</span>
										<span id="revSourceBadge" class="px-2 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wide border border-mapa-contour bg-mapa-canvas-dark text-mapa-navy whitespace-nowrap">
											ESTIMATED &bull; SCHEDULE
										</span>
									</div>
									<p id="revDestLabel" class="text-xs font-medium text-mapa-muted mt-1.5 truncate">
										Towards North Avenue
									</p>
								</div>
								<span id="revStatusChip" class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-bold whitespace-nowrap bg-mapa-green/15 text-mapa-green border border-mapa-green/30">
									Operating
								</span>
							</div>

							<div class="rounded-lg bg-mapa-canvas-dark border border-mapa-contour/80 p-3.5">
								<div id="revPrimaryHeadline" class="text-xs font-semibold uppercase tracking-wider text-mapa-muted">
									Next Expected Train
								</div>
								<div class="mt-1 flex items-baseline justify-between gap-2 flex-wrap">
									<div id="revCountdown" class="font-mono text-2xl sm:text-3xl font-extrabold text-mapa-ink">
										~5 min
									</div>
									<div id="revExactTime" class="font-mono text-xs sm:text-sm font-semibold text-mapa-green">
										Est. --:-- --
									</div>
								</div>
								<p id="revLiveDetail" class="mt-1.5 text-xs text-mapa-ink/80 leading-snug">
									Loading schedule baseline...
								</p>
							</div>
						</div>

						<div class="grid grid-cols-3 gap-2 pt-3 border-t border-mapa-contour/70 text-xs">
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">First Train</span>
								<span id="revFirstTime" class="font-mono font-bold text-mapa-ink">--:--</span>
							</div>
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Last Train</span>
								<span id="revLastTime" class="font-mono font-bold text-mapa-rust">--:--</span>
							</div>
							<div>
								<span class="block text-[10px] uppercase font-bold tracking-wider text-mapa-muted">Gate Cutoff</span>
								<span id="revCutoffTime" class="font-mono font-bold text-mapa-ink">--:--</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Corridor Cadence & Live Pin Track Strip (Zero Vertical Offset Architecture) -->
				<div class="rounded-xl border border-mapa-contour bg-mapa-canvas p-4">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
						<div>
							<h2 class="text-sm font-bold text-mapa-ink">
								Line Corridor Strip: Live Rider Sightings vs Estimated Cadence
							</h2>
							<p class="text-[11px] text-mapa-muted">
								Pulsing green dots mark real commuter check-ins (last 15 min). Outlined markers show schedule cadence estimates.
							</p>
						</div>
						<div class="flex items-center gap-3 text-[11px] font-medium text-mapa-muted">
							<span class="inline-flex items-center gap-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-emerald-600 ring-2 ring-emerald-500/30"></span>
								Live Rider Pin
							</span>
							<span class="inline-flex items-center gap-1.5">
								<span class="w-2.5 h-2.5 rounded-sm border border-mapa-navy bg-mapa-canvas-dark"></span>
