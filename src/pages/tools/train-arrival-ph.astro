					liveVsEstActionBtn.textContent = 'Focus Preview Pin';
				} else {
					lastLiveBannerTarget = { type: 'checkin' };
					liveVsEstBanner.className =
						'rounded-2xl border border-mapa-contour bg-mapa-canvas text-mapa-ink px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 shadow-2xs';
					liveVsEstPill.className =
						'shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wider bg-mapa-ink text-white';
					liveVsEstPill.textContent = 'ESTIMATED SIMULATION';
					liveVsEstText.className = 'text-xs text-mapa-ink/85 leading-snug';
					const scopeLabel = visibleScopeLines.length > 1 ? 'all 3 lines' : lineMeta.shortName;
					liveVsEstText.textContent =
						'Moving train markers on ' +
						scopeLabel +
						' are simulated from official headway schedules and segment runtimes (0 live rider check-ins in the past 15m).';
					liveVsEstActionBtn.className =
						'shrink-0 self-start sm:self-auto h-8 px-3 rounded-lg text-xs font-semibold border border-mapa-contour bg-mapa-canvas-dark text-mapa-ink hover:border-mapa-ink transition-colors cursor-pointer whitespace-nowrap';
					liveVsEstActionBtn.textContent = 'Spot a Train (Check In)';
				}
			}

			// Leaflet real-world map initialization and incremental pin rendering
			function ensureLeafletMap() {
				if (leafletMap || leafletUnavailable) return;
				if (typeof L === 'undefined') {
					leafletUnavailable = true;
					mapFallbackBanner.classList.remove('hidden');
					return;
				}

				const container = document.getElementById('live-rail-map');
				if (!container) return;

				leafletMap = L.map('live-rail-map', {
					center: [14.5995, 121.02],
					zoom: 12,
					zoomControl: true
				});

				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; OpenStreetMap contributors',
					maxZoom: 19
				}).addTo(leafletMap);

				trackLayerGroup = L.layerGroup().addTo(leafletMap);
				stationLayerGroup = L.layerGroup().addTo(leafletMap);
				trainLayerGroup = L.layerGroup().addTo(leafletMap);
			}

			function fitActiveLeafletBounds() {
				if (!leafletMap || typeof L === 'undefined') return;
				const pts = [];
				const scopeKeys = mapScope === 'all' ? ['mrt3', 'lrt1', 'lrt2'] : [currentLine];
				scopeKeys.forEach((lk) => {
					(stationsData[lk] || []).forEach((st) => pts.push([st.lat, st.lon]));
				});
				if (pts.length) {
					leafletMap.fitBounds(L.latLngBounds(pts), {
						paddingTopLeft: [34, 34],
						paddingBottomRight: [34, 46],
						maxZoom: mapScope === 'all' ? 12 : 14
					});
				}
			}

			function renderLeafletTracksAndStations(packedSet) {
				ensureLeafletMap();
				if (!leafletMap || !trackLayerGroup || !stationLayerGroup) return;

				trackLayerGroup.clearLayers();
				stationLayerGroup.clearLayers();

				const scopeKeys = mapScope === 'all' ? ['mrt3', 'lrt1', 'lrt2'] : [currentLine];
				const packedSignature = currentLine + '|' + mapScope + '|' + currentStationId + '|' + Array.from(packedSet).join(',');

				const drawOrder = scopeKeys.slice().sort((a, b) => (a === currentLine ? 1 : b === currentLine ? -1 : 0));

				drawOrder.forEach((lk) => {
					const isActiveLine = lk === currentLine;
					const color = lineColors[lk] || '#3d5a45';
					const verts = getGeoVerticesForLine(lk);
					L.polyline(verts, {
						color,
						weight: isActiveLine ? 5.5 : 3.5,
						opacity: isActiveLine ? 0.9 : 0.45,
						lineJoin: 'round',
						lineCap: 'round'
					}).addTo(trackLayerGroup);
				});

				drawOrder.forEach((lk) => {
					const isActiveLine = lk === currentLine;
					const color = lineColors[lk] || '#3d5a45';
					(stationsData[lk] || []).forEach((st) => {
						const isSelected = lk === currentLine && st.id === currentStationId;
						const isPacked = packedSet.has(lk + '|' + st.id);

						if (isPacked) {
							L.circleMarker([st.lat, st.lon], {
								radius: isSelected ? 12 : 9,
								color: '#9e391a',
								weight: 2,
								fillColor: '#9e391a',
								fillOpacity: 0.18,
								interactive: false
							}).addTo(stationLayerGroup);
						}

						const marker = L.circleMarker([st.lat, st.lon], {
							radius: isSelected ? 8 : st.isTransfer ? 5.5 : isActiveLine ? 4.5 : 3.5,
							color: isSelected ? '#211d16' : color,
							weight: isSelected ? 2.5 : 2,
							fillColor: isSelected ? color : '#f7f3e9',
							fillOpacity: 1
						});

						marker.bindTooltip(
							'<strong>' + st.name + '</strong> (' + lk.toUpperCase() + ')' + (isPacked ? ' · Crowd alert' : ''),
							{ direction: 'top', offset: [0, -6] }
						);

						marker.on('click', () => {
							if (lk !== currentLine) {
								currentLine = lk;
								populateStationSelect(st.id);
							} else {
								currentStationId = st.id;
								stationSelect.value = st.id;
							}
							updateUrlParams();
							renderAll();
						});

						marker.addTo(stationLayerGroup);
					});
				});

				const prevScopeParts = lastTrackSignature.split('|');
				const scopeChanged = prevScopeParts[0] + '|' + prevScopeParts[1] !== currentLine + '|' + mapScope;
				lastTrackSignature = packedSignature;
				if (scopeChanged) {
					fitActiveLeafletBounds();
				}
			}

			function buildTrainIconHtml(train) {
				const lineHex = lineColors[train.lineKey] || '#3d5a45';
				if (train.kind === 'est') {
					const angle = Math.round(train.bearingDeg);
					return (
						'<div class="rail-train-pill rail-train-est" style="border-color:' +
						lineHex +
						';">' +
						'<svg width="9" height="9" viewBox="0 0 12 12" style="transform:rotate(' +
						angle +
						'deg);display:block;flex-shrink:0;" aria-hidden="true"><path d="M6 1L11 11L6 8.5L1 11Z" fill="' +
						lineHex +
						'"/></svg>' +
						'<span>EST·' +
						train.dirShort +
						'</span></div>'
					);
				}

				const bgHex =
					train.kind === 'live_delay'
						? '#9e391a'
						: train.isLocalOnly
						? '#1b2a4a'
						: '#3d5a45';
				const label =
					train.kind === 'live_delay'
						? 'DELAY'
						: (train.isLocalOnly ? 'PREVIEW' : 'LIVE') + ' · ' + train.ageStrShort;
				const angle = Math.round(train.bearingDeg);
				return (
					'<div class="rail-train-pill rail-train-live" style="background-color:' +
					bgHex +
					';">' +
					'<svg width="10" height="10" viewBox="0 0 12 12" style="transform:rotate(' +
					angle +
					'deg);display:block;flex-shrink:0;" aria-hidden="true"><path d="M6 1L11 11L6 8.5L1 11Z" fill="#ffffff"/></svg>' +
					'<span>' +
					label +
					'</span></div>'
				);
			}

			function renderLeafletTrains(estTrains, liveTrains) {
				ensureLeafletMap();
				if (!leafletMap || !trainLayerGroup || typeof L === 'undefined') return;
				trainLayerGroup.clearLayers();

				estTrains.forEach((t) => {
					const icon = L.divIcon({
						className: 'rail-est-icon',
						html: buildTrainIconHtml(t),
						iconSize: [0, 0],
						iconAnchor: [0, 0]
					});
					const marker = L.marker([t.lat, t.lon], {
						icon,
						zIndexOffset: t.lineKey === currentLine ? 250 : 120
					});
					const lineMeta = linesData.find((l) => l.id === t.lineKey) || linesData[0];
					marker.bindPopup(
						'<div style="font-size:12px;line-height:1.35;">' +
							'<strong>' +
							lineMeta.shortName +
							' ' +
							t.dirName +
							' (Estimated Simulation)</strong><br/>' +
							'Between ' +
							t.fromName +
							' and ' +
							t.toName +
							'.<br/>' +
							'<span style="color:#5c5343;">Simulated from official schedule cadence, not operator GPS.</span>' +
							'</div>'
					);
					marker.addTo(trainLayerGroup);
				});

				liveTrains.forEach((t) => {
					const icon = L.divIcon({
						className: 'rail-live-icon',
						html: buildTrainIconHtml(t),
						iconSize: [0, 0],
						iconAnchor: [0, 0]
					});
					const marker = L.marker([t.lat, t.lon], {
						icon,
						zIndexOffset: 1000
					});
					const lineMeta = linesData.find((l) => l.id === t.lineKey) || linesData[0];
					const projNote = t.isProjected ? '<br/>Projected near: <strong>' + t.projectedStationName + '</strong>' : '';
					const tagText = t.kind === 'live_delay' ? 'Delay Advisory' : t.isLocalOnly ? 'Local Browser Preview' : 'Live Rider Sighting';
					marker.bindPopup(
						'<div style="font-size:12px;line-height:1.35;">' +
							'<strong style="color:#3d5a45;">' +
							tagText +
							' (' +
							lineMeta.shortName +
							' ' +
							t.dirName +
							')</strong><br/>' +
							'Reported at <strong>' +
							t.reportedStationName +
							'</strong> (' +
							t.ageStr +
							')' +
							projNote +
							'</div>'
					);
					marker.addTo(trainLayerGroup);
				});
			}

			// 2D Schematic Network Diagram SVG helpers and rendering
			function svgEl(tag, attrs) {
				const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
				Object.keys(attrs || {}).forEach((k) => {
					el.setAttribute(k, String(attrs[k]));
				});
				return el;
			}

			function towardsPt(from, to, dist) {
				const dx = to.x - from.x;
				const dy = to.y - from.y;
				const len = Math.hypot(dx, dy) || 1;
				const k = Math.min(dist, len / 2) / len;
				return { x: from.x + dx * k, y: from.y + dy * k };
			}

			function roundedSvgPath(pts, radius) {
				const r = radius || 26;
				let d = 'M' + pts[0].x + ',' + pts[0].y;
				for (let i = 1; i < pts.length; i++) {
					const p = pts[i];
					if (p.corner && i < pts.length - 1) {
						const t1 = towardsPt(p, pts[i - 1], r);
						const t2 = towardsPt(p, pts[i + 1], r);
						d += ' L' + t1.x + ',' + t1.y + ' Q' + p.x + ',' + p.y + ' ' + t2.x + ',' + t2.y;
					} else {
						d += ' L' + p.x + ',' + p.y;
					}
				}
				return d;
			}

			function shortDiagramName(st) {
				if (st.id === 'lrt1_asia_world') return 'Asia World / PITX';
				return st.name.replace(/\s*\(.*\)/, '');
			}

			function getDiagramLabelPos(lineKey, stId, x, y, idx) {
				if (lineKey === 'lrt1') {
					if (stId === 'lrt1_fpj' || stId === 'lrt1_balintawak') {
						return { lx: x, ly: y - 16, anchor: 'middle' };
					}
					return { lx: x - 14, ly: y + 4, anchor: 'end' };
				}
				if (lineKey === 'mrt3') {
					if (stId === 'mrt3_taft') return { lx: x, ly: y + 22, anchor: 'middle' };
					return { lx: x + 14, ly: y + 4, anchor: 'start' };
				}
				if (stId === 'lrt2_santolan' || stId === 'lrt2_marikina' || stId === 'lrt2_antipolo') {
					return { lx: x + 14, ly: y + 4, anchor: 'start' };
				}
				if (stId === 'lrt2_recto') return { lx: x + 12, ly: y + 18, anchor: 'start' };
				if (stId === 'lrt2_cubao') return { lx: x, ly: y - 15, anchor: 'middle' };
				const isAbove = idx % 2 === 0;
				return { lx: x, ly: isAbove ? y - 14 : y + 21, anchor: 'middle' };
			}

			function renderDiagramView(estTrains, liveTrains, packedSet) {
				if (!railDiagramSvg) return;
				railDiagramSvg.innerHTML = '';

				const scopeKeys = mapScope === 'all' ? ['mrt3', 'lrt1', 'lrt2'] : [currentLine];
				if (mapScope === 'all') {
					railDiagramSvg.setAttribute('viewBox', '0 0 1260 1280');
				} else {
					const pts = diagramPts[currentLine] || [];
					let minX = Infinity;
					let maxX = -Infinity;
					let minY = Infinity;
					let maxY = -Infinity;
					pts.forEach((p) => {
						if (p.x < minX) minX = p.x;
						if (p.x > maxX) maxX = p.x;
						if (p.y < minY) minY = p.y;
						if (p.y > maxY) maxY = p.y;
					});
					const padL = currentLine === 'lrt1' ? 190 : 120;
					const padR = currentLine === 'lrt1' ? 120 : 210;
					const vbX = Math.max(0, Math.round(minX - padL));
					const vbY = Math.max(0, Math.round(minY - 70));
					const vbW = Math.max(420, Math.round(maxX - minX + padL + padR));
					const vbH = Math.max(420, Math.round(maxY - minY + 150));
					railDiagramSvg.setAttribute('viewBox', vbX + ' ' + vbY + ' ' + vbW + ' ' + vbH);
				}

				const gLines = svgEl('g', { id: 'dg-lines' });
				scopeKeys.forEach((lk) => {
					const isActive = lk === currentLine;
					gLines.appendChild(
						svgEl('path', {
							d: roundedSvgPath(diagramPts[lk], 26),
							fill: 'none',
							stroke: lineColors[lk] || '#3d5a45',
							'stroke-width': isActive ? 10 : 7,
							'stroke-opacity': isActive ? 0.92 : 0.4,
							'stroke-linecap': 'round',
							'stroke-linejoin': 'round'
						})
					);
				});
				railDiagramSvg.appendChild(gLines);

				if (mapScope === 'all') {
					const gLinks = svgEl('g', { id: 'dg-links' });
					DIAGRAM_LINKS.forEach(([a, b]) => {
						const pa = diagramPos[a];
						const pb = diagramPos[b];
						if (pa && pb) {
							gLinks.appendChild(
								svgEl('line', {
									x1: pa.x,
									y1: pa.y,
									x2: pb.x,
									y2: pb.y,
									stroke: '#211d16',
									'stroke-width': 4,
									'stroke-dasharray': '6 5',
									'stroke-linecap': 'round'
								})
							);
						}
					});
					railDiagramSvg.appendChild(gLinks);
				}

				const gStations = svgEl('g', { id: 'dg-stations' });
				const gLabels = svgEl('g', {
					id: 'dg-labels',
					'font-family': 'ui-sans-serif, system-ui, -apple-system, sans-serif',
					'font-size': mapScope === 'all' ? '14' : '16',
					'font-weight': '700',
					fill: '#211d16',
					'paint-order': 'stroke fill',
					stroke: '#F7F3E9',
					'stroke-width': '5px',
					'stroke-linejoin': 'round',
					'pointer-events': 'none'
				});

				scopeKeys.forEach((lk) => {
					const lineHex = lineColors[lk] || '#3d5a45';
					const stations = stationsData[lk] || [];
					stations.forEach((st, idx) => {
						const pos = diagramPos[st.id];
						if (!pos) return;
						const isSelected = lk === currentLine && st.id === currentStationId;
						const isPacked = packedSet.has(lk + '|' + st.id);

						if (isPacked) {
							gStations.appendChild(
								svgEl('circle', {
									cx: pos.x,
									cy: pos.y,
									r: 14,
									fill: 'rgba(158, 57, 26, 0.16)',
									stroke: '#9e391a',
									'stroke-width': 2.5
								})
							);
						}

						const c = svgEl('circle', {
							cx: pos.x,
							cy: pos.y,
							r: isSelected ? 11 : st.isTransfer ? 8 : 6.5,
							fill: isSelected ? lineHex : '#f7f3e9',
							stroke: isSelected ? '#211d16' : lineHex,
							'stroke-width': isSelected ? 4 : 3,
							style: 'cursor:pointer;'
						});

						c.addEventListener('click', () => {
							if (lk !== currentLine) {
								currentLine = lk;
								populateStationSelect(st.id);
							} else {
								currentStationId = st.id;
								stationSelect.value = st.id;
							}
							updateUrlParams();
							renderAll();
						});

						gStations.appendChild(c);

						const lbl = getDiagramLabelPos(lk, st.id, pos.x, pos.y, idx);
						const txt = svgEl('text', {
							x: lbl.lx,
							y: lbl.ly,
							'text-anchor': lbl.anchor,
							fill: isSelected ? '#211d16' : '#3a3428'
						});
						txt.textContent = shortDiagramName(st);
						gLabels.appendChild(txt);
					});
				});

				railDiagramSvg.appendChild(gStations);
				railDiagramSvg.appendChild(gLabels);

				const gTrains = svgEl('g', { id: 'dg-trains' });
				estTrains.forEach((t) => {
					const g = svgEl('g', { transform: 'translate(' + t.svgX.toFixed(1) + ',' + t.svgY.toFixed(1) + ')' });
					const halo = svgEl('circle', {
						r: 12,
						fill: '#f7f3e9',
						stroke: lineColors[t.lineKey] || '#3d5a45',
						'stroke-width': 2.5,
						'stroke-dasharray': '4 3'
					});
					const tri = svgEl('path', {
						d: 'M0,-7 L6,5 L0,2.5 L-6,5 Z',
						fill: lineColors[t.lineKey] || '#3d5a45',
						transform: 'rotate(' + Math.round(t.svgAngleDeg) + ')'
					});
					g.appendChild(halo);
					g.appendChild(tri);
					gTrains.appendChild(g);
				});

				liveTrains.forEach((t) => {
					const bg = t.kind === 'live_delay' ? '#9e391a' : t.isLocalOnly ? '#1b2a4a' : '#3d5a45';
					const g = svgEl('g', { transform: 'translate(' + t.svgX.toFixed(1) + ',' + t.svgY.toFixed(1) + ')' });
					const pill = svgEl('rect', {
						x: -36,
						y: -14,
						width: 72,
						height: 28,
						rx: 14,
						fill: bg,
						stroke: '#ffffff',
						'stroke-width': 3
					});
					const txt = svgEl('text', {
						x: 0,
						y: 4,
						'text-anchor': 'middle',
						fill: '#ffffff',
						'font-family': 'ui-monospace, monospace',
						'font-size': '11',
						'font-weight': '800'
					});
					txt.textContent = t.kind === 'live_delay' ? 'DELAY' : 'LIVE · ' + t.ageStrShort;
					g.appendChild(pill);
					g.appendChild(txt);
					gTrains.appendChild(g);
				});

				railDiagramSvg.appendChild(gTrains);
			}

			function renderStationSpine(clock, isWeekend, lineSightings, estByIndex) {
				const table = timetablesByLine[currentLine];
				const lineHex = lineColors[currentLine] || '#3D5A45';
				const spec = specsData[currentLine];
				const lineMeta = linesData.find((l) => l.id === currentLine) || linesData[0];

				const sightingsByStation = {};
				lineSightings.forEach((s) => {
					if (!sightingsByStation[s.station_id]) sightingsByStation[s.station_id] = [];
					sightingsByStation[s.station_id].push(s);
				});

				const q = stationFilterQuery.trim().toLowerCase();
				const visibleRows = table.filter((row) => {
					if (!q) return true;
					return (
						row.station.name.toLowerCase().includes(q) ||
						row.station.city.toLowerCase().includes(q) ||
						(row.station.transferLabel && row.station.transferLabel.toLowerCase().includes(q))
					);
				});

				const prevScrollTop = stationSpineScroll.scrollTop;
				stationSpineScroll.innerHTML = '';

				if (!visibleRows.length) {
					const empty = document.createElement('div');
					empty.className = 'p-4 text-xs text-mapa-muted bg-mapa-canvas border border-mapa-contour rounded-xl';
					empty.textContent = 'No stations on ' + lineMeta.shortName + ' match "' + stationFilterQuery + '".';
					stationSpineScroll.appendChild(empty);
					return;
				}

				const dirCodeFwd = spec.forward.shortDir === 'Eastbound' ? 'EB' : 'SB';
				const dirCodeRev = spec.reverse.shortDir === 'Westbound' ? 'WB' : 'NB';

				visibleRows.forEach((row, visibleIdx) => {
					const st = row.station;
					const isSelected = st.id === currentStationId;
					const isFirstVisible = visibleIdx === 0;
					const isLastVisible = visibleIdx === visibleRows.length - 1;
					const firstTime = isWeekend ? row.weekendFirstFwd : row.weekdayFirstFwd;
					const lastTime = isWeekend ? row.weekendLastFwd : row.weekdayLastFwd;
					const liveList = sightingsByStation[st.id] || [];
					const estTrain = estByIndex[row.index];

					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className =
						'relative w-full text-left flex items-center justify-between gap-3 p-3 rounded-xl transition-colors cursor-pointer group ' +
						(isSelected
							? 'bg-mapa-canvas border-2 border-mapa-ink shadow-2xs'
							: 'bg-mapa-canvas-dark border border-transparent hover:border-mapa-contour hover:bg-mapa-canvas');

					if (!isFirstVisible) {
						const segTop = document.createElement('span');
						segTop.className = 'absolute left-[-16px] top-[-10px] bottom-1/2 w-1.5 z-0 pointer-events-none';
						segTop.style.backgroundColor = lineHex;
						segTop.style.opacity = '0.35';
						btn.appendChild(segTop);
					}
					if (!isLastVisible) {
						const segBot = document.createElement('span');
						segBot.className = 'absolute left-[-16px] top-1/2 bottom-[-10px] w-1.5 z-0 pointer-events-none';
						segBot.style.backgroundColor = lineHex;
						segBot.style.opacity = '0.35';
						btn.appendChild(segBot);
					}

					const node = document.createElement('span');
					node.className =
						'absolute left-[-23px] top-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-2 flex items-center justify-center z-10 pointer-events-none';
					node.style.borderColor = lineHex;
					node.style.backgroundColor = isSelected ? lineHex : '#f7f3e9';
					if (!isSelected && st.isTransfer) {
						const inner = document.createElement('span');
						inner.className = 'w-1.5 h-1.5 rounded-full';
						inner.style.backgroundColor = lineHex;
						node.appendChild(inner);
					}
					btn.appendChild(node);

					const left = document.createElement('div');
					left.className = 'min-w-0 flex-1';

					const titleRow = document.createElement('div');
