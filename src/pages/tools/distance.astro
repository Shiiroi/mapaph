				const bearing = computeBearing(pointA.lat, pointA.lon, pointB.lat, pointB.lon);
				const bearingStr = `${bearing}° (${getCompassName(bearing)})`;

				distKmEl.textContent = km.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
				distNmEl.textContent = `${nm.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} NM`;
				distMilesEl.textContent = `${mi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} mi`;
