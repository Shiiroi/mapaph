				// Flight Durations
				// Jet: 800 km/h + 30 mins taxi/climb
				const jetMins = (km / 800) * 60 + 30;
				timeJetEl.textContent = formatDuration(jetMins);

				// Turboprop: 450 km/h + 25 mins taxi/climb
				const turbopropMins = (km / 450) * 60 + 25;
				timeTurbopropEl.textContent = formatDuration(turbopropMins);

				// Ferry Durations (52 km/h Fastcraft vs 26 km/h RoRo)
				const fastcraftMins = (km / 52) * 60 + 20;
				timeFastcraftEl.textContent = formatDuration(fastcraftMins);

				const roroMins = (km / 26) * 60 + 30;
				timeRoroEl.textContent = formatDuration(roroMins);

				// CO2 Footprint: ~115g CO2e per km per passenger
				const co2Kg = (km * 0.115);
				co2MetricEl.textContent = `~${co2Kg.toFixed(1)} kg CO₂e`;

				// Update Arc Polyline
				if (geodesicPolyline) {
					map.removeLayer(geodesicPolyline);
				}

				const arcCoords = computeGeodesicArc(pointA.lat, pointA.lon, pointB.lat, pointB.lon);
				geodesicPolyline = L.polyline(arcCoords, {
					color: '#F59E0B',
					weight: 4,
					dashArray: '6, 6',
					opacity: 0.95
				}).addTo(map);

				map.fitBounds(geodesicPolyline.getBounds(), { padding: [50, 50] });
			}

			// Drag events for pins
			markerA.on('dragend', (e) => {
				const pos = e.target.getLatLng();
				pointA = { lat: pos.lat, lon: pos.lng, name: 'Custom Map Pin A' };
				origSelect.value = 'custom';
				markerA.setTooltipContent(`<strong>Point A:</strong> Custom (${pos.lat.toFixed(4)}, ${pos.lng.toFixed(4)})`);
				updateCalculations();
			});

			markerB.on('dragend', (e) => {
				const pos = e.target.getLatLng();
				pointB = { lat: pos.lat, lon: pos.lng, name: 'Custom Map Pin B' };
				dstSelect.value = 'custom';
				markerB.setTooltipContent(`<strong>Point B:</strong> Custom (${pos.lat.toFixed(4)}, ${pos.lng.toFixed(4)})`);
				updateCalculations();
			});

			// Map click moves Point B or Point A
			let clickToggle = false;
			map.on('click', (e) => {
				if (clickToggle) {
					pointA = { lat: e.latlng.lat, lon: e.latlng.lng, name: 'Custom Pin A' };
					markerA.setLatLng(e.latlng);
					origSelect.value = 'custom';
				} else {
					pointB = { lat: e.latlng.lat, lon: e.latlng.lng, name: 'Custom Pin B' };
					markerB.setLatLng(e.latlng);
					dstSelect.value = 'custom';
				}
				clickToggle = !clickToggle;
				updateCalculations();
			});

			// Select change handlers
			origSelect.addEventListener('change', () => {
				const loc = LOCATIONS.find(l => l.id === origSelect.value);
				if (loc) {
					pointA = { lat: loc.lat, lon: loc.lon, name: loc.name };
					markerA.setLatLng([loc.lat, loc.lon]);
					markerA.setTooltipContent(`<strong>Point A:</strong> ${loc.name}`);
					updateCalculations();
				}
			});

			dstSelect.addEventListener('change', () => {
				const loc = LOCATIONS.find(l => l.id === dstSelect.value);
				if (loc) {
					pointB = { lat: loc.lat, lon: loc.lon, name: loc.name };
					markerB.setLatLng([loc.lat, loc.lon]);
					markerB.setTooltipContent(`<strong>Point B:</strong> ${loc.name}`);
					updateCalculations();
				}
			});

			swapBtn.addEventListener('click', () => {
				const temp = { ...pointA };
				pointA = { ...pointB };
				pointB = { ...temp };

				markerA.setLatLng([pointA.lat, pointA.lon]);
				markerB.setLatLng([pointB.lat, pointB.lon]);

				const tempVal = origSelect.value;
				origSelect.value = dstSelect.value;
				dstSelect.value = tempVal;

				updateCalculations();
			});

			resetBtn.addEventListener('click', () => {
				const mnl = LOCATIONS.find(l => l.id === 'mnl');
				const ceb = LOCATIONS.find(l => l.id === 'ceb');
				pointA = { lat: mnl.lat, lon: mnl.lon, name: mnl.name };
				pointB = { lat: ceb.lat, lon: ceb.lon, name: ceb.name };
				markerA.setLatLng([mnl.lat, mnl.lon]);
				markerB.setLatLng([ceb.lat, ceb.lon]);
				origSelect.value = 'mnl';
				dstSelect.value = 'ceb';
				updateCalculations();
			});

			// Corridor presets
			document.querySelectorAll('.corridor-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const origId = btn.getAttribute('data-orig');
					const destId = btn.getAttribute('data-dest');
					const locA = LOCATIONS.find(l => l.id === origId);
					const locB = LOCATIONS.find(l => l.id === destId);
					if (locA && locB) {
						pointA = { lat: locA.lat, lon: locA.lon, name: locA.name };
						pointB = { lat: locB.lat, lon: locB.lon, name: locB.name };
						markerA.setLatLng([locA.lat, locA.lon]);
						markerB.setLatLng([locB.lat, locB.lon]);
						origSelect.value = origId;
						dstSelect.value = destId;
						updateCalculations();
					}
				});
			});

			// Initial Calculation
			updateCalculations();
		})();
	</script>
</BaseLayout>
