---
/**
 * @file distance.astro
 * @description Interactive Philippine Great-Circle Inter-Island Distance, Flight Duration & Nautical Route Calculator.
 * Measures geodesic distances, compass headings, commercial flight durations, and RoRo/fastcraft ferry transit times.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Comprehensive catalog of Philippine air hubs, sea ports, and regional centers
const LOCATION_PRESETS = [
	{
		group: 'Major Commercial Airports (CAAP)',
		items: [
			{ id: 'mnl', name: 'Manila (NAIA / MNL)', lat: 14.5086, lon: 121.0194, type: 'Airport' },
			{ id: 'crk', name: 'Clark International (CRK)', lat: 15.1860, lon: 120.5597, type: 'Airport' },
			{ id: 'ceb', name: 'Cebu / Mactan (CEB)', lat: 10.3075, lon: 123.9794, type: 'Airport' },
			{ id: 'dvo', name: 'Davao / Bangoy (DVO)', lat: 7.1253, lon: 125.6458, type: 'Airport' },
			{ id: 'ilo', name: 'Iloilo International (ILO)', lat: 10.8328, lon: 122.4992, type: 'Airport' },
			{ id: 'bcd', name: 'Bacolod–Silay (BCD)', lat: 10.7767, lon: 123.0153, type: 'Airport' },
			{ id: 'pps', name: 'Puerto Princesa (PPS)', lat: 9.7422, lon: 118.7589, type: 'Airport' },
			{ id: 'tag', name: 'Bohol–Panglao (TAG)', lat: 9.5661, lon: 123.7631, type: 'Airport' },
			{ id: 'cgy', name: 'Cagayan de Oro / Laguindingan (CGY)', lat: 8.6122, lon: 124.4564, type: 'Airport' },
			{ id: 'ges', name: 'General Santos (GES)', lat: 6.0581, lon: 125.0961, type: 'Airport' },
			{ id: 'zam', name: 'Zamboanga (ZAM)', lat: 6.9225, lon: 122.0597, type: 'Airport' },
			{ id: 'mph', name: 'Boracay / Caticlan (MPH)', lat: 11.9281, lon: 121.9547, type: 'Airport' },
			{ id: 'klo', name: 'Kalibo International (KLO)', lat: 11.6792, lon: 122.3761, type: 'Airport' },
			{ id: 'tac', name: 'Tacloban (TAC)', lat: 11.2272, lon: 125.0278, type: 'Airport' },
			{ id: 'lao', name: 'Laoag International (LAO)', lat: 18.1783, lon: 120.5317, type: 'Airport' },
			{ id: 'drp', name: 'Bicol / Daraga (DRP)', lat: 13.1133, lon: 123.6769, type: 'Airport' },
			{ id: 'bso', name: 'Batanes / Basco (BSO)', lat: 20.4483, lon: 121.9797, type: 'Airport' },
			{ id: 'usu', name: 'Busuanga / Coron (USU)', lat: 12.1217, lon: 120.1003, type: 'Airport' },
			{ id: 'iao', name: 'Siargao / Sayak (IAO)', lat: 9.8589, lon: 126.0131, type: 'Airport' },
			{ id: 'dgt', name: 'Dumaguete (DGT)', lat: 9.3339, lon: 123.3006, type: 'Airport' }
		]
	},
	{
		group: 'Strategic Ferry Ports & RoRo Gateways (PPA / MARINA)',
		items: [
			{ id: 'port_mnl', name: 'Port of Manila (North/South Harbor)', lat: 14.5833, lon: 120.9500, type: 'Seaport' },
			{ id: 'port_batangas', name: 'Batangas Port (MIMAROPA Gateway)', lat: 13.7583, lon: 121.0417, type: 'Seaport' },
			{ id: 'port_calapan', name: 'Calapan Port (Oriental Mindoro)', lat: 13.4250, lon: 121.1833, type: 'Seaport' },
			{ id: 'port_matnog', name: 'Matnog Port (Sorsogon - Luzon Tip)', lat: 12.5833, lon: 124.0833, type: 'Seaport' },
			{ id: 'port_allen', name: 'Allen Port (Northern Samar Gateway)', lat: 12.5000, lon: 124.2833, type: 'Seaport' },
			{ id: 'port_cebu', name: 'Cebu Pier (Central Visayas Hub)', lat: 10.2917, lon: 123.9083, type: 'Seaport' },
			{ id: 'port_tubigon', name: 'Tubigon Port (Bohol Fastcraft)', lat: 9.9500, lon: 123.9500, type: 'Seaport' },
			{ id: 'port_iloilo', name: 'Iloilo Parola Wharf (Panay)', lat: 10.6917, lon: 122.5833, type: 'Seaport' },
			{ id: 'port_bacolod', name: 'Bacolod BREDCO Port (Negros)', lat: 10.6667, lon: 122.9333, type: 'Seaport' },
			{ id: 'port_lipata', name: 'Lipata Port (Surigao Gateway)', lat: 9.8000, lon: 125.4667, type: 'Seaport' },
			{ id: 'port_liloan', name: 'Liloan Ferry Terminal (Southern Leyte)', lat: 10.1500, lon: 125.1333, type: 'Seaport' },
			{ id: 'port_dapitan', name: 'Dapitan Pulauan Port (Mindanao Entry)', lat: 8.6500, lon: 123.4167, type: 'Seaport' },
			{ id: 'port_dumaguete', name: 'Dumaguete Port (Negros Oriental)', lat: 9.3167, lon: 123.3167, type: 'Seaport' },
			{ id: 'port_cdo', name: 'Cagayan de Oro Port (Macabalan)', lat: 8.5000, lon: 124.6667, type: 'Seaport' },
			{ id: 'port_zamboanga', name: 'Zamboanga Port (Sulu Sea Hub)', lat: 6.9000, lon: 122.0667, type: 'Seaport' }
		]
	},
	{
		group: 'Regional Capitals & Urban Hubs',
		items: [
			{ id: 'city_baguio', name: 'Baguio City (Summer Capital)', lat: 16.4023, lon: 120.5960, type: 'City' },
			{ id: 'city_launion', name: 'San Fernando (La Union Surf Coast)', lat: 16.6167, lon: 120.3167, type: 'City' },
			{ id: 'city_lucena', name: 'Lucena City (Southern Tagalog)', lat: 13.9333, lon: 121.6167, type: 'City' },
			{ id: 'city_puertogalera', name: 'Puerto Galera (Mindoro)', lat: 13.5000, lon: 120.9500, type: 'City' },
			{ id: 'city_tacloban', name: 'Tacloban City (Leyte)', lat: 11.2433, lon: 125.0042, type: 'City' },
			{ id: 'city_tagum', name: 'Tagum City (Davao del Norte)', lat: 7.4475, lon: 125.8078, type: 'City' },
			{ id: 'city_butuan', name: 'Butuan City (Agusan del Norte)', lat: 8.9475, lon: 125.5406, type: 'City' },
			{ id: 'city_iligan', name: 'Iligan City (Lanao del Norte)', lat: 8.2281, lon: 124.2453, type: 'City' }
		]
	}
];

// Popular travel corridor pairs
const CORRIDOR_PRESETS = [
	{ name: 'Manila ↔ Cebu', orig: 'mnl', dest: 'ceb', desc: 'Busiest domestic air and shipping corridor' },
	{ name: 'Manila ↔ Davao', orig: 'mnl', dest: 'dvo', desc: 'North-South trunk route (Luzon to Mindanao)' },
	{ name: 'Batangas ↔ Calapan', orig: 'port_batangas', dest: 'port_calapan', desc: 'Western Nautical Highway primary ferry crossing' },
	{ name: 'Matnog ↔ Allen', orig: 'port_matnog', dest: 'port_allen', desc: 'Eastern Nautical Highway RoRo connection across San Bernardino Strait' },
	{ name: 'Iloilo ↔ Bacolod', orig: 'port_iloilo', dest: 'port_bacolod', desc: 'Guimaras Strait fastcraft passenger crossing' },
	{ name: 'Cebu ↔ Bohol (Tubigon)', orig: 'port_cebu', dest: 'port_tubigon', desc: 'High-speed passenger ferry route across Cebu Strait' },
	{ name: 'Manila ↔ Puerto Princesa', orig: 'mnl', dest: 'pps', desc: 'West Philippine Sea island corridor to Palawan' },
	{ name: 'Manila ↔ Batanes (Basco)', orig: 'mnl', dest: 'bso', desc: 'Northernmost island route crossing Luzon Strait' }
];
---

<BaseLayout
	title="Philippine Inter-Island Distance, Flight & Nautical Route Calculator — mapaPH Tools"
	description="Calculate great-circle distances, nautical miles, commercial flight durations, and RoRo ferry travel times across all 7,641 islands in the Philippines on an interactive map."
	keywords="Philippine distance calculator, Manila to Cebu distance, Manila to Davao flight time, nautical miles Philippines, Batangas Calapan ferry distance, Matnog Allen RoRo, Haversine formula Philippines, great circle distance map, Philippine Nautical Highway distance, air miles Philippines"
>
	<!-- Leaflet Stylesheet -->
	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
		slot="schema"
	/>

	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Philippine Inter-Island Distance, Flight & Nautical Calculator",
					"url": "https://mapaph.com/tools/distance",
					"applicationCategory": "Geographic & Transit Utility",
					"operatingSystem": "All",
					"description": "Interactive great-circle geodesic calculator measuring distance, flight duration, and nautical sea miles across the Philippine archipelago.",
					"provider": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://mapaph.com"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "How far is Manila to Cebu in kilometers and nautical miles?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "The great-circle straight-line distance between Manila (NAIA) and Cebu (Mactan) is approximately 566 kilometers (306 nautical miles or 352 statute miles). Scheduled commercial jet flights take approximately 1 hour and 15 minutes gate-to-gate."
							}
						},
						{
							"@type": "Question",
							"name": "What is the difference between a statute mile and a nautical mile in the Philippines?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "A standard statute mile measures exactly 1,609.34 meters (1.61 km), commonly used on land roads. A nautical mile (NM) measures exactly 1,852 meters (1.852 km), defined as one minute of latitude on Earth's surface. Maritime routes regulated by MARINA and aviation flight paths under CAAP strictly use nautical miles."
							}
						},
						{
							"@type": "Question",
							"name": "What is the Philippine Nautical Highway System?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Established under Executive Order No. 170, the Philippine Nautical Highway is an integrated 919-kilometer network of roll-on/roll-off (RoRo) ferry connections and highways linking Luzon, Visayas, and Mindanao across three main spines: the Western, Central, and Eastern Nautical Highways."
							}
						},
						{
							"@type": "Question",
							"name": "How does the tool calculate flight and ferry travel times?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Commercial jet travel times are estimated using an average cruise speed of 800 km/h plus 30 minutes for taxiing, climbing, and terminal arrival circuits. Turboprops are calculated at 450 km/h plus 25 minutes. Fastcraft passenger catamarans are estimated at 28 knots (52 km/h) and RoRo cargo-passenger vessels at 14 knots (26 km/h)."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main class="max-w-7xl mx-auto px-6 lg:px-8 py-12 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-3xl mb-8">
			<div class="flex items-center gap-2 mb-2">
				<span class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Geodesic & Mobility Utility
				</span>
				<span class="font-sans text-xs text-mapa-clay">
					Great-Circle WGS84 Geodesics
				</span>
			</div>
			<h1 class="text-3xl sm:text-4xl font-extrabold text-mapa-green font-serif tracking-tight">
				Philippine Inter-Island Distance & Route Calculator
			</h1>
			<p class="font-sans text-sm sm:text-base text-mapa-ink/80 mt-2 leading-relaxed">
				Measure true great-circle distances, nautical miles, compass bearings, commercial flight times, and RoRo ferry transit durations between any two points across the 7,641 islands of the Philippines.
			</p>
		</div>

		<!-- 2-Column App Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			
			<!-- Left Column: Interactive Map (7 cols) -->
			<div class="lg:col-span-7 flex flex-col gap-6 font-sans">
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl overflow-hidden shadow-xs flex flex-col">
					<!-- Map Header Bar -->
					<div class="p-4 border-b border-mapa-contour/50 flex flex-wrap items-center justify-between gap-3 bg-mapa-canvas">
						<div class="flex items-center gap-2">
							<span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
							<span class="text-xs font-bold uppercase tracking-wider text-mapa-ink">
								Philippine Archipelago Geodesic Map
							</span>
						</div>
						<div class="flex items-center gap-2 text-xs">
							<span class="px-2 py-0.5 rounded bg-mapa-canvas border border-mapa-contour text-[11px] text-mapa-clay">
								Click any 2 points on map or drag pins
							</span>
						</div>
					</div>

					<!-- Leaflet Map Canvas -->
					<div
						id="distance-map"
						class="w-full h-[480px] sm:h-[550px] bg-stone-100 z-0 relative"
						aria-label="Interactive Philippine inter-island distance map"
					></div>

					<!-- Map Legend Bar -->
					<div class="p-3.5 bg-mapa-canvas border-t border-mapa-contour/50 flex flex-wrap items-center justify-between text-xs text-mapa-ink/70 gap-2">
						<div class="flex items-center gap-4">
							<span class="inline-flex items-center gap-1.5">
								<span class="w-3 h-3 rounded-full bg-emerald-600 border border-white shadow-xs"></span>
								<span class="font-medium text-mapa-ink">Point A (Origin)</span>
							</span>
							<span class="inline-flex items-center gap-1.5">
								<span class="w-3 h-3 rounded-full bg-rose-600 border border-white shadow-xs"></span>
								<span class="font-medium text-mapa-ink">Point B (Destination)</span>
							</span>
							<span class="inline-flex items-center gap-1.5">
								<span class="w-5 h-0.5 bg-amber-500 border-t border-dashed border-amber-600"></span>
								<span>Geodesic Arc</span>
							</span>
						</div>
						<button
							id="reset-points-btn"
							class="text-[11px] font-semibold text-mapa-green hover:underline"
						>
							Reset to Manila ↔ Cebu
						</button>
					</div>
				</div>

				<!-- Major Philippine Sea & Air Corridors -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-5 shadow-xs">
					<h3 class="font-serif text-lg font-bold text-mapa-ink mb-3">
						Popular Inter-Island Commuter & Logistics Corridors
					</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
						{CORRIDOR_PRESETS.map(preset => (
							<button
								class="corridor-btn p-3 rounded-xl bg-mapa-canvas border border-mapa-contour/70 hover:border-mapa-green transition-all text-left flex flex-col justify-between"
								data-orig={preset.orig}
								data-dest={preset.dest}
							>
								<div class="flex items-center justify-between gap-2 mb-1">
									<span class="font-bold text-mapa-ink text-xs">{preset.name}</span>
									<span class="text-[10px] text-mapa-green font-semibold shrink-0">Select &rarr;</span>
								</div>
								<p class="text-[11px] text-mapa-clay leading-relaxed">
									{preset.desc}
								</p>
							</button>
						))}
					</div>
				</div>
			</div>

			<!-- Right Column: Distance Computations & Travel Durations (5 cols) -->
			<div class="lg:col-span-5 flex flex-col gap-6 font-sans">
				
				<!-- Calculator Control Card -->
				<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-2xl p-6 shadow-xs">
					<h2 class="font-serif text-xl font-bold text-mapa-ink mb-4 pb-2 border-b border-mapa-contour/50">
						Route & Distance Calculator
					</h2>

					<!-- Origin Selection -->
					<div class="mb-3.5">
						<label for="origin-select" class="block text-xs font-bold uppercase tracking-wider text-mapa-clay mb-1.5">
							Origin (Point A)
						</label>
						<select
							id="origin-select"
							class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green"
						>
							<option value="custom">-- Custom Map Pin --</option>
							{LOCATION_PRESETS.map(g => (
								<optgroup label={g.group}>
									{g.items.map(loc => (
										<option value={loc.id} selected={loc.id === 'mnl'}>
											{loc.name}
										</option>
									))}
								</optgroup>
							))}
						</select>
						<div id="origin-coords-label" class="mt-1 text-[11px] text-mapa-clay font-mono">
							14.508600° N, 121.019400° E
						</div>
					</div>

					<!-- Swap Button -->
					<div class="flex justify-center -my-1 relative z-10">
						<button
							id="swap-locations-btn"
							type="button"
							class="bg-mapa-canvas hover:bg-mapa-canvas-dark border border-mapa-contour rounded-full p-2 text-mapa-ink/70 hover:text-mapa-green transition-all shadow-xs"
							aria-label="Swap origin and destination"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
							</svg>
						</button>
					</div>

					<!-- Destination Selection -->
					<div class="mb-5">
						<label for="dest-select" class="block text-xs font-bold uppercase tracking-wider text-mapa-clay mb-1.5">
							Destination (Point B)
						</label>
						<select
							id="dest-select"
							class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-mapa-green"
						>
							<option value="custom">-- Custom Map Pin --</option>
							{LOCATION_PRESETS.map(g => (
								<optgroup label={g.group}>
									{g.items.map(loc => (
										<option value={loc.id} selected={loc.id === 'ceb'}>
											{loc.name}
										</option>
									))}
								</optgroup>
							))}
						</select>
						<div id="dest-coords-label" class="mt-1 text-[11px] text-mapa-clay font-mono">
							10.307500° N, 123.979400° E
						</div>
					</div>

					<!-- Primary Distance Result Display -->
					<div class="bg-mapa-canvas border border-mapa-contour rounded-xl p-4.5 mb-5 flex flex-col gap-3">
						<div class="flex items-center justify-between pb-3 border-b border-mapa-contour/50">
							<div>
								<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay">
									Great-Circle Distance
								</span>
								<div class="flex items-baseline gap-2 mt-0.5">
									<span id="dist-km" class="text-3xl sm:text-4xl font-extrabold text-mapa-green font-serif">
										566.2
									</span>
									<span class="text-base font-bold text-mapa-ink">kilometers</span>
								</div>
							</div>
							<div class="text-right">
								<span class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay block">
									Heading
								</span>
								<span id="compass-bearing" class="text-xl font-extrabold text-mapa-ink font-serif">
									148° (SSE)
								</span>
							</div>
						</div>

						<!-- Unit Conversions Grid -->
						<div class="grid grid-cols-2 gap-2 text-xs">
							<div class="p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
								<span class="text-[10px] uppercase font-bold text-mapa-clay block">Nautical Miles (NM)</span>
								<span id="dist-nm" class="text-base font-extrabold text-mapa-ink">305.7 NM</span>
								<span class="text-[10px] text-mapa-clay block mt-0.5">Maritime / Aviation standard</span>
							</div>
							<div class="p-2.5 rounded-lg bg-mapa-canvas-dark border border-mapa-contour/50">
								<span class="text-[10px] uppercase font-bold text-mapa-clay block">Statute Miles (mi)</span>
								<span id="dist-miles" class="text-base font-extrabold text-mapa-ink">351.8 mi</span>
								<span class="text-[10px] text-mapa-clay block mt-0.5">Land road equivalent</span>
							</div>
						</div>
					</div>

					<!-- Estimated Transit Times by Mode -->
					<div class="space-y-3">
						<span class="text-xs font-bold uppercase tracking-wider text-mapa-clay block">
							Estimated Travel Times by Transport Mode
						</span>

						<!-- Commercial Jet Flight -->
						<div class="p-3 rounded-xl bg-mapa-canvas border border-mapa-contour/70 flex items-center justify-between text-xs">
							<div class="flex items-center gap-2.5">
								<span class="text-lg">✈️</span>
								<div>
									<h4 class="font-bold text-mapa-ink">Commercial Jet Flight</h4>
									<p class="text-[11px] text-mapa-clay">A320 / A321 @ 800 km/h + 30m runway circuit</p>
								</div>
							</div>
							<div class="text-right">
								<span id="time-jet" class="font-extrabold text-mapa-green text-sm block">~1h 12m</span>
								<span class="text-[10px] text-mapa-clay">Gate-to-gate</span>
							</div>
						</div>

						<!-- Regional Turboprop Flight -->
						<div class="p-3 rounded-xl bg-mapa-canvas border border-mapa-contour/70 flex items-center justify-between text-xs">
							<div class="flex items-center gap-2.5">
								<span class="text-lg">🛩️</span>
								<div>
									<h4 class="font-bold text-mapa-ink">Regional Turboprop Flight</h4>
									<p class="text-[11px] text-mapa-clay">ATR 72 / Q400 @ 450 km/h + 25m circuit</p>
								</div>
							</div>
							<div class="text-right">
								<span id="time-turboprop" class="font-extrabold text-mapa-ink text-sm block">~1h 40m</span>
								<span class="text-[10px] text-mapa-clay">Gate-to-gate</span>
							</div>
						</div>

						<!-- High-Speed Fastcraft Ferry -->
						<div class="p-3 rounded-xl bg-mapa-canvas border border-mapa-contour/70 flex items-center justify-between text-xs">
							<div class="flex items-center gap-2.5">
								<span class="text-lg">🚤</span>
								<div>
									<h4 class="font-bold text-mapa-ink">High-Speed Fastcraft Ferry</h4>
									<p class="text-[11px] text-mapa-clay">Passenger Catamaran @ 28 knots (52 km/h)</p>
								</div>
							</div>
							<div class="text-right">
								<span id="time-fastcraft" class="font-extrabold text-mapa-ink text-sm block">~11h 05m</span>
