			// Geodesic Mathematics
			function toRad(degrees) {
				return (degrees * Math.PI) / 180;
			}

			function toDeg(radians) {
				return (radians * 180) / Math.PI;
			}

			// Great Circle Haversine Distance (km)
			function computeDistanceKm(lat1, lon1, lat2, lon2) {
				const R = 6371.0; // Mean Earth radius in km
				const dLat = toRad(lat2 - lat1);
				const dLon = toRad(lon2 - lon1);
				const rLat1 = toRad(lat1);
				const rLat2 = toRad(lat2);

				const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
					Math.cos(rLat1) * Math.cos(rLat2) *
					Math.sin(dLon / 2) * Math.sin(dLon / 2);
				const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
				return R * c;
			}

			// Initial Compass Bearing (Azimuth)
			function computeBearing(lat1, lon1, lat2, lon2) {
				const rLat1 = toRad(lat1);
				const rLat2 = toRad(lat2);
				const dLon = toRad(lon2 - lon1);

				const y = Math.sin(dLon) * Math.cos(rLat2);
				const x = Math.cos(rLat1) * Math.sin(rLat2) -
					Math.sin(rLat1) * Math.cos(rLat2) * Math.cos(dLon);
				let brng = toDeg(Math.atan2(y, x));
				brng = (brng + 360) % 360;
				return Math.round(brng);
			}

			function getCompassName(bearing) {
				const compassPoints = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
				const index = Math.round(bearing / 22.5) % 16;
				return compassPoints[index];
			}

			// Geodesic Interpolation Points for Smooth Curved Arc
			function computeGeodesicArc(lat1, lon1, lat2, lon2, numSegments = 50) {
				const rLat1 = toRad(lat1);
				const rLon1 = toRad(lon1);
				const rLat2 = toRad(lat2);
				const rLon2 = toRad(lon2);

				const d = 2 * Math.asin(Math.sqrt(
					Math.sin((rLat2 - rLat1) / 2) ** 2 +
					Math.cos(rLat1) * Math.cos(rLat2) * Math.sin((rLon2 - rLon1) / 2) ** 2
				));

				if (d < 1e-6) return [[lat1, lon1], [lat2, lon2]];

				const arc = [];
				for (let i = 0; i <= numSegments; i++) {
					const f = i / numSegments;
					const A = Math.sin((1 - f) * d) / Math.sin(d);
					const B = Math.sin(f * d) / Math.sin(d);

					const x = A * Math.cos(rLat1) * Math.cos(rLon1) + B * Math.cos(rLat2) * Math.cos(rLon2);
					const y = A * Math.cos(rLat1) * Math.sin(rLon1) + B * Math.cos(rLat2) * Math.sin(rLon2);
					const z = A * Math.sin(rLat1) + B * Math.sin(rLat2);

					const lat = Math.atan2(z, Math.sqrt(x ** 2 + y ** 2));
					const lon = Math.atan2(y, x);
					arc.push([toDeg(lat), toDeg(lon)]);
				}
				return arc;
			}

			function formatDuration(totalMinutes) {
				const hours = Math.floor(totalMinutes / 60);
				const mins = Math.round(totalMinutes % 60);
				if (hours === 0) return `~${mins} mins`;
				return `~${hours}h ${mins < 10 ? '0' : ''}${mins}m`;
			}

			// Update UI and map
			function updateCalculations() {
				const km = computeDistanceKm(pointA.lat, pointA.lon, pointB.lat, pointB.lon);
