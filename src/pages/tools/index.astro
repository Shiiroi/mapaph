	<script is:inline>
		(function () {
			const searchInput = document.getElementById('tools-directory-search');
			const catBtns = document.querySelectorAll('.tool-cat-btn');
			const cards = document.querySelectorAll('[data-tool-card]');
			const emptyState = document.getElementById('tools-empty-state');
			let activeCat = 'all';

			function filterTools() {
				const q = (searchInput?.value || '').trim().toLowerCase();
				let visibleCount = 0;

				cards.forEach((card) => {
					const cat = card.getAttribute('data-cat');
					const text = (card.textContent || '').toLowerCase();
					const matchCat = activeCat === 'all' || cat === activeCat;
					const matchQuery = !q || text.includes(q);
					const show = matchCat && matchQuery;
					card.classList.toggle('hidden', !show);
					if (show) visibleCount++;
				});

				if (emptyState) {
					emptyState.classList.toggle('hidden', visibleCount > 0);
				}
			}

			searchInput?.addEventListener('input', filterTools);

			catBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					activeCat = btn.getAttribute('data-cat') || 'all';
					catBtns.forEach((b) => {
						b.className =
							'tool-cat-btn px-3 py-1.5 rounded-lg font-medium border transition-colors bg-mapa-canvas text-mapa-ink/80 border-mapa-contour hover:border-mapa-green/50 cursor-pointer';
					});
					btn.className =
						'tool-cat-btn px-3 py-1.5 rounded-lg font-semibold border transition-colors bg-mapa-green text-white border-mapa-green cursor-pointer';
					filterTools();
				});
			});
		})();
	</script>
