	description="Free online coordinate converter for the Philippines. Convert between GPS Latitude/Longitude (WGS84) and PRS92 / UTM Zone 51N Easting and Northing."
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "Philippine PRS92 / WGS84 Coordinate Converter",
			"url": "https://mapaph.com/tools/coordinates",
			"applicationCategory": "Geographic Utility",
			"operatingSystem": "All",
			"description": "Convert between GPS latitude/longitude (WGS84) and Philippine Reference System 1992 (PRS92 / UTM Zone 51N) with datum shift analysis.",
			"provider": {
				"@type": "Organization",
				"name": "mapaPH",
				"url": "https://mapaph.com"
			}
		}
	</script>

	<Navbar />

	<main class="max-w-7xl mx-auto px-6 lg:px-8 py-12 text-mapa-ink">
		<!-- Header -->
		<div class="max-w-3xl mb-8">
			<div class="flex items-center gap-2 mb-2">
				<span class="font-sans text-xs font-bold uppercase tracking-wider text-mapa-green bg-mapa-green/10 px-2.5 py-0.5 rounded-full">
					Interactive Mini-Tool
				</span>
				<span class="font-sans text-xs text-mapa-clay">
					Survey & GIS Utility
				</span>
			</div>
