---
/**
 * @file fare-calculator.astro
 * @description Interactive Philippine public transit fare estimator for buses, modern jeepneys, traditional jeepneys, and trains.
 * Powered by official LTFRB and DOTr statutory fare matrices with distance presets and commuter legal rights guides.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Official LTFRB statutory fare matrices (Effective September 28, 2026)
const FARE_RATES = {
	airconBus: {
		name: 'Airconditioned City Bus',
		type: 'City Bus (PUB)',
		baseFare: 18.0,
		baseKm: 5,
		perKm: 2.98,
		discountBase: 14.4,
		discountPerKm: 2.38,
		color: 'text-mapa-green',
		bgLight: 'bg-mapa-green/10',
		borderColor: 'border-mapa-green/30'
	},
	ordinaryBus: {
		name: 'Ordinary (Non-Aircon) Bus',
		type: 'City Bus (PUB)',
		baseFare: 15.0,
		baseKm: 5,
		perKm: 2.49,
		discountBase: 12.0,
		discountPerKm: 1.99,
		color: 'text-mapa-navy',
		bgLight: 'bg-mapa-navy/10',
		borderColor: 'border-mapa-navy/30'
	},
	modernJeep: {
		name: 'Modern E-Jeepney (MPUJ)',
		type: 'Public Utility Jeepney',
		baseFare: 17.0,
		baseKm: 4,
		perKm: 2.4,
		discountBase: 13.6,
		discountPerKm: 1.92,
		color: 'text-mapa-rust',
		bgLight: 'bg-mapa-rust/10',
		borderColor: 'border-mapa-rust/30'
	},
	tradJeep: {
		name: 'Traditional Jeepney (TPUJ)',
		type: 'Public Utility Jeepney',
		baseFare: 14.0,
		baseKm: 4,
		perKm: 2.0,
		discountBase: 11.2,
		discountPerKm: 1.6,
		color: 'text-mapa-green',
		bgLight: 'bg-mapa-green/10',
		borderColor: 'border-mapa-green/30'
	},
	uvExpress: {
		name: 'Modern UV Express',
		type: 'Point-to-Point Van',
		baseFare: 3.0,
		baseKm: 1,
		perKm: 3.0,
		discountBase: 2.4,
		discountPerKm: 2.4,
		color: 'text-mapa-navy',
		bgLight: 'bg-mapa-navy/10',
		borderColor: 'border-mapa-navy/30'
	},
	provBus: {
		name: 'Provincial Bus (Ordinary)',
		type: 'Inter-Provincial PUB',
		baseFare: 12.0,
		baseKm: 5,
		perKm: 2.2,
		discountBase: 9.6,
		discountPerKm: 1.76,
		color: 'text-mapa-rust',
		bgLight: 'bg-mapa-rust/10',
		borderColor: 'border-mapa-rust/30'
	}
};

// Round to nearest 25 centavos per official LTFRB Fare Guide rules
function roundTo25Centavos(val: number): number {
	return Math.round(val * 4) / 4;
}

function computeOfficialFare(modeKey: keyof typeof FARE_RATES, km: number, isDiscounted: boolean): number {
	const conf = FARE_RATES[modeKey];
	const base = isDiscounted ? conf.discountBase : conf.baseFare;
	const perKm = isDiscounted ? conf.discountPerKm : conf.perKm;
	if (km <= conf.baseKm) {
		return roundTo25Centavos(base);
	}
	return roundTo25Centavos(base + (km - conf.baseKm) * perKm);
}

// Pre-compute 1 km to 50 km Official LTFRB Fare Matrix Rows for SSR + Interactive Table
const KM_MATRIX_ROWS = Array.from({ length: 50 }, (_, idx) => {
	const km = idx + 1;
	return {
		km,
		tradJeepReg: computeOfficialFare('tradJeep', km, false),
		tradJeepDisc: computeOfficialFare('tradJeep', km, true),
		modernJeepReg: computeOfficialFare('modernJeep', km, false),
		modernJeepDisc: computeOfficialFare('modernJeep', km, true),
		ordBusReg: computeOfficialFare('ordinaryBus', km, false),
		ordBusDisc: computeOfficialFare('ordinaryBus', km, true),
		airconBusReg: computeOfficialFare('airconBus', km, false),
		airconBusDisc: computeOfficialFare('airconBus', km, true),
		uvModReg: computeOfficialFare('uvExpress', km, false),
		uvModDisc: computeOfficialFare('uvExpress', km, true),
		provBusReg: computeOfficialFare('provBus', km, false),
		provBusDisc: computeOfficialFare('provBus', km, true)
	};
});
