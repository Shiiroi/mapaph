---
/**
 * @file fare-calculator.astro
 * @description Interactive Philippine public transit fare estimator for buses, modern jeepneys, traditional jeepneys, and trains.
 * Powered by official LTFRB and DOTr statutory fare matrices with distance presets and commuter legal rights guides.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Official LTFRB statutory fare matrices (2024–2026 baseline)
const FARE_RATES = {
	airconBus: {
		name: 'Airconditioned City Bus',
		type: 'City Bus',
		baseFare: 15.0,
		baseKm: 5,
		perKm: 2.65,
		discountBase: 12.0,
		discountPerKm: 2.12,
		color: 'text-mapa-green',
		bgLight: 'bg-mapa-green/10',
		borderColor: 'border-mapa-green/30'
	},
	ordinaryBus: {
		name: 'Ordinary (Non-Aircon) Bus',
		type: 'City Bus',
		baseFare: 13.0,
		baseKm: 5,
		perKm: 2.25,
		discountBase: 10.4,
		discountPerKm: 1.8,
		color: 'text-mapa-navy',
		bgLight: 'bg-mapa-navy/10',
		borderColor: 'border-mapa-navy/30'
	},
	modernJeep: {
		name: 'Modern E-Jeepney (MPUJ)',
		type: 'Public Utility Jeepney',
		baseFare: 15.0,
		baseKm: 4,
		perKm: 2.2,
		discountBase: 12.0,
		discountPerKm: 1.76,
		color: 'text-mapa-rust',
		bgLight: 'bg-mapa-rust/10',
		borderColor: 'border-mapa-rust/30'
	},
	tradJeep: {
		name: 'Traditional Jeepney (TPUJ)',
		type: 'Public Utility Jeepney',
		baseFare: 13.0,
		baseKm: 4,
		perKm: 1.8,
		discountBase: 10.4,
		discountPerKm: 1.44,
		color: 'text-mapa-green',
		bgLight: 'bg-mapa-green/10',
		borderColor: 'border-mapa-green/30'
	},
	railTransit: {
		name: 'Metro Manila Rail (LRT/MRT)',
		type: 'Mass Rapid Transit',
		baseFare: 13.29,
		baseKm: 1,
		perKm: 1.21,
		discountBase: 10.63,
		discountPerKm: 0.97,
		color: 'text-mapa-navy',
		bgLight: 'bg-mapa-navy/10',
		borderColor: 'border-mapa-navy/30'
	}
};
---

<BaseLayout
	title="Philippine Commute Fare Calculator: Bus, Jeepney & Train — mapaPH Tools"
	description="Official LTFRB Philippine transit fare estimator. Calculate exact legal fares for Aircon Buses, Ordinary Buses, Modern Jeepneys, Traditional Jeepneys, and MRT/LRT with 20% student, senior, and PWD discount calculations."
	keywords="Philippine fare calculator, jeepney fare calculator, bus fare calculator Metro Manila, LTFRB fare matrix 2026, modern jeepney fare, student fare discount Philippines, senior citizen fare discount, MRT LRT fare calculator, EDSA bus carousel fare"
>
	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "Philippine Public Transit Fare Estimator",
					"url": "https://mapaph.com/tools/fare-calculator",
					"applicationCategory": "Commuting & Transit Utility",
					"operatingSystem": "All",
					"description": "Interactive fare calculator for Philippine public utility vehicles based on official LTFRB and DOTr distance matrices.",
					"provider": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://mapaph.com"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "What is the official base fare for jeepneys in the Philippines?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Under official LTFRB resolutions, the minimum regular base fare for Traditional Public Utility Jeepneys (TPUJ) is ₱13.00 for the first 4 kilometers (₱1.80 per succeeding kilometer). For Modern Public Utility Jeepneys (MPUJ), the base fare is ₱15.00 for the first 4 kilometers (₱2.20 per succeeding kilometer)."
							}
						},
						{
							"@type": "Question",
							"name": "Are students entitled to a 20% fare discount on weekends and holidays?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Yes! Under Republic Act No. 11314 (Student Fare Discount Act), all Filipino students from elementary to college/vocational levels are legally entitled to a 20% discount 365 days a year, including weekends, semester breaks, and national holidays. The driver or conductor cannot refuse the discount upon presentation of a valid student ID."
							}
						},
						{
							"@type": "Question",
							"name": "How is bus fare computed in Metro Manila?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "City buses use a 5-kilometer base distance. For regular ordinary (non-aircon) buses, the base fare is ₱13.00 with ₱2.25 for every succeeding kilometer. For airconditioned buses, the base fare is ₱15.00 with ₱2.65 for every succeeding kilometer."
							}
						},
						{
							"@type": "Question",
							"name": "Where can I report jeepney or bus drivers who overcharge or refuse discounts?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "You can report overcharging, rude drivers, or discount refusals directly to the LTFRB Public Assistance and Complaints Desk via 24/7 Hotline 1342, Viber hotline at 0928-886-4244, or by emailing complaints@ltfrb.gov.ph with the PUV license plate number and route details."
							}
						}
					]
				}
			]
		}
	</script>

	<Navbar />

