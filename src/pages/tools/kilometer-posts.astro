		originKm: 'KM 0 (Luneta, Manila)',
		termini: 'Manila / Pasig ↔ Pililla & Famy (Laguna Border)',
		totalKm: 68.0,
		description: 'The historic circumferential eastern artery traversing Cainta, Taytay, Angono, Binangonan, Cardona, Morong, Baras, Tanay, and Pililla along the northern rim of Laguna de Bay.',
		color: '#2563EB',
		markers: [
			{ km: 0, town: 'Luneta, City of Manila', prov: 'NCR', landmark: 'José Rizal Monument, Kilometer Zero Obelisk', destTop: 'CAINTA 16', lat: 14.5826, lon: 120.9787, isTourist: true, gmapsUrl: 'https://www.google.com/maps/search/?api=1&query=Kilometer+Zero+Rizal+Park+Manila' },
			{ km: 14, town: 'Pasig City / Rosario', prov: 'NCR', landmark: 'Rosario Bridge, Ortigas Ave Extension junction', destTop: 'CAINTA 2', lat: 14.5850, lon: 121.0850 },
			{ km: 16, town: 'Cainta Junction', prov: 'Rizal', landmark: 'Our Lady of Light Parish, Valley Golf, Felix Avenue junction', destTop: 'TAYTAY 3', lat: 14.5780, lon: 121.1210 },
			{ km: 19, town: 'Taytay Town Proper', prov: 'Rizal', landmark: 'St. John the Baptist Parish, Taytay Tiangge Garments Capital', destTop: 'ANGONO 7', lat: 14.5480, lon: 121.1320 },
			{ km: 26, town: 'Angono (Art Capital)', prov: 'Rizal', landmark: 'Blanco Family Museum, Higantes Festival grounds, Petroglyphs gateway', destTop: 'BINANGONAN 6', lat: 14.5240, lon: 121.1550, isTourist: true, gmapsUrl: 'https://www.google.com/maps/search/?api=1&query=Blanco+Family+Museum+Angono+Rizal' },
			{ km: 32, town: 'Binangonan Poblacion', prov: 'Rizal', landmark: 'Santa Ursula Parish, Binangonan Wharf to Talim Island', destTop: 'CARDONA 7', lat: 14.4650, lon: 121.1920 },
			{ km: 39, town: 'Cardona', prov: 'Rizal', landmark: 'Cardona Coastal Strip, Laguna de Bay freshwater fish farming hubs', destTop: 'MORONG 6', lat: 14.4850, lon: 121.2280 },
			{ km: 45, town: 'Morong Historic Town', prov: 'Rizal', landmark: 'St. Jerome Parish Church (Spanish Baroque Belltower), URS Morong', destTop: 'BARAS 4', lat: 14.5120, lon: 121.2380 },
			{ km: 49, town: 'Baras Poblacion', prov: 'Rizal', landmark: 'St. Joseph Parish Church, Baras River Bridge', destTop: 'TANAY 5', lat: 14.5200, lon: 121.2650 },
			{ km: 54, town: 'Tanay Town Center', prov: 'Rizal', landmark: 'San Ildefonso de Toledo Church, Tanay Town Park, Daranak Falls route', destTop: 'PILILLA 6', lat: 14.4980, lon: 121.2850 },
			{ km: 60, town: 'Pililla Wind Farm Ridge', prov: 'Rizal', landmark: 'Pililla Windmill Viewpoint, Rizal–Laguna mountain crossover', destTop: 'FAMY 8', lat: 14.4750, lon: 121.3250, isTourist: true, gmapsUrl: 'https://www.google.com/maps/search/?api=1&query=Pililla+Windmills+Rizal' },
			{ km: 68, town: 'Mabitac / Famy Junction', prov: 'Laguna', landmark: 'Rizal–Laguna Boundary, Gateway to Siniloan & Real', destTop: 'SINILOAN 4', lat: 14.4350, lon: 121.4350 }
		]
	}
];
