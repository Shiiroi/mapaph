	</main>

	<Footer />

	<!-- Leaflet Bundle Script -->
	<script
		src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
		integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
		crossorigin=""
		is:inline
	></script>

	<!-- Interactive Client Logic -->
	<script is:inline define:vars={{ KM_ZERO_ORIGINS, HIGHWAY_CORRIDORS }}>
		document.addEventListener('DOMContentLoaded', () => {
			const corridorSelect = document.getElementById('corridor-select');
			const kmSlider = document.getElementById('km-slider');
			const kmNumberInput = document.getElementById('km-number-input');
			const sliderMinLabel = document.getElementById('slider-min-label');
			const sliderMaxLabel = document.getElementById('slider-max-label');

			const postDestName = document.getElementById('post-dest-name');
			const postKmNumber = document.getElementById('post-km-number');
			const postRoadCode = document.getElementById('post-road-code');

			const markerTownBadge = document.getElementById('marker-town-badge');
			const markerLandmark = document.getElementById('marker-landmark');
			const markerRouteCode = document.getElementById('marker-route-code');
			const markerCoords = document.getElementById('marker-coords');

			const schematicCorridorTitle = document.getElementById('schematic-corridor-title');
			const schematicTotalKm = document.getElementById('schematic-total-km');
			const milestoneChainList = document.getElementById('milestone-chain-list');

			const btnViewSchematic = document.getElementById('btn-view-schematic');
			const btnViewGeo = document.getElementById('btn-view-geo');
			const schematicContainer = document.getElementById('schematic-view-container');
			const geoContainer = document.getElementById('geo-view-container');

			// Origin card elements
			const originCards = document.querySelectorAll('.origin-select-card');
			const originBannerTitle = document.getElementById('origin-banner-title');
			const originBannerLocation = document.getElementById('origin-banner-location');
			const originBannerCoords = document.getElementById('origin-banner-coords');
			const originBannerElevation = document.getElementById('origin-banner-elevation');
			const originBannerHistory = document.getElementById('origin-banner-history');

			let leafletMap = null;
			let mapMarkers = [];
			let corridorPolyline = null;

			// Corridor Lookup Map
			const corridorsMap = new Map();
			HIGHWAY_CORRIDORS.forEach(c => corridorsMap.set(c.id, c));

			const originsMap = new Map();
			KM_ZERO_ORIGINS.forEach(o => originsMap.set(o.id, o));

			function getCurrentCorridor() {
				return corridorsMap.get(corridorSelect.value) || HIGHWAY_CORRIDORS[0];
			}

			function findNearestMarker(corridor, targetKm) {
				if (!corridor.markers || corridor.markers.length === 0) return null;
				let closest = corridor.markers[0];
				let minDiff = Math.abs(closest.km - targetKm);

				for (let i = 1; i < corridor.markers.length; i++) {
					const diff = Math.abs(corridor.markers[i].km - targetKm);
					if (diff < minDiff) {
						minDiff = diff;
						closest = corridor.markers[i];
					}
				}
				return closest;
			}

			function updateCorridorUI() {
				const corridor = getCurrentCorridor();
				const maxKm = Math.round(corridor.totalKm);

				kmSlider.max = maxKm;
				kmNumberInput.max = maxKm;

				sliderMinLabel.textContent = `KM 0 (${corridor.originKm.split('(')[1]?.replace(')', '') || 'Origin'})`;
				sliderMaxLabel.textContent = `KM ${maxKm} (${corridor.termini.split('↔')[1]?.trim() || 'Terminus'})`;

				schematicCorridorTitle.textContent = `${corridor.name} Milestone Chain`;
				schematicTotalKm.textContent = `${corridor.totalKm.toFixed(1)} Total KM`;

				renderMilestoneChain(corridor);
				updateMarkerUI();
				if (leafletMap) {
					renderMapCorridor(corridor);
				}
			}

			function updateMarkerUI() {
				const corridor = getCurrentCorridor();
				const targetKm = parseInt(kmSlider.value, 10) || 0;
				const marker = findNearestMarker(corridor, targetKm);

				if (!marker) return;

				// Update 3D concrete milestone post representation
				postKmNumber.textContent = marker.km.toString();
				postDestName.textContent = marker.destTop || `${marker.town.toUpperCase()}`;
				postRoadCode.textContent = `${corridor.name.split('(')[0].trim().toUpperCase()} • DPWH MILESTONE`;

				// Update card details
				markerTownBadge.textContent = `${marker.town}, ${marker.prov}`;
				markerLandmark.textContent = marker.landmark;
				markerRouteCode.textContent = corridor.name.split('(')[0].trim();
				markerCoords.textContent = `${marker.lat.toFixed(4)}° N, ${marker.lon.toFixed(4)}° E`;

				const gmapsContainer = document.getElementById('marker-gmaps-container');
				const gmapsLink = document.getElementById('marker-gmaps-link');
				if (gmapsContainer && gmapsLink) {
					if (marker.gmapsUrl) {
						gmapsLink.href = marker.gmapsUrl;
						gmapsContainer.classList.remove('hidden');
					} else {
						gmapsContainer.classList.add('hidden');
					}
				}

				// Highlight active schematic node
				document.querySelectorAll('.chain-node').forEach(node => {
					const nodeKm = parseInt(node.getAttribute('data-km'), 10);
					if (nodeKm === marker.km) {
						node.className = 'chain-node p-3 rounded-xl border border-rose-600 bg-rose-500/15 flex items-center justify-between cursor-pointer transition-all';
					} else {
						node.className = 'chain-node p-3 rounded-xl border border-mapa-contour/60 hover:border-mapa-green/40 hover:bg-mapa-canvas flex items-center justify-between cursor-pointer transition-all';
					}
				});

				// Highlight map marker
				if (leafletMap) {
					mapMarkers.forEach(({ km, markerObj }) => {
						if (km === marker.km) {
							markerObj.setStyle({ fillColor: '#E11D48', radius: 10, weight: 3 });
							markerObj.openPopup();
						} else {
							markerObj.setStyle({ fillColor: '#059669', radius: 6, weight: 2 });
						}
					});
				}
			}

			function renderMilestoneChain(corridor) {
				milestoneChainList.innerHTML = '';

				corridor.markers.forEach((marker) => {
					const item = document.createElement('div');
					item.className = 'chain-node p-3 rounded-xl border border-mapa-contour/60 hover:border-mapa-green/40 hover:bg-mapa-canvas flex items-center justify-between cursor-pointer transition-all';
					item.setAttribute('data-km', marker.km.toString());

					item.innerHTML = `
						<div class="flex items-center gap-3 min-w-0 pr-2">
							<div class="w-11 h-11 rounded-lg bg-slate-100 border-2 border-slate-300 flex flex-col items-center justify-center font-mono flex-shrink-0 shadow-2xs">
								<span class="text-[8px] font-bold text-slate-500">KM</span>
								<span class="text-xs font-extrabold text-slate-800 leading-none">${marker.km}</span>
							</div>
							<div class="min-w-0">
								<div class="font-serif font-bold text-sm text-mapa-ink flex items-center gap-1.5 truncate">
									<span>${marker.town}</span>
									${marker.isTourist ? '<span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-amber-500/15 text-amber-800 border border-amber-300/80">⭐ Landmark</span>' : ''}
								</div>
								<div class="text-[11px] text-mapa-clay truncate">${marker.prov} &bull; ${marker.landmark}</div>
							</div>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-mapa-canvas border border-mapa-contour text-mapa-clay">
								${marker.destTop}
							</span>
							${marker.gmapsUrl ? `
								<a
									href="${marker.gmapsUrl}"
									target="_blank"
									rel="noopener noreferrer"
									class="p-1.5 rounded-lg bg-emerald-50 border border-emerald-300/70 hover:bg-emerald-600 hover:text-white text-emerald-800 transition-all shadow-2xs"
									title="View real-life location in Google Maps"
									onclick="event.stopPropagation()"
								>
									<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
									</svg>
								</a>
							` : ''}
						</div>
					`;

					item.addEventListener('click', () => {
						kmSlider.value = marker.km;
						kmNumberInput.value = marker.km;
						updateMarkerUI();
					});

					milestoneChainList.appendChild(item);
				});
			}

			function renderMapCorridor(corridor) {
				if (!leafletMap) return;

				// Clear existing markers
				mapMarkers.forEach(m => leafletMap.removeLayer(m.markerObj));
				mapMarkers = [];
				if (corridorPolyline) leafletMap.removeLayer(corridorPolyline);

				const latLngs = corridor.markers.map(m => [m.lat, m.lon]);

				corridorPolyline = L.polyline(latLngs, {
					color: corridor.color || '#059669',
					weight: 4,
					opacity: 0.85,
					lineJoin: 'round',
					interactive: false
				}).addTo(leafletMap);

				corridor.markers.forEach((marker) => {
					const markerObj = L.circleMarker([marker.lat, marker.lon], {
						radius: 6,
						fillColor: '#059669',
						color: '#ffffff',
						weight: 2,
						opacity: 1,
						fillOpacity: 0.95
					}).addTo(leafletMap);

					markerObj.bindPopup(`
						<div class="font-sans text-xs">
							<div class="flex items-center gap-1.5 mb-0.5">
								<strong class="font-serif text-sm">KM ${marker.km} — ${marker.town}</strong>
								${marker.isTourist ? '<span class="text-[9px] font-bold px-1 py-0.2 rounded bg-amber-100 text-amber-800 border border-amber-300/70">⭐ Landmark</span>' : ''}
							</div>
							<span class="text-gray-600">${marker.prov}</span><br/>
							<span class="text-rose-700 font-semibold">${marker.landmark}</span><br/>
							<span class="text-[10px] text-gray-500 mt-1 block">Sign: ${marker.destTop}</span>
							${marker.gmapsUrl ? `<a href="${marker.gmapsUrl}" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 hover:text-emerald-800 underline">📍 View on Google Maps &rarr;</a>` : ''}
						</div>
					`);

					markerObj.on('click', () => {
						kmSlider.value = marker.km;
						kmNumberInput.value = marker.km;
						updateMarkerUI();
					});

					mapMarkers.push({ km: marker.km, markerObj });
				});

				leafletMap.fitBounds(corridorPolyline.getBounds(), { padding: [40, 40] });
			}

			function initLeafletMap() {
				if (leafletMap || typeof L === 'undefined') return;

				leafletMap = L.map('km-map', {
					center: [15.2, 120.7],
					zoom: 8,
					scrollWheelZoom: true
				});

				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
					maxZoom: 19
				}).addTo(leafletMap);

				renderMapCorridor(getCurrentCorridor());
			}

			// Origin card switcher
			originCards.forEach(card => {
				card.addEventListener('click', () => {
					const originId = card.getAttribute('data-origin-id');
					const origin = originsMap.get(originId);
					if (!origin) return;

					originCards.forEach(c => {
						c.className = 'origin-select-card text-left p-4 rounded-xl border transition-all cursor-pointer bg-mapa-canvas-dark border-mapa-contour hover:border-mapa-green/40';
					});
					card.className = 'origin-select-card text-left p-4 rounded-xl border transition-all cursor-pointer bg-mapa-canvas-dark border-mapa-green shadow-2xs ring-1 ring-mapa-green/30';

					originBannerTitle.textContent = origin.name;
					originBannerLocation.textContent = origin.location;
					originBannerCoords.textContent = `${origin.lat.toFixed(4)}° N, ${origin.lon.toFixed(4)}° E`;
					originBannerElevation.textContent = origin.elevation;
					const originRefLink = document.getElementById('origin-banner-ref-link');
					const originRefLabel = document.getElementById('origin-banner-ref-label');
					if (originRefLink && origin.refUrl) {
						originRefLink.href = origin.refUrl;
					}
					if (originRefLabel && origin.refName) {
						originRefLabel.textContent = origin.refName;
					}
					const originBadge = document.getElementById('origin-banner-badge');
					if (originBadge && origin.markerBadge) {
						originBadge.textContent = origin.markerBadge;
					}
				});
			});

			// Controls listeners
			corridorSelect.addEventListener('change', () => {
				kmSlider.value = 0;
				kmNumberInput.value = 0;
				updateCorridorUI();
			});

			kmSlider.addEventListener('input', () => {
				kmNumberInput.value = kmSlider.value;
				updateMarkerUI();
			});

			kmNumberInput.addEventListener('input', () => {
				kmSlider.value = kmNumberInput.value;
				updateMarkerUI();
			});

			// View switchers
			btnViewSchematic.addEventListener('click', () => {
				btnViewSchematic.className = 'px-3 py-1.5 text-xs font-bold rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				btnViewGeo.className = 'px-3 py-1.5 text-xs font-medium rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
				schematicContainer.classList.remove('hidden');
				geoContainer.classList.add('hidden');
			});

			btnViewGeo.addEventListener('click', () => {
				btnViewGeo.className = 'px-3 py-1.5 text-xs font-bold rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				btnViewSchematic.className = 'px-3 py-1.5 text-xs font-medium rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
				geoContainer.classList.remove('hidden');
				schematicContainer.classList.add('hidden');

				initLeafletMap();
				setTimeout(() => {
					if (leafletMap) {
						leafletMap.invalidateSize();
						if (corridorPolyline) leafletMap.fitBounds(corridorPolyline.getBounds(), { padding: [40, 40] });
					}
				}, 100);
			});

			// Initial setup
			updateCorridorUI();
		});
	</script>
</BaseLayout>
