					</div>
					<div class="pt-2 border-t border-mapa-contour/40">
						<a href="https://www.dpwh.gov.ph" target="_blank" rel="noopener noreferrer" class="text-mapa-green font-bold hover:underline inline-flex items-center gap-1">
							<span>DPWH Official Infrastructure Portal</span>
							<span>&rarr;</span>
						</a>
					</div>
