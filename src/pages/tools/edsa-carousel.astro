						<h2 class="text-lg font-serif font-bold text-mapa-ink">
							Journey Fare Calculator
						</h2>
						<button
							id="swap-stops-btn"
							type="button"
							class="text-xs font-semibold text-mapa-green hover:underline inline-flex items-center gap-1 cursor-pointer"
							title="Swap Boarding and Alighting stops"
						>
							<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
							</svg>
							<span>Reverse Direction</span>
						</button>
					</div>

					<!-- Form Controls -->
					<div class="space-y-4">
						<!-- Origin Stop -->
						<div>
							<label for="origin-select" class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
								<span>Boarding Stop (Origin / Start)</span>
							</label>
							<div class="relative">
								<select
									id="origin-select"
									class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-emerald-600 cursor-pointer"
								>
									{BUSWAY_STOPS.map((stop, index) => (
										<option value={stop.id} selected={index === 0}>
											{index + 1}. {stop.name} ({stop.city}) — KM {stop.km.toFixed(1)}
										</option>
									))}
								</select>
							</div>
						</div>

						<!-- Destination Stop -->
						<div>
							<label for="dest-select" class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-blue-800 mb-1.5">
								<span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
								<span>Alighting Stop (Destination / Exit)</span>
							</label>
							<div class="relative">
								<select
									id="dest-select"
									class="w-full bg-mapa-canvas border border-mapa-contour rounded-xl px-3.5 py-2.5 text-sm font-medium text-mapa-ink focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
								>
									{BUSWAY_STOPS.map((stop, index) => (
										<option value={stop.id} selected={index === BUSWAY_STOPS.length - 1}>
											{index + 1}. {stop.name} ({stop.city}) — KM {stop.km.toFixed(1)}
										</option>
									))}
								</select>
							</div>
						</div>

						<!-- Discount Toggle -->
						<div class="pt-2">
							<label class="flex items-center justify-between p-3 rounded-xl bg-mapa-canvas border border-mapa-contour/70 cursor-pointer hover:border-mapa-green/50 transition-colors">
