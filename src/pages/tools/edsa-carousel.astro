									<span class="text-xs font-bold text-mapa-ink">20% Statutory Discount</span>
									<span class="text-[11px] text-mapa-clay">Student (RA 11314), Senior Citizen (RA 9994), PWD (RA 10754)</span>
								</div>
								<input
									type="checkbox"
									id="discount-toggle"
									class="w-4 h-4 rounded text-mapa-green focus:ring-mapa-green cursor-pointer"
								/>
							</label>
						</div>
					</div>

					<!-- Calculation Result Card -->
					<div class="mt-6 p-5 rounded-xl bg-emerald-600/10 border border-emerald-600/30">
