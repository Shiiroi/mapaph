				<div class="bg-mapa-canvas border border-mapa-contour/70 rounded-xl p-4 flex flex-col justify-between">
					<div>
						<div class="flex items-center gap-2 mb-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
							<h3 class="font-bold text-mapa-ink text-sm">DOTr & MMDA Busway Project Management Office</h3>
