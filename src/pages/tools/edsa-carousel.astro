const INTERCHANGE_HUBS = [
	{
		title: 'One Ayala Intermodal Terminal',
		stop: 'Ayala (One Ayala)',
		description: 'Metro Manila’s premier private-public transit interchange connecting EDSA Carousel with MRT-3 Ayala, BGC Bus, point-to-point (P2P) buses to Laguna/Cavite, and city UV Express vans.',
		badge: 'Terminal Concourse'
	},
	{
		title: 'PITX (Parañaque Integrated Terminal Exchange)',
		stop: 'PITX',
		description: 'South Luzon gateway terminal providing seamless transfers to Southwest provincial buses (Cavite, Batangas), Bicol express lines, modern jeepneys, and future LRT-1 Asia World station.',
		badge: 'Grand Intermodal'
	},
	{
		title: 'North Avenue Grand Central Hub',
		stop: 'North Avenue',
		description: 'Northern junction connecting EDSA Carousel with MRT-3 North Avenue, TriNoma, SM City North EDSA, and the future Unified Grand Central Station (LRT-1 / MRT-3 / MRT-7 / Metro Manila Subway).',
		badge: 'Mega Transit Hub'
	},
	{
		title: 'Pasay Rotonda Interchange',
		stop: 'Taft Avenue',
		description: 'Dense multi-tiered transfer point between the EDSA Carousel median busway, MRT-3 Taft Avenue terminus, and LRT-1 EDSA station via an elevated pedestrian footbridge network.',
		badge: 'Dual Rail Link'
	}
];

const BUSWAY_STOPS_WITH_FARES = BUSWAY_STOPS.map((stop) => {
	const dist = stop.km;
	let regFare = dist <= 4.0 ? 15.0 : 15.0 + (dist - 4.0) * 2.65;
	regFare = Math.min(75.5, Math.max(15.0, Math.round(regFare * 2) / 2));
	const discFare = Math.round(regFare * 0.8 * 2) / 2;
	return {
		...stop,
		regFare,
		discFare
	};
});
---

<BaseLayout
	title="EDSA Carousel Busway Stop-by-Stop Fare & Route Map — mapaPH Tools"
	description="Interactive EDSA Carousel Busway (Route E) stop-by-stop fare calculator, schematic transit ribbon, and geographic route map. Computes official LTFRB distance-based fares, 20% statutory discounts, travel times, and rail interchanges between Monumento and PITX."
	keywords="EDSA Carousel fare calculator, EDSA Busway stops, Monumento to PITX fare, EDSA Carousel map, LTFRB bus fare matrix, One Ayala busway, MRT 3 to EDSA Carousel transfer, 24/7 bus EDSA, PITX busway stops, Ayala Malls Manila Bay bus stop"
>
	<!-- Leaflet Stylesheet -->
	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
		slot="schema"
	/>

	<script type="application/ld+json" slot="schema" is:inline>
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "EDSA Carousel Busway Stop-by-Stop Fare & Route Map",
					"url": "https://mapaph.com/tools/edsa-carousel",
					"applicationCategory": "Public Transit & Commuter Utility",
					"operatingSystem": "All",
					"description": "Interactive fare calculator and dual schematic/geographic route map for the EDSA Carousel Busway (Route E) from Monumento to PITX with official LTFRB distance tariffs.",
					"provider": {
						"@type": "Organization",
						"name": "mapaPH",
						"url": "https://mapaph.com"
					}
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": "https://mapaph.com"
						},
