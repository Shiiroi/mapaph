							"@type": "ListItem",
							"position": 3,
							"name": "EDSA Carousel Busway Guide",
							"item": "https://mapaph.com/tools/edsa-carousel"
						}
					]
				}
			]
		}
	</script>

	<Navbar />

	<main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 text-mapa-ink">
		<!-- Header Breadcrumb & Tag -->
		<div class="mb-8">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-sans text-mapa-muted mb-3">
				<a href="/" class="hover:text-mapa-green transition-colors">Home</a>
				<span>/</span>
				<a href="/tools" class="hover:text-mapa-green transition-colors">Tools</a>
				<span>/</span>
				<span class="text-mapa-ink font-semibold">EDSA Carousel Busway</span>
			</nav>

			<div class="flex flex-wrap items-center gap-2.5">
				<span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-emerald-600/15 text-emerald-800 border border-emerald-600/30">
					Route E &bull; Median Bus Rapid Transit (BRT)
				</span>
				<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-mapa-canvas-dark border border-mapa-contour text-mapa-ink/75">
					21 Stations &bull; 28.1 Kilometers
				</span>
				<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-800 border border-blue-500/20">
					24/7 Operating Hours
				</span>
			</div>

			<h1 class="text-3xl sm:text-5xl font-extrabold text-mapa-green font-serif tracking-tight mt-3">
				EDSA Carousel Busway Fare & Route Map
			</h1>
			<p class="font-sans text-base sm:text-lg text-mapa-ink/80 mt-2.5 max-w-3xl leading-relaxed">
				Official LTFRB distance-based fare calculator, schematic transit strip, and geographic route map for Metro Manila's 24/7 inner-lane busway connecting Caloocan (Monumento) to Parañaque (PITX).
			</p>
		</div>

		<!-- Top Summary Stat Badges -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4 mb-8 font-sans">
			<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-xl p-4 shadow-2xs">
				<div class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay">Base Fare</div>
				<div class="text-2xl font-extrabold text-mapa-ink mt-1">₱15.00</div>
