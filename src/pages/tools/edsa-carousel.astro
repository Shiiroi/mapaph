				<div class="text-2xl font-extrabold text-mapa-ink mt-1">₱2.65 <span class="text-xs font-normal text-mapa-ink/60">/ km</span></div>
				<div class="text-[11px] text-mapa-ink/65 mt-0.5">Every succeeding kilometer</div>
			</div>
			<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-xl p-4 shadow-2xs">
				<div class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay">Maximum Fare</div>
				<div class="text-2xl font-extrabold text-emerald-800 mt-1">₱75.50</div>
				<div class="text-[11px] text-mapa-ink/65 mt-0.5">End-to-End (Monumento ↔ PITX)</div>
			</div>
			<div class="bg-mapa-canvas-dark border border-mapa-contour rounded-xl p-4 shadow-2xs">
				<div class="text-[11px] font-bold uppercase tracking-wider text-mapa-clay">Statutory Discount</div>
				<div class="text-2xl font-extrabold text-blue-700 mt-1">20% OFF</div>
				<div class="text-[11px] text-mapa-ink/65 mt-0.5">Students, Seniors, PWDs (₱60.50 max)</div>
			</div>
		</div>

		<!-- Main Interactive Tool Section: 2 Columns (Control & Result Panel + Dual Visualizer) -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
			
			<!-- Left Column: Controls, Fare Result, and Station Details (5 cols) -->
			<div class="lg:col-span-5 flex flex-col gap-6 font-sans">
