					<div>
						<div class="flex items-center gap-2 mb-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-mapa-green"></span>
							<h3 class="font-bold text-mapa-ink text-sm">Land Transportation Franchising and Regulatory Board (LTFRB)</h3>
						</div>
						<p class="text-mapa-ink/75 leading-relaxed">
							Authorized under <strong>LTFRB Route 1 (EDSA Busway)</strong> PUB (Aircon) Regular Fare Guide effective <strong>28 September 2026</strong>. Minimum commuter fare is ₱18.00 regular (₱14.50 discounted) for the initial 5.0 km with a succeeding distance rate of ₱2.98/km, rounded to the nearest 25 centavos.
						</p>
					</div>
					<div class="mt-3 pt-2.5 border-t border-mapa-contour/50">
						<a
							href="https://ltfrb.gov.ph"
							target="_blank"
							rel="noopener noreferrer"
							class="text-mapa-green font-bold hover:underline inline-flex items-center gap-1"
						>
							<span>LTFRB Official Portal</span>
							<span>&rarr;</span>
						</a>
					</div>
				</div>

				<div class="bg-mapa-canvas border border-mapa-contour/70 rounded-xl p-4 flex flex-col justify-between">
					<div>
						<div class="flex items-center gap-2 mb-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-mapa-green"></span>
							<h3 class="font-bold text-mapa-ink text-sm">DOTr & MMDA Busway Project Management Office</h3>
						</div>
						<p class="text-mapa-ink/75 leading-relaxed">
							Jointly administered by the Department of Transportation (DOTr) Road Transport Sector and Metropolitan Manila Development Authority (MMDA) for dedicated median corridor traffic enforcement, footbridge concourses, and PITX terminal operations.
						</p>
					</div>
					<div class="mt-3 pt-2.5 border-t border-mapa-contour/50">
						<a
							href="https://dotr.gov.ph"
							target="_blank"
							rel="noopener noreferrer"
							class="text-mapa-green font-bold hover:underline inline-flex items-center gap-1"
						>
							<span>DOTr Official Portal</span>
							<span>&rarr;</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<!-- Leaflet Bundle Script -->
	<script
		src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
		integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
		crossorigin=""
		is:inline
	></script>

	<!-- Interactive Client Logic -->
	<script is:inline define:vars={{ BUSWAY_STOPS, FULL_BUSWAY_MATRIX }}>
		document.addEventListener('DOMContentLoaded', () => {
			const originSelect = document.getElementById('origin-select');
			const destSelect = document.getElementById('dest-select');
			const discountToggle = document.getElementById('discount-toggle');
			const swapBtn = document.getElementById('swap-stops-btn');
			const quickSwapBtn = document.getElementById('busway-quick-swap-btn');

			const targetOriginBtn = document.getElementById('busway-target-origin');
			const targetDestBtn = document.getElementById('busway-target-dest');
			const clickHintEl = document.getElementById('busway-click-hint');

			const summaryOriginEl = document.getElementById('busway-summary-origin');
			const summaryDestEl = document.getElementById('busway-summary-dest');
			const summaryMetricEl = document.getElementById('busway-summary-metric');

			const computedFareEl = document.getElementById('computed-fare');
			const strikeFareEl = document.getElementById('discounted-fare-strikethrough');
			const fareRateBadge = document.getElementById('fare-rate-badge');

			const statDistanceEl = document.getElementById('stat-distance');
			const statStopsEl = document.getElementById('stat-stops');
			const statTimeEl = document.getElementById('stat-time');

			const cardStopName = document.getElementById('card-stop-name');
			const cardStopCity = document.getElementById('card-stop-city');
			const cardStopPlatform = document.getElementById('card-stop-platform');
			const cardStopAccess = document.getElementById('card-stop-access');
			const cardStopInterchanges = document.getElementById('card-stop-interchanges');
			const cardStopLandmarks = document.getElementById('card-stop-landmarks');

			const btnViewList = document.getElementById('btn-view-list');
			const btnViewSchematic = document.getElementById('btn-view-schematic');
			const btnViewGeo = document.getElementById('btn-view-geo');
			const listContainer = document.getElementById('list-view-container');
			const schematicContainer = document.getElementById('schematic-view-container');
			const geoContainer = document.getElementById('geo-view-container');
			const buswayDiagramSvg = document.getElementById('busway-diagram-svg');
			const buswayDiagramTargetLabel = document.getElementById('busway-diagram-target-label');

			let leafletMap = null;
			let mapMarkers = [];
			let routePolyline = null;

			// Stop Lookup Map
			const stopsMap = new Map();
			BUSWAY_STOPS.forEach((stop, idx) => {
				stopsMap.set(stop.id, { ...stop, index: idx });
			});

			// Current active click target mode: 'origin' or 'dest'
			let currentTargetMode = 'origin';

			function setTargetMode(mode) {
				currentTargetMode = mode;
				if (buswayDiagramTargetLabel) {
					buswayDiagramTargetLabel.textContent = mode === 'origin' ? 'Boarding' : 'Destination';
				}
				if (mode === 'origin') {
					targetOriginBtn.className = 'px-3 py-1.5 rounded-lg bg-mapa-green text-white shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer';
					targetDestBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer';
					clickHintEl.className = 'text-xs text-mapa-ink/80 bg-mapa-canvas border border-mapa-contour px-3 py-1.5 rounded-lg flex items-center gap-2 font-medium';
					clickHintEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-mapa-green shrink-0"></span><span>Click any stop row or select <strong>Board</strong> to set your origin stop.</span>';
				} else {
					targetDestBtn.className = 'px-3 py-1.5 rounded-lg bg-mapa-navy text-white shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer';
					targetOriginBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all flex items-center gap-1.5 cursor-pointer';
					clickHintEl.className = 'text-xs text-mapa-ink/80 bg-mapa-canvas border border-mapa-contour px-3 py-1.5 rounded-lg flex items-center gap-2 font-medium';
					clickHintEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-mapa-navy shrink-0"></span><span>Click any stop row or select <strong>Alight</strong> to set your destination stop.</span>';
				}
			}

			targetOriginBtn?.addEventListener('click', () => setTargetMode('origin'));
			targetDestBtn?.addEventListener('click', () => setTargetMode('dest'));

			// Global method to set stop
			window.setBuswayStop = function (stopId, type) {
				const stop = stopsMap.get(stopId);
				if (!stop) return;

				if (type === 'origin') {
					originSelect.value = stopId;
					// Automatically advance to destination mode
					setTargetMode('dest');
					clickHintEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-mapa-navy shrink-0"></span><span>Boarding set to <strong>${stop.name}</strong>. Now select your <strong>Destination</strong> stop.</span>`;
				} else {
					destSelect.value = stopId;
				}

				inspectStop(stop);
				calculateFare();
				if (leafletMap) leafletMap.closePopup();
			};

			function calculateFare() {
				const originId = originSelect.value;
				const destId = destSelect.value;
				const hasDiscount = discountToggle.checked;

				const origin = stopsMap.get(originId);
				const dest = stopsMap.get(destId);

				if (!origin || !dest) return;

				const distance = Math.abs(dest.km - origin.km);
				const stopsTraversed = Math.abs(dest.index - origin.index);

				// Update Summary Ribbon
				if (summaryOriginEl) summaryOriginEl.textContent = origin.name;
				if (summaryDestEl) summaryDestEl.textContent = dest.name;

				// Official LTFRB Route 1: EDSA Busway Fare Guide (Effective 28 September 2026)
				// Lookup exact station-to-station fare from FULL_BUSWAY_MATRIX
				const regFare = origin.index === dest.index ? 18.0 : FULL_BUSWAY_MATRIX[origin.index][dest.index];
				const discFare = Math.max(14.5, Math.round(regFare * 0.8 * 4) / 4);

				if (hasDiscount) {
					computedFareEl.textContent = `₱${discFare.toFixed(2)}`;
					strikeFareEl.textContent = `₱${regFare.toFixed(2)}`;
					strikeFareEl.classList.remove('hidden');
					fareRateBadge.textContent = '20% Discount';
					fareRateBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-mapa-navy text-white';
					if (summaryMetricEl) summaryMetricEl.textContent = `${stopsTraversed} stops • ₱${discFare.toFixed(2)}`;
				} else {
					computedFareEl.textContent = `₱${regFare.toFixed(2)}`;
					strikeFareEl.classList.add('hidden');
					fareRateBadge.textContent = 'Regular';
					fareRateBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-mapa-green text-white';
					if (summaryMetricEl) summaryMetricEl.textContent = `${stopsTraversed} stops • ₱${regFare.toFixed(2)}`;
				}

				const activeCurrentFare = hasDiscount ? discFare : regFare;
				updateBuswaySukli(activeCurrentFare);

				statDistanceEl.textContent = `${distance.toFixed(1)} km`;
				statStopsEl.textContent = `${stopsTraversed} ${stopsTraversed === 1 ? 'stop' : 'stops'}`;

				const estMin = Math.max(5, Math.round(stopsTraversed * 2.2));
				const estMax = Math.max(8, Math.round(stopsTraversed * 3.1));
				statTimeEl.textContent = stopsTraversed === 0 ? '0 mins' : `~${estMin}–${estMax} mins`;

				updateSchematicHighlight(origin.index, dest.index);
				updateMapHighlight(origin, dest);
				updateBuswayDiagram(origin.id, dest.id);
			}

			let currentBuswayTender = 100.0;
			const buswaySukliDisplay = document.getElementById('busway-sukli-display');
			const buswaySukliBreakdown = document.getElementById('busway-sukli-breakdown');
			const btnCopyBuswayFare = document.getElementById('btn-copy-busway-fare');
			const btnCopyBuswayFareText = document.getElementById('btn-copy-busway-fare-text');
			const buswayTenderBtns = document.querySelectorAll('.busway-tender-btn');

			function formatChangeBreakdown(cents) {
				if (cents === 0) return 'Exact payment handed. No change needed.';
				const denoms = [
					{ name: '₱500 bill', val: 50000 },
					{ name: '₱200 bill', val: 20000 },
					{ name: '₱100 bill', val: 10000 },
					{ name: '₱50 bill', val: 5000 },
					{ name: '₱20 bill', val: 2000 },
					{ name: '₱10 coin', val: 1000 },
					{ name: '₱5 coin', val: 500 },
					{ name: '₱1 coin', val: 100 },
					{ name: '25¢ coin', val: 25 }
				];
				let remaining = cents;
				const pieces = [];
				for (const d of denoms) {
					if (remaining >= d.val) {
						const count = Math.floor(remaining / d.val);
						remaining = remaining % d.val;
						pieces.push(`${count} × ${d.name}`);
					}
				}
				return pieces.length > 0 ? pieces.join(', ') : 'Exact amount';
			}

			function updateBuswaySukli(fare) {
				if (!buswaySukliDisplay) return;
				const diff = Math.round((currentBuswayTender - fare) * 4) / 4;
				if (diff < 0) {
					buswaySukliDisplay.textContent = `Kulang ng ₱${Math.abs(diff).toFixed(2)}`;
					buswaySukliDisplay.className = 'font-bold text-mapa-rust';
					if (buswaySukliBreakdown) buswaySukliBreakdown.textContent = 'Tendered cash is less than the required fare.';
				} else {
					buswaySukliDisplay.textContent = `₱${diff.toFixed(2)} sukli for ₱${currentBuswayTender.toFixed(0)}`;
					buswaySukliDisplay.className = 'font-bold text-mapa-green';
					if (buswaySukliBreakdown) {
						const cents = Math.round(diff * 100);
						buswaySukliBreakdown.textContent = `Expected: ${formatChangeBreakdown(cents)}`;
					}
				}
			}

			buswayTenderBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					buswayTenderBtns.forEach((b) => {
						b.classList.remove('active', 'bg-mapa-green', 'text-white');
						b.classList.add('bg-mapa-canvas-dark', 'text-mapa-ink');
					});
					btn.classList.add('active', 'bg-mapa-green', 'text-white');
					btn.classList.remove('bg-mapa-canvas-dark', 'text-mapa-ink');
					currentBuswayTender = parseFloat(btn.getAttribute('data-cash'));
					const origin = stopsMap.get(originSelect.value);
					const dest = stopsMap.get(destSelect.value);
					if (origin && dest) {
						const regFare = origin.index === dest.index ? 18.0 : FULL_BUSWAY_MATRIX[origin.index][dest.index];
						const discFare = Math.max(14.5, Math.round(regFare * 0.8 * 4) / 4);
						const activeFare = discountToggle.checked ? discFare : regFare;
						updateBuswaySukli(activeFare);
					}
				});
			});

			if (btnCopyBuswayFare) {
				btnCopyBuswayFare.addEventListener('click', async () => {
					const origin = stopsMap.get(originSelect.value);
					const dest = stopsMap.get(destSelect.value);
					if (!origin || !dest) return;

					const regFare = origin.index === dest.index ? 18.0 : FULL_BUSWAY_MATRIX[origin.index][dest.index];
					const discFare = Math.max(14.5, Math.round(regFare * 0.8 * 4) / 4);
					const isDisc = discountToggle.checked;
					const activeFare = isDisc ? discFare : regFare;
					const distance = Math.abs(dest.km - origin.km);
					const stopsTraversed = Math.abs(dest.index - origin.index);

					const text = `EDSA Carousel Busway Fare (${origin.name} to ${dest.name}):\n` +
						`• Fare: ₱${activeFare.toFixed(2)} (${isDisc ? '20% Discounted' : 'Regular'})\n` +
						`• Distance: ${distance.toFixed(1)} km (${stopsTraversed} stops)\n` +
						`• Service: 24/7 Route 1 Busway (PUB Aircon)\n` +
						`Official LTFRB 2026 Fare Guide via mapaPH: https://www.mapaph.com/tools/edsa-carousel`;

					try {
						await navigator.clipboard.writeText(text);
						if (btnCopyBuswayFareText) btnCopyBuswayFareText.textContent = 'Copied to Clipboard!';
						setTimeout(() => {
							if (btnCopyBuswayFareText) btnCopyBuswayFareText.textContent = 'Copy Journey Fare Breakdown';
						}, 3000);
					} catch (err) {
						console.error('Copy failed:', err);
					}
				});
			}

			function updateSchematicHighlight(idx1, idx2) {
				const minIdx = Math.min(idx1, idx2);
				const maxIdx = Math.max(idx1, idx2);

				BUSWAY_STOPS.forEach((stop, index) => {
					const nodeEl = document.getElementById(`schematic-node-${stop.id}`);
					const badgeEl = document.getElementById(`busway-badge-${stop.id}`);
					if (!nodeEl) return;

					const trackTop = nodeEl.querySelector('.busway-track-top');
					const trackBottom = nodeEl.querySelector('.busway-track-bottom');

					// Reset track segments
					if (trackTop) {
						trackTop.className = 'busway-track-top absolute left-[-15px] top-[-14px] bottom-1/2 w-1.5 bg-mapa-contour transition-colors z-0';
					}
					if (trackBottom) {
						trackBottom.className = 'busway-track-bottom absolute left-[-15px] top-1/2 bottom-[-14px] w-1.5 bg-mapa-contour transition-colors z-0';
					}

					if (index === idx1) {
						nodeEl.className = 'schematic-node relative flex items-center justify-between p-3 rounded-xl border border-mapa-green bg-mapa-green/10 transition-all cursor-pointer';
						if (badgeEl) {
							badgeEl.textContent = 'Boarding';
							badgeEl.className = 'busway-status-badge inline-block text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-mapa-green text-white';
						}
					} else if (index === idx2) {
						nodeEl.className = 'schematic-node relative flex items-center justify-between p-3 rounded-xl border border-mapa-navy bg-mapa-navy/10 transition-all cursor-pointer';
						if (badgeEl) {
							badgeEl.textContent = 'Alighting';
							badgeEl.className = 'busway-status-badge inline-block text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-mapa-navy text-white';
						}
					} else if (index > minIdx && index < maxIdx) {
						nodeEl.className = 'schematic-node relative flex items-center justify-between p-3 rounded-xl border border-mapa-green/35 bg-mapa-canvas transition-all cursor-pointer';
						if (badgeEl) badgeEl.className = 'busway-status-badge hidden';
					} else {
						nodeEl.className = 'schematic-node relative flex items-center justify-between p-3 rounded-xl border border-transparent hover:border-mapa-green/40 hover:bg-mapa-canvas transition-all cursor-pointer group';
						if (badgeEl) badgeEl.className = 'busway-status-badge hidden';
					}

					// Light up track segments along the active busway journey path
					if (idx1 !== idx2) {
						if (index > minIdx && index <= maxIdx && trackTop) {
							trackTop.className = 'busway-track-top absolute left-[-15px] top-[-14px] bottom-1/2 w-1.5 bg-mapa-green transition-colors z-0';
						}
						if (index >= minIdx && index < maxIdx && trackBottom) {
							trackBottom.className = 'busway-track-bottom absolute left-[-15px] top-1/2 bottom-[-14px] w-1.5 bg-mapa-green transition-colors z-0';
						}
					}
				});
			}

			function inspectStop(stop) {
				if (!stop) return;
				cardStopName.textContent = stop.name;
				cardStopCity.textContent = stop.city;
				cardStopPlatform.textContent = stop.platform;
				cardStopAccess.textContent = stop.access;
				cardStopLandmarks.textContent = stop.landmarks;

				// Clear and rebuild interchanges
				cardStopInterchanges.innerHTML = '';
				if (stop.interchanges && stop.interchanges.length > 0) {
					stop.interchanges.forEach(ic => {
						const span = document.createElement('span');
						span.className = 'px-2 py-0.5 rounded bg-mapa-green/10 text-mapa-green border border-mapa-green/25';
						span.textContent = ic;
						cardStopInterchanges.appendChild(span);
					});
				} else {
					const span = document.createElement('span');
					span.className = 'text-mapa-muted';
					span.textContent = 'None / Local street connections';
					cardStopInterchanges.appendChild(span);
				}
			}

			// Intermediate road-following waypoints between consecutive stops (EDSA median alignment).
			// Hand-traced from OpenStreetMap; accurate to roughly tens of meters, not survey grade.
			const PATH_WAYPOINTS = {
				'monumento>bagong_barrio': [[14.6552, 120.9890], [14.6572, 120.9945]],
				'bagong_barrio>balintawak': [[14.6577, 121.0005]],
				'balintawak>kaingin': [[14.6572, 121.0095]],
				'roosevelt>sm_north_edsa': [[14.6568, 121.0255]],
				'sm_north_edsa>north_ave': [[14.6542, 121.0310]],
				'north_ave>philam_qc': [[14.6505, 121.0340]],
				'philam_qc>quezon_ave': [[14.6455, 121.0370]],
				'quezon_ave>kamuning': [[14.6390, 121.0410]],
				'kamuning>q_mart': [[14.6335, 121.0436]],
				'q_mart>main_ave': [[14.6270, 121.0475]],
				'main_ave>santolan': [[14.6135, 121.0535]],
				'santolan>ortigas': [[14.5995, 121.0580], [14.5935, 121.0580]],
				'ortigas>guadalupe': [[14.5813, 121.0535], [14.5740, 121.0482]],
				'guadalupe>buendia': [[14.5622, 121.0420], [14.5582, 121.0382]],
				'ayala>tramo': [[14.5420, 121.0194], [14.5402, 121.0140]],
				'tramo>taft_ave': [[14.5378, 121.0040]],
				'taft_ave>roxas_blvd': [[14.5368, 120.9965]],
				'roxas_blvd>moa': [[14.5353, 120.9880]],
				'moa>dfa_aseana': [[14.5280, 120.9875]]
			};

			// Full ordered path: every vertex is { stopId | null, ll }
			const FULL_PATH = [];
			BUSWAY_STOPS.forEach((stop, i) => {
				FULL_PATH.push({ stopId: stop.id, ll: [stop.lat, stop.lon] });
				const next = BUSWAY_STOPS[i + 1];
				if (next) {
					(PATH_WAYPOINTS[`${stop.id}>${next.id}`] || []).forEach(ll => FULL_PATH.push({ stopId: null, ll }));
				}
			});

			function pathBetween(idA, idB) {
				let a = FULL_PATH.findIndex(v => v.stopId === idA);
				let b = FULL_PATH.findIndex(v => v.stopId === idB);
				if (a === -1 || b === -1) return [];
				if (a > b) [a, b] = [b, a];
				return FULL_PATH.slice(a, b + 1).map(v => v.ll);
			}

			let activeRoutePolyline = null;

			const SVG_NS = 'http://www.w3.org/2000/svg';
			function svgEl(name, attrs = {}, text) {
				const el = document.createElementNS(SVG_NS, name);
				Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
				if (text !== undefined) el.textContent = text;
				return el;
			}

			// Station coordinates on the schematic diagram (24 official stations)
			const BUSWAY_DIAGRAM_STATIONS = [
				{ id: 'monumento', name: 'Monumento', x: 140, y: 120, align: 'top', hub: 'LRT-1' },
				{ id: 'bagong_barrio', name: 'Bagong Barrio', x: 230, y: 120, align: 'top' },
				{ id: 'balintawak', name: 'Balintawak', x: 320, y: 120, align: 'top', hub: 'LRT-1' },
				{ id: 'kaingin', name: 'Kaingin', x: 410, y: 120, align: 'top' },
				{ id: 'roosevelt', name: 'Fernando Poe Jr.', x: 500, y: 120, align: 'top', hub: 'LRT-1' },
				{ id: 'sm_north_edsa', name: 'SM North EDSA', x: 595, y: 120, align: 'top', hub: 'SM North' },
				{ id: 'north_ave', name: 'North Avenue', x: 675, y: 185, align: 'right', hub: 'MRT-3' },
				{ id: 'philam_qc', name: 'Philam Q.C.', x: 690, y: 245, align: 'right' },
				{ id: 'quezon_ave', name: 'Quezon Avenue', x: 705, y: 305, align: 'right', hub: 'MRT-3' },
				{ id: 'kamuning', name: 'Kamuning', x: 715, y: 365, align: 'right', hub: 'MRT-3' },
				{ id: 'q_mart', name: 'Nepa Q. Mart', x: 725, y: 425, align: 'right' },
				{ id: 'main_ave', name: 'Main Avenue (Cubao)', x: 730, y: 485, align: 'right', hub: 'LRT-2 / MRT-3' },
				{ id: 'santolan', name: 'Santolan', x: 730, y: 545, align: 'right', hub: 'MRT-3' },
				{ id: 'ortigas', name: 'Ortigas', x: 720, y: 610, align: 'right', hub: 'MRT-3' },
				{ id: 'guadalupe', name: 'Guadalupe', x: 690, y: 675, align: 'right', hub: 'MRT-3' },
				{ id: 'buendia', name: 'Buendia', x: 645, y: 740, align: 'right', hub: 'MRT-3' },
				{ id: 'ayala', name: 'Ayala (One Ayala)', x: 585, y: 805, align: 'right', hub: 'One Ayala' },
				{ id: 'tramo', name: 'Tramo (SB)', x: 505, y: 865, align: 'bottom' },
				{ id: 'taft_ave', name: 'Taft Avenue', x: 415, y: 905, align: 'bottom', hub: 'LRT-1 / MRT-3' },
				{ id: 'roxas_blvd', name: 'Roxas Boulevard', x: 325, y: 915, align: 'bottom' },
				{ id: 'moa', name: 'SM Mall of Asia (MOA)', x: 250, y: 970, align: 'right', hub: 'MOA' },
				{ id: 'dfa_aseana', name: 'DFA', x: 250, y: 1035, align: 'right' },
				{ id: 'ayala_manila_bay', name: 'Ayala Malls / City of Dreams', x: 250, y: 1100, align: 'right' },
				{ id: 'pitx', name: 'PITX Grand Terminal', x: 250, y: 1165, align: 'right', hub: 'PITX' }
			];

			const buswayPosMap = {};
			BUSWAY_DIAGRAM_STATIONS.forEach((s, idx) => {
				buswayPosMap[s.id] = { ...s, index: idx };
			});

			// Generate continuous SVG corridor path
			function getBuswayCorridorPath(fromIdx = 0, toIdx = BUSWAY_DIAGRAM_STATIONS.length - 1) {
				const min = Math.min(fromIdx, toIdx);
				const max = Math.max(fromIdx, toIdx);
				const pts = BUSWAY_DIAGRAM_STATIONS.slice(min, max + 1);
				if (pts.length < 2) return '';

				let d = `M ${pts[0].x},${pts[0].y}`;
				for (let i = 0; i < pts.length - 1; i++) {
					const curr = pts[i];
					const next = pts[i + 1];
					if (curr.id === 'sm_north_edsa' && next.id === 'north_ave') {
						d += ` L 645,120 Q 675,120 675,155 L ${next.x},${next.y}`;
					} else if (curr.id === 'roxas_blvd' && next.id === 'moa') {
						d += ` L 280,915 Q 250,915 250,945 L ${next.x},${next.y}`;
					} else {
						d += ` L ${next.x},${next.y}`;
					}
				}
				return d;
			}

			function renderBuswayDiagram() {
				if (!buswayDiagramSvg) return;
				buswayDiagramSvg.innerHTML = '';

				// 1. High-contrast crisp canvas background
				buswayDiagramSvg.appendChild(svgEl('rect', { width: '100%', height: '100%', rx: '16', fill: '#F7F3E9', stroke: '#E5D9C3', 'stroke-width': '2' }));

				// 2. Sector Labels
				const sectors = [
					{ x: 360, y: 55, text: 'NORTH METRO (CALOOCAN & QC NORTH)' },
					{ x: 740, y: 160, text: 'QUEZON CITY EDSA CORRIDOR' },
					{ x: 720, y: 790, text: 'MAKATI CBD & INTERCHANGE' },
					{ x: 410, y: 865, text: 'PASAY ROTONDA' },
					{ x: 250, y: 1220, text: 'BAY AREA & PITX TERMINUS' }
				];
				sectors.forEach(sec => {
					buswayDiagramSvg.appendChild(svgEl('text', {
						x: sec.x, y: sec.y, 'text-anchor': 'middle',
						'font-family': 'ui-sans-serif, system-ui, sans-serif',
						'font-size': '10', 'font-weight': '800', fill: '#5C5343', 'letter-spacing': '2'
					}, sec.text));
				});

				// 5. Full Busway Corridor Base Line
				const fullD = getBuswayCorridorPath(0, BUSWAY_DIAGRAM_STATIONS.length - 1);
				const gBaseLine = svgEl('g', { id: 'busway-base-line' });
				gBaseLine.appendChild(svgEl('path', {
					d: fullD, fill: 'none', stroke: '#3D5A45', 'stroke-width': '10',
					'stroke-linecap': 'round', 'stroke-linejoin': 'round'
				}));
				buswayDiagramSvg.appendChild(gBaseLine);

				// 6. Active Route Container
				buswayDiagramSvg.appendChild(svgEl('g', { id: 'busway-route-highlight' }));

				// 7. Stations Group & Labels Group
				const gStations = svgEl('g', { id: 'busway-stations' });
				const gLabels = svgEl('g', {
					id: 'busway-labels',
					'font-family': 'ui-sans-serif, system-ui, -apple-system, sans-serif',
					'font-size': '13',
					'font-weight': '700',
					fill: '#211D16',
					'paint-order': 'stroke fill',
					stroke: '#F7F3E9',
					'stroke-width': '4px',
					'stroke-linejoin': 'round',
					'pointer-events': 'none'
				});

				BUSWAY_DIAGRAM_STATIONS.forEach(st => {
					const isHub = !!st.hub;

					const g = svgEl('g', {
						'data-stop-id': st.id, tabindex: 0, role: 'button',
						'aria-label': `${st.name} Busway Stop`, style: 'cursor:pointer'
					});

					// Selection ring
					g.appendChild(svgEl('circle', {
						class: 'busway-ring', cx: st.x, cy: st.y, r: 16,
						fill: 'none', stroke: 'transparent', 'stroke-width': 4
					}));

					// Station circle
					g.appendChild(svgEl('circle', {
						class: 'busway-dot', cx: st.x, cy: st.y,
						r: isHub ? 9.5 : 7,
						fill: isHub ? '#FFFFFF' : '#3D5A45',
						stroke: isHub ? '#3D5A45' : '#FFFFFF',
						'stroke-width': isHub ? 3.5 : 2.5
					}));

					// Touch target
					g.appendChild(svgEl('circle', { cx: st.x, cy: st.y, r: 22, fill: 'transparent' }));
					g.appendChild(svgEl('title', {}, `${st.name} (KM ${stopsMap.get(st.id)?.km.toFixed(1) || 0})`));

					g.addEventListener('click', () => window.setBuswayStop(st.id, currentTargetMode));
					g.addEventListener('keydown', e => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							window.setBuswayStop(st.id, currentTargetMode);
						}
					});
					gStations.appendChild(g);

					// Label with halo and offset
					let textAttrs = {};
					if (st.align === 'top') {
						textAttrs = { x: st.x, y: st.y - 18, 'text-anchor': 'middle' };
					} else if (st.align === 'bottom') {
						textAttrs = { x: st.x, y: st.y + 24, 'text-anchor': 'middle' };
					} else {
						textAttrs = { x: st.x + 18, y: st.y + 5, 'text-anchor': 'start' };
					}

					const textEl = svgEl('text', textAttrs, st.name);
					if (st.hub) {
						const tspan = svgEl('tspan', {
							dx: 5, 'font-size': '10', 'font-weight': '800',
							fill: '#3D5A45', stroke: '#F7F3E9', 'stroke-width': '2px', 'paint-order': 'stroke fill'
						}, `[${st.hub}]`);
						textEl.appendChild(tspan);
					}
					gLabels.appendChild(textEl);
				});

				buswayDiagramSvg.appendChild(gStations);
				buswayDiagramSvg.appendChild(gLabels);
			}

			function updateBuswayDiagram(originId, destId) {
				if (!buswayDiagramSvg) return;
				const gRoute = buswayDiagramSvg.querySelector('#busway-route-highlight');
				const gBaseLine = buswayDiagramSvg.querySelector('#busway-base-line');
				if (!gRoute || !gBaseLine) return;

				gRoute.innerHTML = '';

				const oStop = buswayPosMap[originId];
				const dStop = buswayPosMap[destId];

				if (oStop && dStop && oStop.index !== dStop.index) {
					gBaseLine.setAttribute('opacity', '0.35');
					const subD = getBuswayCorridorPath(oStop.index, dStop.index);
					if (subD) {
						gRoute.appendChild(svgEl('path', {
							d: subD, fill: 'none', stroke: '#9E391A', 'stroke-width': 16,
							'stroke-linecap': 'round', 'stroke-linejoin': 'round', opacity: 0.95
						}));
						gRoute.appendChild(svgEl('path', {
							d: subD, fill: 'none', stroke: '#3D5A45', 'stroke-width': 8,
							'stroke-linecap': 'round', 'stroke-linejoin': 'round'
						}));
					}
				} else {
					gBaseLine.setAttribute('opacity', '1');
				}

				// Update station rings
				buswayDiagramSvg.querySelectorAll('#busway-stations g[data-stop-id]').forEach(g => {
					const id = g.getAttribute('data-stop-id');
					const ring = g.querySelector('.busway-ring');
					if (ring) {
						ring.setAttribute('stroke', id === originId ? '#3D5A45' : id === destId ? '#1B2A4A' : 'transparent');
					}
				});
			}

			function initLeafletMap() {
				if (leafletMap || typeof L === 'undefined') return;

				leafletMap = L.map('busway-map', {
					center: [14.582, 121.03],
					zoom: 12,
					scrollWheelZoom: true
				});

				// 100% Free OpenStreetMap raster tiles (Zero API key required)
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
					maxZoom: 19
				}).addTo(leafletMap);

				// Route coordinates array (stops + road-following waypoints)
				const latLngs = FULL_PATH.map(v => v.ll);

				// Add background route line
				routePolyline = L.polyline(latLngs, {
					color: '#3D5A45',
					weight: 5,
					opacity: 0.85,
					lineJoin: 'round',
					interactive: false
				}).addTo(leafletMap);

				// Add markers for all 21 stops
				BUSWAY_STOPS.forEach((stop, index) => {
					const marker = L.circleMarker([stop.lat, stop.lon], {
						radius: stop.isTerminus ? 8 : 6,
						fillColor: stop.isTerminus ? '#211D16' : '#3D5A45',
						color: '#ffffff',
						weight: 2,
						opacity: 1,
						fillOpacity: 0.95
					}).addTo(leafletMap);

					marker.bindPopup(`
						<div class="font-sans text-xs p-1">
							<strong class="text-sm font-serif block text-mapa-ink">${index + 1}. ${stop.name}</strong>
							<span class="text-mapa-muted block text-[11px]">${stop.city} &bull; KM ${stop.km.toFixed(1)}</span>
							<span class="text-mapa-green font-semibold block text-[11px] mb-2">${stop.platform}</span>
							<div class="flex gap-1.5 mt-2">
								<button type="button" class="px-2.5 py-1 bg-mapa-green text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setBuswayStop('${stop.id}', 'origin')">
									Board Here
								</button>
								<button type="button" class="px-2.5 py-1 bg-mapa-navy text-white rounded text-[11px] font-bold shadow-xs cursor-pointer" onclick="window.setBuswayStop('${stop.id}', 'dest')">
									Alight Here
								</button>
							</div>
						</div>
					`);

					marker.on('click', () => {
						window.setBuswayStop(stop.id, currentTargetMode);
					});

					mapMarkers.push({ id: stop.id, marker });
				});

				leafletMap.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });
			}

			function updateMapHighlight(origin, dest) {
				if (!leafletMap) return;

				if (activeRoutePolyline) {
					leafletMap.removeLayer(activeRoutePolyline);
					activeRoutePolyline = null;
				}
				if (origin.id !== dest.id) {
					activeRoutePolyline = L.polyline(pathBetween(origin.id, dest.id), {
						color: '#9E391A',
						weight: 7,
						opacity: 0.95,
						lineJoin: 'round',
						interactive: false
					}).addTo(leafletMap);
					mapMarkers.forEach(({ marker }) => marker.bringToFront());
				}

				mapMarkers.forEach(({ id, marker }) => {
					if (id === origin.id) {
						marker.setStyle({ fillColor: '#3D5A45', radius: 10, weight: 3 });
					} else if (id === dest.id) {
						marker.setStyle({ fillColor: '#1B2A4A', radius: 10, weight: 3 });
					} else {
						const isTerm = id === 'monumento' || id === 'pitx';
						marker.setStyle({ fillColor: isTerm ? '#211D16' : '#3D5A45', radius: isTerm ? 8 : 6, weight: 2 });
					}
				});
			}

			// Event Listeners
			originSelect.addEventListener('change', () => {
				const stop = stopsMap.get(originSelect.value);
				inspectStop(stop);
				calculateFare();
			});

			destSelect.addEventListener('change', () => {
				const stop = stopsMap.get(destSelect.value);
				inspectStop(stop);
				calculateFare();
			});

			discountToggle.addEventListener('change', calculateFare);

			function swapBuswayStops() {
				const temp = originSelect.value;
				originSelect.value = destSelect.value;
				destSelect.value = temp;
				calculateFare();
			}

			swapBtn.addEventListener('click', swapBuswayStops);
			quickSwapBtn?.addEventListener('click', swapBuswayStops);

			// Schematic node click delegation & quick buttons
			document.querySelectorAll('.schematic-node').forEach(node => {
				const stopId = node.getAttribute('data-stop-id');

				// Clicking entire row sets according to active currentTargetMode
				node.addEventListener('click', (e) => {
					if (e.target.closest('.btn-busway-board') || e.target.closest('.btn-busway-alight')) return;
					window.setBuswayStop(stopId, currentTargetMode);
				});

				const boardBtn = node.querySelector('.btn-busway-board');
				boardBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					window.setBuswayStop(stopId, 'origin');
				});

				const alightBtn = node.querySelector('.btn-busway-alight');
				alightBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					window.setBuswayStop(stopId, 'dest');
				});
			});

			// View Switcher logic (List / Schematic / Geo).
			// State lives in originSelect/destSelect so switching is instant and preserves the route.
			const VIEW_ON = 'px-3 py-1.5 text-xs font-bold rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
			const VIEW_OFF = 'px-3 py-1.5 text-xs font-medium rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';

			function setView(view) {
				const views = {
					list: [btnViewList, listContainer],
					schematic: [btnViewSchematic, schematicContainer],
					geo: [btnViewGeo, geoContainer]
				};

				Object.entries(views).forEach(([key, [btn, el]]) => {
					if (btn) btn.className = key === view ? VIEW_ON : VIEW_OFF;
					if (el) el.classList.toggle('hidden', key !== view);
				});

				if (view === 'geo') {
					initLeafletMap();
					calculateFare(); // redraws the active route on the map
					leafletMap?.invalidateSize();
					if (activeRoutePolyline) {
						leafletMap.fitBounds(activeRoutePolyline.getBounds(), { padding: [40, 40] });
					} else if (routePolyline) {
						leafletMap.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });
					}
					setTimeout(() => leafletMap?.invalidateSize(), 60);
				} else if (view === 'schematic') {
					renderBuswayDiagram();
					calculateFare();
				} else {
					calculateFare();
				}
			}

			btnViewList?.addEventListener('click', () => setView('list'));
			btnViewSchematic?.addEventListener('click', () => setView('schematic'));
			btnViewGeo?.addEventListener('click', () => setView('geo'));

			// Official Triangular Fare Matrix Toggles (Southbound/Northbound & Regular/20% Discount)
			const matrixDirSbBtn = document.getElementById('matrix-dir-sb');
			const matrixDirNbBtn = document.getElementById('matrix-dir-nb');
			const sbMatrixWrapper = document.getElementById('sb-matrix-wrapper');
			const nbMatrixWrapper = document.getElementById('nb-matrix-wrapper');

			const matrixRateRegBtn = document.getElementById('matrix-rate-reg');
			const matrixRateDiscBtn = document.getElementById('matrix-rate-disc');

			matrixDirSbBtn?.addEventListener('click', () => {
				sbMatrixWrapper?.classList.remove('hidden');
				nbMatrixWrapper?.classList.add('hidden');
				matrixDirSbBtn.className = 'px-3 py-1.5 rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				if (matrixDirNbBtn) matrixDirNbBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
			});

			matrixDirNbBtn?.addEventListener('click', () => {
				nbMatrixWrapper?.classList.remove('hidden');
				sbMatrixWrapper?.classList.add('hidden');
				matrixDirNbBtn.className = 'px-3 py-1.5 rounded-lg bg-mapa-green text-white shadow-2xs transition-all cursor-pointer';
				if (matrixDirSbBtn) matrixDirSbBtn.className = 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
			});

			function setMatrixRate(mode) {
				const isDisc = mode === 'disc';
				if (matrixRateRegBtn && matrixRateDiscBtn) {
					matrixRateRegBtn.className = !isDisc
						? 'px-3 py-1.5 rounded-lg bg-mapa-navy text-white shadow-2xs transition-all cursor-pointer'
						: 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
					matrixRateDiscBtn.className = isDisc
						? 'px-3 py-1.5 rounded-lg bg-mapa-navy text-white shadow-2xs transition-all cursor-pointer'
						: 'px-3 py-1.5 rounded-lg text-mapa-ink/70 hover:text-mapa-ink transition-all cursor-pointer';
				}
				document.querySelectorAll('.edsa-matrix-cell').forEach(cell => {
					const val = isDisc ? cell.getAttribute('data-disc') : cell.getAttribute('data-reg');
					if (val) cell.textContent = val;
				});
			}

			matrixRateRegBtn?.addEventListener('click', () => setMatrixRate('reg'));
			matrixRateDiscBtn?.addEventListener('click', () => setMatrixRate('disc'));

			// Initial calculation and diagram rendering
			renderBuswayDiagram();
			calculateFare();
			inspectStop(BUSWAY_STOPS[0]);
		});
	</script>
</BaseLayout>
